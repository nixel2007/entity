#Использовать "../.."

// Демо-приложение "Задачник", версия 1.
// Схема 1.0.0: Задача (Идентификатор, Имя, Выполнена).

КаталогДанных = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "данные");
ФайлКаталога = Новый Файл(КаталогДанных);
Если НЕ ФайлКаталога.Существует() Тогда
	СоздатьКаталог(КаталогДанных);
КонецЕсли;

ПодключитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "Задача.os"), "Задача");

Сообщить("=== Задачник v1 (версия схемы 1.0.0) ===");

Менеджер = Новый МенеджерСущностей(Тип("КоннекторJSON"), КаталогДанных);
Менеджер.ДобавитьКлассВМодель(Тип("Задача"));
Менеджер.УстановитьВерсиюСхемы("1.0.0");

Попытка
	Менеджер.Инициализировать();
Исключение
	Сообщить("ОШИБКА ИНИЦИАЛИЗАЦИИ: " + ОписаниеОшибки());
	ЗавершитьРаботу(1);
КонецПопытки;

Задача = Новый Задача;
Задача.Имя = "Задача из приложения v1";
Задача.Выполнена = Ложь;
Менеджер.Сохранить(Задача);

Сообщить("Версия схемы в БД: " + Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы());

Задачи = Менеджер.Получить(Тип("Задача"));
Сообщить(СтрШаблон("Задач в базе: %1", Задачи.Количество()));
Для Каждого ЭлементСписка Из Задачи Цикл
	Сообщить(СтрШаблон(
		"  #%1 | Имя: %2 | Выполнена: %3",
		ЭлементСписка.Идентификатор,
		ЭлементСписка.Имя,
		ЭлементСписка.Выполнена
	));
КонецЦикла;

Менеджер.Закрыть();
