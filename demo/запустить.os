// Запуск демо-приложения "Задачник" нужной версии.
//
// Использование:
//   oscript demo/запустить.os <v1|v2|v3> [чисто]
//
// Параметры:
//   v1|v2|v3 - версия приложения (каталог demo_vN);
//   чисто    - удалить каталог данных перед запуском (гринфилд-сценарий).
//
// Примеры сценариев:
//   oscript demo/запустить.os v1 чисто   # гринфилд на версии 1
//   oscript demo/запустить.os v2         # миграция 1.0.0 -> 2.0.0
//   oscript demo/запустить.os v3         # миграция 2.0.0 -> 3.0.0
//   oscript demo/запустить.os v3 чисто   # гринфилд сразу на версии 3
//   v1 чисто, затем v3                   # ОШИБКА: барьерная версия 2.0.0
//   v2 чисто, затем v1                   # ОШИБКА: понижение версии схемы

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	Сообщить("Использование: oscript запустить.os <v1|v2|v3> [чисто]");
	ЗавершитьРаботу(1);
КонецЕсли;

Версия = НРег(СокрЛП(АргументыКоманднойСтроки[0]));
Если СтрНачинаетсяС(Версия, "demo_") Тогда
	Версия = Сред(Версия, СтрДлина("demo_") + 1);
КонецЕсли;
Если НЕ СтрНачинаетсяС(Версия, "v") Тогда
	Версия = "v" + Версия;
КонецЕсли;

ФайлПриложения = ОбъединитьПути(ТекущийСценарий().Каталог, "demo_" + Версия, "приложение.os");
ОписаниеФайла = Новый Файл(ФайлПриложения);
Если НЕ ОписаниеФайла.Существует() Тогда
	Сообщить("Неизвестная версия демо-приложения: " + АргументыКоманднойСтроки[0]);
	ЗавершитьРаботу(1);
КонецЕсли;

ОчиститьДанные = Ложь;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	ВторойАргумент = НРег(СокрЛП(АргументыКоманднойСтроки[1]));
	ОчиститьДанные = ВторойАргумент = "чисто" ИЛИ ВторойАргумент = "--чисто" ИЛИ ВторойАргумент = "clean";
КонецЕсли;

КаталогДанных = ОбъединитьПути(ТекущийСценарий().Каталог, "данные");
ОписаниеКаталога = Новый Файл(КаталогДанных);
Если ОчиститьДанные И ОписаниеКаталога.Существует() Тогда
	УдалитьФайлы(КаталогДанных);
	Сообщить("Каталог данных очищен: " + КаталогДанных);
КонецЕсли;

КодВозврата = 0;
ЗапуститьПриложение("oscript """ + ФайлПриложения + """", , Истина, КодВозврата);
ЗавершитьРаботу(КодВозврата);
