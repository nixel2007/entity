#Использовать "../.."

// Слой данных задачника. Вся работа с БД сосредоточена здесь:
// бизнес-слой (приложение.os) использует только методы этого класса.

Перем Менеджер;

Процедура ПриСозданииОбъекта(Знач КаталогДанных)
	ОписаниеКаталога = Новый Файл(КаталогДанных);
	Если НЕ ОписаниеКаталога.Существует() Тогда
		СоздатьКаталог(КаталогДанных);
	КонецЕсли;

	Менеджер = Новый МенеджерСущностей(Тип("КоннекторJSON"), КаталогДанных);
	Менеджер.ДобавитьКлассВМодель(Тип("Задача"));

	// Миграция на версию 3:
	//   1. из класса Задача удалена колонка Имя, добавлена колонка Приоритет (Задача.os);
	//   2. написан обработчик заполнения приоритета (МиграцияНаВерсию3.os);
	//   3. поднята версия схемы, зарегистрирован обработчик и объявлен барьер:
	//      сквозное обновление с 1.x невозможно, потому что миграция Имя -> Описание
	//      версии 2.0.0 в этой версии приложения уже неисполнима.
	Мигратор = Менеджер.ПолучитьМиграторСхемы();
	Мигратор.УстановитьВерсиюСхемы("3.0.0");
	Мигратор.УстановитьМинимальнуюВерсиюОбновления("2.0.0");
	Мигратор.УстановитьУдалениеЛишнихКолонок(Истина); // колонка Имя удаляется из хранилища
	Менеджер.ДобавитьОбработчикМиграции(Новый МиграцияНаВерсию3);
	// Обработчики версий 1.x и 2.0 здесь уже НЕ регистрируются: барьер гарантирует,
	// что хранимая версия схемы не ниже 2.0.0, а значит они никогда не выполнятся.
	// Барьерная версия - точка, после которой старые миграции можно удалять из кода.

	// Анализ схемы БД, приведение ее к состоянию модели, вызов обработчиков миграции
	Менеджер.Инициализировать();
КонецПроцедуры

Функция ДобавитьЗадачу(Знач Описание, Знач Приоритет) Экспорт
	Задача = Новый Задача;
	Задача.Описание = Описание;
	Задача.Приоритет = Приоритет;
	Задача.Выполнена = Ложь;
	Менеджер.Сохранить(Задача);

	Возврат Задача;
КонецФункции

Функция ВсеЗадачи() Экспорт
	Возврат Менеджер.Получить(Тип("Задача"));
КонецФункции

Функция ВерсияСхемыВБазе() Экспорт
	Возврат Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы();
КонецФункции

Процедура Закрыть() Экспорт
	Менеджер.Закрыть();
КонецПроцедуры
