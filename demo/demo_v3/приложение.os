#Использовать "../.."

// Демо-приложение "Задачник", версия 3.
// Схема 3.0.0: колонка Имя удалена, добавлена колонка Приоритет.
// Обновление поддерживается только с версии схемы 2.0.0 (барьерная версия).

КаталогДанных = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "данные");
ФайлКаталога = Новый Файл(КаталогДанных);
Если НЕ ФайлКаталога.Существует() Тогда
	СоздатьКаталог(КаталогДанных);
КонецЕсли;

ПодключитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "Задача.os"), "Задача");
ПодключитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "МиграцияНаВерсию3.os"), "МиграцияНаВерсию3");

Сообщить("=== Задачник v3 (версия схемы 3.0.0) ===");

Менеджер = Новый МенеджерСущностей(Тип("КоннекторJSON"), КаталогДанных);
Менеджер.ДобавитьКлассВМодель(Тип("Задача"));

Мигратор = Менеджер.ПолучитьМиграторСхемы();
Мигратор.УстановитьВерсиюСхемы("3.0.0");
// Барьер приложения: сквозное обновление с 1.x запрещено (см. МиграцияНаВерсию3)
Мигратор.УстановитьМинимальнуюВерсиюОбновления("2.0.0");
// Колонка Имя больше не нужна - удаляем ее из хранилища при миграции
Мигратор.УстановитьУдалениеЛишнихКолонок(Истина);

Менеджер.ДобавитьОбработчикМиграции(Новый МиграцияНаВерсию3);

Попытка
	Менеджер.Инициализировать();
Исключение
	Сообщить("ОШИБКА ИНИЦИАЛИЗАЦИИ: " + ОписаниеОшибки());
	ЗавершитьРаботу(1);
КонецПопытки;

Задача = Новый Задача;
Задача.Описание = "Задача, созданная приложением версии 3";
Задача.Приоритет = 2;
Задача.Выполнена = Ложь;
Менеджер.Сохранить(Задача);

Сообщить("Версия схемы в БД: " + Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы());

Задачи = Менеджер.Получить(Тип("Задача"));
Сообщить(СтрШаблон("Задач в базе: %1", Задачи.Количество()));
Для Каждого ЭлементСписка Из Задачи Цикл
	Сообщить(СтрШаблон(
		"  #%1 | Описание: %2 | Приоритет: %3 | Выполнена: %4",
		ЭлементСписка.Идентификатор,
		ЭлементСписка.Описание,
		ЭлементСписка.Приоритет,
		ЭлементСписка.Выполнена
	));
КонецЦикла;

Менеджер.Закрыть();
