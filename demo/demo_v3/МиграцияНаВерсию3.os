// Миграция данных на версию схемы 3.0.0: заполняет новую колонку Приоритет.
//
// Барьерная версия 2.0.0: выполнение допустимо только с хранимой версии схемы 2.0.0 и выше.
// Сквозное обновление 1.x -> 3.0.0 невозможно: миграция версии 2.0.0 (Имя -> Описание)
// в этой версии приложения уже неисполнима - колонки Имя больше нет в модели данных.

Функция ВерсияСхемы() Экспорт
	Возврат "3.0.0";
КонецФункции

Функция МинимальнаяВерсияСхемы() Экспорт
	Возврат "2.0.0";
КонецФункции

Процедура ПослеМиграции(МенеджерСущностей, ПланМиграции) Экспорт
	Обновлено = 0;

	Задачи = МенеджерСущностей.Получить(Тип("Задача"));
	Для Каждого Задача Из Задачи Цикл
		Если ЗначениеЗаполнено(Задача.Приоритет) Тогда
			Продолжить;
		КонецЕсли;

		Задача.Приоритет = 1;
		МенеджерСущностей.Сохранить(Задача);
		Обновлено = Обновлено + 1;
	КонецЦикла;

	Сообщить(СтрШаблон("[миграция 3.0.0] Приоритет по умолчанию установлен (%1 шт.)", Обновлено));
КонецПроцедуры
