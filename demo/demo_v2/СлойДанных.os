#Использовать "../.."

// Слой данных задачника. Вся работа с БД сосредоточена здесь:
// бизнес-слой (приложение.os) использует только методы этого класса.

Перем Менеджер;

Процедура ПриСозданииОбъекта(Знач КаталогДанных)
	ОписаниеКаталога = Новый Файл(КаталогДанных);
	Если НЕ ОписаниеКаталога.Существует() Тогда
		СоздатьКаталог(КаталогДанных);
	КонецЕсли;

	Менеджер = Новый МенеджерСущностей(Тип("КоннекторJSON"), КаталогДанных);
	Менеджер.ДобавитьКлассВМодель(Тип("Задача"));

	// Миграция на версию 2:
	//   1. в класс Задача добавлена колонка Описание (Задача.os);
	//   2. написан обработчик переноса данных Имя -> Описание (МиграцияНаВерсию2.os);
	//   3. поднята версия схемы и зарегистрирован обработчик.
	Менеджер.УстановитьВерсиюСхемы("2.0.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый МиграцияНаВерсию2);

	// Обработчики прошлых версий НЕ удаляются, пока исполнимы против текущей модели:
	// при обновлении, например, с версии 1.0.0 мигратор выполнит 1.2.0, 1.3.0 и 2.0.0
	// по порядку, а при обновлении с 1.3.0 - только 2.0.0.
	Менеджер.ДобавитьОбработчикМиграции(Новый МиграцияНаВерсию1_2);
	Менеджер.ДобавитьОбработчикМиграции(Новый МиграцияНаВерсию1_3);

	// Анализ схемы БД, приведение ее к состоянию модели, вызов обработчиков миграции
	Менеджер.Инициализировать();
КонецПроцедуры

Функция ДобавитьЗадачу(Знач Имя, Знач Описание) Экспорт
	Задача = Новый Задача;
	Задача.Имя = Имя;
	Задача.Описание = Описание;
	Задача.Выполнена = Ложь;
	Менеджер.Сохранить(Задача);

	Возврат Задача;
КонецФункции

Функция ВсеЗадачи() Экспорт
	Возврат Менеджер.Получить(Тип("Задача"));
КонецФункции

Функция ВерсияСхемыВБазе() Экспорт
	Возврат Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы();
КонецФункции

Процедура Закрыть() Экспорт
	Менеджер.Закрыть();
КонецПроцедуры
