// Миграция данных на версию схемы 1.2.0: невыполненные задачи помечаются важными.

Функция ВерсияСхемы() Экспорт
	Возврат "1.2.0";
КонецФункции

Процедура ПослеМиграции(МенеджерСущностей, ПланМиграции) Экспорт
	Обновлено = 0;

	Задачи = МенеджерСущностей.Получить(Тип("Задача"));
	Для Каждого Задача Из Задачи Цикл
		Если Задача.Выполнена ИЛИ Задача.Важная Тогда
			Продолжить;
		КонецЕсли;

		Задача.Важная = Истина;
		МенеджерСущностей.Сохранить(Задача);
		Обновлено = Обновлено + 1;
	КонецЦикла;

	Сообщить(СтрШаблон("[миграция 1.2.0] Невыполненные задачи помечены важными (%1 шт.)", Обновлено));
КонецПроцедуры
