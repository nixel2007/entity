// Миграция данных на версию схемы 2.0.0:
// заполняет новую колонку Описание значениями из колонки Имя.

Функция ВерсияСхемы() Экспорт
	Возврат "2.0.0";
КонецФункции

Процедура ПослеМиграции(МенеджерСущностей, ПланМиграции) Экспорт
	Обновлено = 0;

	Задачи = МенеджерСущностей.Получить(Тип("Задача"));
	Для Каждого Задача Из Задачи Цикл
		Если ЗначениеЗаполнено(Задача.Описание) Тогда
			Продолжить;
		КонецЕсли;

		Задача.Описание = "Задача: " + Задача.Имя;
		МенеджерСущностей.Сохранить(Задача);
		Обновлено = Обновлено + 1;
	КонецЦикла;

	Сообщить(СтрШаблон("[миграция 2.0.0] Колонка Описание заполнена из колонки Имя (%1 шт.)", Обновлено));
КонецПроцедуры
