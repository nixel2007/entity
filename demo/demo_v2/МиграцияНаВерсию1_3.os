// Миграция данных на версию схемы 1.3.0: задачам без срока заполняется заметка.

Функция ВерсияСхемы() Экспорт
	Возврат "1.3.0";
КонецФункции

Процедура ПослеМиграции(МенеджерСущностей, ПланМиграции) Экспорт
	Обновлено = 0;

	Задачи = МенеджерСущностей.Получить(Тип("Задача"));
	Для Каждого Задача Из Задачи Цикл
		Если ЗначениеЗаполнено(Задача.Срок) ИЛИ ЗначениеЗаполнено(Задача.Заметка) Тогда
			Продолжить;
		КонецЕсли;

		Задача.Заметка = "Требуется назначить срок";
		МенеджерСущностей.Сохранить(Задача);
		Обновлено = Обновлено + 1;
	КонецЦикла;

	Сообщить(СтрШаблон("[миграция 1.3.0] Задачам без срока заполнена заметка (%1 шт.)", Обновлено));
КонецПроцедуры
