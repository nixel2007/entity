// Задачник v2 - бизнес-слой. Вся работа с БД - в классе СлойДанных.

КаталогСценария = ТекущийСценарий().Каталог;
ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "Задача.os"), "Задача");
ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "МиграцияНаВерсию1_2.os"), "МиграцияНаВерсию1_2");
ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "МиграцияНаВерсию1_3.os"), "МиграцияНаВерсию1_3");
ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "МиграцияНаВерсию2.os"), "МиграцияНаВерсию2");
ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "СлойДанных.os"), "СлойДанных");

Сообщить("=== Задачник v2 (версия схемы 2.0.0) ===");

Попытка
	СлойДанных = Новый СлойДанных(ОбъединитьПути(КаталогСценария, "..", "данные"));
Исключение
	Сообщить("ОШИБКА ИНИЦИАЛИЗАЦИИ: " + ОписаниеОшибки());
	ЗавершитьРаботу(1);
КонецПопытки;

СлойДанных.ДобавитьЗадачу("Задача из приложения v2", "Задача, созданная приложением версии 2");

Сообщить("Версия схемы в БД: " + СлойДанных.ВерсияСхемыВБазе());

Задачи = СлойДанных.ВсеЗадачи();
Сообщить(СтрШаблон("Задач в базе: %1", Задачи.Количество()));
Для Каждого Задача Из Задачи Цикл
	Сообщить(СтрШаблон(
		"  #%1 | Имя: %2 | Описание: %3 | Важная: %4 | Заметка: %5 | Выполнена: %6",
		Задача.Идентификатор,
		Задача.Имя,
		Задача.Описание,
		Задача.Важная,
		Задача.Заметка,
		Задача.Выполнена
	));
КонецЦикла;

СлойДанных.Закрыть();
