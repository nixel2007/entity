// Сигнал о том, что проверяемый код дошел до нужного места.
//
// Тестам, где два потока должны встретиться в определенной точке, недостаточно ждать публикации
// события: между ней и интересным местом проходит еще какой-то путь. Такой тест ждет отметку,
// которую ставит сам код в нужной точке.
//
// Экземпляр приходит в фикстуры параметрами и общий у них с тестом: отметку ставит один поток,
// читает другой, поэтому признак атомарный - читается и пишется под его блокировкой.
//

// АтомарноеБулево - Признак того, что отметка поставлена.
Перем Отмечен;

Процедура ПриСозданииОбъекта()
	Отмечен = Новый АтомарноеБулево(Ложь);
КонецПроцедуры

// Ставит отметку.
//
Процедура Отметить() Экспорт
	Отмечен.Установить(Истина);
КонецПроцедуры

// Определяет, поставлена ли отметка.
//
// Возвращаемое значение:
//   Булево - Истина, если код дошел до отмечаемого места.
//
Функция Отмечен() Экспорт
	Возврат Отмечен.Получить();
КонецФункции

// Ждет отметку не дольше заданного.
//
// Параметры:
//   Таймаут - Число - Предел ожидания в миллисекундах.
//
// Возвращаемое значение:
//   Булево - Истина, если отметка поставлена до истечения предела.
//
Функция Дождаться(Знач Таймаут = 30000) Экспорт

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Таймаут;

	Пока НЕ Отмечен.Получить() Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= КрайнийСрок Тогда
			Возврат Ложь;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Возврат Истина;

КонецФункции
