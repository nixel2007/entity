// Наблюдатель, который задерживается в ПослеСобытия события заданного вида.
//
// Нужен там, где проверяется, что чужой код не зовется из-под блокировки пула: пока такой
// наблюдатель спит, другой поток должен свободно работать с пулом.
//
// BSLLS:ExportVariables-off

// Массив из Структура - Записи о событиях: Фаза ("До" или "После") и само Событие.
Перем Записи Экспорт;
// Строка - Вид события, на завершении которого наблюдатель засыпает.
Перем ВидСобытия;
// Число - Пауза внутри ПослеСобытия в миллисекундах.
Перем Пауза;
// СигналСобытия - Сигнал, отмечаемый перед паузой: по нему тест узнает, что наблюдатель уснул.
Перем СигналПаузы;
// БлокировкаЧтенияЗаписи - События приходят из фоновых заданий, пока тест читает записи.
Перем Блокировка;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПВидСобытия, Знач ППауза, Знач ПСигналПаузы)
	Записи = Новый Массив;
	ВидСобытия = ПВидСобытия;
	Пауза = ППауза;
	СигналПаузы = ПСигналПаузы;
	Блокировка = Новый БлокировкаЧтенияЗаписи;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт
	Записать("До", Событие);
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт

	Записать("После", Событие);

	Если Событие.Вид() <> ВидСобытия Тогда
		Возврат;
	КонецЕсли;

	СигналПаузы.Отметить();
	Приостановить(Пауза);

КонецПроцедуры

Процедура Записать(Знач Фаза, Знач Событие)
	Блокировка.Запись().Заблокировать();
	Записи.Добавить(Новый Структура("Фаза, Событие", Фаза, Событие));
	Блокировка.Запись().Разблокировать();
КонецПроцедуры

// Возвращает завершенные события указанного вида.
//
// Параметры:
//   Вид - Строка - Вид события.
//
// Возвращаемое значение:
//   Массив из СобытиеИсточникаДанных - Завершенные события этого вида в порядке поступления.
//
Функция Завершенные(Знач Вид) Экспорт

	Найденные = Новый Массив;

	Блокировка.Чтение().Заблокировать();
	Для Каждого Запись Из Записи Цикл
		Если Запись.Фаза = "После" И Запись.Событие.Вид() = Вид Тогда
			Найденные.Добавить(Запись.Событие);
		КонецЕсли;
	КонецЦикла;
	Блокировка.Чтение().Разблокировать();

	Возврат Найденные;

КонецФункции
