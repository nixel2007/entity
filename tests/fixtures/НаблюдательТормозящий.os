// Наблюдатель, который задерживается в ПослеСобытия события заданного вида.
//
// Нужен там, где проверяется, что чужой код не зовется из-под блокировки пула: пока такой
// наблюдатель спит, другой поток должен свободно работать с пулом.
//
// События приходят из фоновых заданий, пока тест читает записи, поэтому записи закрыты и читаются
// и пишутся только под блокировкой наблюдателя; наружу отдаются копии. Спит наблюдатель вне своей
// блокировки.

// Массив из Структура - Записи о событиях: Фаза ("До" или "После") и само Событие.
Перем Записи;
// Строка - Вид события, на завершении которого наблюдатель засыпает.
Перем ВидСобытия;
// Число - Пауза внутри ПослеСобытия в миллисекундах.
Перем Пауза;
// СигналСобытия - Сигнал, отмечаемый перед паузой: по нему тест узнает, что наблюдатель уснул.
Перем СигналПаузы;
// БлокировкаРесурса - Защищает Записи.
Перем Блокировка;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПВидСобытия, Знач ППауза, Знач ПСигналПаузы)
	Записи = Новый Массив;
	ВидСобытия = ПВидСобытия;
	Пауза = ППауза;
	СигналПаузы = ПСигналПаузы;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт
	Записать("До", Событие);
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт

	Записать("После", Событие);

	Если Событие.Вид() <> ВидСобытия Тогда
		Возврат;
	КонецЕсли;

	СигналПаузы.Отметить();
	Приостановить(Пауза);

КонецПроцедуры

Процедура Записать(Знач Фаза, Знач Событие)

	Запись = Новый Структура("Фаза, Событие", Фаза, Событие);

	Блокировка.Заблокировать();

	Попытка
		Записи.Добавить(Запись);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Число записанных событий обеих фаз.
//
// Возвращаемое значение:
//   Число - Сколько записей о событиях сделано к этому моменту.
//
Функция Количество() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = Записи.Количество();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Все записи о событиях обеих фаз в порядке поступления.
//
// Возвращаемое значение:
//   Массив из Структура - Копия записей, снятая под блокировкой: Фаза ("До" или "После") и Событие.
//     Дальнейшие события в нее не попадают.
//
Функция ВсеЗаписи() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = Новый Массив;
		Для Каждого Запись Из Записи Цикл
			Результат.Добавить(Новый Структура("Фаза, Событие", Запись.Фаза, Запись.Событие));
		КонецЦикла;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает завершенные события указанного вида.
//
// Отбор идет по копии записей: методы событий зовутся уже вне блокировки наблюдателя.
//
// Параметры:
//   Вид - Строка - Вид события.
//
// Возвращаемое значение:
//   Массив из СобытиеИсточникаДанных - Завершенные события этого вида в порядке поступления.
//
Функция Завершенные(Знач Вид) Экспорт

	Найденные = Новый Массив;

	Для Каждого Запись Из ВсеЗаписи() Цикл
		Если Запись.Фаза = "После" И Запись.Событие.Вид() = Вид Тогда
			Найденные.Добавить(Запись.Событие);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции
