// Наблюдатель, который в начале захвата соединения задерживает помеченный поток до сигнала теста.
//
// Помечает поток сам тест (фоновое задание), кладя признак в данные своего потока исполнения
// под ключом КлючПометки. Остальные потоки наблюдатель пропускает сразу. Дойдя до задержки,
// наблюдатель отмечает СигналДошел, а продолжает, когда тест отметит СигналОтпустить.
//

// Строка - Ключ пометки задерживаемого потока.
Перем КлючПометки;
// СигналСобытия - Отмечается, когда помеченный поток дошел до задержки.
Перем СигналДошел;
// СигналСобытия - Отмечает тест, отпуская помеченный поток.
Перем СигналОтпустить;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПСигналДошел, Знач ПСигналОтпустить)
	КлючПометки = "entity.tests.delay." + Строка(Новый УникальныйИдентификатор);
	СигналДошел = ПСигналДошел;
	СигналОтпустить = ПСигналОтпустить;
КонецПроцедуры

// Ключ, под которым поток кладет в свои данные признак Истина, чтобы его задержали.
//
// Возвращаемое значение:
//   Строка - Ключ.
//
Функция КлючПометки() Экспорт
	Возврат КлючПометки;
КонецФункции

Процедура ПередСобытием(Событие) Экспорт

	Если Событие.Вид() <> "Соединение" ИЛИ Событие.Операция() <> "Занять" Тогда
		Возврат;
	КонецЕсли;
	Если ТекущийПоток().Данные.Получить(КлючПометки) <> Истина Тогда
		Возврат;
	КонецЕсли;

	СигналДошел.Отметить();
	СигналОтпустить.Дождаться(30000);

КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры
