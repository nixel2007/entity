// Обрыв соединений для КоннекторУправляемоеОткрытие: изображает соединения, закрытые сервером -
// перезапуск СУБД, разрыв сети, административное отключение.
//
// Один экземпляр разделяется всеми коннекторами пула: он приходит к ним параметрами коннектора,
// а параметры пул передает каждому создаваемому коннектору как есть.
//
// Обрыв считается волнами: коннектор запоминает волну, на которой открылся, и считает себя
// открытым, пока волна не сменилась. Так обрыв достается только уже открытым соединениям, а
// открытые после него живы - как и после настоящего перезапуска сервера.
//

// Число - Номер текущей волны. Соединения прошлых волн оборваны.
Перем НомерВолны;

Процедура ПриСозданииОбъекта()
	НомерВолны = 1;
КонецПроцедуры

// Возвращает волну, на которой открываются соединения прямо сейчас.
//
// Возвращаемое значение:
//   Число - Номер текущей волны.
//
Функция Волна() Экспорт
	Возврат НомерВолны;
КонецФункции

// Обрывает все соединения, открытые до этого вызова.
//
Процедура ОборватьОткрытые() Экспорт
	НомерВолны = НомерВолны + 1;
КонецПроцедуры
