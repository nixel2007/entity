// Наблюдатель, который после запроса заданной операции делает паузу.
//
// Расширяет окно между запросами одной операции библиотеки: так перемежение двух операций,
// которое без изоляции случается редко, проявляется надежно. Пауза идет в потоке, выполнившем
// запрос. Состояния, кроме неизменяемых настроек, у наблюдателя нет.

// Строка - Операция запроса, после которого делается пауза: DELETE, INSERT и т.п.
Перем ОперацияЗапроса;
// Число - Пауза в миллисекундах.
Перем Пауза;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПОперацияЗапроса, Знач ППауза)
	ОперацияЗапроса = ПОперацияЗапроса;
	Пауза = ППауза;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт

	Если Событие.Вид() <> "Запрос" ИЛИ Событие.Операция() <> ОперацияЗапроса Тогда
		Возврат;
	КонецЕсли;

	Приостановить(Пауза);

КонецПроцедуры
