// Отметки занятости соединений для нагрузочного теста пула: соединение, выданное потоку, должно
// быть только у него.
//
// Поток, получив соединение, отмечает его занятым, а перед освобождением снимает отметку. Отметка
// поверх чужой - нарушение: пул выдал одно соединение двум потокам. Отметки ставят и снимают все
// задания теста, поэтому состояние меняется только под блокировкой.
//

// Соответствие - Соединение и поток исполнения, который его отметил.
Перем Занятые;
// Число - Сколько раз соединение оказалось занятым другим потоком.
Перем Нарушений;
// БлокировкаРесурса - Защищает отметки и счетчик.
Перем Блокировка;

Процедура ПриСозданииОбъекта()
	Занятые = Новый Соответствие;
	Нарушений = 0;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

// Отмечает соединение занятым текущим потоком.
//
// Параметры:
//   Соединение - СоединениеСБД - Выданное соединение.
//
Процедура Отметить(Знач Соединение) Экспорт

	Поток = ТекущийПоток();

	Блокировка.Заблокировать();
	Попытка
		Владелец = Занятые.Получить(Соединение);
		Если Владелец <> Неопределено И Владелец <> Поток Тогда
			Нарушений = Нарушений + 1;
		КонецЕсли;
		Занятые.Вставить(Соединение, Поток);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Снимает отметку текущего потока с соединения.
//
// Параметры:
//   Соединение - СоединениеСБД - Соединение, которое поток сейчас освободит.
//
Процедура СнятьОтметку(Знач Соединение) Экспорт

	Поток = ТекущийПоток();

	Блокировка.Заблокировать();
	Попытка
		Владелец = Занятые.Получить(Соединение);
		Если Владелец = Поток Тогда
			Занятые.Удалить(Соединение);
		ИначеЕсли Владелец <> Неопределено Тогда
			Нарушений = Нарушений + 1;
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Число нарушений.
//
// Возвращаемое значение:
//   Число - Сколько раз соединение оказалось у двух потоков сразу.
//
Функция Нарушений() Экспорт

	Блокировка.Заблокировать();
	Результат = Нарушений;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции
