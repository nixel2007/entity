// Запоминает, считался ли источник закрытым в тот момент, когда закрывались его соединения.
//
// Источник закрывает пул, а пул - каждое свое соединение, поэтому коннектор и есть та точка,
// из которой видно середину закрытия. Наблюдателя коннектор получает параметрами коннектора,
// как и все остальные настройки КоннекторУправляемоеОткрытие.
//
// Коннектор может спросить наблюдателя из любого потока, поэтому поля читаются и пишутся только
// под блокировкой наблюдателя. Сам источник спрашивается вне ее: под ней чужой код не зовется.
//

// ИсточникДанных - Источник, за закрытием которого наблюдаем.
Перем Источник;
// Булево - Ответ источника на вопрос "закрыт?", заданный посреди закрытия.
Перем ИсточникСчиталсяЗакрытым;
// БлокировкаРесурса - Защищает Источник и ИсточникСчиталсяЗакрытым.
Перем Блокировка;

Процедура ПриСозданииОбъекта()
	Источник = Неопределено;
	ИсточникСчиталсяЗакрытым = Неопределено;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

// Задает источник, за которым наблюдаем. Вызывается после создания источника: раньше его нет,
// а параметры коннектора собираются до.
//
// Параметры:
//   ПИсточник - ИсточникДанных - Источник.
//
Процедура УстановитьИсточник(ПИсточник) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Источник = ПИсточник;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Спрашивает у источника, закрыт ли он. Вызывается коннектором из его Закрыть().
//
Процедура ЗаписатьСостояниеИсточника() Экспорт

	Блокировка.Заблокировать();

	Попытка
		НаблюдаемыйИсточник = Источник;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Если НаблюдаемыйИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Закрыт = НаблюдаемыйИсточник.Закрыт();

	Блокировка.Заблокировать();

	Попытка
		ИсточникСчиталсяЗакрытым = Закрыт;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Состояние источника, замеченное посреди закрытия.
//
// Возвращаемое значение:
//   Булево - Истина, если источник уже считал себя закрытым, когда его соединения еще закрывались.
//   Неопределено - Соединения не закрывались, спросить было некогда.
//
Функция ИсточникСчиталсяЗакрытым() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ИсточникСчиталсяЗакрытым;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции
