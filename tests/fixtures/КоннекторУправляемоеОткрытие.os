// Коннектор для тестов пула соединений: поведение задается параметрами коннектора.
//
// Пул конструирует коннекторы сам, поэтому настроить экземпляр снаружи нельзя - настройки
// приходят тем же путем, что и всегда, через параметры коннектора пула.
//
// Единственный параметр коннектора - НастройкиТестовогоКоннектора, см. описание того модуля.
//

// Булево - Состояние соединения.
Перем Открыт;
// НастройкиТестовогоКоннектора - Настройки, с которыми соединение открыто. Из них коннектор
// спрашивает только то, что потокобезопасно само: отмену падений закрытия.
Перем Настройки;
// Структура - Копия открытых полей настроек, снятая при открытии: поля настроек не меняются после
// создания пула, но и читать чужой объект на каждом вызове незачем.
Перем Копия;
// Число - Волна обрыва, на которой соединение было открыто. Задана только с настроенным обрывом.
Перем ВолнаОткрытия;

&Реализует("АбстрактныйКоннектор")
Процедура ПриСозданииОбъекта()
	Открыт = Ложь;
	Настройки = Неопределено;
	Копия = Неопределено;
	ВолнаОткрытия = 0;
КонецПроцедуры

// Открывает соединение так, как задано настройками.
//
// Параметры:
//   СтрокаСоединения - Строка - Не используется.
//   ПараметрыКоннектора - Массив - Единственным элементом идут НастройкиТестовогоКоннектора.
//
Процедура Открыть(СтрокаСоединения, ПараметрыКоннектора) Экспорт // BSLLS:UnusedParameters-off

	Настройки = ПараметрыКоннектора[0];
	Копия = Новый Структура(
		"ПаузаОткрытия, ПадатьПриОткрытии, ПадатьПриЗавершенииТранзакции, ПадатьПриЗакрытии,"
			+ " ПланЗакрытий, ПланПроверок, ПланОткрытий, НаблюдательЗакрытия, ОбрывСоединений",
		Настройки.ПаузаОткрытия,
		Настройки.ПадатьПриОткрытии,
		Настройки.ПадатьПриЗавершенииТранзакции,
		Настройки.ПадатьПриЗакрытии,
		Настройки.ПланЗакрытий,
		Настройки.ПланПроверок,
		Настройки.ПланОткрытий,
		Настройки.НаблюдательЗакрытия,
		Настройки.ОбрывСоединений
	);

	Если Копия.ПаузаОткрытия > 0 Тогда
		Приостановить(Копия.ПаузаОткрытия);
	КонецЕсли;

	Если Копия.ПадатьПриОткрытии Тогда
		ВызватьИсключение "Открытие соединения не удалось";
	КонецЕсли;

	Если Копия.ПланОткрытий <> Неопределено И Копия.ПланОткрытий.ВызовПадает() Тогда
		ВызватьИсключение "Открытие соединения не удалось";
	КонецЕсли;

	Если Копия.ОбрывСоединений <> Неопределено Тогда
		ВолнаОткрытия = Копия.ОбрывСоединений.Волна();
	КонецЕсли;

	Открыт = Истина;

КонецПроцедуры

// Начинает транзакцию.
//
Процедура НачатьТранзакцию() Экспорт
	// Изображать состояние транзакции незачем: проверяется поведение пула, а не коннектора.
КонецПроцедуры

// Фиксирует транзакцию, падая, если так задано параметрами.
//
Процедура ЗафиксироватьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

// Отменяет транзакцию, падая, если так задано параметрами.
//
Процедура ОтменитьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

// Общее поведение фиксации и отмены.
//
Процедура ЗавершитьТранзакцию()
	Если Копия.ПадатьПриЗавершенииТранзакции Тогда
		ВызватьИсключение "Завершение транзакции не удалось";
	КонецЕсли;
КонецПроцедуры

// Закрывает соединение, падая, если так задано параметрами.
//
Процедура Закрыть() Экспорт

	Если Копия.НаблюдательЗакрытия <> Неопределено Тогда
		Копия.НаблюдательЗакрытия.ЗаписатьСостояниеИсточника();
	КонецЕсли;

	Если Копия.ПланЗакрытий <> Неопределено Тогда
		ПадаемСейчас = Копия.ПланЗакрытий.ЗакрытиеПадает();
	Иначе
		ПадаемСейчас = Копия.ПадатьПриЗакрытии;
	КонецЕсли;

	Если ПадаемСейчас И НЕ Настройки.ПаденияЗакрытияОтменены() Тогда
		ВызватьИсключение "Закрытие соединения не удалось";
	КонецЕсли;

	Открыт = Ложь;

КонецПроцедуры

// Возвращает состояние соединения.
//
// Оборванное сервером соединение закрытым себя не помнит: закрытия оно не выполняло, а узнало
// о нем от общего на пул обрыва - так же, как настоящий коннектор узнает состояние у драйвера.
//
// План проверок изображает драйвер, который на вопросе о состоянии сам падает.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение открыто.
//
Функция Открыт() Экспорт

	Если Копия <> Неопределено И Копия.ПланПроверок <> Неопределено И Копия.ПланПроверок.ВызовПадает() Тогда
		ВызватьИсключение "Проверка соединения не удалась";
	КонецЕсли;

	Если НЕ Открыт Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Копия.ОбрывСоединений = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ВолнаОткрытия = Копия.ОбрывСоединений.Волна();

КонецФункции

// Операции над данными коннектор не поддерживает: он изображает только соединение. Методы
// объявлены, чтобы коннектор отвечал интерфейсу АбстрактныйКоннектор, который проверяет
// ИсточникДанных. Поиск отвечает пустым результатом: функции нужен возврат, а данных
// у коннектора нет.
//
// BSLLS:UnusedParameters-off

Процедура ИнициализироватьТаблицу(ОбъектМодели) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

Процедура Сохранить(ОбъектМодели, Сущность) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

Процедура Удалить(ОбъектМодели, Сущность) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

Функция НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	Возврат Новый Массив;
КонецФункции

Процедура УдалитьСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

// BSLLS:UnusedParameters-on
