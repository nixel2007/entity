// Коннектор для тестов пула соединений: поведение задается параметрами коннектора.
//
// Пул конструирует коннекторы сам, поэтому настроить экземпляр снаружи нельзя - настройки
// приходят тем же путем, что и всегда, через параметры коннектора пула.
//
// Единственный параметр коннектора - НастройкиТестовогоКоннектора, см. описание того модуля.
//

// Булево - Состояние соединения.
Перем Открыт;
// НастройкиТестовогоКоннектора - Настройки, с которыми соединение открыто.
Перем Настройки;

Процедура ПриСозданииОбъекта()
	Открыт = Ложь;
	Настройки = Неопределено;
КонецПроцедуры

// Открывает соединение так, как задано настройками.
//
// Параметры:
//   СтрокаСоединения - Строка - Не используется.
//   ПараметрыКоннектора - Массив - Единственным элементом идут НастройкиТестовогоКоннектора.
//
Процедура Открыть(СтрокаСоединения, ПараметрыКоннектора) Экспорт // BSLLS:UnusedParameters-off

	Настройки = ПараметрыКоннектора[0];

	Если Настройки.ПаузаОткрытия > 0 Тогда
		Приостановить(Настройки.ПаузаОткрытия);
	КонецЕсли;

	Если Настройки.ПадатьПриОткрытии Тогда
		ВызватьИсключение "Открытие соединения не удалось";
	КонецЕсли;

	Открыт = Истина;

КонецПроцедуры

// Начинает транзакцию.
//
Процедура НачатьТранзакцию() Экспорт
	// Изображать состояние транзакции незачем: проверяется поведение пула, а не коннектора.
КонецПроцедуры

// Фиксирует транзакцию, падая, если так задано параметрами.
//
Процедура ЗафиксироватьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

// Отменяет транзакцию, падая, если так задано параметрами.
//
Процедура ОтменитьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

// Общее поведение фиксации и отмены.
//
Процедура ЗавершитьТранзакцию()
	Если Настройки.ПадатьПриЗавершенииТранзакции Тогда
		ВызватьИсключение "Завершение транзакции не удалось";
	КонецЕсли;
КонецПроцедуры

// Закрывает соединение, падая, если так задано параметрами.
//
Процедура Закрыть() Экспорт

	Если Настройки.НаблюдательЗакрытия <> Неопределено Тогда
		Настройки.НаблюдательЗакрытия.ЗаписатьСостояниеИсточника();
	КонецЕсли;

	Если Настройки.ПланЗакрытий <> Неопределено Тогда
		ПадаемСейчас = Настройки.ПланЗакрытий.ЗакрытиеПадает();
	Иначе
		ПадаемСейчас = Настройки.ПадатьПриЗакрытии;
	КонецЕсли;

	Если ПадаемСейчас Тогда
		ВызватьИсключение "Закрытие соединения не удалось";
	КонецЕсли;

	Открыт = Ложь;

КонецПроцедуры

// Возвращает состояние соединения.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение открыто.
//
Функция Открыт() Экспорт
	Возврат Открыт;
КонецФункции

// Операции над данными коннектор не поддерживает: он изображает только соединение. Методы
// объявлены, чтобы коннектор отвечал интерфейсу АбстрактныйКоннектор, который проверяет
// ИсточникДанных. Поиск отвечает пустым результатом: функции нужен возврат, а данных
// у коннектора нет.
//
// BSLLS:UnusedParameters-off

Процедура ИнициализироватьТаблицу(ОбъектМодели) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

Процедура Сохранить(ОбъектМодели, Сущность) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

Процедура Удалить(ОбъектМодели, Сущность) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

Функция НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	Возврат Новый Массив;
КонецФункции

Процедура УдалитьСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

// BSLLS:UnusedParameters-on
