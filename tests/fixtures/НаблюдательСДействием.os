// Наблюдатель, который на заданном событии выполняет действие теста - обычно работу с БД через
// менеджер, как это делает настоящий наблюдатель, пишущий аудит в ту же базу.
//
// Действие получает защиту от рекурсии, которую документация требует от такого наблюдателя:
// работа с БД в обработчике сама порождает события, и обработчик вызывается для них снова. Признак
// "действие уже идет" лежит в данных текущего потока исполнения.
//
// Ошибки действия наблюдатель не выпускает - реестр все равно проглотил бы их, - а запоминает:
// тест проверяет, что вложенная работа прошла. Запоминают их разные потоки, поэтому под блокировкой.
//

// Строка - Вид события, на котором выполняется действие.
Перем Вид;
// Строка - Операция события; пустая строка - любая.
Перем Операция;
// Строка - Фаза: "До" (ПередСобытием) или "После" (ПослеСобытия).
Перем Фаза;
// Действие - Действие теста без параметров.
Перем ДействиеТеста;
// Строка - Ключ признака "действие идет" в данных потока исполнения.
Перем КлючРекурсии;
// Булево - Выполнить действие один раз за жизнь наблюдателя, на первом подходящем событии.
Перем Однократно;
// Булево - Действие уже запускалось.
Перем Запущено;
// Число - Сколько раз действие выполнено.
Перем Выполнено;
// Массив из ИнформацияОбОшибке - Ошибки действия.
Перем Ошибки;
// БлокировкаРесурса - Защищает признак запуска, счетчик и ошибки.
Перем Блокировка;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПВид, Знач ПОперация, Знач ПФаза, Знач ПДействие, Знач ПОднократно = Ложь)

	Вид = ПВид;
	Операция = ПОперация;
	Фаза = ПФаза;
	ДействиеТеста = ПДействие;
	Однократно = ПОднократно;
	Запущено = Ложь;
	КлючРекурсии = "entity.tests.action." + Строка(Новый УникальныйИдентификатор);
	Выполнено = 0;
	Ошибки = Новый Массив;
	Блокировка = Новый БлокировкаРесурса;

КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт
	Если Фаза = "До" Тогда
		Обработать(Событие);
	КонецЕсли;
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт
	Если Фаза = "После" Тогда
		Обработать(Событие);
	КонецЕсли;
КонецПроцедуры

// Сколько раз действие выполнено.
//
// Возвращаемое значение:
//   Число - Количество выполнений.
//
Функция Выполнено() Экспорт

	Блокировка.Заблокировать();
	Результат = Выполнено;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Ошибки действия, копией.
//
// Возвращаемое значение:
//   Массив из ИнформацияОбОшибке - Ошибки в порядке возникновения.
//
Функция Ошибки() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Массив(Новый ФиксированныйМассив(Ошибки));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Отмечает запуск действия и отвечает, запускать ли его: однократное запускается только первым.
//
// Возвращаемое значение:
//   Булево - Истина, если действие нужно выполнить сейчас.
//
Функция ЗапуститьСейчас()

	Блокировка.Заблокировать();
	Попытка
		Запускать = НЕ (Однократно И Запущено);
		Запущено = Истина;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Запускать;

КонецФункции

Процедура Обработать(Событие)

	Если Событие.Вид() <> Вид Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Операция) И Событие.Операция() <> Операция Тогда
		Возврат;
	КонецЕсли;
	Если ТекущийПоток().Данные.Получить(КлючРекурсии) = Истина Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗапуститьСейчас() Тогда
		Возврат;
	КонецЕсли;

	ТекущийПоток().Данные.Вставить(КлючРекурсии, Истина);

	Попытка
		ДействиеТеста.Выполнить();
		ОшибкаДействия = Неопределено;
	Исключение
		ОшибкаДействия = ИнформацияОбОшибке();
	КонецПопытки;

	ТекущийПоток().Данные.Удалить(КлючРекурсии);

	Блокировка.Заблокировать();
	Попытка
		Выполнено = Выполнено + 1;
		Если ОшибкаДействия <> Неопределено Тогда
			Ошибки.Добавить(ОшибкаДействия);
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры
