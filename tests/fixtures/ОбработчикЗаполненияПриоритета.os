// Обработчик миграции для тестов: при переходе на версию схемы 0.2.0
// заполняет колонку Приоритет мигрируемых сущностей значением по умолчанию.

Функция ВерсияСхемы() Экспорт
	Возврат "0.2.0";
КонецФункции

Процедура ПослеМиграции(МенеджерСущностей, ПланМиграции) Экспорт
	Сущности = МенеджерСущностей.Получить(Тип("МигрируемаяСущностьВерсия2"));
	Для Каждого Сущность Из Сущности Цикл
		Если НЕ ЗначениеЗаполнено(Сущность.Приоритет) Тогда
			Сущность.Приоритет = 1;
			МенеджерСущностей.Сохранить(Сущность);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
