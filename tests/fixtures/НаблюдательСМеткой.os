// Наблюдатель для тестов состояния события: в ПередСобытием кладет в событие свою метку,
// в ПослеСобытия запоминает, что из события прочитал. Два таких наблюдателя на одном менеджере
// проверяют, что состояние у каждого свое.
//
// События могут прийти из любого потока, поэтому увиденное закрыто и читается и пишется только
// под блокировкой наблюдателя; наружу отдается копия.
//
// Параметры конструктора:
//   Метка - Строка - Что наблюдатель кладет в состояние события.

// Массив из Произвольный - Состояния, прочитанные в ПослеСобытия, в порядке событий.
Перем ПрочитанныеСостояния;
// Строка - Метка наблюдателя.
Перем Метка;
// БлокировкаРесурса - Защищает ПрочитанныеСостояния.
Перем Блокировка;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПМетка)
	ПрочитанныеСостояния = Новый Массив;
	Метка = ПМетка;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт
	Событие.УстановитьСостояние(Метка);
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт

	// Состояние читается у события до захвата: под блокировкой наблюдателя чужой код не зовется.
	Состояние = Событие.Состояние();

	Блокировка.Заблокировать();

	Попытка
		ПрочитанныеСостояния.Добавить(Состояние);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Состояния, прочитанные в ПослеСобытия.
//
// Возвращаемое значение:
//   Массив из Произвольный - Копия увиденного, снятая под блокировкой, в порядке событий.
//
Функция Увиденные() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = Новый Массив;
		Для Каждого Состояние Из ПрочитанныеСостояния Цикл
			Результат.Добавить(Состояние);
		КонецЦикла;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции
