// План сбоев для КоннекторУправляемоеОткрытие: какой по счету вызов, считая от взвода, должен
// упасть. Одним классом задаются и план проверок открытости (вызовы Открыт()), и план открытий
// (вызовы Открыть()): коннектор спрашивает свой план перед каждым таким вызовом.
//
// Один экземпляр разделяется всеми коннекторами пула, а зовут их разные потоки, поэтому состояние
// плана меняется только под его блокировкой.
//

// Булево - План взведен: вызовы считаются и падают по номеру.
Перем Взведен;
// Число - Номер вызова после взвода, с которого вызовы падают.
Перем НомерСбоя;
// Число - Сколько вызовов подряд падает, начиная с номера сбоя.
Перем КоличествоСбоев;
// Число - Сколько вызовов прошло после взвода.
Перем Вызовов;
// Число - Сколько вызовов упало по плану.
Перем Сбоев;
// БлокировкаРесурса - Защищает поля плана.
Перем Блокировка;

Процедура ПриСозданииОбъекта()

	Взведен = Ложь;
	НомерСбоя = 0;
	КоличествоСбоев = 0;
	Вызовов = 0;
	Сбоев = 0;
	Блокировка = Новый БлокировкаРесурса;

КонецПроцедуры

// Взводит план: следующие вызовы считаются с единицы.
//
// Параметры:
//   ПНомерСбоя - Число - Номер вызова после взвода, который падает первым.
//   ПКоличествоСбоев - Число - Сколько вызовов подряд падает.
//
Процедура Взвести(Знач ПНомерСбоя, Знач ПКоличествоСбоев = 1) Экспорт

	Блокировка.Заблокировать();
	Взведен = Истина;
	НомерСбоя = ПНомерСбоя;
	КоличествоСбоев = ПКоличествоСбоев;
	Вызовов = 0;
	Блокировка.Разблокировать();

КонецПроцедуры

// Регистрирует очередной вызов и отвечает, должен ли он упасть.
//
// Возвращаемое значение:
//   Булево - Истина, если этот вызов должен упасть.
//
Функция ВызовПадает() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Падает = Ложь;
		Если Взведен Тогда
			Вызовов = Вызовов + 1;
			Падает = Вызовов >= НомерСбоя И Вызовов < НомерСбоя + КоличествоСбоев;
			Если Падает Тогда
				Сбоев = Сбоев + 1;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Падает;

КонецФункции

// Сколько вызовов упало по плану.
//
// Возвращаемое значение:
//   Число - Количество сбоев.
//
Функция Сбоев() Экспорт

	Блокировка.Заблокировать();
	Результат = Сбоев;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции
