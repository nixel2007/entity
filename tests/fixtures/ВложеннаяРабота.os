// Работа с БД, которую наблюдатель выполняет изнутри обработчика события: операция через менеджер
// сущностей или захват соединения пула напрямую.
//
// Действие наблюдателю нужно без параметров, поэтому цель работы хранится здесь.
//

// МенеджерСущностей, ПулСоединенийСБД - Через что работать с БД.
Перем Цель;

Процедура ПриСозданииОбъекта(Знач ПЦель)
	Цель = ПЦель;
КонецПроцедуры

// Выполняет работу: у менеджера - операцию с коннектором, у пула - захват и освобождение.
//
Процедура Сделать() Экспорт

	Если ТипЗнч(Цель) = Тип("МенеджерСущностей") Тогда
		Цель.ВыполнитьСКоннектором("Коннектор -> Коннектор.Открыт()");
		Возврат;
	КонецЕсли;

	Цель.Занять();
	Цель.Освободить();

КонецПроцедуры
