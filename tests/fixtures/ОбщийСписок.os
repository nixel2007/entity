// Список, в который пишут несколько потоков: порядок получения соединений, итоги заданий.
//
// Добавляют в него фоновые задания, читает тест, поэтому массив меняется и читается только под
// блокировкой списка, а наружу отдается копией.
//

// Массив - Элементы в порядке добавления.
Перем Элементы;
// БлокировкаРесурса - Защищает элементы.
Перем Блокировка;

Процедура ПриСозданииОбъекта()
	Элементы = Новый Массив;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

// Добавляет элемент в конец.
//
// Параметры:
//   Элемент - Произвольный - Добавляемое значение.
//
Процедура Добавить(Знач Элемент) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Элементы.Добавить(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Копия элементов в порядке добавления.
//
// Возвращаемое значение:
//   Массив - Копия.
//
Функция Копия() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Массив(Новый ФиксированныйМассив(Элементы));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Число элементов.
//
// Возвращаемое значение:
//   Число - Количество.
//
Функция Количество() Экспорт

	Блокировка.Заблокировать();
	Результат = Элементы.Количество();
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции
