// Поставщик текущего потока исполнения для тестов пула: потоку, который попросил подмену, пул
// видит подставной поток, остальным - настоящий.
//
// Нужен тестам, где поддельные потоки держат соединения, а настоящие фоновые задания в это время
// работают с тем же пулом. Мок moskito здесь не годится: пул спрашивает поставщика из всех потоков,
// а мок записывает каждый вызов в общий массив без блокировки.
//
// Подмена хранится в данных самого попросившего потока: пишет и читает ее только он, поэтому
// общего изменяемого состояния у поставщика нет. Каждый метод теста oneunit выполняет в своем
// фоновом задании, так что подменять нужно в самом тесте, а не в ПередКаждым.
//

// Строка - Ключ подмены в данных потока исполнения; свой у каждого поставщика.
Перем КлючПодмены;

Процедура ПриСозданииОбъекта()
	КлючПодмены = "entity.tests.substitute." + Строка(Новый УникальныйИдентификатор);
КонецПроцедуры

// Текущий поток исполнения с учетом подмены.
//
// Возвращаемое значение:
//   ПотокИсполнения - Подставной поток, если текущий поток попросил подмену, иначе текущий.
//
Функция Текущий() Экспорт

	Подмена = ТекущийПоток().Данные.Получить(КлючПодмены);
	Если Подмена <> Неопределено Тогда
		Возврат Подмена;
	КонецЕсли;

	Возврат ТекущийПоток();

КонецФункции

// Подставляет поток: пока подмена не снята, пул видит текущий поток как подставной.
//
// Параметры:
//   Поток - Произвольный - Подставной поток: объект с событием ПриЗавершении.
//
Процедура Подменить(Знач Поток) Экспорт
	ТекущийПоток().Данные.Вставить(КлючПодмены, Поток);
КонецПроцедуры

// Снимает подмену текущего потока.
//
Процедура СнятьПодмену() Экспорт
	ТекущийПоток().Данные.Удалить(КлючПодмены);
КонецПроцедуры
