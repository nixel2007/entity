// Сигнал о том, что коннектор вошел в закрытие соединения.
//
// Закрытие пул делает под своей блокировкой записи, поэтому отметка в начале КоннекторТранзакций-
// ДляТестов.Закрыть означает для теста ровно одно: блокировка уже занята другим потоком. Тест,
// которому нужно упереться в эту блокировку, ждет отметки и только после нее идет за соединением.
//
// Экземпляр приходит к коннекторам параметрами коннектора и общий у пула и у теста, поэтому
// отметку, сделанную фоновым потоком, видит основной.
//

// Булево - Признак того, что закрытие началось.
Перем Начато;

Процедура ПриСозданииОбъекта()
	Начато = Ложь;
КонецПроцедуры

// Отмечает начало закрытия.
//
Процедура ОтметитьНачало() Экспорт
	Начато = Истина;
КонецПроцедуры

// Определяет, началось ли закрытие.
//
// Возвращаемое значение:
//   Булево - Истина, если коннектор уже вошел в закрытие.
//
Функция Начато() Экспорт
	Возврат Начато;
КонецФункции
