// Наблюдатель для тестов состава получателей: в первом же ПередСобытием меняет реестр
// источника данных - снимает себя или добавляет другого наблюдателя - и записывает события обеих фаз.
//
// События могут прийти из любого потока, поэтому записанные события и признак изменения реестра
// закрыты и читаются и пишутся только под блокировкой наблюдателя; наружу отдаются копии. Реестр
// источника меняется уже вне этой блокировки: под ней чужой код не зовется.
//
// Параметры конструктора:
//   ПИсточник - ИсточникДанных - Источник, реестр наблюдателей которого меняется.
//   ПДругой - Произвольный, Неопределено - Наблюдатель, которого добавить; Неопределено - снять себя.

// Массив из СобытиеИсточникаДанных - События фазы "До" в порядке поступления.
Перем НачатыеСобытия;
// Массив из СобытиеИсточникаДанных - События фазы "После" в порядке поступления.
Перем ЗавершенныеСобытия;
// ИсточникДанных - Источник, реестр которого меняется.
Перем Источник;
// Произвольный, Неопределено - Кого добавить; Неопределено - снять себя.
Перем Другой;
// Булево - Реестр уже изменен: меняется он один раз, в первом событии.
Перем РеестрИзменен;
// БлокировкаРесурса - Защищает НачатыеСобытия, ЗавершенныеСобытия и РеестрИзменен.
Перем Блокировка;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПИсточник, Знач ПДругой = Неопределено)
	НачатыеСобытия = Новый Массив;
	ЗавершенныеСобытия = Новый Массив;
	Источник = ПИсточник;
	Другой = ПДругой;
	РеестрИзменен = Ложь;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт

	// Запись события и проверка с установкой признака - одним участком под блокировкой: реестр
	// меняет ровно один поток, первым записавший событие.
	Блокировка.Заблокировать();

	Попытка
		НачатыеСобытия.Добавить(Событие);
		МенятьРеестр = НЕ РеестрИзменен;
		РеестрИзменен = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Если НЕ МенятьРеестр Тогда
		Возврат;
	КонецЕсли;

	Если Другой = Неопределено Тогда
		Источник.УдалитьНаблюдателя(ЭтотОбъект);
	Иначе
		Источник.ДобавитьНаблюдателя(Другой);
	КонецЕсли;

КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт

	Блокировка.Заблокировать();

	Попытка
		ЗавершенныеСобытия.Добавить(Событие);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// События фазы "До".
//
// Возвращаемое значение:
//   Массив из СобытиеИсточникаДанных - Копия, снятая под блокировкой, в порядке поступления.
//
Функция Начатые() Экспорт
	Возврат КопияПодБлокировкой(НачатыеСобытия);
КонецФункции

// События фазы "После".
//
// Возвращаемое значение:
//   Массив из СобытиеИсточникаДанных - Копия, снятая под блокировкой, в порядке поступления.
//
Функция Завершенные() Экспорт
	Возврат КопияПодБлокировкой(ЗавершенныеСобытия);
КонецФункции

Функция КопияПодБлокировкой(События)

	Блокировка.Заблокировать();

	Попытка
		Результат = Новый Массив;
		Для Каждого Событие Из События Цикл
			Результат.Добавить(Событие);
		КонецЦикла;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции
