// Коннектор для тестов событий транзакций: данные держит в КоннекторInMemory, а транзакции
// изображает сам, потому что InMemory их не поддерживает.
//
// Единственный параметр коннектора - НастройкиКоннектораТранзакций, см. описание того модуля.
// Без параметров коннектор ведет себя как безотказная база, терпящая и вложенное начало.

// КоннекторInMemory - Коннектор, которому делегируются операции с данными.
Перем Внутренний;
// Булево - Признак того, что начало транзакции должно падать.
Перем ПадатьПриНачалеТранзакции;
// Булево - Признак того, что завершение транзакции должно падать.
Перем ПадатьПриЗавершенииТранзакции;
// Булево - Признак того, что начало транзакции поверх начатой должно отвергаться.
Перем ОтвергатьВложеннуюТранзакцию;
// Число - Пауза внутри закрытия соединения в миллисекундах.
Перем ПаузаЗакрытия;
// СигналСобытия - Сигнал, отмечаемый в начале закрытия; Неопределено - сигналить некому.
Перем СигналЗакрытия;
// ПланЗакрытийКоннектора - План падений закрытия; Неопределено - закрытие не падает.
Перем ПланЗакрытий;
// Булево - Признак начатой транзакции. Нужен только для отказа во вложенной.
Перем ВТранзакции;

&Реализует("АбстрактныйКоннектор")
Процедура ПриСозданииОбъекта()
	Внутренний = Новый КоннекторInMemory;
	ПадатьПриНачалеТранзакции = Ложь;
	ПадатьПриЗавершенииТранзакции = Ложь;
	ОтвергатьВложеннуюТранзакцию = Ложь;
	ПаузаЗакрытия = 0;
	СигналЗакрытия = Неопределено;
	ПланЗакрытий = Неопределено;
	ВТранзакции = Ложь;
КонецПроцедуры

Процедура Открыть(СтрокаСоединения, ПараметрыКоннектора) Экспорт

	Если ПараметрыКоннектора.Количество() > 0 Тогда
		Настройки = ПараметрыКоннектора[0];
		ПадатьПриНачалеТранзакции = Настройки.ПадатьПриНачалеТранзакции;
		ПадатьПриЗавершенииТранзакции = Настройки.ПадатьПриЗавершенииТранзакции;
		ОтвергатьВложеннуюТранзакцию = Настройки.ОтвергатьВложеннуюТранзакцию;
		ПаузаЗакрытия = Настройки.ПаузаЗакрытия;
		СигналЗакрытия = Настройки.СигналЗакрытия;
		ПланЗакрытий = Настройки.ПланЗакрытий;
	КонецЕсли;

	Внутренний.Открыть(СтрокаСоединения, ПараметрыКоннектора);

КонецПроцедуры

Процедура Закрыть() Экспорт

	// Отметка до паузы: пул закрывает соединение под своей блокировкой записи, и тесту важен
	// именно момент, когда блокировка уже занята.
	Если СигналЗакрытия <> Неопределено Тогда
		СигналЗакрытия.Отметить();
	КонецЕсли;

	Если ПаузаЗакрытия > 0 Тогда
		Приостановить(ПаузаЗакрытия);
	КонецЕсли;

	Если ПланЗакрытий <> Неопределено И ПланЗакрытий.ЗакрытиеПадает() Тогда
		ВызватьИсключение "Закрытие соединения не удалось";
	КонецЕсли;

	Внутренний.Закрыть();

КонецПроцедуры

Функция Открыт() Экспорт
	Возврат Внутренний.Открыт();
КонецФункции

Процедура НачатьТранзакцию() Экспорт

	Если ПадатьПриНачалеТранзакции Тогда
		ВызватьИсключение "Начало транзакции не удалось";
	КонецЕсли;

	Если ВТранзакции И ОтвергатьВложеннуюТранзакцию Тогда
		ВызватьИсключение "Вложенная транзакция не поддерживается";
	КонецЕсли;

	ВТранзакции = Истина;

КонецПроцедуры

Процедура ЗафиксироватьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

Процедура ОтменитьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

Процедура ЗавершитьТранзакцию()

	Если ПадатьПриЗавершенииТранзакции Тогда
		ВызватьИсключение "Завершение транзакции не удалось";
	КонецЕсли;

	ВТранзакции = Ложь;

КонецПроцедуры

Процедура ИнициализироватьТаблицу(ОбъектМодели) Экспорт
	Внутренний.ИнициализироватьТаблицу(ОбъектМодели);
КонецПроцедуры

Процедура Сохранить(ОбъектМодели, Сущность) Экспорт
	Внутренний.Сохранить(ОбъектМодели, Сущность);
КонецПроцедуры

Процедура Удалить(ОбъектМодели, Сущность) Экспорт
	Внутренний.Удалить(ОбъектМодели, Сущность);
КонецПроцедуры

Функция НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	Возврат Внутренний.НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска);
КонецФункции

Процедура УдалитьСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	Внутренний.УдалитьСтрокиВТаблице(ОбъектМодели, ОпцииПоиска);
КонецПроцедуры
