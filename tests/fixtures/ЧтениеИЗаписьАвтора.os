// Действие для монопольного выполнения коннектором: прочитать авторов, дождаться, пока прочитает
// другой поток, и записать автора. Ждет другой поток не дольше секунды: поток, ждущий начала своей
// транзакции, до чтения не дойдет.

// АбстрактныйКоннекторSQL - Коннектор, которым выполняются запросы.
Перем Коннектор;
// Строка - Имя записываемого автора.
Перем Имя;
// СигналСобытия - Отмечается после чтения.
Перем СвойСигнал;
// СигналСобытия - Чтение другого потока.
Перем ЧужойСигнал;

Процедура ПриСозданииОбъекта(ПКоннектор, Знач ПИмя, ПСвойСигнал, ПЧужойСигнал)
	Коннектор = ПКоннектор;
	Имя = ПИмя;
	СвойСигнал = ПСвойСигнал;
	ЧужойСигнал = ПЧужойСигнал;
КонецПроцедуры

// Читает, ждет чтения другого потока и пишет.
//
Процедура Записать() Экспорт

	Коннектор.ВыполнитьЗапрос("SELECT * FROM Авторы");
	СвойСигнал.Отметить();
	ЧужойСигнал.Дождаться(1000);

	Коннектор.ВыполнитьЗапрос(СтрШаблон("INSERT INTO Авторы (Имя, Фамилия) VALUES ('%1', 'Иванов')", Имя));

КонецПроцедуры
