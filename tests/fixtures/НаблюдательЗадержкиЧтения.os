// Наблюдатель, который задерживает помеченный поток перед чтением сущности заданного типа.
//
// Нужен тестам, где поток должен остановиться посреди сборки сущности: на вложенном чтении
// ссылки, когда часть полей уже заполнена, а часть еще нет. Помечает поток сам тест (фоновое
// задание), кладя признак в данные своего потока исполнения под ключом КлючПометки. Остальные
// потоки наблюдатель пропускает сразу. Дойдя до задержки, наблюдатель отмечает СигналДошел, а
// продолжает, когда тест отметит СигналОтпустить.
//

// Тип - Тип сущности, перед чтением которой поток задерживается.
Перем ТипСущности;
// Строка - Ключ пометки задерживаемого потока.
Перем КлючПометки;
// СигналСобытия - Отмечается, когда помеченный поток дошел до задержки.
Перем СигналДошел;
// СигналСобытия - Отмечает тест, отпуская помеченный поток.
Перем СигналОтпустить;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПТипСущности, Знач ПСигналДошел, Знач ПСигналОтпустить)
	ТипСущности = ПТипСущности;
	КлючПометки = "entity.tests.read-delay." + Строка(Новый УникальныйИдентификатор);
	СигналДошел = ПСигналДошел;
	СигналОтпустить = ПСигналОтпустить;
КонецПроцедуры

// Ключ, под которым поток кладет в свои данные признак Истина, чтобы его задержали.
//
// Возвращаемое значение:
//   Строка - Ключ.
//
Функция КлючПометки() Экспорт
	Возврат КлючПометки;
КонецФункции

Процедура ПередСобытием(Событие) Экспорт

	Если Событие.Вид() <> ВидыСобытийИсточникаДанных.Операция()
		ИЛИ Событие.Операция() <> "ПолучитьОдно"
		ИЛИ Событие.ТипСущности() <> ТипСущности Тогда
		Возврат;
	КонецЕсли;
	Если ТекущийПоток().Данные.Получить(КлючПометки) <> Истина Тогда
		Возврат;
	КонецЕсли;

	СигналДошел.Отметить();
	СигналОтпустить.Дождаться(30000);

КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры
