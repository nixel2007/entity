// BSLLS:ExportVariables-off
// Наблюдатель для тестов: запоминает события обеих фаз в порядке поступления.
//
// Параметры конструктора:
//   ПадатьВПередСобытием - Булево - Истина, если ПередСобытием должен завершаться ошибкой.
//     Проверяет, что ошибка наблюдателя не ломает операцию.

// Массив из Структура - Записи о событиях: Фаза ("До" или "После") и само Событие.
Перем Записи Экспорт;
// Булево - Признак того, что ПередСобытием должен падать.
Перем ПадатьВПередСобытием;

&Реализует("НаблюдательСущностей")
Процедура ПриСозданииОбъекта(Знач ППадатьВПередСобытием = Ложь)
	Записи = Новый Массив;
	ПадатьВПередСобытием = ППадатьВПередСобытием;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт
	Если ПадатьВПередСобытием Тогда
		ВызватьИсключение "Наблюдатель сломан";
	КонецЕсли;
	Записи.Добавить(Новый Структура("Фаза, Событие", "До", Событие));
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт
	Записи.Добавить(Новый Структура("Фаза, Событие", "После", Событие));
КонецПроцедуры

// Возвращает завершенные события указанного вида.
//
// Параметры:
//   Вид - Строка - Вид события, значение ВидыСобытийСущностей.
//   Операция - Строка - Операция события; пустая строка - любая.
//
// Возвращаемое значение:
//   Массив из СобытиеСущностей - События фазы "После" в порядке завершения.
//
Функция Завершенные(Знач Вид, Знач Операция = "") Экспорт
	Возврат Отобрать("После", Вид, Операция);
КонецФункции

// Возвращает начатые события указанного вида.
//
// Параметры:
//   Вид - Строка - Вид события, значение ВидыСобытийСущностей.
//   Операция - Строка - Операция события; пустая строка - любая.
//
// Возвращаемое значение:
//   Массив из СобытиеСущностей - События фазы "До" в порядке начала.
//
Функция Начатые(Знач Вид, Знач Операция = "") Экспорт
	Возврат Отобрать("До", Вид, Операция);
КонецФункции

Функция Отобрать(Знач Фаза, Знач Вид, Знач Операция)

	Результат = Новый Массив;

	Для Каждого Запись Из Записи Цикл
		Если Запись.Фаза <> Фаза ИЛИ Запись.Событие.Вид() <> Вид Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Операция) И Запись.Событие.Операция() <> Операция Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Запись.Событие);
	КонецЦикла;

	Возврат Результат;

КонецФункции
