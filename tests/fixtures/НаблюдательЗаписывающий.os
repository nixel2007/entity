// Наблюдатель для тестов: запоминает события обеих фаз в порядке поступления.
//
// События приходят из разных потоков, в том числе из фоновых заданий, пока тест читает записи,
// поэтому записи закрыты и читаются и пишутся только под блокировкой наблюдателя. Наружу
// отдаются копии.
//
// Параметры конструктора:
//   ПадатьВПередСобытием - Булево - Истина, если ПередСобытием должен завершаться ошибкой.
//     Проверяет, что ошибка наблюдателя не ломает операцию.

// Массив из Структура - Записи о событиях: Фаза ("До" или "После") и само Событие.
Перем Записи;
// Булево - Признак того, что ПередСобытием должен падать.
Перем ПадатьВПередСобытием;
// БлокировкаРесурса - Защищает Записи.
Перем Блокировка;

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ППадатьВПередСобытием = Ложь)
	Записи = Новый Массив;
	ПадатьВПередСобытием = ППадатьВПередСобытием;
	Блокировка = Новый БлокировкаРесурса;
КонецПроцедуры

Процедура ПередСобытием(Событие) Экспорт
	Если ПадатьВПередСобытием Тогда
		ВызватьИсключение "Наблюдатель сломан";
	КонецЕсли;
	Записать("До", Событие);
КонецПроцедуры

Процедура ПослеСобытия(Событие) Экспорт
	Записать("После", Событие);
КонецПроцедуры

Процедура Записать(Знач Фаза, Знач Событие)

	Запись = Новый Структура("Фаза, Событие", Фаза, Событие);

	Блокировка.Заблокировать();

	Попытка
		Записи.Добавить(Запись);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Число записанных событий обеих фаз.
//
// Возвращаемое значение:
//   Число - Сколько записей о событиях сделано к этому моменту.
//
Функция Количество() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = Записи.Количество();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Все записи о событиях обеих фаз в порядке поступления.
//
// Возвращаемое значение:
//   Массив из Структура - Копия записей, снятая под блокировкой: Фаза ("До" или "После") и Событие.
//     Дальнейшие события в нее не попадают.
//
Функция ВсеЗаписи() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = Новый Массив;
		Для Каждого Запись Из Записи Цикл
			Результат.Добавить(Новый Структура("Фаза, Событие", Запись.Фаза, Запись.Событие));
		КонецЦикла;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает завершенные события указанного вида.
//
// Параметры:
//   Вид - Строка - Вид события, значение ВидыСобытийИсточникаДанных.
//   Операция - Строка - Операция события; пустая строка - любая.
//
// Возвращаемое значение:
//   Массив из СобытиеИсточникаДанных - События фазы "После" в порядке завершения.
//
Функция Завершенные(Знач Вид, Знач Операция = "") Экспорт
	Возврат Отобрать("После", Вид, Операция);
КонецФункции

// Возвращает начатые события указанного вида.
//
// Параметры:
//   Вид - Строка - Вид события, значение ВидыСобытийИсточникаДанных.
//   Операция - Строка - Операция события; пустая строка - любая.
//
// Возвращаемое значение:
//   Массив из СобытиеИсточникаДанных - События фазы "До" в порядке начала.
//
Функция Начатые(Знач Вид, Знач Операция = "") Экспорт
	Возврат Отобрать("До", Вид, Операция);
КонецФункции

// Отбирает события по копии записей: методы событий зовутся уже вне блокировки наблюдателя.
//
Функция Отобрать(Знач Фаза, Знач Вид, Знач Операция)

	Результат = Новый Массив;

	Для Каждого Запись Из ВсеЗаписи() Цикл
		Если Запись.Фаза <> Фаза ИЛИ Запись.Событие.Вид() <> Вид Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Операция) И Запись.Событие.Операция() <> Операция Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Запись.Событие);
	КонецЦикла;

	Возврат Результат;

КонецФункции
