// Настройки КоннекторУправляемоеОткрытие: что коннектор делает на открытии, проверке открытости,
// завершении транзакции и закрытии.
//
// Пул конструирует коннекторы сам, поэтому настроить экземпляр снаружи нельзя - настройки приходят
// тем же путем, что и всегда, через параметры коннектора. Единственным элементом массива параметров
// идет этот объект: позиционный список из полудюжины значений читать невозможно.
//
// Открытые поля задаются до создания пула и после не меняются: коннектор снимает с них копию при
// открытии. Все, что тесту нужно менять на ходу, живет в общих объектах со своей блокировкой -
// планах, обрыве, наблюдателе закрытия, признаке отмены падений закрытия.
//
// BSLLS:ExportVariables-off

// Число - Пауза внутри открытия в миллисекундах. Изображает медленное подключение: рукопожатие,
// аутентификацию, недоступный хост.
Перем ПаузаОткрытия Экспорт;
// Булево - Истина, если открытие должно завершиться ошибкой.
Перем ПадатьПриОткрытии Экспорт;
// Булево - Истина, если фиксация и отмена транзакции должны завершаться ошибкой.
Перем ПадатьПриЗавершенииТранзакции Экспорт;
// Булево - Истина, если закрытие должно завершиться ошибкой. См. ОтменитьПаденияПриЗакрытии.
Перем ПадатьПриЗакрытии Экспорт;
// ПланЗакрытийКоннектора - Общий на пул план падений закрытия: с какого по счету закрытия начинать
// падать. Задан - решает он, а не ПадатьПриЗакрытии.
Перем ПланЗакрытий Экспорт;
// ПланСбоевКоннектора - Общий на пул план падений вызова Открыт().
Перем ПланПроверок Экспорт;
// ПланСбоевКоннектора - Общий на пул план падений открытия.
Перем ПланОткрытий Экспорт;
// НаблюдательЗакрытияИсточника - Наблюдатель, которого коннектор спрашивает в начале закрытия.
Перем НаблюдательЗакрытия Экспорт;
// ОбрывСоединений - Общий на пул обрыв соединений со стороны сервера. Задан - коннектор считает
// себя закрытым, как только его волна оборвана.
Перем ОбрывСоединений Экспорт;
// АтомарноеБулево - Падения закрытия отменены тестом: закрытие больше не падает, что бы ни
// говорили ПадатьПриЗакрытии и план.
Перем ПаденияЗакрытияОтменены;

Процедура ПриСозданииОбъекта()

	ПаузаОткрытия = 0;
	ПадатьПриОткрытии = Ложь;
	ПадатьПриЗавершенииТранзакции = Ложь;
	ПадатьПриЗакрытии = Ложь;
	ПланЗакрытий = Неопределено;
	ПланПроверок = Неопределено;
	ПланОткрытий = Неопределено;
	НаблюдательЗакрытия = Неопределено;
	ОбрывСоединений = Неопределено;
	ПаденияЗакрытияОтменены = Новый АтомарноеБулево(Ложь);

КонецПроцедуры

// Собирает параметры коннектора для ИсточникДанных и ПулСоединенийСБД.
//
// Возвращаемое значение:
//   Массив - Параметры коннектора с этими настройками единственным элементом.
//
Функция ПараметрыКоннектора() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(ЭтотОбъект);

	Возврат Параметры;

КонецФункции

// Отменяет падения закрытия у всех коннекторов с этими настройками, уже открытых в том числе.
// Нужно тесту, который заказал падение закрытия и должен в конце закрыть пул.
//
Процедура ОтменитьПаденияПриЗакрытии() Экспорт
	ПаденияЗакрытияОтменены.Установить(Истина);
КонецПроцедуры

// Отменены ли падения закрытия.
//
// Возвращаемое значение:
//   Булево - Истина, если закрытие падать больше не должно.
//
Функция ПаденияЗакрытияОтменены() Экспорт
	Возврат ПаденияЗакрытияОтменены.Получить();
КонецФункции
