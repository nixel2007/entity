// Настройки КоннекторТранзакцийДляТестов: что коннектор делает на начале и завершении транзакции.
//
// Пул конструирует коннекторы сам, поэтому настроить экземпляр снаружи нельзя - настройки приходят
// тем же путем, что и всегда, через параметры коннектора. Единственным элементом массива параметров
// идет этот объект: позиционный список флагов читать невозможно.
//
// Класс хранит только данные, поэтому поля открыты - как у НастройкиТестовогоКоннектора.
//
// BSLLS:ExportVariables-off

// Булево - Истина, если начало транзакции должно завершаться ошибкой.
Перем ПадатьПриНачалеТранзакции Экспорт;
// Булево - Истина, если фиксация и отмена транзакции должны завершаться ошибкой.
Перем ПадатьПриЗавершенииТранзакции Экспорт;
// Булево - Истина, если начало транзакции поверх начатой должно отвергаться, как это делает
// СУБД без поддержки вложенных транзакций.
Перем ОтвергатьВложеннуюТранзакцию Экспорт;
// Число - Пауза внутри закрытия соединения в миллисекундах. Изображает медленное закрытие,
// которое пул делает под своей блокировкой записи.
Перем ПаузаЗакрытия Экспорт;
// СигналЗакрытияСоединения - Сигнал, который коннектор отмечает в начале закрытия. Задан - тест
// может дождаться момента, когда блокировка пула уже занята закрывающим потоком.
Перем СигналЗакрытия Экспорт;

Процедура ПриСозданииОбъекта()

	ПадатьПриНачалеТранзакции = Ложь;
	ПадатьПриЗавершенииТранзакции = Ложь;
	ОтвергатьВложеннуюТранзакцию = Ложь;
	ПаузаЗакрытия = 0;
	СигналЗакрытия = Неопределено;

КонецПроцедуры

// Собирает параметры коннектора для ИсточникДанных и ПулСоединенийСБД.
//
// Возвращаемое значение:
//   Массив - Параметры коннектора с этими настройками единственным элементом.
//
Функция ПараметрыКоннектора() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(ЭтотОбъект);

	Возврат Параметры;

КонецФункции
