// Пул соединений принадлежит источнику данных: менеджеры одного источника делят пул и
// транзакцию потока, а закрывает пул источник - явно или по завершению потока, в котором
// источник создан.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// ИсточникДанных - Источник, созданный в другом потоке; поток теста проверяет его после
// завершения потока создания. Другой поток дает фоновое задание.
Перем ИсточникДругогоПотока;

&Тест
Процедура МенеджерыОдногоИсточникаДелятПул() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "общий пул");
	Первый = Новый МенеджерСущностей(Источник);
	Второй = Новый МенеджерСущностей(Источник);

	Ожидаем.Что(Первый.ИсточникДанных().ПулСоединений() = Второй.ИсточникДанных().ПулСоединений(), "Пул один на источник")
		.ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура МенеджерВозвращаетСвойИсточник() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "источник менеджера");
	Менеджер = Новый МенеджерСущностей(Источник);

	Ожидаем.Что(Менеджер.ИсточникДанных() = Источник, "Менеджер отдает источник, из которого создан").ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

// Транзакции нужен коннектор СУБД: КоннекторInMemory их не поддерживает.
&Тест
Процедура ТранзакцияПотокаОбщаяДляМенеджеровИсточника() Экспорт

	Источник = ИсточникСТранзакциями();
	Первый = Новый МенеджерСущностей(Источник);
	Второй = Новый МенеджерСущностей(Источник);

	Первый.НачатьТранзакцию();
	КоннекторПервого = Первый.ВычислитьСКоннектором("Коннектор -> Коннектор");
	КоннекторВторого = Второй.ВычислитьСКоннектором("Коннектор -> Коннектор");
	Первый.ОтменитьТранзакцию();

	Ожидаем.Что(КоннекторПервого = КоннекторВторого, "Второй менеджер попадает в транзакцию потока")
		.ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура ЗакрытиеМенеджераНеЗакрываетПулИсточника() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "живой пул");
	Первый = Новый МенеджерСущностей(Источник);
	Второй = Новый МенеджерСущностей(Источник);
	Первый.ВычислитьСКоннектором("Коннектор -> Коннектор");

	Первый.Закрыть();

	Ожидаем.Что(Источник.Закрыт(), "Закрытие менеджера источник не закрывает").ЭтоЛожь();
	Ожидаем.Что(Второй.ВычислитьСКоннектором("Коннектор -> ТипЗнч(Коннектор)")).Равно(Тип("КоннекторInMemory"));

	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура ПослеЗакрытияИсточникаМенеджерНеРаботает() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "закрытый пул");
	Менеджер = Новый МенеджерСущностей(Источник);
	Менеджер.ВычислитьСКоннектором("Коннектор -> Коннектор");

	Источник.Закрыть();

	ТекстОшибки = "";
	Попытка
		Менеджер.ВычислитьСКоннектором("Коннектор -> Коннектор");
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "Обращение через закрытый источник завершается ошибкой").Содержит("закрыт");

КонецПроцедуры

&Тест
Процедура ИсточникЗакрываетсяПоЗавершениюПотока() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СоздатьИсточникВДругомПотоке", Новый Массив, Истина);
	Задание.ОжидатьЗавершения();

	Ожидаем.Что(Задание.ИнформацияОбОшибке = Неопределено, "Поток создания завершился без ошибок").ЭтоИстина();
	Ожидаем.Что(ИсточникДругогоПотока.Закрыт(), "Источник закрыт по завершению создавшего его потока")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АвтоЗакрытиеОтключаетсяСеттером() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СоздатьИсточникБезАвтоЗакрытияВДругомПотоке", Новый Массив, Истина);
	Задание.ОжидатьЗавершения();

	Ожидаем.Что(Задание.ИнформацияОбОшибке = Неопределено, "Поток создания завершился без ошибок").ЭтоИстина();
	Ожидаем.Что(ИсточникДругогоПотока.Закрыт(), "Без автоматического закрытия источник переживает поток").ЭтоЛожь();

	Менеджер = Новый МенеджерСущностей(ИсточникДругогоПотока);
	Ожидаем.Что(Менеджер.ВычислитьСКоннектором("Коннектор -> ТипЗнч(Коннектор)")).Равно(Тип("КоннекторInMemory"));

	ИсточникДругогоПотока.Закрыть();

КонецПроцедуры

// Закрытие менеджера терминально: хранилищ он больше не выдает. Иначе поток, ожидавший создания
// хранилища, создал бы его уже после закрытия, и это хранилище пережило бы менеджер вместе с его
// очищенной моделью.
&Тест
Процедура ЗакрытыйМенеджерХранилищНеВыдает() Экспорт

	ПодключитьКлассыСущностей();

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "хранилища после закрытия");
	Менеджер = МенеджерАвторов(Источник);

	Менеджер.Закрыть();

	ТекстОшибкиХранилища = "";
	Попытка
		Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));
	Исключение
		ТекстОшибкиХранилища = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТекстОшибкиЧтения = "";
	Попытка
		Менеджер.Получить(Тип("Автор"));
	Исключение
		ТекстОшибкиЧтения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибкиХранилища, "Закрытый менеджер хранилище не выдает").Содержит("закрыт");
	Ожидаем.Что(ТекстОшибкиЧтения, "Чтение через закрытый менеджер завершается ошибкой").Содержит("закрыт");

	Источник.Закрыть();

КонецПроцедуры

// Хранилища принадлежат менеджеру, поэтому закрытие менеджера их и закрывает: прочитанные
// сущности из пула сущностей уходят.
&Тест
Процедура ЗакрытиеМенеджераЗакрываетЕгоХранилища() Экспорт

	ПодключитьКлассыСущностей();

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "закрытие хранилищ");
	Менеджер = МенеджерАвторов(Источник);

	Автор = Менеджер.СоздатьЭлемент(Тип("Автор"));
	Автор.Имя = "Иван";
	Менеджер.Сохранить(Автор);

	Хранилище = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));
	Ожидаем.Что(Хранилище.ПолучитьПулСущностей().Количество(), "Сохраненная сущность попала в пул сущностей")
		.Равно(1);

	Менеджер.Закрыть();

	Ожидаем.Что(Хранилище.ПолучитьПулСущностей().Количество(), "Закрытие менеджера очистило пул сущностей")
		.Равно(0);

	Источник.Закрыть();

КонецПроцедуры

// Хранилище работает с моделью данных своего менеджера, поэтому и принадлежит менеджеру: у двух
// менеджеров одного источника хранилища разные, как и пулы сущностей в них.
&Тест
Процедура ХранилищаПринадлежатМенеджеруАНеИсточнику() Экспорт

	ПодключитьКлассыСущностей();

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "хранилища по менеджеру");
	Первый = МенеджерАвторов(Источник);
	Второй = МенеджерАвторов(Источник);

	Ожидаем
		.Что(Первый.ПолучитьХранилищеСущностей(Тип("Автор")) = Второй.ПолучитьХранилищеСущностей(Тип("Автор")),
			"У каждого менеджера свое хранилище")
		.ЭтоЛожь();

	Источник.Закрыть();

КонецПроцедуры

// Закрытие менеджера очищает его модель данных. Пока хранилища принадлежали источнику, хранилище
// с моделью закрытого менеджера доставалось следующему менеджеру, и разыменование ссылки в нем
// уже не находило тип.
&Тест
Процедура ЗакрытиеМенеджераНеЛомаетДругойМенеджерИсточника() Экспорт

	ПодключитьКлассыСущностей();

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "чужая модель");

	Первый = МенеджерАвторов(Источник);
	Внешняя = Первый.СоздатьЭлемент(Тип("СущностьБезГенерируемогоИдентификатора"));
	Внешняя.ВнутреннийИдентификатор = 1;
	Первый.Сохранить(Внешняя);
	Автор = Первый.СоздатьЭлемент(Тип("Автор"));
	Автор.Имя = "Иван";
	Автор.ВнешняяСущность = Внешняя;
	Первый.Сохранить(Автор);

	Второй = МенеджерАвторов(Источник);
	ХранилищеВторого = Второй.ПолучитьХранилищеСущностей(Тип("Автор"));

	Первый.Закрыть();

	Ожидаем
		.Что(ХранилищеВторого.Получить(), "Чтение со ссылкой переживает закрытие чужого менеджера")
		.ИмеетДлину(1);

	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура ПовторноеЗакрытиеИсточникаБезошибочно() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "двойное закрытие");
	Менеджер = Новый МенеджерСущностей(Источник);
	Менеджер.ВычислитьСКоннектором("Коннектор -> Коннектор");

	Источник.Закрыть();
	Источник.Закрыть();

	Ожидаем.Что(Источник.Закрыт()).ЭтоИстина();

КонецПроцедуры

// Менеджер с типом Автор в модели, созданный из источника.
//
// Параметры:
//   Источник - ИсточникДанных - Источник.
//
// Возвращаемое значение:
//   МенеджерСущностей - Менеджер с инициализированной моделью.
//
Функция МенеджерАвторов(Источник)

	Менеджер = Новый МенеджерСущностей(Источник);
	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Возврат Менеджер;

КонецФункции

// Подключает классы сущностей Автор и СущностьБезГенерируемогоИдентификатора.
//
Процедура ПодключитьКлассыСущностей()

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"), "Автор");

КонецПроцедуры

// Источник на СУБД с транзакциями: SQLite в памяти, если тесты SQLite включены, иначе PostgreSQL
// по переменным среды.
//
// Возвращаемое значение:
//   ИсточникДанных - Источник.
//
Функция ИсточникСТранзакциями()

	Если ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true") = "true" Тогда
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), "FullUri=file::memory:?cache=shared");
	КонецЕсли;

	Если ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true") = "true" Тогда
		СтрокаСоединения = СтрШаблон(
			"Host=%1;Port=%2;Username=%3;Password=%4;Database=%5",
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres")
		);
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторPostgreSQL"), СтрокаСоединения);
	КонецЕсли;

	ВызватьИсключение "Нет доступного коннектора с транзакциями";

КонецФункции

// Создает источник и открывает соединение в потоке фонового задания. Используется тестом
// "ИсточникЗакрываетсяПоЗавершениюПотока".
//
Процедура СоздатьИсточникВДругомПотоке() Экспорт

	ИсточникДругогоПотока = Новый ИсточникДанных("Другой поток", Тип("КоннекторInMemory"), "другой поток");
	Менеджер = Новый МенеджерСущностей(ИсточникДругогоПотока);
	Менеджер.ВычислитьСКоннектором("Коннектор -> Коннектор");

КонецПроцедуры

// Создает источник без автоматического закрытия и открывает соединение в потоке фонового задания. Используется
// тестом "АвтоЗакрытиеОтключаетсяСеттером".
//
Процедура СоздатьИсточникБезАвтоЗакрытияВДругомПотоке() Экспорт

	ИсточникДругогоПотока = Новый ИсточникДанных("Другой поток", Тип("КоннекторInMemory"), "без автоматического закрытия");
	ИсточникДругогоПотока.УстановитьАвтоЗакрытие(Ложь);
	Менеджер = Новый МенеджерСущностей(ИсточникДругогоПотока);
	Менеджер.ВычислитьСКоннектором("Коннектор -> Коннектор");

КонецПроцедуры
