// Пул выдает соединение потоку исполнения и хранит эту привязку, пока поток не освободит
// соединение. Здесь проверяется механика выдачи и возврата в пределах одного потока;
// независимость транзакций разных потоков проверяется в МногопоточностьФоновыеЗадания.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

#Использовать moskito

// Пул, который тесты создают заново перед каждым тестом.
Перем Пул;
// Пул с пределом в одно соединение для проверки ожидания. Виден фоновому заданию.
Перем ПулСПределом;
// Пул на коннекторе с медленным открытием. Виден фоновому заданию.
Перем ПулМедленный;
// Пул с коротким пределом ожидания в очереди. Виден фоновому заданию.
Перем ПулСОжиданием;
// Тип коннектора БД, доступной в текущем окружении.
Перем ТипКоннектораТестовойБазы;
// Строка соединения с БД, доступной в текущем окружении.
Перем СтрокаСоединенияТестовойБазы;
// Признак того, что таблицы тестовой БД переживают перезапуск и их нужно сбрасывать.
Перем СбрасыватьТаблицы;
// Соединение, удерживающее базу SQLite в памяти живой. Не задано для PostgreSQL.
Перем ДержательБазыВПамяти;
// Признак того, что подписчик завершения потока, вставший в очередь после пула, был вызван.
Перем ПодписчикПослеПулаВызван;
// БлокировкаЧтенияЗаписи - Настоящая блокировка пула, за которой следит шпион.
Перем БлокировкаПодШпионом;
// Число - Сколько раз у блокировки спрашивали половину чтения.
Перем ОбращенийКЧтению;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	// КоннекторInMemory не требует внешней БД, а механике выдачи соединений все равно, какой коннектор внутри.
	Пул = Новый ПулСоединенийСБД(2, Тип("КоннекторInMemory"), "", Новый Массив);

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "КоннекторУправляемоеОткрытие.os"),
		"КоннекторУправляемоеОткрытие"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ПланЗакрытийКоннектора.os"),
		"ПланЗакрытийКоннектора"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "НастройкиТестовогоКоннектора.os"),
		"НастройкиТестовогоКоннектора"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ОбрывСоединений.os"),
		"ОбрывСоединений"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "НаблюдательЗаписывающий.os"),
		"НаблюдательЗаписывающий"
	);

	ОпределитьТестовуюБазу();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт

	Пул.Закрыть();
	Пул = Неопределено;

	Если ДержательБазыВПамяти <> Неопределено Тогда
		ДержательБазыВПамяти.Закрыть();
		ДержательБазыВПамяти = Неопределено;
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура НовыйПулНеДержитСоединений() Экспорт

	Ожидаем.Что(Пул.КоличествоЗанятых(), "В новом пуле нет занятых соединений").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "В новом пуле нет свободных соединений").Равно(0);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоПотокаИсполнения(), "За текущим потоком ничего не закреплено")
		.ЭтоЛожь();

КонецПроцедуры

// Пока поток не освободил соединение, он получает то же самое - иначе начатая им транзакция
// была бы не видна его же последующим операциям.
//
&Тест
Процедура ПотокПолучаетОдноИТоЖеСоединение() Экспорт

	Первое = Пул.Занять();
	Второе = Пул.Занять();

	Ожидаем.Что(Второе = Первое, "Потоку выдано то же соединение").ЭтоИстина();
	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занято одно соединение").Равно(1);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных соединений нет").Равно(0);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоПотокаИсполнения(), "За текущим потоком закреплено соединение")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОсвобожденноеСоединениеСтановитсяСвободным() Экспорт

	Пул.Занять();
	Пул.Освободить();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых соединений не осталось").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Соединение вернулось в очередь свободных").Равно(1);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоПотокаИсполнения(), "За текущим потоком ничего не закреплено")
		.ЭтоЛожь();

КонецПроцедуры

// Освобожденное соединение не закрывается, а переиспользуется: иначе пул не имел бы смысла.
//
&Тест
Процедура СвободноеСоединениеВыдаетсяПовторно() Экспорт

	Первое = Пул.Занять();
	Пул.Освободить();
	Второе = Пул.Занять();

	Ожидаем.Что(Второе = Первое, "Из очереди выдано то же соединение").ЭтоИстина();
	Ожидаем.Что(Пул.КоличествоСвободных(), "Очередь свободных опустела").Равно(0);
	Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение снова закреплено за потоком").Равно(1);

КонецПроцедуры

&Тест
Процедура ОсвобождениеБезЗахватаНичегоНеМеняет() Экспорт

	Пул.Освободить();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых соединений нет").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных соединений нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗакрытиеОсвобождаетИЗанятыеИСвободные() Экспорт

	Пул.Занять();
	Пул.Освободить();
	Пул.Занять();

	Пул.Закрыть();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятые соединения закрыты").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободные соединения закрыты").Равно(0);

КонецПроцедуры

// При нулевом размере пул не переиспользует соединения: каждая транзакция открывает свое.
// Собственное соединение поток получает и в этом режиме - потокобезопасность не отключается.
//
&Тест
Процедура НулевойРазмерОтключаетПереиспользование() Экспорт

	ИсточникБезПереиспользования = Новый ИсточникДанных(
		"Без переиспользования",
		ТипКоннектораТестовойБазы,
		СтрокаСоединенияТестовойБазы,
		,
		0
	);
	Менеджер = Новый МенеджерСущностей(ИсточникБезПереиспользования);

	Попытка
		ОчиститьТестовуюБазу(Менеджер);
		ПроверитьРаботуБезПереиспользования(Менеджер);
	Исключение
		ИсточникБезПереиспользования.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ИсточникБезПереиспользования.Закрыть();

КонецПроцедуры

// Проверяет транзакции менеджера, чей пул не переиспользует соединения.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, созданный с нулевым размером пула.
//
Процедура ПроверитьРаботуБезПереиспользования(Менеджер)

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);

	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Менеджер.НачатьТранзакцию();

	Ожидаем
		.Что(Менеджер.ИсточникДанных().ПулСоединений().СоединениеТекущегоПотокаИсполнения() <> Неопределено,
			"Поток получил соединение и при нулевом размере")
		.ЭтоИстина();

	Менеджер.Сохранить(НовыйАвтор("Отмененный"));
	Менеджер.ОтменитьТранзакцию();

	Ожидаем
		.Что(ТестовыеУтилиты.ВыполнитьЗапрос(Менеджер, "SELECT * FROM Авторы"), "Откат сработал")
		.ИмеетДлину(0);

	Менеджер.НачатьТранзакцию();
	Менеджер.Сохранить(НовыйАвтор("Сохраненный"));
	Менеджер.ЗафиксироватьТранзакцию();

	Ожидаем
		.Что(ТестовыеУтилиты.ВыполнитьЗапрос(Менеджер, "SELECT * FROM Авторы"), "Фиксация сработала")
		.ИмеетДлину(1);

КонецПроцедуры

// Создает автора с указанным именем.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
// Возвращаемое значение:
//   Произвольный - Новый автор.
//
Функция НовыйАвтор(Знач Имя)

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	Возврат Автор;

КонецФункции

// Определяет коннектор и строку соединения с БД, доступной в текущем окружении.
//
// Отключенный пул проверяется на настоящей транзакции, поэтому КоннекторInMemory здесь не годится:
// транзакций он не поддерживает.
//
Процедура ОпределитьТестовуюБазу()

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединенияТестовойБазы = "FullUri=file::memory:?cache=shared";
		ТипКоннектораТестовойБазы = Тип("КоннекторSQLite");
		СбрасыватьТаблицы = Ложь;

		// База в памяти живет, пока открыто хотя бы одно соединение к ней. При нулевом размере
		// пула таких моментов нет: соединение закрывается сразу после операции. Держим свое,
		// мимо пула, иначе база исчезала бы между операциями вместе с таблицами.
		ДержательБазыВПамяти = Новый КоннекторSQLite;
		ДержательБазыВПамяти.Открыть(СтрокаСоединенияТестовойБазы, Новый Массив);
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединенияТестовойБазы = СтрокаСоединенияPostgres();
		ТипКоннектораТестовойБазы = Тип("КоннекторPostgreSQL");
		СбрасыватьТаблицы = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования менеджера без пула";
	КонецЕсли;

КонецПроцедуры

// Сбрасывает таблицы тестовой БД, если они переживают перезапуск.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, коннектором которого выполняется сброс.
//
Процедура ОчиститьТестовуюБазу(Менеджер)

	Если НЕ СбрасыватьТаблицы Тогда
		Возврат;
	КонецЕсли;

	ТестовыеУтилиты.СброситьТаблицы(Менеджер);

КонецПроцедуры

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции

// Когда предел пула исчерпан, следующий поток ждет, пока соединение освободит другой.
//
&Тест
Процедура ПриИсчерпанномПределеПотокЖдет() Экспорт

	ПулСПределом = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка
		ПроверитьОжиданиеНаПределе();
	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Нулевой размер предела не ставит: соединение получают все, сколько бы их ни просило.
//
&Тест
Процедура ПриНулевомРазмереНиктоНеЖдет() Экспорт

	ПулСПределом = Новый ПулСоединенийСБД(0, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка

		ПулСПределом.Занять();

		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОсвободитьВФоне", Новый Массив, Истина);
		ДождатьсяЗадания(Задание);

		Ожидаем.Что(Задание.ИнформацияОбОшибке, "Фоновое задание получило соединение").Равно(Неопределено);
		Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Ждать никому не пришлось").Равно(0);

		ПулСПределом.Освободить();

	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Проверяет, что фоновое задание встает в очередь, пока единственное соединение занято,
// и получает его сразу после освобождения.
//
Процедура ПроверитьОжиданиеНаПределе()

	ПулСПределом.Занять();

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОсвободитьВФоне", Новый Массив, Истина);

	Приостановить(300);

	Ожидаем
		.Что(Задание.Состояние = СостояниеФоновогоЗадания.Активно, "Задание ждет: единственное соединение занято")
		.ЭтоИстина();
	Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Задание встало в очередь").Равно(1);

	ПулСПределом.Освободить();
	ДождатьсяЗадания(Задание);

	Ожидаем.Что(Задание.ИнформацияОбОшибке, "Задание дождалось соединения").Равно(Неопределено);
	Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Очередь ожидающих опустела").Равно(0);

КонецПроцедуры

// Занимает и освобождает соединение проверяемого пула. Запускается в фоновом задании.
//
Процедура ЗанятьИОсвободитьВФоне() Экспорт
	ПулСПределом.Занять();
	ПулСПределом.Освободить();
КонецПроцедуры

// Дожидается завершения фонового задания за отведенное время.
//
// Без ограничения зависший пул подвесил бы весь прогон, и причину пришлось бы искать по таймауту
// сборки вместо понятного падения теста.
//
// Параметры:
//   Задание - ФоновоеЗадание - Задание, завершения которого ждем.
//
Процедура ДождатьсяЗадания(Задание)

	Если НЕ Задание.ОжидатьЗавершения(30000) Тогда
		ВызватьИсключение "Фоновое задание не завершилось за 30 секунд";
	КонецЕсли;

КонецПроцедуры

// Поток оборвался, не освободив соединение. Соединение возвращается в пул сразу по завершении
// потока - иначе оно было бы потеряно навсегда.
//
// Поток исполнения подставлен поддельный, а событие завершения поднимается явно: здесь проверяется
// реакция пула на завершение потока, а не умение движка обрывать фоновые задания.
//
&Тест
Процедура СоединениеОборвавшегосяПотокаВозвращаетсяВПул() Экспорт

	ПоддельныеПотоки = Мок.Получить(Тип("ПотокиИсполнения"));
	ОборвавшийсяПоток = Мок.Получить(Тип("ПотокИсполнения"));

	ПулОборванного = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторInMemory"),
		"",
		Новый Массив,
		1000,
		10,
		ПоддельныеПотоки
	);

	Попытка
		ПроверитьВозвратПослеОбрыва(ПулОборванного, ПоддельныеПотоки, ОборвавшийсяПоток);
	Исключение
		ПулОборванного.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулОборванного.Закрыть();

КонецПроцедуры

// Ошибка при открытии соединения не должна оставлять блокировку пула захваченной.
//
&Тест
Процедура ОшибкаЗахватаНеОставляетПулЗаблокированным() Экспорт

	// Массив коннектором не является: открытие соединения свалится внутри захвата.
	ПулСОшибкой = Новый ПулСоединенийСБД(1, Тип("Массив"), "", Новый Массив);

	Ожидаем
		.Что(ПулСОшибкой, "Захват завершился ошибкой")
		.Метод("Занять")
		.ВыбрасываетИсключение();

	// Если бы блокировка осталась захваченной, этот вызов не вернулся бы.
	Ожидаем.Что(ПулСОшибкой.КоличествоЗанятых(), "Блокировка освобождена, состояние читается").Равно(0);

КонецПроцедуры

// Проверяет, что соединение оборвавшегося потока достается следующему.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул с пределом в одно соединение.
//   Потоки - ПотокиИсполнения - Поддельный поставщик текущего потока.
//   ОборвавшийсяПоток - ПотокИсполнения - Поток, который займет соединение и завершится.
//
Процедура ПроверитьВозвратПослеОбрыва(Пул, Потоки, ОборвавшийсяПоток)

	Потоки.Когда().Текущий().ТогдаВозвращает(ОборвавшийсяПоток);
	Пул.Занять();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение закреплено за потоком").Равно(1);

	// Поток завершился, не освободив соединение: движок поднял бы это событие сам.
	ОборвавшийсяПоток.ВызватьСобытие("ПриЗавершении", Новый Массив);

	Ожидаем
		.Что(Пул.КоличествоЗанятых(), "За оборвавшимся потоком соединение не осталось")
		.Равно(0);
	Ожидаем
		.Что(Пул.КоличествоСвободных(), "Соединение вернулось в пул сразу по завершении потока")
		.Равно(1);

	// Предел в одно соединение исчерпан: следующий поток получает брошенное без ожидания.
	Потоки.Когда().Текущий().ТогдаВозвращает(Мок.Получить(Тип("ПотокИсполнения")));
	Пул.Занять();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение выдано следующему потоку").Равно(1);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных не осталось").Равно(0);

	Пул.Освободить();

КонецПроцедуры

// При нулевом размере освобожденное соединение закрывается, а не встает в очередь: следующий
// захват открывает новое.
//
&Тест
Процедура ПриНулевомРазмереСоединениеНеПереиспользуется() Экспорт

	ПулБезПредела = Новый ПулСоединенийСБД(0, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка

		Первое = ПулБезПредела.Занять();
		ПулБезПредела.Освободить();

		Ожидаем.Что(ПулБезПредела.КоличествоСвободных(), "Освобожденное соединение закрыто").Равно(0);

		Второе = ПулБезПредела.Занять();

		Ожидаем.Что(Второе = Первое, "Выдано новое соединение, а не прежнее").ЭтоЛожь();

		ПулБезПредела.Освободить();

	Исключение
		ПулБезПредела.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулБезПредела.Закрыть();

КонецПроцедуры

// Открытие соединения - сетевой вызов, и держать на нем блокировку пула нельзя: иначе
// недоступная база морозит всех, включая тех, кто хочет вернуть исправное соединение.
//
&Тест
Процедура ОткрытиеСоединенияНеДержитБлокировкуПула() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПаузаОткрытия = 3000;

	ПулМедленный = Новый ПулСоединенийСБД(
		2,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора()
	);

	Попытка
		ПроверитьЧтоПулОтвечаетВоВремяОткрытия();
	Исключение
		ПулМедленный.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулМедленный.Закрыть();

КонецПроцедуры

// Пока фоновое задание открывает соединение, пул отвечает на обращения без задержки.
//
Процедура ПроверитьЧтоПулОтвечаетВоВремяОткрытия()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьМедленноеВФоне", Новый Массив, Истина);

	// Дать заданию дойти до открытия: до него оно успевает только взять бронь под блокировкой.
	Приостановить(500);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПулМедленный.КоличествоЗанятых();
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем
		.Что(Длительность < 1000, "Пул ответил, не дожидаясь конца открытия: " + Длительность + " мс")
		.ЭтоИстина();

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке, "Задание открыло соединение без ошибок")
		.Равно(Неопределено);

КонецПроцедуры

// Занимает и освобождает соединение медленного пула. Запускается в фоновом задании.
//
Процедура ЗанятьМедленноеВФоне() Экспорт
	ПулМедленный.Занять();
	ПулМедленный.Освободить();
КонецПроцедуры

// Ждет, пока фоновое задание займет место в пуле и уйдет открывать соединение.
//
// Ждать по счетчику, а не паузой: на загруженном раннере фоновое задание может стартовать
// не сразу, и тест успел бы закрыть пул раньше, чем задание до него добралось.
//
Процедура ДождатьсяБрони()

	Попыток = 0;
	Пока ПулМедленный.КоличествоСозданных() = 0 Цикл

		Попыток = Попыток + 1;
		Если Попыток > 300 Тогда
			ВызватьИсключение "Фоновое задание не заняло место в пуле за 30 секунд";
		КонецЕсли;

		Приостановить(100);

	КонецЦикла;

КонецПроцедуры

// Пул, закрытый посреди открытия, не оставляет открывшееся соединение живым и не считает
// занятым место под него.
//
&Тест
Процедура ЗакрытиеВоВремяОткрытияНеОставляетСоединения() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПаузаОткрытия = 3000;

	ПулМедленный = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора()
	);

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьМедленноеВФоне", Новый Массив, Истина);

	ДождатьсяБрони();
	ПулМедленный.Закрыть();

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Открывавший поток узнал о закрытии пула")
		.ЭтоИстина();
	Ожидаем.Что(ПулМедленный.КоличествоЗанятых(), "Занятых соединений не осталось").Равно(0);
	Ожидаем.Что(ПулМедленный.КоличествоСвободных(), "Свободных соединений не осталось").Равно(0);
	Ожидаем.Что(ПулМедленный.КоличествоСозданных(), "Место под соединение вернулось в пул").Равно(0);

КонецПроцедуры

// Неудачное открытие не съедает место в пуле: иначе после нескольких ошибок пул считал бы себя
// полным и отправлял бы всех в очередь ожидания, из которой при исчерпанном пределе не выйти.
//
&Тест
Процедура НеудачноеОткрытиеВозвращаетМестоВПул() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПадатьПриОткрытии = Истина;

	ПулПадающий = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора()
	);

	Попытка

		Ожидаем
			.Что(ПулПадающий, "Захват завершился ошибкой открытия")
			.Метод("Занять")
			.ВыбрасываетИсключение();

		Ожидаем.Что(ПулПадающий.КоличествоСозданных(), "Место в пуле свободно").Равно(0);
		Ожидаем.Что(ПулПадающий.КоличествоЗанятых(), "Занятых соединений нет").Равно(0);

	Исключение
		ПулПадающий.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулПадающий.Закрыть();

КонецПроцедуры

// Снимок пула нужен наблюдателям для атрибутов события, а не для корректности, поэтому отдельного
// захвата блокировки он не стоит. Захват чтения проходит только когда блокировку записи никто не
// ждет, а под нагрузкой ожидающие соединения не дают этому случиться: поток, уже получивший
// соединение, застревал бы на снимке, держа соединение занятым и удлиняя ту же очередь.
//
&Тест
Процедура ЗахватИВозвратСоединенияНеБерутБлокировкуЧтения() Экспорт

	БлокировкаПодШпионом = Новый БлокировкаЧтенияЗаписи;
	Шпион = Мок.Следить(БлокировкаПодШпионом);
	Шпион.Когда().Чтение().ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗасчитатьОбращениеКЧтению"));

	ПулПодШпионом = Новый ПулСоединенийСБД(
		2,
		Тип("КоннекторInMemory"),
		"",
		Новый Массив,
		30000,
		10,
		Неопределено,
		Шпион
	);

	Попытка

		// Без наблюдателей событий нет, а снимок снимается только для события.
		ПулПодШпионом.Наблюдатели().Добавить(Новый НаблюдательЗаписывающий);
		ОбращенийКЧтению = 0;

		ПулПодШпионом.Занять();
		ПулПодШпионом.Освободить();

		Ожидаем
			.Что(ОбращенийКЧтению, "Захват и возврат обошлись без блокировки чтения")
			.Равно(0);

		// Проверка положительная: блокировка записи браться должна, иначе тест зеленел бы и на
		// пуле, который не синхронизирует состояние вовсе.
		Шпион.ПроверитьЧтоВызывалсяМетод().Запись();

	Исключение
		ПулПодШпионом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулПодШпионом.Закрыть();

КонецПроцедуры

// Считает обращения к половине чтения и отдает настоящую: шпион подменяет только учет.
//
// Параметры:
//   ИнформацияОВызове - ИнформацияОВызове - Сведения о перехваченном вызове, здесь не нужны.
//
// Возвращаемое значение:
//   БлокировкаЧтения - Половина настоящей блокировки.
//
Функция ЗасчитатьОбращениеКЧтению(ИнформацияОВызове) Экспорт // BSLLS:UnusedParameters-off
	ОбращенийКЧтению = ОбращенийКЧтению + 1;
	Возврат БлокировкаПодШпионом.Чтение();
КонецФункции

// Соединение, оборванное сервером, пока лежало свободным, выдавать нельзя: операции на нем
// падают, а пул отдает свободные в порядке "последним вернули - первым выдали", поэтому одно
// и то же мертвое соединение доставалось бы потокам снова и снова.
//
&Тест
Процедура ОборванноеСвободноеСоединениеНеВыдаетсяСнова() Экспорт

	Обрыв = Новый ОбрывСоединений;
	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ОбрывСоединений = Обрыв;

	ПулОбрыва = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора()
	);

	Попытка

		// Соединение уходит в очередь свободных, и только после этого сервер его обрывает.
		ПулОбрыва.Занять();
		ПулОбрыва.Освободить();
		Обрыв.ОборватьОткрытые();

		Соединение = ПулОбрыва.Занять();

		Ожидаем
			.Что(Соединение.ПолучитьКоннектор().Открыт(), "Выдано живое соединение, а не оборванное")
			.ЭтоИстина();
		Ожидаем
			.Что(ПулОбрыва.КоличествоСозданных(), "Место оборванного соединения занято новым, а не обоими")
			.Равно(1);

		ПулОбрыва.Освободить();

	Исключение
		ПулОбрыва.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулОбрыва.Закрыть();

КонецПроцедуры

// Соединение, оборванное сервером прямо во время работы потока, в пул не возвращается: пул
// закрывает его и освобождает место, а новое откроет следующий захват.
//
// Этой же проверкой закрыт и путь к ожидающему: соединение уходит голове очереди заявок из
// того же возврата в пул, и непригодное до нее не доходит.
//
&Тест
Процедура ОборванноеСоединениеНеВозвращаетсяВПул() Экспорт

	Обрыв = Новый ОбрывСоединений;
	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ОбрывСоединений = Обрыв;

	ПулОбрыва = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора()
	);

	Попытка

		ПулОбрыва.Занять();
		Обрыв.ОборватьОткрытые();
		ПулОбрыва.Освободить();

		Ожидаем
			.Что(ПулОбрыва.КоличествоСвободных(), "Оборванное соединение не встало в очередь свободных")
			.Равно(0);
		Ожидаем
			.Что(ПулОбрыва.КоличествоСозданных(), "Место оборванного соединения вернулось в пул")
			.Равно(0);

	Исключение
		ПулОбрыва.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулОбрыва.Закрыть();

КонецПроцедуры

// Начатая транзакция держит соединение за потоком исполнения и после освобождения захвата, но
// оборванное соединение так держать нельзя: транзакция на нем все равно потеряна, а поток -
// например, фоновое задание приложения - таскал бы мертвое соединение до своего завершения.
//
&Тест
Процедура ОборванноеСоединениеНеОстаетсяЗаПотокомИсполнения() Экспорт

	Обрыв = Новый ОбрывСоединений;
	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ОбрывСоединений = Обрыв;

	ИсточникОбрыва = Новый ИсточникДанных(
		"Оборванный",
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1
	);
	ПулОбрыва = ИсточникОбрыва.ПулСоединений();

	Попытка

		РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(ИсточникОбрыва);
		Обрыв.ОборватьОткрытые();

		// Захват операции внутри транзакции: его освобождение и решает судьбу соединения.
		ПулОбрыва.Занять();
		ПулОбрыва.Освободить();

		Ожидаем
			.Что(ПулОбрыва.ЕстьСоединениеТекущегоПотокаИсполнения(), "Оборванное соединение отобрано у потока")
			.ЭтоЛожь();
		Ожидаем
			.Что(ПулОбрыва.КоличествоСозданных(), "Место оборванного соединения вернулось в пул")
			.Равно(0);

	Исключение
		ИсточникОбрыва.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ИсточникОбрыва.Закрыть();

КонецПроцедуры

// Соединение, на котором не удалось завершить транзакцию, непригодно к переиспользованию:
// в каком состоянии осталась транзакция, неизвестно. Такое соединение пул закрывает и
// освобождает его место, а не оставляет за потоком.
//
&Тест
Процедура ОшибкаЗавершенияТранзакцииНеОставляетСоединениеЗаПотокомИсполнения() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПадатьПриЗавершенииТранзакции = Истина;

	ИсточникПадающий = Новый ИсточникДанных(
		"Падающий",
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1
	);
	ПулПадающий = ИсточникПадающий.ПулСоединений();

	Попытка

		РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(ИсточникПадающий);

		Ожидаем
			.Что(РаботаСКоннекторами, "Фиксация завершилась ошибкой коннектора")
			.Метод("ЗафиксироватьТранзакциюПотокаИсполнения", ПараметрыЗавершенияТранзакции(ИсточникПадающий))
			.ВыбрасываетИсключение();

		Ожидаем
			.Что(ПулПадающий.КоличествоЗанятых(), "Соединение не осталось закрепленным за потоком")
			.Равно(0);
		Ожидаем
			.Что(ПулПадающий.КоличествоСвободных(), "Непригодное соединение не встало в очередь свободных")
			.Равно(0);
		Ожидаем
			.Что(ПулПадающий.КоличествоСозданных(), "Место непригодного соединения вернулось в пул")
			.Равно(0);

	Исключение
		ИсточникПадающий.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ИсточникПадающий.Закрыть();

КонецПроцедуры

// Место непригодного соединения возвращается пулу до его закрытия: соединение уже отобрано у
// потока исполнения и больше нигде не числится, поэтому упади закрытие - место осталось бы занятым
// навсегда, и пул перестал бы выдавать соединения вовсе.
//
&Тест
Процедура ОшибкаЗакрытияНепригодногоСоединенияНеТеряетМестоВПуле() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПадатьПриЗавершенииТранзакции = Истина;
	НастройкиКоннектора.ПадатьПриЗакрытии = Истина;

	ИсточникПадающий = Новый ИсточникДанных(
		"Падающий и при транзакции, и при закрытии",
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1
	);
	ПулПадающий = ИсточникПадающий.ПулСоединений();

	РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(ИсточникПадающий);

	// Фиксация не удалась - соединение непригодно, а его закрытие в пуле тоже падает.
	Ожидаем
		.Что(РаботаСКоннекторами, "Завершение транзакции завершилось ошибкой")
		.Метод("ЗафиксироватьТранзакциюПотокаИсполнения", ПараметрыЗавершенияТранзакции(ИсточникПадающий))
		.ВыбрасываетИсключение();

	Ожидаем
		.Что(ПулПадающий.КоличествоСозданных(), "Место непригодного соединения вернулось в пул")
		.Равно(0);

КонецПроцедуры

// Транзакцию, которую поток исполнения не завершил сам, откатывает пул при возврате соединения.
// Неудача такого отката значит ровно то же, что и неудача явной фиксации или отмены: в каком
// состоянии осталась транзакция на стороне СУБД, неизвестно, и переиспользовать соединение нельзя.
//
&Тест
Процедура НеудачныйНеявныйОткатДелаетСоединениеНепригодным() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПадатьПриЗавершенииТранзакции = Истина;

	ПоддельныеПотоки = Мок.Получить(Тип("ПотокиИсполнения"));
	ОборвавшийсяПоток = Мок.Получить(Тип("ПотокИсполнения"));

	ПулПадающий = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1000,
		10,
		ПоддельныеПотоки
	);

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ОборвавшийсяПоток);
	ПулПадающий.Занять().НачатьТранзакцию();

	// Поток исполнения оборвался, не завершив транзакцию: откат делает сам пул при возврате.
	ОборвавшийсяПоток.ВызватьСобытие("ПриЗавершении", Новый Массив);

	Ожидаем
		.Что(ПулПадающий.КоличествоСвободных(), "Соединение с незавершенной транзакцией в очередь свободных не встало")
		.Равно(0);
	Ожидаем
		.Что(ПулПадающий.КоличествоСозданных(), "Место непригодного соединения вернулось в пул")
		.Равно(0);

КонецПроцедуры

// Обработчик завершения потока исполнения, встающий в очередь подписчиков после пула. Используется
// тестом "ОшибкаОсвобожденияНеОбрываетОстальныхПодписчиковЗавершенияПотока".
//
Процедура ОтметитьВызовПодписчикаПослеПула() Экспорт
	ПодписчикПослеПулаВызван = Истина;
КонецПроцедуры

// Освобождение ресурсов завершившегося потока исполнения ошибку наружу не выпускает. Подписчиков
// у завершения потока столько, сколько пулов и источников его застали, и движок обходит их одним
// циклом, не перехватывая ошибки обработчиков: выпусти этот обработчик исключение - и до
// подписавшихся позже очередь не дойдет.
//
&Тест
Процедура ОшибкаОсвобожденияНеОбрываетОстальныхПодписчиковЗавершенияПотока() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПадатьПриЗавершенииТранзакции = Истина;
	НастройкиКоннектора.ПадатьПриЗакрытии = Истина;

	ПоддельныеПотоки = Мок.Получить(Тип("ПотокиИсполнения"));
	ОборвавшийсяПоток = Мок.Получить(Тип("ПотокИсполнения"));

	ПулПадающий = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1000,
		10,
		ПоддельныеПотоки
	);

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ОборвавшийсяПоток);

	// Незавершенная транзакция делает соединение непригодным при возврате, а его закрытие падает:
	// освобождение ресурсов потока исполнения натыкается на ошибку.
	ПулПадающий.Занять().НачатьТранзакцию();

	ПодписчикПослеПулаВызван = Ложь;
	ДобавитьОбработчик ОборвавшийсяПоток.ПриЗавершении, ОтметитьВызовПодписчикаПослеПула;

	ОборвавшийсяПоток.ВызватьСобытие("ПриЗавершении", Новый Массив);

	Ожидаем
		.Что(ПодписчикПослеПулаВызван, "Подписчик, вставший в очередь после пула, дождался вызова")
		.ЭтоИстина();

КонецПроцедуры

// Ошибка при закрытии соединения не должна делать источник закрытым: иначе повторный вызов
// ничего не сделает, и оставшиеся соединения некому закрыть.
//
&Тест
Процедура ОшибкаЗакрытияНеДелаетИсточникЗакрытым() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПланЗакрытий = Новый ПланЗакрытийКоннектора(1, 1);

	ИсточникПадающий = Новый ИсточникДанных(
		"Падающий при закрытии",
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1
	);
	ПулПадающий = ИсточникПадающий.ПулСоединений();
	ПулПадающий.Занять();
	ПулПадающий.Освободить();

	Ожидаем
		.Что(ИсточникПадающий, "Закрытие завершилось ошибкой коннектора")
		.Метод("Закрыть")
		.ВыбрасываетИсключение("Закрытие соединения не удалось");

	Ожидаем.Что(ИсточникПадающий.Закрыт(), "Источник не считается закрытым после ошибки").ЭтоЛожь();

	// Соединение, на котором споткнулось закрытие, осталось в пуле: повтор закрывает его же, и на
	// этот раз удачно - по плану падает только первое закрытие.
	ИсточникПадающий.Закрыть();

	Ожидаем.Что(ИсточникПадающий.Закрыт(), "Повторное закрытие доводит дело до конца").ЭтоИстина();

КонецПроцедуры

// Закрытие, упавшее на одном соединении, не должно оставить за потоками уже закрытые соединения:
// иначе поток получит из пула закрытое соединение и упадет на уровне драйвера, а не на понятной
// ошибке о закрытом пуле.
//
// Потоки исполнения подставлены поддельные, поэтому тест однопоточный: проверяется привязка
// "поток - соединение", а не конкуренция потоков.
//
&Тест
Процедура НеудачноеЗакрытиеНеОставляетЗакрытыеСоединенияЗаПотоками() Экспорт

	ПоддельныеПотоки = Мок.Получить(Тип("ПотокиИсполнения"));
	ПервыйПоток = Мок.Получить(Тип("ПотокИсполнения"));
	ВторойПоток = Мок.Получить(Тип("ПотокИсполнения"));

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПланЗакрытий = Новый ПланЗакрытийКоннектора(2, 1);

	ПулПадающий = Новый ПулСоединенийСБД(
		2,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1000,
		10,
		ПоддельныеПотоки
	);

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ПервыйПоток);
	ПулПадающий.Занять();

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ВторойПоток);
	ПулПадающий.Занять();

	// Второе по счету закрытие падает: пул закрытым не считается, закрытие можно повторить.
	ОшибкаЗакрытия = "";
	Попытка
		ПулПадающий.Закрыть();
	Исключение
		ОшибкаЗакрытия = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем
		.Что(ОшибкаЗакрытия, "Закрытие споткнулось на втором соединении")
		.Содержит("Закрытие соединения не удалось");

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ПервыйПоток);
	Ожидаем
		.Что(ПулПадающий.Занять().ПолучитьКоннектор().Открыт(), "Первому потоку досталось живое соединение")
		.ЭтоИстина();

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ВторойПоток);
	Ожидаем
		.Что(ПулПадающий.Занять().ПолучитьКоннектор().Открыт(), "Второму потоку досталось живое соединение")
		.ЭтоИстина();

	ПулПадающий.Закрыть();

КонецПроцедуры

// Свободное соединение, на котором закрытие споткнулось, из очереди свободных не выбывает: иначе
// повтор закрытия его уже не найдет, отчитается об успехе, а соединение с БД останется открытым,
// и закрыть его будет некому. Занятые ведут себя так же - соединение остается за своим потоком.
//
// Потоки исполнения подставлены поддельные: два свободных соединения в одном потоке не получить,
// а проверяется здесь очередь свободных, а не конкуренция потоков.
//
&Тест
Процедура НеудачноеЗакрытиеНеТеряетСвободноеСоединение() Экспорт

	ПулПадающий = ПулСДвумяСвободнымиСоединениями(2);

	Ожидаем
		.Что(ПулПадающий, "Закрытие споткнулось на втором свободном соединении")
		.Метод("Закрыть")
		.ВыбрасываетИсключение("Закрытие соединения не удалось");

	Ожидаем
		.Что(ПулПадающий.КоличествоСвободных(), "Соединение, на котором упало закрытие, осталось в пуле")
		.Равно(1);

	ПулПадающий.Закрыть();

КонецПроцедуры

// Место закрытого соединения возвращается пулу сразу, как соединение закрыто: счетчик занятых
// мест считает живые соединения, а не когда-то открытые. Иначе после неудачного закрытия пул
// остается с местами, занятыми уже закрытыми соединениями, и следующий захват ждет впустую:
// вернуть соединение некому.
//
&Тест
Процедура НеудачноеЗакрытиеОсвобождаетМестоЗакрытогоСоединения() Экспорт

	ПулПадающий = ПулСДвумяСвободнымиСоединениями(2);

	// Первое соединение закрывается, на втором закрытие падает - что оно падает, проверяет соседний
	// тест, здесь это лишь способ остановить закрытие на полпути.
	Ожидаем.Что(ПулПадающий).Метод("Закрыть").ВыбрасываетИсключение("Закрытие соединения не удалось");

	Ожидаем
		.Что(ПулПадающий.КоличествоСозданных(), "Место закрытого соединения освобождено")
		.Равно(1);

	ПулПадающий.Закрыть();

КонецПроцедуры

// Закрытие пула терминально. Иначе ожидающий, проснувшийся после закрытия, молча открыл бы
// себе новое соединение, которое пережило бы закрытие пула.
//
&Тест
Процедура ЗакрытыйПулБольшеНеВыдаетСоединений() Экспорт

	ПулЗакрываемый = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив);
	ПулЗакрываемый.Закрыть();

	Ожидаем
		.Что(ПулЗакрываемый, "Закрытый пул отказывает в захвате")
		.Метод("Занять")
		.ВыбрасываетИсключение("Пул соединений закрыт");

КонецПроцедуры

// Соединение, назначенное заявке, остается видимым пулу, пока ожидающий его не забрал.
//
// Между назначением и получением есть окно: ожидающий проверяет свою заявку не непрерывно, а
// раз в паузу ожидания. Если в этом окне заявка выпадет из очереди, соединение не будет лежать
// нигде из того, что пул обходит, - ни за потоком, ни в свободных, ни в очереди, - и ни
// закрытие пула, ни разбор брошенных заявок его не найдут. Пауза ожидания здесь намеренно
// большая: она и есть то самое окно, растянутое до наблюдаемого.
//
&Тест
Процедура НазначенноеЗаявкеСоединениеОстаетсяВОчереди() Экспорт

	ПулСОжиданием = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив, 30000, 5000);

	// Единственное соединение занято, поэтому фоновое задание встанет в очередь.
	ПулСОжиданием.Занять();

	Попытка
		ПроверитьВидимостьСоединенияВЗаявке();
	Исключение
		ПулСОжиданием.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСОжиданием.Закрыть();

КонецПроцедуры

// Освобождает соединение при ожидающем в очереди и проверяет, что заявка из очереди не пропала.
//
Процедура ПроверитьВидимостьСоединенияВЗаявке()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИзПулаСОжиданиемВФоне", Новый Массив, Истина);

	ДождатьсяОжидающего();

	// Освобожденное соединение уходит голове очереди, то есть заявке фонового задания. Забрать
	// его задание сможет только через паузу ожидания - до тех пор заявка обязана быть в очереди.
	ПулСОжиданием.Освободить();

	Ожидаем
		.Что(ПулСОжиданием.КоличествоОжидающих(), "Заявка с назначенным соединением осталась в очереди")
		.Равно(1);

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке, "Задание дождалось соединения по заявке")
		.Равно(Неопределено);

КонецПроцедуры

// Соединение, назначенное заявке, при ошибке закрытия из очереди ожидающих не выбывает - как не
// выбывают свободное и занятое. Иначе повтор закрытия прошел бы мимо него, а соединение с БД
// осталось бы открытым.
//
&Тест
Процедура НеудачноеЗакрытиеНеТеряетСоединениеЗаявки() Экспорт

	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПланЗакрытий = Новый ПланЗакрытийКоннектора(1, 1);

	ПулСОжиданием = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		30000,
		5000
	);

	// Единственное соединение занято, поэтому фоновое задание встанет в очередь.
	ПулСОжиданием.Занять();

	Попытка
		ПроверитьСохранностьСоединенияЗаявки();
	Исключение
		ПулСОжиданием.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Отдает соединение заявке фонового задания и закрывает пул, пока задание спит между проверками
// своей заявки.
//
Процедура ПроверитьСохранностьСоединенияЗаявки()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИзПулаСОжиданиемВФоне", Новый Массив, Истина);

	ДождатьсяОжидающего();

	// Освобожденное соединение уходит заявке задания и до его пробуждения лежит только в очереди
	// ожидающих: там его и находит закрытие пула.
	ПулСОжиданием.Освободить();

	Ожидаем
		.Что(ПулСОжиданием, "Закрытие споткнулось на соединении заявки")
		.Метод("Закрыть")
		.ВыбрасываетИсключение("Закрытие соединения не удалось");

	Ожидаем
		.Что(ПулСОжиданием.КоличествоОжидающих(), "Заявка с незакрытым соединением осталась в очереди")
		.Равно(1);

	// По плану падает только первое закрытие: повтор закрывает то же соединение и доводит дело
	// до конца.
	ПулСОжиданием.Закрыть();

	ДождатьсяЗадания(Задание);

КонецПроцедуры

// Ждет, пока фоновое задание встанет в очередь ожидающих.
//
Процедура ДождатьсяОжидающего()

	Попыток = 0;
	Пока ПулСОжиданием.КоличествоОжидающих() = 0 Цикл

		Попыток = Попыток + 1;
		Если Попыток > 300 Тогда
			ВызватьИсключение "Фоновое задание не встало в очередь за 30 секунд";
		КонецЕсли;

		Приостановить(100);

	КонецЦикла;

КонецПроцедуры

// Ожидание в очереди ограничено по времени. Иначе поток, чье соединение не освободили из-за
// пропущенного `Освободить()`, ждал бы вечно: разбор завершенных потоков отбирает соединения
// только у мертвых, а этот поток жив.
//
&Тест
Процедура ОжиданиеСоединенияОграниченоПоВремени() Экспорт

	ПулСОжиданием = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив, 500);

	// Единственное соединение занято и намеренно не освобождается.
	ПулСОжиданием.Занять();

	Попытка
		ПроверитьОтказПоИстеченииОжидания();
	Исключение
		ПулСОжиданием.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСОжиданием.Закрыть();

КонецПроцедуры

// Фоновое задание, не дождавшееся соединения, завершается понятной ошибкой, а не висит.
//
Процедура ПроверитьОтказПоИстеченииОжидания()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИзПулаСОжиданиемВФоне", Новый Массив, Истина);

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Ожидание прервано ошибкой, а не зависло")
		.ЭтоИстина();

	ТекстОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);

	Ожидаем
		.Что(Найти(ТекстОшибки, "не дождался") > 0, "Ошибка объясняет причину: " + ТекстОшибки)
		.ЭтоИстина();

КонецПроцедуры

// Пытается занять соединение пула, все места которого заняты. Запускается в фоновом задании.
//
Процедура ЗанятьИзПулаСОжиданиемВФоне() Экспорт
	ПулСОжиданием.Занять();
КонецПроцедуры

// Пул на два соединения, оба занятые и сразу освобожденные: обе штуки лежат в очереди свободных.
//
// Потоки исполнения поддельные: захват реентерабельный, и в одном потоке второго соединения
// не получить. Предел ожидания короткий, чтобы тест не стоял на нем полминуты.
//
// Параметры:
//   НомерПадающегоЗакрытия - Число - Номер закрытия, начиная с которого коннектор падает.
//
// Возвращаемое значение:
//   ПулСоединенийСБД - Пул с двумя свободными соединениями.
//
Функция ПулСДвумяСвободнымиСоединениями(Знач НомерПадающегоЗакрытия)

	ПоддельныеПотоки = Мок.Получить(Тип("ПотокиИсполнения"));
	// Падает одно закрытие: тест закрывает пул в конце, и вечно падающий коннектор ему бы этого
	// не дал.
	НастройкиКоннектора = Новый НастройкиТестовогоКоннектора;
	НастройкиКоннектора.ПланЗакрытий = Новый ПланЗакрытийКоннектора(НомерПадающегоЗакрытия, 1);

	ПулДвухСоединений = Новый ПулСоединенийСБД(
		2,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		НастройкиКоннектора.ПараметрыКоннектора(),
		1000,
		10,
		ПоддельныеПотоки
	);

	ПервыйПоток = Мок.Получить(Тип("ПотокИсполнения"));
	ВторойПоток = Мок.Получить(Тип("ПотокИсполнения"));

	// Соединения занимаются оба сразу: освободи первый поток свое до захвата второго, второй взял
	// бы то же самое из свободных, и второго соединения в пуле не появилось бы.
	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ПервыйПоток);
	ПулДвухСоединений.Занять();

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ВторойПоток);
	ПулДвухСоединений.Занять();
	ПулДвухСоединений.Освободить();

	ПоддельныеПотоки.Когда().Текущий().ТогдаВозвращает(ПервыйПоток);
	ПулДвухСоединений.Освободить();

	Возврат ПулДвухСоединений;

КонецФункции

// Параметры вызова ЗафиксироватьТранзакциюПотокаИсполнения.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, которому принадлежит соединение.
//
// Возвращаемое значение:
//   Массив - Параметры метода.
//
Функция ПараметрыЗавершенияТранзакции(Источник)

	Параметры = Новый Массив;
	Параметры.Добавить(Источник);

	Возврат Параметры;

КонецФункции
