// Пул выдает соединение контексту исполнения и хранит эту привязку, пока контекст не освободит
// соединение. Здесь проверяется механика выдачи и возврата в пределах одного контекста;
// независимость транзакций разных контекстов проверяется в МногопоточностьФоновыеЗадания.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Пул, который тесты создают заново перед каждым тестом.
Перем Пул;
// Пул с пределом в одно соединение для проверки ожидания. Виден фоновому заданию.
Перем ПулСПределом;
// Пул на коннекторе с медленным открытием. Виден фоновому заданию.
Перем ПулМедленный;
// Пул с коротким пределом ожидания в очереди. Виден фоновому заданию.
Перем ПулСОжиданием;
// Тип коннектора БД, доступной в текущем окружении.
Перем ТипКоннектораТестовойБазы;
// Строка соединения с БД, доступной в текущем окружении.
Перем СтрокаСоединенияТестовойБазы;
// Признак того, что таблицы тестовой БД переживают перезапуск и их нужно сбрасывать.
Перем СбрасыватьТаблицы;
// Соединение, удерживающее базу SQLite в памяти живой. Не задано для PostgreSQL.
Перем ДержательБазыВПамяти;
// Число - Сколько раз проверочное обращение к списку заданий еще должно сорваться.
Перем СрывовОсталось;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	// КоннекторInMemory не требует внешней БД, а механике выдачи соединений все равно, какой коннектор внутри.
	Пул = Новый ПулСоединенийСБД(2, Тип("КоннекторInMemory"), "", Новый Массив);

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "КоннекторУправляемоеОткрытие.os"),
		"КоннекторУправляемоеОткрытие"
	);

	ОпределитьТестовуюБазу();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт

	Пул.Закрыть();
	Пул = Неопределено;

	Если ДержательБазыВПамяти <> Неопределено Тогда
		ДержательБазыВПамяти.Закрыть();
		ДержательБазыВПамяти = Неопределено;
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура НовыйПулНеДержитСоединений() Экспорт

	Ожидаем.Что(Пул.КоличествоЗанятых(), "В новом пуле нет занятых соединений").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "В новом пуле нет свободных соединений").Равно(0);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоКонтекста(), "За текущим контекстом ничего не закреплено")
		.ЭтоЛожь();

КонецПроцедуры

// Пока контекст не освободил соединение, он получает то же самое - иначе начатая им транзакция
// была бы не видна его же последующим операциям.
//
&Тест
Процедура КонтекстПолучаетОдноИТоЖеСоединение() Экспорт

	Первое = Пул.Занять();
	Второе = Пул.Занять();

	Ожидаем.Что(Второе = Первое, "Контексту выдано то же соединение").ЭтоИстина();
	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занято одно соединение").Равно(1);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных соединений нет").Равно(0);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоКонтекста(), "За текущим контекстом закреплено соединение")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОсвобожденноеСоединениеСтановитсяСвободным() Экспорт

	Пул.Занять();
	Пул.Освободить();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых соединений не осталось").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Соединение вернулось в очередь свободных").Равно(1);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоКонтекста(), "За текущим контекстом ничего не закреплено")
		.ЭтоЛожь();

КонецПроцедуры

// Освобожденное соединение не закрывается, а переиспользуется: иначе пул не имел бы смысла.
//
&Тест
Процедура СвободноеСоединениеВыдаетсяПовторно() Экспорт

	Первое = Пул.Занять();
	Пул.Освободить();
	Второе = Пул.Занять();

	Ожидаем.Что(Второе = Первое, "Из очереди выдано то же соединение").ЭтоИстина();
	Ожидаем.Что(Пул.КоличествоСвободных(), "Очередь свободных опустела").Равно(0);
	Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение снова закреплено за контекстом").Равно(1);

КонецПроцедуры

&Тест
Процедура ОсвобождениеБезЗахватаНичегоНеМеняет() Экспорт

	Пул.Освободить();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых соединений нет").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных соединений нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗакрытиеОсвобождаетИЗанятыеИСвободные() Экспорт

	Пул.Занять();
	Пул.Освободить();
	Пул.Занять();

	Пул.Закрыть();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятые соединения закрыты").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободные соединения закрыты").Равно(0);

КонецПроцедуры

// Ключ контекста вне фонового задания постоянен, и такой контекст всегда считается работающим:
// иначе пул отобрал бы у основного потока его же соединение.
//
&Тест
Процедура КонтекстВнеФоновогоЗаданияСчитаетсяРаботающим() Экспорт

	Ключ = КонтекстИсполнения.Ключ();

	Ожидаем.Что(КонтекстИсполнения.Ключ(), "Ключ контекста не меняется от вызова к вызову").Равно(Ключ);
	Ожидаем.Что(КонтекстИсполнения.Работает(Ключ), "Контекст вне фонового задания работает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестныйКонтекстНеСчитаетсяРаботающим() Экспорт

	Ожидаем
		.Что(КонтекстИсполнения.Работает(Строка(Новый УникальныйИдентификатор)), "Такого задания нет")
		.ЭтоЛожь();

КонецПроцедуры

// Завершенное фоновое задание работающим не считается - на этом держится возврат соединений,
// которые задание не освободило само.
//
&Тест
Процедура ЗавершенноеФоновоеЗаданиеНеСчитаетсяРаботающим() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПустаяРаботаВФоне", Новый Массив, Истина);
	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(КонтекстИсполнения.Работает(Строка(Задание.УникальныйИдентификатор)), "Задание уже завершено")
		.ЭтоЛожь();

КонецПроцедуры

// Тело фонового задания для проверки определения завершенного контекста.
//
Процедура ПустаяРаботаВФоне() Экспорт
	// Заданию достаточно завершиться.
КонецПроцедуры

// При нулевом размере пул не переиспользует соединения: каждая транзакция открывает свое.
// Собственное соединение контекст получает и в этом режиме - потокобезопасность не отключается.
//
&Тест
Процедура НулевойРазмерОтключаетПереиспользование() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектораТестовойБазы, СтрокаСоединенияТестовойБазы, Неопределено, 0);

	Попытка
		ОчиститьТестовуюБазу(Менеджер);
		ПроверитьРаботуБезПереиспользования(Менеджер);
	Исключение
		Менеджер.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Менеджер.Закрыть();

КонецПроцедуры

// Проверяет транзакции менеджера, чей пул не переиспользует соединения.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, созданный с нулевым размером пула.
//
Процедура ПроверитьРаботуБезПереиспользования(Менеджер)

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);

	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Менеджер.НачатьТранзакцию();

	Ожидаем
		.Что(Менеджер.ПолучитьПулСоединений().СоединениеТекущегоКонтекста() <> Неопределено,
			"Контекст получил соединение и при нулевом размере")
		.ЭтоИстина();

	Менеджер.Сохранить(НовыйАвтор("Отмененный"));
	Менеджер.ОтменитьТранзакцию();

	Ожидаем
		.Что(ТестовыеУтилиты.ВыполнитьЗапрос(Менеджер, "SELECT * FROM Авторы"), "Откат сработал")
		.ИмеетДлину(0);

	Менеджер.НачатьТранзакцию();
	Менеджер.Сохранить(НовыйАвтор("Сохраненный"));
	Менеджер.ЗафиксироватьТранзакцию();

	Ожидаем
		.Что(ТестовыеУтилиты.ВыполнитьЗапрос(Менеджер, "SELECT * FROM Авторы"), "Фиксация сработала")
		.ИмеетДлину(1);

КонецПроцедуры

// Создает автора с указанным именем.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
// Возвращаемое значение:
//   Произвольный - Новый автор.
//
Функция НовыйАвтор(Знач Имя)

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	Возврат Автор;

КонецФункции

// Определяет коннектор и строку соединения с БД, доступной в текущем окружении.
//
// Отключенный пул проверяется на настоящей транзакции, поэтому КоннекторInMemory здесь не годится:
// транзакций он не поддерживает.
//
Процедура ОпределитьТестовуюБазу()

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединенияТестовойБазы = "FullUri=file::memory:?cache=shared";
		ТипКоннектораТестовойБазы = Тип("КоннекторSQLite");
		СбрасыватьТаблицы = Ложь;

		// База в памяти живет, пока открыто хотя бы одно соединение к ней. При нулевом размере
		// пула таких моментов нет: соединение закрывается сразу после операции. Держим свое,
		// мимо пула, иначе база исчезала бы между операциями вместе с таблицами.
		ДержательБазыВПамяти = Новый КоннекторSQLite;
		ДержательБазыВПамяти.Открыть(СтрокаСоединенияТестовойБазы, Новый Массив);
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединенияТестовойБазы = СтрокаСоединенияPostgres();
		ТипКоннектораТестовойБазы = Тип("КоннекторPostgreSQL");
		СбрасыватьТаблицы = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования менеджера без пула";
	КонецЕсли;

КонецПроцедуры

// Сбрасывает таблицы тестовой БД, если они переживают перезапуск.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, коннектором которого выполняется сброс.
//
Процедура ОчиститьТестовуюБазу(Менеджер)

	Если НЕ СбрасыватьТаблицы Тогда
		Возврат;
	КонецЕсли;

	ТестовыеУтилиты.СброситьТаблицы(Менеджер);

КонецПроцедуры

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции

// Когда предел пула исчерпан, следующий контекст ждет, пока соединение освободит другой.
//
&Тест
Процедура ПриИсчерпанномПределеКонтекстЖдет() Экспорт

	ПулСПределом = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка
		ПроверитьОжиданиеНаПределе();
	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Нулевой размер предела не ставит: соединение получают все, сколько бы их ни просило.
//
&Тест
Процедура ПриНулевомРазмереНиктоНеЖдет() Экспорт

	ПулСПределом = Новый ПулСоединенийСБД(0, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка

		ПулСПределом.Занять();

		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОсвободитьВФоне", Новый Массив, Истина);
		ДождатьсяЗадания(Задание);

		Ожидаем.Что(Задание.ИнформацияОбОшибке, "Фоновое задание получило соединение").Равно(Неопределено);
		Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Ждать никому не пришлось").Равно(0);

		ПулСПределом.Освободить();

	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Проверяет, что фоновое задание встает в очередь, пока единственное соединение занято,
// и получает его сразу после освобождения.
//
Процедура ПроверитьОжиданиеНаПределе()

	ПулСПределом.Занять();

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОсвободитьВФоне", Новый Массив, Истина);

	Приостановить(300);

	Ожидаем
		.Что(Задание.Состояние = СостояниеФоновогоЗадания.Активно, "Задание ждет: единственное соединение занято")
		.ЭтоИстина();
	Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Задание встало в очередь").Равно(1);

	ПулСПределом.Освободить();
	ДождатьсяЗадания(Задание);

	Ожидаем.Что(Задание.ИнформацияОбОшибке, "Задание дождалось соединения").Равно(Неопределено);
	Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Очередь ожидающих опустела").Равно(0);

КонецПроцедуры

// Занимает и освобождает соединение проверяемого пула. Запускается в фоновом задании.
//
Процедура ЗанятьИОсвободитьВФоне() Экспорт
	ПулСПределом.Занять();
	ПулСПределом.Освободить();
КонецПроцедуры

// Дожидается завершения фонового задания за отведенное время.
//
// Без ограничения зависший пул подвесил бы весь прогон, и причину пришлось бы искать по таймауту
// сборки вместо понятного падения теста.
//
// Параметры:
//   Задание - ФоновоеЗадание - Задание, завершения которого ждем.
//
Процедура ДождатьсяЗадания(Задание)

	Если НЕ Задание.ОжидатьЗавершения(30000) Тогда
		ВызватьИсключение "Фоновое задание не завершилось за 30 секунд";
	КонецЕсли;

КонецПроцедуры

// Задание оборвалось, не освободив соединение. При исчерпанном пределе пул отбирает его у
// завершившегося контекста - иначе соединение было бы потеряно навсегда.
//
&Тест
Процедура СоединениеОборвавшегосяЗаданияВозвращаетсяВПул() Экспорт

	ПулСПределом = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка
		ПроверитьВозвратПослеОбрыва();
	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Ошибка при открытии соединения не должна оставлять блокировку пула захваченной.
//
&Тест
Процедура ОшибкаЗахватаНеОставляетПулЗаблокированным() Экспорт

	// Массив коннектором не является: открытие соединения свалится внутри захвата.
	ПулСОшибкой = Новый ПулСоединенийСБД(1, Тип("Массив"), "", Новый Массив);

	Ожидаем
		.Что(ПулСОшибкой, "Захват завершился ошибкой")
		.Метод("Занять")
		.ВыбрасываетИсключение();

	// Если бы блокировка осталась захваченной, этот вызов не вернулся бы.
	Ожидаем.Что(ПулСОшибкой.КоличествоЗанятых(), "Блокировка освобождена, состояние читается").Равно(0);

КонецПроцедуры

// Проверяет, что соединение оборвавшегося задания достается следующему контексту.
//
Процедура ПроверитьВозвратПослеОбрыва()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОборватьсяВФоне", Новый Массив, Истина);
	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Задание оборвалось, не освободив соединение")
		.ЭтоИстина();
	Ожидаем
		.Что(ПулСПределом.КоличествоЗанятых(), "Соединение осталось закрепленным за мертвым контекстом")
		.Равно(1);

	// Предел в одно соединение исчерпан, свободных нет: пул обязан отобрать брошенное.
	ПулСПределом.Занять();

	Ожидаем.Что(ПулСПределом.КоличествоЗанятых(), "Соединение выдано текущему контексту").Равно(1);
	Ожидаем.Что(ПулСПределом.КоличествоСвободных(), "Свободных не осталось").Равно(0);

	ПулСПределом.Освободить();

КонецПроцедуры

// Занимает соединение и обрывается, не освободив его. Запускается в фоновом задании.
//
Процедура ЗанятьИОборватьсяВФоне() Экспорт
	ПулСПределом.Занять();
	ВызватьИсключение "Обрыв задания с занятым соединением";
КонецПроцедуры

// При нулевом размере освобожденное соединение закрывается, а не встает в очередь: следующий
// захват открывает новое.
//
&Тест
Процедура ПриНулевомРазмереСоединениеНеПереиспользуется() Экспорт

	ПулБезПредела = Новый ПулСоединенийСБД(0, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка

		Первое = ПулБезПредела.Занять();
		ПулБезПредела.Освободить();

		Ожидаем.Что(ПулБезПредела.КоличествоСвободных(), "Освобожденное соединение закрыто").Равно(0);

		Второе = ПулБезПредела.Занять();

		Ожидаем.Что(Второе = Первое, "Выдано новое соединение, а не прежнее").ЭтоЛожь();

		ПулБезПредела.Освободить();

	Исключение
		ПулБезПредела.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулБезПредела.Закрыть();

КонецПроцедуры

// Обращение к списку фоновых заданий срывается, если список в этот момент меняет другой поток.
// Библиотека переживает это повтором.
//
&Тест
Процедура ОбращениеКСпискуЗаданийПовторяетсяПослеСрыва() Экспорт

	СрывовОсталось = 3;

	Результат = КонтекстИсполнения.ВыполнитьСПовтором(Новый Действие(ЭтотОбъект, "СорватьсяЗаданноеЧислоРаз"));

	Ожидаем.Что(Результат, "Обращение удалось после повторов").Равно("получилось");
	Ожидаем.Что(СрывовОсталось, "Сорвалось ровно столько раз, сколько задано").Равно(0);

КонецПроцедуры

// Когда повторы исчерпаны, ошибка выходит наружу, а не глотается.
//
&Тест
Процедура ИсчерпаниеПовторовВыбрасываетОшибку() Экспорт

	СрывовОсталось = 1000000;

	Ожидаем
		.Что(КонтекстИсполнения, "Ошибка вышла наружу после исчерпания повторов")
		.Метод("ВыполнитьСПовтором", ПараметрыОбращенияСрыв())
		.ВыбрасываетИсключение();

КонецПроцедуры

// Обращение, которое срывается заданное число раз, а потом отрабатывает.
//
// Возвращаемое значение:
//   Строка - Признак успешного обращения.
//
Функция СорватьсяЗаданноеЧислоРаз() Экспорт

	Если СрывовОсталось > 0 Тогда
		СрывовОсталось = СрывовОсталось - 1;
		ВызватьИсключение "Collection was modified; enumeration operation may not execute.";
	КонецЕсли;

	Возврат "получилось";

КонецФункции

// Параметры вызова ВыполнитьСПовтором с обращением, которое срывается всегда.
//
// Возвращаемое значение:
//   Массив - Параметры метода.
//
Функция ПараметрыОбращенияСрыв()

	Параметры = Новый Массив;
	Параметры.Добавить(Новый Действие(ЭтотОбъект, "СорватьсяЗаданноеЧислоРаз"));

	Возврат Параметры;

КонецФункции

// Открытие соединения - сетевой вызов, и держать на нем блокировку пула нельзя: иначе
// недоступная база морозит всех, включая тех, кто хочет вернуть исправное соединение.
//
&Тест
Процедура ОткрытиеСоединенияНеДержитБлокировкуПула() Экспорт

	ПулМедленный = Новый ПулСоединенийСБД(
		2,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		ПараметрыТестовогоКоннектора(3000, Ложь)
	);

	Попытка
		ПроверитьЧтоПулОтвечаетВоВремяОткрытия();
	Исключение
		ПулМедленный.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулМедленный.Закрыть();

КонецПроцедуры

// Пока фоновое задание открывает соединение, пул отвечает на обращения без задержки.
//
Процедура ПроверитьЧтоПулОтвечаетВоВремяОткрытия()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьМедленноеВФоне", Новый Массив, Истина);

	// Дать заданию дойти до открытия: до него оно успевает только взять бронь под блокировкой.
	Приостановить(500);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПулМедленный.КоличествоЗанятых();
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем
		.Что(Длительность < 1000, "Пул ответил, не дожидаясь конца открытия: " + Длительность + " мс")
		.ЭтоИстина();

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке, "Задание открыло соединение без ошибок")
		.Равно(Неопределено);

КонецПроцедуры

// Занимает и освобождает соединение медленного пула. Запускается в фоновом задании.
//
Процедура ЗанятьМедленноеВФоне() Экспорт
	ПулМедленный.Занять();
	ПулМедленный.Освободить();
КонецПроцедуры

// Ждет, пока фоновое задание займет место в пуле и уйдет открывать соединение.
//
// Ждать по счетчику, а не паузой: на загруженном раннере фоновое задание может стартовать
// не сразу, и тест успел бы закрыть пул раньше, чем задание до него добралось.
//
Процедура ДождатьсяБрони()

	Попыток = 0;
	Пока ПулМедленный.КоличествоСозданных() = 0 Цикл

		Попыток = Попыток + 1;
		Если Попыток > 300 Тогда
			ВызватьИсключение "Фоновое задание не заняло место в пуле за 30 секунд";
		КонецЕсли;

		Приостановить(100);

	КонецЦикла;

КонецПроцедуры

// Пул, закрытый посреди открытия, не оставляет открывшееся соединение живым и не считает
// занятым место под него.
//
&Тест
Процедура ЗакрытиеВоВремяОткрытияНеОставляетСоединения() Экспорт

	ПулМедленный = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		ПараметрыТестовогоКоннектора(3000, Ложь)
	);

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьМедленноеВФоне", Новый Массив, Истина);

	ДождатьсяБрони();
	ПулМедленный.Закрыть();

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Открывавший контекст узнал о закрытии пула")
		.ЭтоИстина();
	Ожидаем.Что(ПулМедленный.КоличествоЗанятых(), "Занятых соединений не осталось").Равно(0);
	Ожидаем.Что(ПулМедленный.КоличествоСвободных(), "Свободных соединений не осталось").Равно(0);
	Ожидаем.Что(ПулМедленный.КоличествоСозданных(), "Место под соединение вернулось в пул").Равно(0);

КонецПроцедуры

// Неудачное открытие не съедает место в пуле: иначе после нескольких ошибок пул считал бы себя
// полным и отправлял бы всех в очередь ожидания, из которой при исчерпанном пределе не выйти.
//
&Тест
Процедура НеудачноеОткрытиеВозвращаетМестоВПул() Экспорт

	ПулПадающий = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		ПараметрыТестовогоКоннектора(0, Истина)
	);

	Попытка

		Ожидаем
			.Что(ПулПадающий, "Захват завершился ошибкой открытия")
			.Метод("Занять")
			.ВыбрасываетИсключение();

		Ожидаем.Что(ПулПадающий.КоличествоСозданных(), "Место в пуле свободно").Равно(0);
		Ожидаем.Что(ПулПадающий.КоличествоЗанятых(), "Занятых соединений нет").Равно(0);

	Исключение
		ПулПадающий.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулПадающий.Закрыть();

КонецПроцедуры

// Соединение, на котором не удалось завершить транзакцию, непригодно к переиспользованию:
// в каком состоянии осталась транзакция, неизвестно. Такое соединение пул закрывает и
// освобождает его место, а не оставляет за контекстом.
//
&Тест
Процедура ОшибкаЗавершенияТранзакцииНеОставляетСоединениеЗаКонтекстом() Экспорт

	ПулПадающий = Новый ПулСоединенийСБД(
		1,
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		ПараметрыТестовогоКоннектора(0, Ложь, Истина)
	);

	Попытка

		РаботаСКоннекторами.НачатьТранзакциюКонтекста(ПулПадающий);

		Ожидаем
			.Что(РаботаСКоннекторами, "Фиксация завершилась ошибкой коннектора")
			.Метод("ЗафиксироватьТранзакциюКонтекста", ПараметрыЗавершенияТранзакции(ПулПадающий))
			.ВыбрасываетИсключение();

		Ожидаем
			.Что(ПулПадающий.КоличествоЗанятых(), "Соединение не осталось закрепленным за контекстом")
			.Равно(0);
		Ожидаем
			.Что(ПулПадающий.КоличествоСвободных(), "Непригодное соединение не встало в очередь свободных")
			.Равно(0);
		Ожидаем
			.Что(ПулПадающий.КоличествоСозданных(), "Место непригодного соединения вернулось в пул")
			.Равно(0);

	Исключение
		ПулПадающий.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулПадающий.Закрыть();

КонецПроцедуры

// Закрытие пула терминально. Иначе ожидающий, проснувшийся после закрытия, молча открыл бы
// себе новое соединение, которое пережило бы закрытие пула.
//
&Тест
Процедура ЗакрытыйПулБольшеНеВыдаетСоединений() Экспорт

	ПулЗакрываемый = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив);
	ПулЗакрываемый.Закрыть();

	Ожидаем
		.Что(ПулЗакрываемый, "Закрытый пул отказывает в захвате")
		.Метод("Занять")
		.ВыбрасываетИсключение("Пул соединений закрыт");

КонецПроцедуры

// Соединение, назначенное заявке, остается видимым пулу, пока ожидающий его не забрал.
//
// Между назначением и получением есть окно: ожидающий проверяет свою заявку не непрерывно, а
// раз в паузу ожидания. Если в этом окне заявка выпадет из очереди, соединение не будет лежать
// нигде из того, что пул обходит, - ни за контекстом, ни в свободных, ни в очереди, - и ни
// закрытие пула, ни разбор брошенных заявок его не найдут. Пауза ожидания здесь намеренно
// большая: она и есть то самое окно, растянутое до наблюдаемого.
//
&Тест
Процедура НазначенноеЗаявкеСоединениеОстаетсяВОчереди() Экспорт

	ПулСОжиданием = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив, 30000, 5000);

	// Единственное соединение занято, поэтому фоновое задание встанет в очередь.
	ПулСОжиданием.Занять();

	Попытка
		ПроверитьВидимостьСоединенияВЗаявке();
	Исключение
		ПулСОжиданием.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСОжиданием.Закрыть();

КонецПроцедуры

// Освобождает соединение при ожидающем в очереди и проверяет, что заявка из очереди не пропала.
//
Процедура ПроверитьВидимостьСоединенияВЗаявке()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИзПулаСОжиданиемВФоне", Новый Массив, Истина);

	ДождатьсяОжидающего();

	// Освобожденное соединение уходит голове очереди, то есть заявке фонового задания. Забрать
	// его задание сможет только через паузу ожидания - до тех пор заявка обязана быть в очереди.
	ПулСОжиданием.Освободить();

	Ожидаем
		.Что(ПулСОжиданием.КоличествоОжидающих(), "Заявка с назначенным соединением осталась в очереди")
		.Равно(1);

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке, "Задание дождалось соединения по заявке")
		.Равно(Неопределено);

КонецПроцедуры

// Ждет, пока фоновое задание встанет в очередь ожидающих.
//
Процедура ДождатьсяОжидающего()

	Попыток = 0;
	Пока ПулСОжиданием.КоличествоОжидающих() = 0 Цикл

		Попыток = Попыток + 1;
		Если Попыток > 300 Тогда
			ВызватьИсключение "Фоновое задание не встало в очередь за 30 секунд";
		КонецЕсли;

		Приостановить(100);

	КонецЦикла;

КонецПроцедуры

// Ожидание в очереди ограничено по времени. Иначе контекст, чье соединение не освободили из-за
// пропущенного `Освободить()`, ждал бы вечно: разбор завершенных контекстов отбирает соединения
// только у мертвых, а этот контекст жив.
//
&Тест
Процедура ОжиданиеСоединенияОграниченоПоВремени() Экспорт

	ПулСОжиданием = Новый ПулСоединенийСБД(1, Тип("КоннекторInMemory"), "", Новый Массив, 500);

	// Единственное соединение занято и намеренно не освобождается.
	ПулСОжиданием.Занять();

	Попытка
		ПроверитьОтказПоИстеченииОжидания();
	Исключение
		ПулСОжиданием.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСОжиданием.Закрыть();

КонецПроцедуры

// Фоновое задание, не дождавшееся соединения, завершается понятной ошибкой, а не висит.
//
Процедура ПроверитьОтказПоИстеченииОжидания()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИзПулаСОжиданиемВФоне", Новый Массив, Истина);

	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Ожидание прервано ошибкой, а не зависло")
		.ЭтоИстина();

	ТекстОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);

	Ожидаем
		.Что(Найти(ТекстОшибки, "не дождался") > 0, "Ошибка объясняет причину: " + ТекстОшибки)
		.ЭтоИстина();

КонецПроцедуры

// Пытается занять соединение пула, все места которого заняты. Запускается в фоновом задании.
//
Процедура ЗанятьИзПулаСОжиданиемВФоне() Экспорт
	ПулСОжиданием.Занять();
КонецПроцедуры

// Собирает параметры коннектора для КоннекторУправляемоеОткрытие.
//
// Параметры:
//   ПаузаОткрытия - Число - Пауза внутри открытия в миллисекундах.
//   ПадатьПриОткрытии - Булево - Истина, если открытие должно завершиться ошибкой.
//   ПадатьПриЗавершенииТранзакции - Булево - Истина, если фиксация и отмена должны падать.
//
// Возвращаемое значение:
//   Массив - Параметры коннектора.
//
Функция ПараметрыТестовогоКоннектора(
	Знач ПаузаОткрытия,
	Знач ПадатьПриОткрытии,
	Знач ПадатьПриЗавершенииТранзакции = Ложь
)

	Параметры = Новый Массив;
	Параметры.Добавить(ПаузаОткрытия);
	Параметры.Добавить(ПадатьПриОткрытии);
	Параметры.Добавить(ПадатьПриЗавершенииТранзакции);

	Возврат Параметры;

КонецФункции

// Параметры вызова ЗафиксироватьТранзакциюКонтекста.
//
// Параметры:
//   Пул - ПулСоединений - Пул, которому принадлежит соединение.
//
// Возвращаемое значение:
//   Массив - Параметры метода.
//
Функция ПараметрыЗавершенияТранзакции(Пул)

	Параметры = Новый Массив;
	Параметры.Добавить(Пул);

	Возврат Параметры;

КонецФункции
