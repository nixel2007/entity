// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."

#Использовать asserts

// Проверяемая блокировка. Разделяется с фоновыми заданиями, которые пробуют захватить ее
// от имени другого владельца.
Перем Блокировка;
// Результат попытки захвата, выполненной в фоновом задании.
Перем РезультатПробы;

Процедура ПередЗапускомТеста() Экспорт
	Блокировка = Новый БлокировкаЧтенияЗаписи();
	РезультатПробы = Неопределено;
КонецПроцедуры

&Тест
Процедура ЧтениеЗахватываетсяПовторно() Экспорт

	// Когда
	Блокировка.Чтение().Заблокировать();
	Блокировка.Чтение().Заблокировать();

	// Тогда
	Ожидаем.Что(Блокировка.ГлубинаЗахватаЧтения(), "Учтены оба захвата").Равно(2);
	Ожидаем.Что(Блокировка.ЗахваченоЧтение(), "Чтение захвачено").Равно(Истина);

	Блокировка.Чтение().Разблокировать();
	Ожидаем.Что(Блокировка.ГлубинаЗахватаЧтения(), "После первого освобождения").Равно(1);

	Блокировка.Чтение().Разблокировать();
	Ожидаем.Что(Блокировка.ЗахваченоЧтение(), "Читателей не осталось").Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЗаписьЗахватываетсяПовторно() Экспорт

	// Когда
	Блокировка.Запись().Заблокировать();
	Блокировка.Запись().Заблокировать();

	// Тогда
	Ожидаем.Что(Блокировка.ГлубинаЗахватаЗаписи(), "Учтены оба захвата").Равно(2);

	Блокировка.Запись().Разблокировать();
	Ожидаем.Что(Блокировка.ЗахваченаЗапись(), "Запись занята до полного освобождения").Равно(Истина);

	Блокировка.Запись().Разблокировать();
	Ожидаем.Что(Блокировка.ЗахваченаЗапись(), "Запись свободна").Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ВладелецЗаписиЗахватываетЧтение() Экспорт

	// Дано
	Блокировка.Запись().Заблокировать();

	// Когда
	Блокировка.Чтение().Заблокировать();

	// Тогда
	Ожидаем.Что(Блокировка.ГлубинаЗахватаЧтения(), "Чтение захвачено владельцем записи").Равно(1);

	Блокировка.Чтение().Разблокировать();
	Блокировка.Запись().Разблокировать();

КонецПроцедуры

&Тест
Процедура ПовышениеЧтенияДоЗаписиЗапрещено() Экспорт

	// Дано
	Блокировка.Чтение().Заблокировать();

	// Когда
	ТекстОшибки = "";
	Попытка
		Блокировка.Запись().Заблокировать();
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Блокировка.Чтение().Разблокировать();

	// Тогда
	Ожидаем.Что(СтрНайти(ТекстОшибки, "Повышение блокировки чтения") > 0, "Названа причина").Равно(Истина);

КонецПроцедуры

&Тест
Процедура ЧитателиНеМешаютДругДругу() Экспорт

	// Дано
	Блокировка.Чтение().Заблокировать();

	// Когда
	// Тогда
	Ожидаем.Что(ЧтениеЗахваченоВФоне(), "Второй читатель проходит").Равно(Истина);

	Блокировка.Чтение().Разблокировать();

КонецПроцедуры

&Тест
Процедура ЧитательНеПускаетПисателя() Экспорт

	// Дано
	Блокировка.Чтение().Заблокировать();

	// Когда
	// Тогда
	Ожидаем.Что(ЗаписьЗахваченаВФоне(), "Писатель ждет читателя").Равно(Ложь);

	Блокировка.Чтение().Разблокировать();

	Ожидаем.Что(ЗаписьЗахваченаВФоне(), "Писатель проходит после освобождения").Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПисательНеПускаетЧитателя() Экспорт

	// Дано
	Блокировка.Запись().Заблокировать();

	// Когда
	// Тогда
	Ожидаем.Что(ЧтениеЗахваченоВФоне(), "Читатель ждет писателя").Равно(Ложь);
	Ожидаем.Что(Блокировка.ЗахваченаЗаписьТекущимКонтекстом(), "Запись за текущим контекстом").Равно(Истина);

	Блокировка.Запись().Разблокировать();

	Ожидаем.Что(ЧтениеЗахваченоВФоне(), "Читатель проходит после освобождения").Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПопыткаБезТаймаутаНеЖдет() Экспорт

	// Дано
	Блокировка.Запись().Заблокировать();

	// Когда
	Захвачено = ПопыткаЗахватитьЗаписьВФонеБезОжидания();

	// Тогда
	Ожидаем.Что(Захвачено, "Занятая блокировка не захватывается").Равно(Ложь);

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

&Тест
Процедура ОсвобождениеБезЗахватаВызываетИсключение() Экспорт

	// Когда
	ОшибкаЧтения = "";
	Попытка
		Блокировка.Чтение().Разблокировать();
	Исключение
		ОшибкаЧтения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ОшибкаЗаписи = "";
	Попытка
		Блокировка.Запись().Разблокировать();
	Исключение
		ОшибкаЗаписи = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ОшибкаЧтения, "Освобождение чтения без захвата").Не_().Равно("");
	Ожидаем.Что(ОшибкаЗаписи, "Освобождение записи без захвата").Не_().Равно("");

КонецПроцедуры

// Пытается захватить блокировку записи из фонового задания, ожидая до таймаута.
//
// Возвращаемое значение:
//   Булево - Истина, если захват удался.
//
Функция ЗаписьЗахваченаВФоне()
	Возврат ВыполнитьПробуВФоне("ЗахватитьЗаписьВФоне");
КонецФункции

// Пытается захватить блокировку чтения из фонового задания, ожидая до таймаута.
//
// Возвращаемое значение:
//   Булево - Истина, если захват удался.
//
Функция ЧтениеЗахваченоВФоне()
	Возврат ВыполнитьПробуВФоне("ЗахватитьЧтениеВФоне");
КонецФункции

// Пытается захватить блокировку записи из фонового задания одной попыткой, без ожидания.
//
// Возвращаемое значение:
//   Булево - Истина, если захват удался.
//
Функция ПопыткаЗахватитьЗаписьВФонеБезОжидания()
	Возврат ВыполнитьПробуВФоне("ЗахватитьЗаписьВФонеБезОжидания");
КонецФункции

// Выполняет пробу захвата в фоновом задании: у него другой ключ владельца, поэтому
// реентерабельность не маскирует занятость блокировки.
//
// Параметры:
//   ИмяПроцедуры - Строка - Имя процедуры пробы.
//
// Возвращаемое значение:
//   Булево - Результат попытки захвата.
//
Функция ВыполнитьПробуВФоне(Знач ИмяПроцедуры)

	РезультатПробы = Неопределено;

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяПроцедуры, Новый Массив, Истина);
	Задание.ОжидатьЗавершения();

	Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;

	Возврат РезультатПробы;

КонецФункции

// Проба захвата блокировки записи с ожиданием. Запускается в фоновом задании.
//
Процедура ЗахватитьЗаписьВФоне() Экспорт

	РезультатПробы = Блокировка.Запись().ПопытатьсяЗаблокировать(ТаймаутОжидания());
	Если РезультатПробы Тогда
		Блокировка.Запись().Разблокировать();
	КонецЕсли;

КонецПроцедуры

// Проба захвата блокировки чтения с ожиданием. Запускается в фоновом задании.
//
Процедура ЗахватитьЧтениеВФоне() Экспорт

	РезультатПробы = Блокировка.Чтение().ПопытатьсяЗаблокировать(ТаймаутОжидания());
	Если РезультатПробы Тогда
		Блокировка.Чтение().Разблокировать();
	КонецЕсли;

КонецПроцедуры

// Проба захвата блокировки записи одной попыткой. Запускается в фоновом задании.
//
Процедура ЗахватитьЗаписьВФонеБезОжидания() Экспорт

	РезультатПробы = Блокировка.Запись().ПопытатьсяЗаблокировать();
	Если РезультатПробы Тогда
		Блокировка.Запись().Разблокировать();
	КонецЕсли;

КонецПроцедуры

// Таймаут ожидания захвата. Достаточно велик, чтобы успешный захват не сорвался на медленной
// машине, и достаточно мал, чтобы заведомо занятая блокировка не задерживала тест надолго.
//
// Возвращаемое значение:
//   Число - Таймаут в миллисекундах.
//
Функция ТаймаутОжидания()
	Возврат 500;
КонецФункции
