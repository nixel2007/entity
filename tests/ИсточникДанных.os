// Описание источника данных: параметры менеджера сущностей одним объектом, из которого
// менеджер и создается.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."

&Тест
Процедура ИсточникСоздаетсяСоЗначениямиПоУмолчанию() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"));

	Ожидаем.Что(Источник.Имя()).Равно("Основной");
	Ожидаем.Что(Источник.ТипКоннектора()).Равно(Тип("КоннекторInMemory"));
	Ожидаем.Что(Источник.СтрокаСоединения()).Равно("");
	Ожидаем.Что(Источник.ПараметрыКоннектора()).ИмеетДлину(0);
	Ожидаем.Что(Источник.РазмерПула(), "Размер пула по умолчанию").Равно(10);

КонецПроцедуры

&Тест
Процедура ТипБезИнтерфейсаКоннектораОтвергается() Экспорт

	ТекстОшибки = "";
	Попытка
		Источник = Новый ИсточникДанных("Основной", Тип("ОпцииПоиска")); // BSLLS:UnusedLocalVariable-off
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "Источник отвергает тип без интерфейса коннектора")
		.Содержит("не реализует интерфейс коннектора");

КонецПроцедуры

// Пул создается вместе с источником, поэтому и размер пула проверяется при создании.
&Тест
Процедура НеверныйРазмерПулаОтвергаетсяПриСоздании() Экспорт

	ТекстОшибки = "";
	Попытка
		Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "", , -1); // BSLLS:UnusedLocalVariable-off
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "Источник отвергает отрицательный размер пула")
		.Содержит("Размер пула соединений должен быть неотрицательным числом");

КонецПроцедуры

&Тест
Процедура РазмерПулаЗадаетсяПятымПараметром() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("параметр");

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), "Data Source=:memory:", Параметры, 3);

	Ожидаем.Что(Источник.СтрокаСоединения()).Равно("Data Source=:memory:");
	Ожидаем.Что(Источник.ПараметрыКоннектора()).ИмеетДлину(1);
	Ожидаем.Что(Источник.РазмерПула()).Равно(3);

КонецПроцедуры

&Тест
Процедура ПараметрыДругогоИсточникаПринимаютсяКакЕсть() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("параметр");
	Исходный = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "", Параметры);

	Копия = Новый ИсточникДанных("Копия", Тип("КоннекторInMemory"), "", Исходный.ПараметрыКоннектора());

	Ожидаем.Что(Копия.ПараметрыКоннектора()).ИмеетТип("ФиксированныйМассив");
	Ожидаем.Что(Копия.ПараметрыКоннектора()).ИмеетДлину(1);

КонецПроцедуры

// Менеджер работает коннектором того типа, который задан источником: другого способа узнать,
// чем ходить в базу, у менеджера нет.
&Тест
Процедура МенеджерСоздаетсяИзИсточникаДанных() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "источник");

	МенеджерСущностей = Новый МенеджерСущностей(Источник);

	Ожидаем
		.Что(МенеджерСущностей.ВычислитьСКоннектором("Коннектор -> ТипЗнч(Коннектор)"), "Коннектор источника")
		.Равно(Тип("КоннекторInMemory"));

	МенеджерСущностей.Закрыть();
	Источник.Закрыть();

КонецПроцедуры

// Массив вызывающего кода источнику не принадлежит: источник снимает с него копию, и правка
// после создания параметров источника не меняет.
&Тест
Процедура ПравкаМассиваПослеСозданияПараметровНеМеняет() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("ПроизвольныйПараметр");

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "", Параметры);

	Параметры.Добавить("ЛишнийПараметр");

	Ожидаем.Что(Источник.ПараметрыКоннектора(), "Лишний параметр в источник не попал").ИмеетДлину(1);
	Ожидаем.Что(Источник.ПараметрыКоннектора()[0]).Равно("ПроизвольныйПараметр");

	Источник.Закрыть();

КонецПроцедуры

// Параметры соединения задает только источник: менеджер их не принимает и сам источник
// не создает.
&Тест
Процедура МенеджерБезИсточникаДанныхНеСоздается() Экспорт

	ТекстОшибки = "";
	Попытка
		МенеджерСущностей = Новый МенеджерСущностей(Тип("КоннекторInMemory")); // BSLLS:UnusedLocalVariable-off
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "Менеджер отвергает параметры соединения вместо источника")
		.Содержит("создается из ИсточникДанных");

КонецПроцедуры
