// Записи сущностей: один зарегистрированный тип на тип сущности, привязка записи к своему менеджеру.
//
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// ИсточникДанных - Источники, созданные тестом; закрываются после каждого теста.
Перем Источники;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	ПодключитьСценарий("tests/fixtures/ПростойОбъект.os", "ПростойОбъект");
	Источники = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Для Каждого Источник Из Источники Цикл
		Источник.Закрыть();
	КонецЦикла;
КонецПроцедуры

Функция НовыйМенеджер(ИмяИсточника)
	Источник = Новый ИсточникДанных(ИмяИсточника, Тип("КоннекторInMemory"), ИмяИсточника);
	Источник.УстановитьАвтоЗакрытие(Ложь);
	Источники.Добавить(Источник);

	Менеджер = Новый МенеджерСущностей(Источник);
	Менеджер.ДобавитьКлассВМодель(Тип("ПростойОбъект"));
	Менеджер.Инициализировать();

	Возврат Менеджер;
КонецФункции

&Тест
Процедура ЗаписиОдногоТипаСущностиИмеютОдинТип() Экспорт
	Менеджер = НовыйМенеджер("записи одного типа");

	Первая = Менеджер.СоздатьЭлемент(Тип("ПростойОбъект"));
	Вторая = Менеджер.СоздатьЭлемент(Тип("ПростойОбъект"));

	Ожидаем.Что(ТипЗнч(Первая), "тип первой записи").Равно(Тип("ЗаписьСущности_ПростойОбъект"));
	Ожидаем.Что(ТипЗнч(Вторая), "тип второй записи").Равно(ТипЗнч(Первая));
	Ожидаем.Что(Первая = Вторая, "записи - разные объекты").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ЗаписьСохраняетЧитаетИУдаляетСебя() Экспорт
	Менеджер = НовыйМенеджер("методы записи");

	Запись = Менеджер.СоздатьЭлемент(Тип("ПростойОбъект"));
	Запись.Идентификатор = "1";
	Запись.Поле = "до";
	Запись.Сохранить();

	Найденная = Менеджер.ПолучитьОдно(Тип("ПростойОбъект"), "1");
	Ожидаем.Что(Найденная.Поле, "поле после сохранения").Равно("до");

	Найденная.Поле = "после";
	Найденная.Сохранить();
	Запись.Прочитать();
	Ожидаем.Что(Запись.Поле, "поле после чтения").Равно("после");

	Запись.Удалить();
	Ожидаем.Что(Менеджер.Получить(Тип("ПростойОбъект")).Количество(), "записей после удаления").Равно(0);
КонецПроцедуры

&Тест
Процедура ЗаписьПривязанаКСвоемуМенеджеру() Экспорт
	Первый = НовыйМенеджер("первый менеджер");
	Второй = НовыйМенеджер("второй менеджер");

	ЗаписьПервого = Первый.СоздатьЭлемент(Тип("ПростойОбъект"));
	ЗаписьПервого.Идентификатор = "1";
	ЗаписьПервого.Поле = "первый";
	ЗаписьПервого.Сохранить();

	ЗаписьВторого = Второй.СоздатьЭлемент(Тип("ПростойОбъект"));
	ЗаписьВторого.Идентификатор = "2";
	ЗаписьВторого.Поле = "второй";
	ЗаписьВторого.Сохранить();

	Ожидаем.Что(Первый.Получить(Тип("ПростойОбъект")).Количество(), "записей у первого").Равно(1);
	Ожидаем.Что(Первый.ПолучитьОдно(Тип("ПростойОбъект"), "1").Поле, "поле записи первого").Равно("первый");
	Ожидаем.Что(Второй.Получить(Тип("ПростойОбъект")).Количество(), "записей у второго").Равно(1);
	Ожидаем.Что(Второй.ПолучитьОдно(Тип("ПростойОбъект"), "2").Поле, "поле записи второго").Равно("второй");
КонецПроцедуры

&Тест
Процедура МенеджерПринимаетЗаписьПоТипуСущности() Экспорт
	Менеджер = НовыйМенеджер("запись через менеджер");

	Запись = Менеджер.СоздатьЭлемент(Тип("ПростойОбъект"));
	Запись.Идентификатор = "1";
	Запись.Поле = "через менеджер";
	Менеджер.Сохранить(Запись);

	Ожидаем.Что(Менеджер.ПолучитьОдно(Тип("ПростойОбъект"), "1").Поле, "поле").Равно("через менеджер");

	Менеджер.Удалить(Запись);
	Ожидаем.Что(Менеджер.Получить(Тип("ПростойОбъект")).Количество(), "записей после удаления").Равно(0);
КонецПроцедуры
