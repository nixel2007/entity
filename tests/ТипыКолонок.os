// Перечни типов из глобальных модулей библиотеки отдаются неизменяемыми.

#Использовать ".."

&Тест
Процедура ТипыКолонокНеизменяемы() Экспорт

	Ожидаем.Что(ТипЗнч(ТипыКолонок.Типы()), "Типы колонок - фиксированный массив")
		.Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(ТипыКолонок.Типы(), "Перечень содержит все типы колонок").ИмеетДлину(9);

КонецПроцедуры

&Тест
Процедура ТипыПодчиненныхТаблицНеизменяемы() Экспорт

	Ожидаем.Что(ТипЗнч(ТипыПодчиненныхТаблиц.Типы()), "Типы подчиненных таблиц - фиксированный массив")
		.Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(ТипыПодчиненныхТаблиц.Типы(), "Перечень содержит все типы подчиненных таблиц").ИмеетДлину(2);

КонецПроцедуры
