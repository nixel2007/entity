// Наблюдатели сущностей: события уровня запроса у SQL-коннекторов и описание соединения.
//
// База выбирается как в остальных наборах: SQLite, если разрешен, иначе PostgreSQL.
// У обоих коннекторов события запроса несут текст SQL с плейсхолдерами параметров.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Наблюдатель, зарегистрированный до инициализации менеджера.
Перем Наблюдатель;
// Тип коннектора тестовой БД.
Перем ТипКоннектораТестовойБазы;
// Строка соединения с тестовой БД.
Перем СтрокаСоединенияКоннектора;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ВыполнятьСбросТаблиц = Ложь;
	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединенияКоннектора = "FullUri=file::memory:?cache=shared";
		ТипКоннектораТестовойБазы = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединенияКоннектора = СтрокаСоединенияPostgres();
		ТипКоннектораТестовойБазы = Тип("КоннекторPostgreSQL");
		ВыполнятьСбросТаблиц = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования наблюдателей запросов";
	КонецЕсли;

	ПодключитьФикстуры();

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектораТестовойБазы, СтрокаСоединенияКоннектора);

	Если ВыполнятьСбросТаблиц Тогда
		ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);
	КонецЕсли;

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	Наблюдатель = Новый НаблюдательЗаписывающий;
	МенеджерСущностей.ДобавитьНаблюдателя(Наблюдатель);

	МенеджерСущностей.Инициализировать();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.ВыполнитьСКоннектором("Коннектор -> Коннектор.ВыполнитьЗапрос(""DELETE FROM Авторы"")");
	МенеджерСущностей.Закрыть();
КонецПроцедуры

&Тест
Процедура ИнициализацияПорождаетСобытияСозданияТаблиц() Экспорт

	Создания = Наблюдатель.Завершенные("Запрос", "CREATE TABLE");

	Ожидаем.Что(Создания, "По событию на каждую таблицу модели").ИмеетДлину(2);
	Ожидаем.Что(Создания[1].ИмяТаблицы()).Равно("Авторы");
	Ожидаем.Что(Создания[1].ТекстЗапроса()).Содержит("CREATE TABLE IF NOT EXISTS Авторы");
	Ожидаем.Что(Создания[1].Ошибка()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СохранениеПорождаетСобытиеВставки() Экспорт

	МенеджерСущностей.Сохранить(НовыйАвтор("Пушкин"));

	Вставки = Наблюдатель.Завершенные("Запрос", "INSERT");

	Ожидаем.Что(Вставки).ИмеетДлину(1);
	Ожидаем.Что(Вставки[0].ИмяТаблицы()).Равно("Авторы");
	Ожидаем.Что(Вставки[0].ТекстЗапроса()).Содержит("INSERT");
	Ожидаем.Что(Вставки[0].ТекстЗапроса(), "Значения передаются параметрами, а не текстом").Не_().Содержит("Пушкин");
	Ожидаем.Что(Вставки[0].Длительность()).Не_().Меньше(0);

КонецПроцедуры

&Тест
Процедура ЧтениеПорождаетСобытиеВыборкиСЧисломСтрок() Экспорт

	МенеджерСущностей.Сохранить(НовыйАвтор("Пушкин"));
	МенеджерСущностей.Сохранить(НовыйАвтор("Гоголь"));

	МенеджерСущностей.Получить(Тип("Автор"));

	Выборки = Наблюдатель.Завершенные("Запрос", "SELECT");

	Ожидаем.Что(Выборки).ИмеетДлину(1);
	Ожидаем.Что(Выборки[0].ИмяТаблицы()).Равно("Авторы");
	Ожидаем.Что(Выборки[0].ТекстЗапроса()).Содержит("SELECT * FROM Авторы");
	Ожидаем.Что(Выборки[0].КоличествоСтрок()).Равно(2);

	Операции = Наблюдатель.Завершенные("Операция", "Получить");
	Ожидаем.Что(Операции[0].Начало(), "Запрос начинается не раньше операции").Не_().Меньше(Операции[0].Начало());

КонецПроцедуры

&Тест
Процедура УдалениеПорождаетСобытиеУдаления() Экспорт

	Автор = НовыйАвтор("Пушкин");
	МенеджерСущностей.Сохранить(Автор);
	МенеджерСущностей.Удалить(Автор);

	Удаления = Наблюдатель.Завершенные("Запрос", "DELETE");

	Ожидаем.Что(Удаления).ИмеетДлину(1);
	Ожидаем.Что(Удаления[0].ИмяТаблицы()).Равно("Авторы");
	Ожидаем.Что(Удаления[0].ТекстЗапроса()).Содержит("DELETE FROM Авторы");

КонецПроцедуры

&Тест
Процедура ТранзакцияПорождаетСобытияКомандТранзакции() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.Сохранить(НовыйАвтор("Пушкин"));
	МенеджерСущностей.ЗафиксироватьТранзакцию();

	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.Сохранить(НовыйАвтор("Гоголь"));
	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем.Что(Наблюдатель.Завершенные("Запрос", "BEGIN")).ИмеетДлину(2);
	Ожидаем.Что(Наблюдатель.Завершенные("Запрос", "COMMIT")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Запрос", "ROLLBACK")).ИмеетДлину(1);

	Начало = Наблюдатель.Завершенные("Запрос", "BEGIN")[0];
	Ожидаем.Что(Начало.ТекстЗапроса()).Содержит("TRANSACTION");
	Ожидаем.Что(Начало.ИмяТаблицы()).Равно("");

КонецПроцедуры

&Тест
Процедура ПроизвольныйЗапросПорождаетСобытиеСОперациейИзТекста() Экспорт

	Строки = МенеджерСущностей.ВычислитьСКоннектором("Коннектор -> Коннектор.ВыполнитьЗапрос(""SELECT 1 AS Единица"")");

	Ожидаем.Что(Строки).ИмеетДлину(1);

	Выборки = Наблюдатель.Завершенные("Запрос", "SELECT");
	Ожидаем.Что(Выборки).ИмеетДлину(1);
	Ожидаем.Что(Выборки[0].ТекстЗапроса()).Равно("SELECT 1 AS Единица");
	Ожидаем.Что(Выборки[0].ИмяТаблицы()).Равно("");
	Ожидаем.Что(Выборки[0].КоличествоСтрок()).Равно(1);

КонецПроцедуры

&Тест
Процедура ОшибкаЗапросаПопадаетВСобытиеИДоходитДоВызывающего() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("Коннектор -> Коннектор.ВыполнитьЗапрос(""SELECT * FROM НетТакойТаблицы"")");

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВычислитьСКоннектором", Параметры)
		.ВыбрасываетИсключение("НетТакойТаблицы");

	Выборки = Наблюдатель.Завершенные("Запрос", "SELECT");
	Ожидаем.Что(Выборки).ИмеетДлину(1);
	Ожидаем.Что(Выборки[0].Ошибка()).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(Выборки[0].Длительность()).Не_().Меньше(0);

	Операции = Наблюдатель.Завершенные("Операция", "ВычислитьСКоннектором");
	Ожидаем.Что(Операции[0].Ошибка(), "Ошибка запроса поднимается и в операцию").ИмеетТип("ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура СобытияНесутОписаниеСоединенияБезСекретов() Экспорт

	МенеджерСущностей.Сохранить(НовыйАвтор("Пушкин"));

	Событие = Наблюдатель.Завершенные("Запрос", "INSERT")[0];

	Если ТипКоннектораТестовойБазы = Тип("КоннекторSQLite") Тогда
		Ожидаем.Что(Событие.Система()).Равно("sqlite");
		Ожидаем.Что(Событие.БазаДанных()).Содержит("memory");
		Ожидаем.Что(Событие.Адрес()).Равно("");
		Ожидаем.Что(Событие.Порт()).Равно(0);
	Иначе
		Ожидаем.Что(Событие.Система()).Равно("postgresql");
		Ожидаем.Что(Событие.Адрес()).Равно(ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost"));
		Ожидаем.Что(Строка(Событие.Порт())).Равно(ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432"));
		Ожидаем.Что(Событие.БазаДанных()).Равно(ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres"));
	КонецЕсли;

	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	Ожидаем.Что(Событие.БазаДанных()).Не_().Содержит(Пароль);
	Ожидаем.Что(Событие.Адрес()).Не_().Содержит(Пароль);

	Операция = Наблюдатель.Завершенные("Операция", "Сохранить")[0];
	Ожидаем.Что(Операция.Система(), "Описание соединения есть и у событий операций").Равно(Событие.Система());

КонецПроцедуры

// Служебные

Функция НовыйАвтор(Знач Имя)
	Автор = Новый Автор;
	Автор.Имя = Имя;
	Возврат Автор;
КонецФункции

Процедура ПодключитьФикстуры()

	Фикстуры = Новый Массив;
	Фикстуры.Добавить("СущностьБезГенерируемогоИдентификатора");
	Фикстуры.Добавить("Автор");
	Фикстуры.Добавить("НаблюдательЗаписывающий");

	Для Каждого Фикстура Из Фикстуры Цикл
		ПодключитьСценарий(
			ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", Фикстура + ".os"),
			Фикстура
		);
	КонецЦикла;

КонецПроцедуры

Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Port=%2;Username=%3;Password=%4;Database=%5;",
		Хост,
		Порт,
		Пользователь,
		Пароль,
		ИмяБД
	);

КонецФункции
