// Пул выдает соединение контексту исполнения и хранит эту привязку, пока контекст не освободит
// соединение. Здесь проверяется механика выдачи и возврата в пределах одного контекста;
// независимость транзакций разных контекстов проверяется в МногопоточностьФоновыеЗадания.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Пул, который тесты создают заново перед каждым тестом.
Перем Пул;
// Пул с пределом в одно соединение для проверки ожидания. Виден фоновому заданию.
Перем ПулСПределом;
// Тип коннектора БД, доступной в текущем окружении.
Перем ТипКоннектораТестовойБазы;
// Строка соединения с БД, доступной в текущем окружении.
Перем СтрокаСоединенияТестовойБазы;
// Признак того, что таблицы тестовой БД переживают перезапуск и их нужно сбрасывать.
Перем СбрасыватьТаблицы;

Процедура ПередЗапускомТеста() Экспорт

	// КоннекторInMemory не требует внешней БД, а механике выдачи соединений все равно, какой коннектор внутри.
	Пул = Новый ПулСоединений(2, Тип("КоннекторInMemory"), "", Новый Массив);

	ОпределитьТестовуюБазу();

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	Пул.Закрыть();
	Пул = Неопределено;
КонецПроцедуры

&Тест
Процедура НовыйПулНеДержитСоединений() Экспорт

	Ожидаем.Что(Пул.КоличествоЗанятых(), "В новом пуле нет занятых соединений").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "В новом пуле нет свободных соединений").Равно(0);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоКонтекста(), "За текущим контекстом ничего не закреплено")
		.ЭтоЛожь();

КонецПроцедуры

// Пока контекст не освободил соединение, он получает то же самое - иначе начатая им транзакция
// была бы не видна его же последующим операциям.
//
&Тест
Процедура КонтекстПолучаетОдноИТоЖеСоединение() Экспорт

	Первое = Пул.Занять();
	Второе = Пул.Занять();

	Ожидаем.Что(Второе = Первое, "Контексту выдано то же соединение").ЭтоИстина();
	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занято одно соединение").Равно(1);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных соединений нет").Равно(0);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоКонтекста(), "За текущим контекстом закреплено соединение")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОсвобожденноеСоединениеСтановитсяСвободным() Экспорт

	Пул.Занять();
	Пул.Освободить();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых соединений не осталось").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Соединение вернулось в очередь свободных").Равно(1);
	Ожидаем
		.Что(Пул.ЕстьСоединениеТекущегоКонтекста(), "За текущим контекстом ничего не закреплено")
		.ЭтоЛожь();

КонецПроцедуры

// Освобожденное соединение не закрывается, а переиспользуется: иначе пул не имел бы смысла.
//
&Тест
Процедура СвободноеСоединениеВыдаетсяПовторно() Экспорт

	Первое = Пул.Занять();
	Пул.Освободить();
	Второе = Пул.Занять();

	Ожидаем.Что(Второе = Первое, "Из очереди выдано то же соединение").ЭтоИстина();
	Ожидаем.Что(Пул.КоличествоСвободных(), "Очередь свободных опустела").Равно(0);
	Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение снова закреплено за контекстом").Равно(1);

КонецПроцедуры

&Тест
Процедура ОсвобождениеБезЗахватаНичегоНеМеняет() Экспорт

	Пул.Освободить();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых соединений нет").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободных соединений нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗакрытиеОсвобождаетИЗанятыеИСвободные() Экспорт

	Пул.Занять();
	Пул.Освободить();
	Пул.Занять();

	Пул.Закрыть();

	Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятые соединения закрыты").Равно(0);
	Ожидаем.Что(Пул.КоличествоСвободных(), "Свободные соединения закрыты").Равно(0);

КонецПроцедуры

// Ключ контекста вне фонового задания постоянен, и такой контекст всегда считается работающим:
// иначе пул отобрал бы у основного потока его же соединение.
//
&Тест
Процедура КонтекстВнеФоновогоЗаданияСчитаетсяРаботающим() Экспорт

	Ключ = КонтекстИсполнения.Ключ();

	Ожидаем.Что(КонтекстИсполнения.Ключ(), "Ключ контекста не меняется от вызова к вызову").Равно(Ключ);
	Ожидаем.Что(КонтекстИсполнения.Работает(Ключ), "Контекст вне фонового задания работает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестныйКонтекстНеСчитаетсяРаботающим() Экспорт

	Ожидаем
		.Что(КонтекстИсполнения.Работает(Строка(Новый УникальныйИдентификатор)), "Такого задания нет")
		.ЭтоЛожь();

КонецПроцедуры

// Завершенное фоновое задание работающим не считается - на этом держится возврат соединений,
// которые задание не освободило само.
//
&Тест
Процедура ЗавершенноеФоновоеЗаданиеНеСчитаетсяРаботающим() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПустаяРаботаВФоне", Новый Массив, Истина);
	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(КонтекстИсполнения.Работает(Строка(Задание.УникальныйИдентификатор)), "Задание уже завершено")
		.ЭтоЛожь();

КонецПроцедуры

// Тело фонового задания для проверки определения завершенного контекста.
//
Процедура ПустаяРаботаВФоне() Экспорт
	// Заданию достаточно завершиться.
КонецПроцедуры

// При нулевом размере пул не переиспользует соединения: каждая транзакция открывает свое.
// Собственное соединение контекст получает и в этом режиме - потокобезопасность не отключается.
//
&Тест
Процедура НулевойРазмерОтключаетПереиспользование() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектораТестовойБазы, СтрокаСоединенияТестовойБазы, Неопределено, 0);

	Попытка
		ОчиститьТестовуюБазу(Менеджер);
		ПроверитьРаботуБезПереиспользования(Менеджер);
	Исключение
		Менеджер.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Менеджер.Закрыть();

КонецПроцедуры

// Проверяет транзакции менеджера, чей пул не переиспользует соединения.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, созданный с нулевым размером пула.
//
Процедура ПроверитьРаботуБезПереиспользования(Менеджер)

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);

	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Ожидаем
		.Что(Менеджер.ПолучитьПулСоединений().СоединениеТекущегоКонтекста(), "Транзакция не начата, соединение не закреплено")
		.Равно(Неопределено);

	Менеджер.НачатьТранзакцию();
	ПервоеСоединение = Менеджер.ПолучитьПулСоединений().СоединениеТекущегоКонтекста();

	Ожидаем
		.Что(ПервоеСоединение <> Неопределено, "Контекст получил собственное соединение и без переиспользования")
		.ЭтоИстина();

	Менеджер.Сохранить(НовыйАвтор("Отмененный"));
	Менеджер.ОтменитьТранзакцию();

	Ожидаем
		.Что(Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM Авторы"), "Откат сработал")
		.ИмеетДлину(0);

	Менеджер.НачатьТранзакцию();
	ВтороеСоединение = Менеджер.ПолучитьПулСоединений().СоединениеТекущегоКонтекста();

	Ожидаем
		.Что(ВтороеСоединение = ПервоеСоединение, "Соединение первой транзакции закрыто, а не переиспользовано")
		.ЭтоЛожь();

	Менеджер.Сохранить(НовыйАвтор("Сохраненный"));
	Менеджер.ЗафиксироватьТранзакцию();

	Ожидаем
		.Что(Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM Авторы"), "Фиксация сработала")
		.ИмеетДлину(1);

КонецПроцедуры

// Создает автора с указанным именем.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
// Возвращаемое значение:
//   Произвольный - Новый автор.
//
Функция НовыйАвтор(Знач Имя)

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	Возврат Автор;

КонецФункции

// Определяет коннектор и строку соединения с БД, доступной в текущем окружении.
//
// Отключенный пул проверяется на настоящей транзакции, поэтому КоннекторInMemory здесь не годится:
// транзакций он не поддерживает.
//
Процедура ОпределитьТестовуюБазу()

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	Если ЗапускатьТестыSQLite = "true" Тогда
		// База в памяти должна быть разделяемой: без переиспользования каждая транзакция открывает
		// новое соединение, а приватная база у каждого соединения была бы своя.
		СтрокаСоединенияТестовойБазы = "FullUri=file::memory:?cache=shared";
		ТипКоннектораТестовойБазы = Тип("КоннекторSQLite");
		СбрасыватьТаблицы = Ложь;
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединенияТестовойБазы = СтрокаСоединенияPostgres();
		ТипКоннектораТестовойБазы = Тип("КоннекторPostgreSQL");
		СбрасыватьТаблицы = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования менеджера без пула";
	КонецЕсли;

КонецПроцедуры

// Сбрасывает таблицы тестовой БД, если они переживают перезапуск.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, коннектором которого выполняется сброс.
//
Процедура ОчиститьТестовуюБазу(Менеджер)

	Если НЕ СбрасыватьТаблицы Тогда
		Возврат;
	КонецЕсли;

	Коннектор = Менеджер.ПолучитьКоннектор();
	Коннектор.Открыть(СтрокаСоединенияТестовойБазы, Новый Массив);
	ТестовыеУтилиты.УдалитьТаблицыВБазеДанных(Коннектор);
	Коннектор.Закрыть();

КонецПроцедуры

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции

// Когда предел пула исчерпан, следующий контекст ждет, пока соединение освободит другой.
//
&Тест
Процедура ПриИсчерпанномПределеКонтекстЖдет() Экспорт

	ПулСПределом = Новый ПулСоединений(1, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка
		ПроверитьОжиданиеНаПределе();
	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Нулевой размер предела не ставит: соединение получают все, сколько бы их ни просило.
//
&Тест
Процедура ПриНулевомРазмереНиктоНеЖдет() Экспорт

	ПулСПределом = Новый ПулСоединений(0, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка

		ПулСПределом.Занять();

		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОсвободитьВФоне", Новый Массив, Истина);
		ДождатьсяЗадания(Задание);

		Ожидаем.Что(Задание.ИнформацияОбОшибке, "Фоновое задание получило соединение").Равно(Неопределено);
		Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Ждать никому не пришлось").Равно(0);

		ПулСПределом.Освободить();

	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Проверяет, что фоновое задание встает в очередь, пока единственное соединение занято,
// и получает его сразу после освобождения.
//
Процедура ПроверитьОжиданиеНаПределе()

	ПулСПределом.Занять();

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОсвободитьВФоне", Новый Массив, Истина);

	Приостановить(300);

	Ожидаем
		.Что(Задание.Состояние = СостояниеФоновогоЗадания.Активно, "Задание ждет: единственное соединение занято")
		.ЭтоИстина();
	Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Задание встало в очередь").Равно(1);

	ПулСПределом.Освободить();
	ДождатьсяЗадания(Задание);

	Ожидаем.Что(Задание.ИнформацияОбОшибке, "Задание дождалось соединения").Равно(Неопределено);
	Ожидаем.Что(ПулСПределом.КоличествоОжидающих(), "Очередь ожидающих опустела").Равно(0);

КонецПроцедуры

// Занимает и освобождает соединение проверяемого пула. Запускается в фоновом задании.
//
Процедура ЗанятьИОсвободитьВФоне() Экспорт
	ПулСПределом.Занять();
	ПулСПределом.Освободить();
КонецПроцедуры

// Дожидается завершения фонового задания за отведенное время.
//
// Без ограничения зависший пул подвесил бы весь прогон, и причину пришлось бы искать по таймауту
// сборки вместо понятного падения теста.
//
// Параметры:
//   Задание - ФоновоеЗадание - Задание, завершения которого ждем.
//
Процедура ДождатьсяЗадания(Задание)

	Если НЕ Задание.ОжидатьЗавершения(30000) Тогда
		ВызватьИсключение "Фоновое задание не завершилось за 30 секунд";
	КонецЕсли;

КонецПроцедуры

// Задание оборвалось, не освободив соединение. При исчерпанном пределе пул отбирает его у
// завершившегося контекста - иначе соединение было бы потеряно навсегда.
//
&Тест
Процедура СоединениеОборвавшегосяЗаданияВозвращаетсяВПул() Экспорт

	ПулСПределом = Новый ПулСоединений(1, Тип("КоннекторInMemory"), "", Новый Массив);

	Попытка
		ПроверитьВозвратПослеОбрыва();
	Исключение
		ПулСПределом.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ПулСПределом.Закрыть();

КонецПроцедуры

// Ошибка при открытии соединения не должна оставлять блокировку пула захваченной.
//
&Тест
Процедура ОшибкаЗахватаНеОставляетПулЗаблокированным() Экспорт

	// Массив коннектором не является: открытие соединения свалится внутри захвата.
	ПулСОшибкой = Новый ПулСоединений(1, Тип("Массив"), "", Новый Массив);

	Попытка
		ПулСОшибкой.Занять();
		ВызватьИсключение "Захват должен был завершиться ошибкой";
	Исключение
		// Ожидаемо.
	КонецПопытки;

	// Если бы блокировка осталась захваченной, этот вызов не вернулся бы.
	Ожидаем.Что(ПулСОшибкой.КоличествоЗанятых(), "Блокировка освобождена, состояние читается").Равно(0);

КонецПроцедуры

// Проверяет, что соединение оборвавшегося задания достается следующему контексту.
//
Процедура ПроверитьВозвратПослеОбрыва()

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗанятьИОборватьсяВФоне", Новый Массив, Истина);
	ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Задание оборвалось, не освободив соединение")
		.ЭтоИстина();
	Ожидаем
		.Что(ПулСПределом.КоличествоЗанятых(), "Соединение осталось закрепленным за мертвым контекстом")
		.Равно(1);

	// Предел в одно соединение исчерпан, свободных нет: пул обязан отобрать брошенное.
	ПулСПределом.Занять();

	Ожидаем.Что(ПулСПределом.КоличествоЗанятых(), "Соединение выдано текущему контексту").Равно(1);
	Ожидаем.Что(ПулСПределом.КоличествоСвободных(), "Свободных не осталось").Равно(0);

	ПулСПределом.Освободить();

КонецПроцедуры

// Занимает соединение и обрывается, не освободив его. Запускается в фоновом задании.
//
Процедура ЗанятьИОборватьсяВФоне() Экспорт
	ПулСПределом.Занять();
	ВызватьИсключение "Обрыв задания с занятым соединением";
КонецПроцедуры
