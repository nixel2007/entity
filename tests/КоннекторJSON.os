&Тест
Процедура ДатыПереживаютЗаписьИЧтение() Экспорт

	// Дано
	МодельДанных = Новый МодельДанных();
	ОбъектМодели = МодельДанных.СоздатьОбъектМодели(Тип("СущностьСоВсемиТипамиКолонок"));
	Коннектор.ИнициализироватьТаблицу(ОбъектМодели);

	Сущность = Новый СущностьСоВсемиТипамиКолонок;
	Сущность.Целое = 1;
	Сущность.Дата = Дата(2018, 1, 1);
	Сущность.Время = Дата(1, 1, 1, 10, 53, 20);
	Сущность.ДатаВремя = Дата(2018, 1, 1, 10, 53, 20);

	// Когда
	Коннектор.Сохранить(ОбъектМодели, Сущность);
	НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, Новый ОпцииПоиска);

	// Тогда
	Ожидаем.Что(НайденныеСтроки, "Сущность сохранилась").ИмеетДлину(1);
	Ожидаем.Что(НайденныеСтроки[0].Получить("Дата"), "Дата прочитана без искажений").Равно(Сущность.Дата);
	Ожидаем.Что(НайденныеСтроки[0].Получить("Время"), "Время прочитано без искажений").Равно(Сущность.Время);
	Ожидаем.Что(НайденныеСтроки[0].Получить("ДатаВремя"), "ДатаВремя прочитано без искажений").Равно(Сущность.ДатаВремя);

КонецПроцедуры

&Тест
Процедура ДатаСоСтарымСуффиксомЧитаетсяБезСмещения() Экспорт

	// Дано
	МодельДанных = Новый МодельДанных();
	ОбъектМодели = МодельДанных.СоздатьОбъектМодели(Тип("СущностьСоВсемиТипамиКолонок"));

	// Файл таблицы в формате, который писала библиотека json: суффикс "Z" при местном времени
	ИмяФайла = ОбъединитьПути(СтрокаСоединения, ОбъектМодели.ИмяТаблицы()) + ".json";
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, "UTF-8");
	ЗаписьТекста.Записать("{""1"":{""Целое"":1,""Дата"":""2018-01-01T00:00:00Z""}}");
	ЗаписьТекста.Закрыть();

	// Когда
	НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, Новый ОпцииПоиска);

	// Тогда
	Ожидаем.Что(НайденныеСтроки, "Строка получена").ИмеетДлину(1);
	Ожидаем.Что(НайденныеСтроки[0].Получить("Дата"), "Суффикс не сдвинул дату на часовой пояс")
		.Равно(Дата(2018, 1, 1));

КонецПроцедуры

&Тест
Процедура ОтборПоДатеСравниваетДаты() Экспорт

	// Дано
	МодельДанных = Новый МодельДанных();
	ОбъектМодели = МодельДанных.СоздатьОбъектМодели(Тип("СущностьСоВсемиТипамиКолонок"));
	Коннектор.ИнициализироватьТаблицу(ОбъектМодели);

	Сущность = Новый СущностьСоВсемиТипамиКолонок;
	Сущность.Целое = 1;
	Сущность.Дата = Дата(2018, 1, 1);
	Коннектор.Сохранить(ОбъектМодели, Сущность);

	Сущность = Новый СущностьСоВсемиТипамиКолонок;
	Сущность.Целое = 2;
	Сущность.Дата = Дата(2020, 6, 15);
	Коннектор.Сохранить(ОбъектМодели, Сущность);

	// Когда
	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("Дата", ВидСравнения.Равно, Дата(2020, 6, 15));
	НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска);

	// Тогда
	Ожидаем.Что(НайденныеСтроки, "Отбор на равенство нашел одну строку").ИмеетДлину(1);
	Ожидаем.Что(НайденныеСтроки[0].Получить("Целое"), "Найдена нужная строка").Равно(2);

	// Когда
	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("Дата", ВидСравнения.Больше, Дата(2019, 1, 1));
	НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска);

	// Тогда
	Ожидаем.Что(НайденныеСтроки, "Отбор на сравнение нашел одну строку").ИмеетДлину(1);
	Ожидаем.Что(НайденныеСтроки[0].Получить("Целое"), "Найдена нужная строка").Равно(2);

КонецПроцедуры

&Тест
Процедура ЧтениеНеКонфликтуетСПараллельнойЗаписью() Экспорт

	// Дано
	МодельДанных = Новый МодельДанных();
	// Объект модели неизменяем после создания и разделяется обоими потоками -
	// так же, как его разделяет хранилище сущностей.
	ОбъектМоделиФоновойЗаписи = МодельДанных.СоздатьОбъектМодели(Тип("СущностьСоВсемиТипамиКолонок"));
	Коннектор.ИнициализироватьТаблицу(ОбъектМоделиФоновойЗаписи);

	Для Счетчик = 1 По КоличествоСущностейФоновойЗаписи() Цикл
		Сущность = Новый СущностьСоВсемиТипамиКолонок;
		Сущность.Целое = Счетчик;
		Коннектор.Сохранить(ОбъектМоделиФоновойЗаписи, Сущность);
	КонецЦикла;

	// Когда
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗаписатьСущностиВФоне", Новый Массив, Истина);

	ОшибкаЧтения = "";
	Пока НЕ Задание.ОжидатьЗавершения(1) Цикл
		Попытка
			Коннектор.НайтиСтрокиВТаблице(ОбъектМоделиФоновойЗаписи, Новый ОпцииПоиска());
		Исключение
			ОшибкаЧтения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Прервать;
		КонецПопытки;
	КонецЦикла;

	Задание.ОжидатьЗавершения();

	// Тогда
	Ожидаем.Что(ОшибкаЧтения, "Чтение не конфликтует с параллельной записью").Равно("");

	ОшибкаЗаписи = "";
	Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ОшибкаЗаписи = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;
	Ожидаем.Что(ОшибкаЗаписи, "Фоновая запись прошла без ошибок").Равно("");

	НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМоделиФоновойЗаписи, Новый ОпцииПоиска());
	Ожидаем.Что(НайденныеСтроки, "Строки обоих потоков сохранены")
		.ИмеетДлину(2 * КоличествоСущностейФоновойЗаписи());

КонецПроцедуры

&Тест
Процедура СемафорОсвобождаетсяПриОшибкеЧтения() Экспорт

	// Дано
	МодельДанных = Новый МодельДанных();
	// Таблица не инициализирована - файла нет, и чтение завершится ошибкой.
	ОбъектМодели = МодельДанных.СоздатьОбъектМодели(Тип("СущностьСоВсемиТипамиКолонок"));

	// Когда
	ТекстОшибки = "";
	Попытка
		Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, Новый ОпцииПоиска());
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки, "Чтение отсутствующей таблицы завершается ошибкой").Не_().Равно("");
	ПроверитьЧтоСемафорТаблицыСвободен(ОбъектМодели, "Семафор освобожден после ошибки чтения");

КонецПроцедуры

&Тест
Процедура СемафорОсвобождаетсяПриОшибкеИнициализации() Экспорт

	// Дано
	МодельДанных = Новый МодельДанных();
	ОбъектМодели = МодельДанных.СоздатьОбъектМодели(Тип("СущностьСоВсемиТипамиКолонок"));
	// Каталога нет - создание файла таблицы завершится ошибкой.
	УдалитьФайлы(СтрокаСоединения);

	// Когда
	ТекстОшибки = "";
	Попытка
		Коннектор.ИнициализироватьТаблицу(ОбъектМодели);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	СоздатьКаталог(СтрокаСоединения);

	// Тогда
	Ожидаем.Что(ТекстОшибки, "Инициализация без каталога завершается ошибкой").Не_().Равно("");
	ПроверитьЧтоСемафорТаблицыСвободен(ОбъектМодели, "Семафор освобожден после ошибки инициализации");

КонецПроцедуры

// Записывает сущности в таблицу из фонового задания. Используется тестом
// "ЧтениеНеКонфликтуетСПараллельнойЗаписью", который читает ту же таблицу из главного потока.
// Идентификаторы продолжают диапазон, записанный главным потоком, поэтому строки не перетираются.
//
Процедура ЗаписатьСущностиВФоне() Экспорт

	Для Счетчик = 1 По КоличествоСущностейФоновойЗаписи() Цикл
		Сущность = Новый СущностьСоВсемиТипамиКолонок;
		Сущность.Целое = КоличествоСущностейФоновойЗаписи() + Счетчик;
		Коннектор.Сохранить(ОбъектМоделиФоновойЗаписи, Сущность);
	КонецЦикла;

КонецПроцедуры

// Проверяет, что семафор файла таблицы никем не удерживается.
//
// Захват выполняется с таймаутом: при утечке семафора проверка завершится ошибкой ожидания,
// а не бесконечным зависанием теста.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект модели, определяющий имя файла таблицы.
//   Пояснение - Строка - Пояснение к проверке.
//
Процедура ПроверитьЧтоСемафорТаблицыСвободен(ОбъектМодели, Пояснение)

	ИмяФайла = ОбъединитьПути(СтрокаСоединения, ОбъектМодели.ИмяТаблицы()) + ".json";
	Семафор = Семафоры.Получить(ИмяФайла);

	ОшибкаЗахвата = "";
	Попытка
		Семафор.Захватить(ТаймаутОжиданияСемафора());
		Семафор.Освободить();
	Исключение
		ОшибкаЗахвата = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ОшибкаЗахвата, Пояснение).Равно("");

КонецПроцедуры

// Количество сущностей, записываемых каждым из потоков. Файл таблицы должен быть достаточно
// большим, чтобы окно между открытием и закрытием файла было заметным.
//
// Возвращаемое значение:
//   Число - Количество сущностей.
//
Функция КоличествоСущностейФоновойЗаписи()
	Возврат 60;
КонецФункции

// Таймаут ожидания захвата семафора в проверках его освобождения.
//
// Возвращаемое значение:
//   Число - Таймаут в миллисекундах.
//
Функция ТаймаутОжиданияСемафора()
	Возврат 1000;
КонецФункции
