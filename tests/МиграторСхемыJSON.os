// BSLLS:LineLength-off

#Использовать fs
#Использовать ".."
#Использовать "utils"

Перем СтрокаСоединения;

Процедура ПередЗапускомТеста() Экспорт
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "МигрируемаяСущностьВерсия1.os"), "МигрируемаяСущностьВерсия1");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "МигрируемаяСущностьВерсия2.os"), "МигрируемаяСущностьВерсия2");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ОбработчикМиграцииДляТестов.os"), "ОбработчикМиграцииДляТестов");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ОбработчикЗаполненияПриоритета.os"), "ОбработчикЗаполненияПриоритета");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ПростойОбъект.os"), "ПростойОбъект");

	СтрокаСоединения = ОбъединитьПути(ТекущийКаталог(), "tests", "jsonmigrationdata");
	СоздатьКаталог(СтрокаСоединения);
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	УдалитьФайлы(СтрокаСоединения);
КонецПроцедуры

&Тест
Процедура БессхемныеКоннекторыРеализуютИнтерфейсМиграций() Экспорт
	ИнтерфейсМиграций = Новый ИнтерфейсОбъекта();
	ИнтерфейсМиграций.ИзОбъекта(Тип("АбстрактныйКоннекторМиграций"));

	РефлекторОбъекта = Новый РефлекторОбъекта(Тип("КоннекторJSON"));
	РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсМиграций, Истина);

	РефлекторОбъекта = Новый РефлекторОбъекта(Тип("КоннекторInMemory"));
	РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсМиграций, Истина);
КонецПроцедуры

&Тест
Процедура ПервичнаяИнициализацияФиксируетВерсиюБезВызоваВерсионныхОбработчиков() Экспорт
	Журнал = Новый Массив;

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.1.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("0.1.0", Журнал));
	Менеджер.Инициализировать();

	Ожидаем
		.Что(Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы(), "Версия схемы зафиксирована в служебной таблице")
		.Равно("0.1.0");
	Ожидаем.Что(Журнал, "Версионные обработчики не вызываются при первичной инициализации").ИмеетДлину(0);

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ДобавлениеКолонкиМигрируетСтрокиХранилища() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия1;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.Инициализировать();

	Ожидаем
		.Что(ФайлТаблицыСодержит("МигрируемыеСущности", "Приоритет"), "Строки хранилища получили новую колонку")
		.ЭтоИстина();

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьВерсия2"), 1);
	Ожидаем.Что(ПолученнаяСущность.Наименование, "Данные сущности сохранились при миграции").Равно("Первая");

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура КонвейерВерсийВыполняетсяПоВозрастаниюНезависимоОтПорядкаРегистрации() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.1.0");
	Менеджер.Инициализировать();
	Менеджер.Закрыть();

	Журнал = Новый Массив;

	// Обновление с 0.1.0 сразу на 0.3.0 через промежуточные версии 0.2.0 и 0.2.5.
	// Обработчики регистрируются вразнобой.
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.3.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("0.3.0", Журнал));
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("", Журнал));
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("0.2.5", Журнал));
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("0.2.0", Журнал));
	Менеджер.Инициализировать();

	Ожидаем.Что(Журнал, "Вызваны все обработчики конвейера").ИмеетДлину(8);
	Ожидаем.Что(Журнал[0]).Равно("ПередМиграцией");
	Ожидаем.Что(Журнал[1]).Равно("ПередМиграцией 0.2.0");
	Ожидаем.Что(Журнал[2]).Равно("ПередМиграцией 0.2.5");
	Ожидаем.Что(Журнал[3]).Равно("ПередМиграцией 0.3.0");
	Ожидаем.Что(Журнал[4]).Равно("ПослеМиграции 0.2.0");
	Ожидаем.Что(Журнал[5]).Равно("ПослеМиграции 0.2.5");
	Ожидаем.Что(Журнал[6]).Равно("ПослеМиграции 0.3.0");
	Ожидаем.Что(Журнал[7]).Равно("ПослеМиграции");

	Ожидаем
		.Что(Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы(), "Зафиксирована целевая версия схемы")
		.Равно("0.3.0");

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ОбработчикиНеВыполняютсяПовторноПриНеизменнойВерсии() Экспорт
	Журнал = Новый Массив;

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.2.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("0.2.0", Журнал));
	Менеджер.Инициализировать();
	Менеджер.Закрыть();

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.2.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикМиграцииДляТестов("0.2.0", Журнал));
	Менеджер.Инициализировать();

	Ожидаем.Что(Журнал, "Обработчики не вызывались: версия схемы не изменялась").ИмеетДлину(0);

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ПонижениеВерсииСхемыВызываетИсключение() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.2.0");
	Менеджер.Инициализировать();
	Менеджер.Закрыть();

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.1.0");

	ПараметрыМетода = Новый Массив;
	Ожидаем
		.Что(Менеджер)
		.Метод("Инициализировать", ПараметрыМетода)
		.ВыбрасываетИсключение("Понижение версии схемы не поддерживается");
КонецПроцедуры

&Тест
Процедура НеполнаяВерсияДополняетсяНулямиДоСемантической() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
