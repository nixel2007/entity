	Менеджер.Инициализировать();

	Ожидаем
		.Что(Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы(), "Версия дополнена до формата МАЖОР.МИНОР.ПАТЧ")
		.Равно("0.1.0");

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ОбработчикЗаполняетДанныеПриПовышенииВерсии() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.1.0");
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия1;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.УстановитьВерсиюСхемы("0.2.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикЗаполненияПриоритета);
	Менеджер.Инициализировать();

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьВерсия2"), 1);
	Ожидаем.Что(ПолученнаяСущность.Приоритет, "Обработчик миграции заполнил данные новой колонки").Равно(1);

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ЛишниеКолонкиНеУдаляютсяПоУмолчанию() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия2;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Сущность.Приоритет = 5;
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.Инициализировать();

	Ожидаем
		.Что(ФайлТаблицыСодержит("МигрируемыеСущности", "Приоритет"), "Лишняя колонка сохранена в хранилище")
		.ЭтоИстина();

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ЛишниеКолонкиУдаляютсяПриВключеннойОпции() Экспорт
	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия2;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Сущность.Приоритет = 5;
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = НовыйМенеджер();
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.ПолучитьМиграторСхемы().УстановитьУдалениеЛишнихКолонок(Истина);
	Менеджер.Инициализировать();

	Ожидаем
		.Что(ФайлТаблицыСодержит("МигрируемыеСущности", "Приоритет"), "Лишняя колонка удалена из хранилища")
		.ЭтоЛожь();

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьВерсия1"), 1);
	Ожидаем.Что(ПолученнаяСущность.Наименование, "Данные остальных колонок сохранились").Равно("Первая");

	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура КоннекторБезПоддержкиМиграцийИнициализируетсяПоСтарому() Экспорт
	Менеджер = Новый МенеджерСущностей(Тип("АбстрактныйКоннектор"));
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.Инициализировать();
	Менеджер.Закрыть();
КонецПроцедуры

&Тест
Процедура ОбработчикБезМетодовМиграцииНеРегистрируется() Экспорт
	Менеджер = НовыйМенеджер();
	Мигратор = Менеджер.ПолучитьМиграторСхемы();

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Новый ПростойОбъект);
	Ожидаем
		.Что(Мигратор)
		.Метод("ДобавитьОбработчикМиграции", ПараметрыМетода)
		.ВыбрасываетИсключение("должен реализовывать хотя бы один из методов");
КонецПроцедуры

Функция НовыйМенеджер()
	Возврат Новый МенеджерСущностей(Тип("КоннекторJSON"), СтрокаСоединения);
КонецФункции

Функция ФайлТаблицыСодержит(Знач ИмяТаблицы, Знач Подстрока)
	ИмяФайла = ОбъединитьПути(СтрокаСоединения, ИмяТаблицы) + ".json";
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, "UTF-8");
	ТекстФайла = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Возврат СтрНайти(ТекстФайла, Подстрока) > 0;
КонецФункции
