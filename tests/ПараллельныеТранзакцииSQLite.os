// Параллельная монопольная работа с SQLite из разных потоков исполнения: каждое действие сначала
// читает, потом пишет.
//
// Отложенная транзакция SQLite берет блокировку записи только на первой записи. Две такие
// транзакции, обе успевшие прочитать, ждут друг друга: первая не может зафиксироваться, пока вторая
// держит блокировку чтения, вторая не может писать, пока первая держит блокировку записи. Ожидание
// кончается ошибкой "database is locked". Монопольное действие начинает транзакцию сразу с
// блокировкой записи и ждет предшественницу на начале, до чтения: взаимной блокировки нет.
//
// База - файл: база в памяти с общим кэшем ведет блокировки иначе.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// Массив из ИсточникДанных - Источники, созданные тестом.
Перем СозданныеИсточники;
// МенеджерСущностей - Менеджер теста; закрывается после теста.
Перем МенеджерСущностей;
// Строка - Файл базы теста; удаляется после теста.
Перем ФайлБазы;
// Строка - Строка соединения с базой теста.
Перем СтрокаСоединения;

&ВключенЕсли("() -> ЗапускатьТестыSQLite()")
&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Определяет, доступна ли в текущем окружении база SQLite.
//
// Возвращаемое значение:
//   Булево - Истина, если набор нужно выполнять.
//
Функция ЗапускатьТестыSQLite() Экспорт
	Возврат ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true") = "true";
КонецФункции

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СигналСобытия.os"),
		"СигналСобытия"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ЧтениеИЗаписьАвтора.os"),
		"ЧтениеИЗаписьАвтора"
	);

	СозданныеИсточники = Новый Массив;
	ФайлБазы = ПолучитьИмяВременногоФайла("sqlite");

	// Ожидание занятой базы - 3 секунды вместо 30 по умолчанию: взаимная блокировка кончается
	// ошибкой быстро.
	СтрокаСоединения = "Data Source=" + ФайлБазы + ";Default Timeout=3";

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), СтрокаСоединения);
	СозданныеИсточники.Добавить(Источник);
	// oneunit исполняет подготовку и тест в разных потоках: источник живет до ПослеКаждого.
	Источник.УстановитьАвтоЗакрытие(Ложь);

	МенеджерСущностей = ТестовыеУтилиты.МенеджерАвторов(Источник);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	ТестовыеУтилиты.ЗакрытьИсточники(СозданныеИсточники);
	УдалитьФайлы(ФайлБазы);
КонецПроцедуры

// Два монопольных действия читают таблицу, дожидаются друг друга и пишут в нее. Оба должны
// завершиться.
//
&Тест
Процедура МонопольныеДействияСЧтениемИЗаписьюНеБлокируютДругДруга() Экспорт

	ПервыйПрочитал = Новый СигналСобытия;
	ВторойПрочитал = Новый СигналСобытия;

	Задания = Новый Массив;
	Попытка
		Задания.Добавить(ЗапуститьЗадание("Первый", ПервыйПрочитал, ВторойПрочитал));
		Задания.Добавить(ЗапуститьЗадание("Второй", ВторойПрочитал, ПервыйПрочитал));
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания);

	Строки = ТестовыеУтилиты.ВыполнитьЗапрос(МенеджерСущностей, "SELECT Имя FROM Авторы");
	Ожидаем.Что(Строки, "Оба действия записали").ИмеетДлину(2);

КонецПроцедуры

// Запускает задание, выполняющее монопольное действие своим коннектором.
//
// Параметры:
//   Имя - Строка - Имя записываемого автора.
//   СвойСигнал - СигналСобытия - Отмечается заданием после чтения.
//   ЧужойСигнал - СигналСобытия - Чтение другого задания.
//
// Возвращаемое значение:
//   ФоновоеЗадание - Запущенное задание.
//
Функция ЗапуститьЗадание(Знач Имя, СвойСигнал, ЧужойСигнал)

	Параметры = Новый Массив;
	Параметры.Добавить(СтрокаСоединения);
	Параметры.Добавить(Имя);
	Параметры.Добавить(СвойСигнал);
	Параметры.Добавить(ЧужойСигнал);

	Возврат ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПрочитатьИЗаписатьМонопольноВФоне", Параметры, Истина);

КонецФункции

// Открывает свой коннектор и выполняет им монопольно чтение и запись. Выполняется фоновым
// заданием.
//
// Параметры:
//   СтрокаСоединенияБазы - Строка - Строка соединения с базой теста.
//   Имя - Строка - Имя записываемого автора.
//   СвойСигнал - СигналСобытия - Отмечается после чтения.
//   ЧужойСигнал - СигналСобытия - Чтение другого задания.
//
Процедура ПрочитатьИЗаписатьМонопольноВФоне(Знач СтрокаСоединенияБазы, Знач Имя, СвойСигнал, ЧужойСигнал) Экспорт

	Коннектор = Новый КоннекторSQLite;
	Коннектор.Открыть(СтрокаСоединенияБазы, Новый Массив);

	Попытка
		Действие = Новый ЧтениеИЗаписьАвтора(Коннектор, Имя, СвойСигнал, ЧужойСигнал);
		Коннектор.ВыполнитьМонопольно(Новый Действие(Действие, "Записать"));
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Коннектор.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Коннектор.Закрыть();

КонецПроцедуры
