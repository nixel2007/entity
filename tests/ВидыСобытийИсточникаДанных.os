// Модуль-перечисление ВидыСобытийИсточникаДанных: значения совпадают с видами событий, которые
// источник данных отдает наблюдателям, поэтому наблюдатель сравнивает Вид() с перечислением,
// а не со строковыми литералами.
//
// BSLLS:MagicNumber-off

#Использовать ".."
#Использовать "utils"

&Тест
Процедура ПеречислениеСодержитВсеВидыВПорядкеОбъявления() Экспорт

	Виды = ВидыСобытийИсточникаДанных.Виды();

	Ожидаем.Что(Виды, "Перечень нельзя изменить извне").ИмеетТип("ФиксированныйМассив");
	Ожидаем.Что(Виды).ИмеетДлину(4);
	Ожидаем.Что(Виды[0]).Равно(ВидыСобытийИсточникаДанных.Операция());
	Ожидаем.Что(Виды[1]).Равно(ВидыСобытийИсточникаДанных.Запрос());
	Ожидаем.Что(Виды[2]).Равно(ВидыСобытийИсточникаДанных.Соединение());
	Ожидаем.Что(Виды[3]).Равно(ВидыСобытийИсточникаДанных.Транзакция());

КонецПроцедуры

&Тест
Процедура ЗначенияПеречисленияСовпадаютСВидамиСобытийИсточникаДанных() Экспорт

	ПодключитьФикстуры();

	// Операции, запросы и соединения - на InMemory; транзакции он не поддерживает,
	// их изображает тестовый коннектор поверх него.
	Наблюдатель = НаблюдательПослеРаботы(Тип("КоннекторInMemory"), "виды-событий");
	НаблюдательТранзакций = НаблюдательПослеРаботы(Тип("КоннекторТранзакцийДляТестов"), "виды-событий-транзакции");

	Ожидаем.Что(Наблюдатель.Завершенные(ВидыСобытийИсточникаДанных.Операция(), "Сохранить")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные(ВидыСобытийИсточникаДанных.Запрос(), "INSERT")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные(ВидыСобытийИсточникаДанных.Соединение(), "Занять")).Не_().ИмеетДлину(0);
	Ожидаем.Что(НаблюдательТранзакций.Завершенные(ВидыСобытийИсточникаДанных.Транзакция())).ИмеетДлину(1);

	// Каждое событие несет ровно одно из значений перечисления.
	Виды = ВидыСобытийИсточникаДанных.Виды();
	Для Каждого Запись Из Наблюдатель.Записи Цикл
		Ожидаем.Что(Виды.Найти(Запись.Событие.Вид()), Запись.Событие.Вид()).Не_().Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Служебные

// Прогоняет через менеджер на указанном коннекторе сохранение внутри транзакции и возвращает
// наблюдателя с записанными событиями.
//
// Параметры:
//   ТипКоннектора - Тип - Тип коннектора тестовой базы.
//   СтрокаСоединения - Строка - Строка соединения с тестовой базой.
//
// Возвращаемое значение:
//   НаблюдательЗаписывающий - Наблюдатель с записанными событиями.
//
Функция НаблюдательПослеРаботы(Знач ТипКоннектора, Знач СтрокаСоединения)

	ХранилищеВПамяти.Очистить(СтрокаСоединения);

	Источник = Новый ИсточникДанных("виды", ТипКоннектора, СтрокаСоединения);
	Наблюдатель = Новый НаблюдательЗаписывающий;
	Источник.ДобавитьНаблюдателя(Наблюдатель);

	МенеджерСущностей = Новый МенеджерСущностей(Источник);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ПростойОбъект"));
	МенеджерСущностей.Инициализировать();

	Если ТипКоннектора <> Тип("КоннекторInMemory") Тогда
		МенеджерСущностей.НачатьТранзакцию();
	КонецЕсли;
	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	Если ТипКоннектора <> Тип("КоннекторInMemory") Тогда
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	КонецЕсли;
	МенеджерСущностей.Закрыть();

	Возврат Наблюдатель;

КонецФункции

Функция НовыйПростойОбъект(Знач Идентификатор)
	Объект = Новый ПростойОбъект;
	Объект.Идентификатор = Строка(Идентификатор);
	Объект.Поле = "поле " + Идентификатор;
	Возврат Объект;
КонецФункции

Процедура ПодключитьФикстуры()

	Фикстуры = Новый Массив;
	Фикстуры.Добавить("ПростойОбъект");
	Фикстуры.Добавить("НаблюдательЗаписывающий");
	Фикстуры.Добавить("КоннекторТранзакцийДляТестов");

	Для Каждого Фикстура Из Фикстуры Цикл
		ПодключитьСценарий(
			ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", Фикстура + ".os"),
			Фикстура
		);
	КонецЦикла;

КонецПроцедуры
