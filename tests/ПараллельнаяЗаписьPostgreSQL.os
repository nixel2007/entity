// Параллельная запись сущностей одного типа из разных потоков исполнения.
//
// Пока коннектор был один на менеджер, вставку одного типа сериализовал семафор по имени типа:
// без него вставка и получение идентификатора на общем соединении разъезжались. Сейчас соединение
// принадлежит потоку, семафор снят, и записи должны идти параллельно, не теряя строк и не
// выдавая двум сущностям один идентификатор.
//
// Тест только для PostgreSQL: SQLite с общим кэшем параллельных писателей не допускает и отвечает
// "database table is locked".
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;

&ВключенЕсли("() -> ЗапускатьТестыPostgreSQL()")
&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Определяет, доступна ли в текущем окружении база PostgreSQL.
//
// Возвращаемое значение:
//   Булево - Истина, если набор нужно выполнять.
//
Функция ЗапускатьТестыPostgreSQL() Экспорт
	Возврат ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true") = "true";
КонецФункции

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	МенеджерСущностей = Новый МенеджерСущностей(Тип("КоннекторPostgreSQL"), СтрокаСоединенияPostgres());

	ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
КонецПроцедуры

// Четыре задания одновременно пишут авторов. Ни одна строка не должна потеряться, и ни один
// идентификатор не должен достаться двум сущностям.
//
&Тест
Процедура ПараллельнаяЗаписьОдногоТипаНеТеряетСтрокИИдентификаторов() Экспорт

	Задания = Новый Массив;
	Запущено = 0;
	Пока Запущено < 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СохранитьАвторовВФоне", Новый Массив, Истина));
		Запущено = Запущено + 1;
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Если НЕ Задание.ОжидатьЗавершения(60000) Тогда
			ВызватьИсключение "Фоновое задание не завершилось за 60 секунд";
		КонецЕсли;
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	КонецЦикла;

	Строки = ТестовыеУтилиты.ВыполнитьЗапрос(МенеджерСущностей, "SELECT Идентификатор FROM Авторы");

	Ожидаем.Что(Строки, "Сохранились все строки всех заданий").ИмеетДлину(100);

	Идентификаторы = Новый Соответствие();
	Для Каждого Строка Из Строки Цикл
		Идентификаторы.Вставить(Строка.Идентификатор, Истина);
	КонецЦикла;

	Ожидаем.Что(Идентификаторы.Количество(), "Все идентификаторы различны").Равно(100);

КонецПроцедуры

// Сохраняет авторов в цикле. Запускается в фоновом задании.
//
Процедура СохранитьАвторовВФоне() Экспорт

	Сохранено = 0;
	Пока Сохранено < 25 Цикл

		Автор = Новый Автор;
		Автор.Имя = "Автор";
		Автор.ВтороеИмя = "Иванов";
		МенеджерСущностей.Сохранить(Автор);

		Сохранено = Сохранено + 1;

	КонецЦикла;

КонецПроцедуры

// Возвращает строку соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
