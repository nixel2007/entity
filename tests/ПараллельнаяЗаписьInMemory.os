// Параллельная работа с базой в памяти из разных контекстов исполнения.
//
// Таблицы и счетчики идентификаторов базы в памяти общие на строку подключения, а коннекторы
// разные: пул выдает каждому контексту свой. Таблица значений параллельного изменения не
// переживает, поэтому коннектор изменяет данные под блокировкой записи, а читает под блокировкой
// чтения. Тесты проверяют, что запись не теряет строк и не выдает двум сущностям один
// идентификатор, а чтение не падает на изменяемой таблице.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Строка - Строка соединения с базой в памяти.
Перем СтрокаСоединения;

Процедура ПередЗапускомТеста() Экспорт

	СтрокаСоединения = "ПараллельнаяЗаписьInMemory";
	ХранилищеВПамяти.Очистить(СтрокаСоединения);

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	МенеджерСущностей = Новый МенеджерСущностей(Тип("КоннекторInMemory"), СтрокаСоединения);

	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
КонецПроцедуры

// Четыре задания одновременно пишут авторов. Ни одна строка не должна потеряться, и ни один
// идентификатор не должен достаться двум сущностям.
//
&Тест
Процедура ПараллельнаяЗаписьОдногоТипаНеТеряетСтрокИИдентификаторов() Экспорт

	ДождатьсяЗаданий(ЗапуститьЗадания("СохранитьАвторовВФоне", 4));

	Авторы = МенеджерСущностей.Получить(Тип("Автор"));

	Ожидаем.Что(Авторы, "Сохранились все строки всех заданий").ИмеетДлину(400);

	Идентификаторы = Новый Соответствие();
	Для Каждого Автор Из Авторы Цикл
		Идентификаторы.Вставить(Автор.ВнутреннийИдентификатор, Истина);
	КонецЦикла;

	Ожидаем.Что(Идентификаторы.Количество(), "Все идентификаторы различны").Равно(400);

КонецПроцедуры

// Пока два задания пишут, два других читают ту же таблицу. Чтение не должно падать на
// изменяемой таблице значений.
//
&Тест
Процедура ЧтениеПараллельноЗаписиНеПадает() Экспорт

	Задания = ЗапуститьЗадания("СохранитьАвторовВФоне", 2);
	Для Каждого Задание Из ЗапуститьЗадания("ПрочитатьАвторовВФоне", 2) Цикл
		Задания.Добавить(Задание);
	КонецЦикла;

	ДождатьсяЗаданий(Задания);

	Авторы = МенеджерСущностей.Получить(Тип("Автор"));

	Ожидаем.Что(Авторы, "Сохранились все строки пишущих заданий").ИмеетДлину(200);

КонецПроцедуры

// Сохраняет авторов в цикле. Запускается в фоновом задании.
//
Процедура СохранитьАвторовВФоне() Экспорт

	Сохранено = 0;
	Пока Сохранено < 100 Цикл

		Автор = Новый Автор;
		Автор.Имя = "Автор";
		Автор.ВтороеИмя = "Иванов";
		МенеджерСущностей.Сохранить(Автор);

		Сохранено = Сохранено + 1;

	КонецЦикла;

КонецПроцедуры

// Читает авторов в цикле. Запускается в фоновом задании.
//
Процедура ПрочитатьАвторовВФоне() Экспорт

	Прочитано = 0;
	Пока Прочитано < 25 Цикл

		МенеджерСущностей.Получить(Тип("Автор"));

		Прочитано = Прочитано + 1;

	КонецЦикла;

КонецПроцедуры

// Запускает фоновые задания указанного метода.
//
// Параметры:
//   ИмяМетода - Строка - Метод, выполняемый заданием.
//   Количество - Число - Число запускаемых заданий.
//
// Возвращаемое значение:
//   Массив - Запущенные фоновые задания.
//
Функция ЗапуститьЗадания(Знач ИмяМетода, Знач Количество)

	Задания = Новый Массив;

	Запущено = 0;
	Пока Запущено < Количество Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Новый Массив, Истина));
		Запущено = Запущено + 1;
	КонецЦикла;

	Возврат Задания;

КонецФункции

// Ожидает завершения фоновых заданий и перевыбрасывает их ошибки.
//
// Параметры:
//   Задания - Массив - Фоновые задания, завершения которых нужно дождаться.
//
Процедура ДождатьсяЗаданий(Знач Задания)

	Для Каждого Задание Из Задания Цикл

		Если НЕ Задание.ОжидатьЗавершения(60000) Тогда
			ВызватьИсключение "Фоновое задание не завершилось за 60 секунд";
		КонецЕсли;

		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
