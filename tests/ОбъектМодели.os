#Использовать ".."

#Использовать asserts

&Тест
Процедура КонструкторОбъектаМоделиКорректноАнализируетКласс() Экспорт
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"), "Автор");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"), "СущностьБезГенерируемогоИдентификатора");
	
	ОбъектМодели = Новый ОбъектМодели(Тип("Автор"), Неопределено);
	
	Ожидаем.Что(ОбъектМодели.ИмяТаблицы(), "Имя таблицы определено корректно").Равно("Авторы");
	
	Ожидаем.Что(ОбъектМодели.Колонки(), "Сущность имеет четыре колонки").ИмеетДлину(4);
	
	Идентификатор = ОбъектМодели.Идентификатор(); 
	Ожидаем.Что(Идентификатор, "Таблица имеет идентификатор").Не_().Равно(Неопределено);

	Ожидаем.Что(Идентификатор.ИмяПоля, "Идентификатор таблицы указывает на корректное поле").Равно("ВнутреннийИдентификатор");
	Ожидаем.Что(Идентификатор.ИмяКолонки, "Идентификатор таблицы имеет корректное имя колонки").Равно("Идентификатор");
	Ожидаем.Что(Идентификатор.ТипКолонки, "Идентификатор таблицы имеет корректный тип колонки").Равно(ТипыКолонок.Целое);
	Ожидаем.Что(Идентификатор.ГенерируемоеЗначение, "Идентификатор таблицы имеет флаг автоинкремента").Равно(Истина);
	Ожидаем.Что(Идентификатор.ГенерируемоеЗначение, "Идентификатор таблицы имеет флаг идентификатора").Равно(Истина);
	
	Колонки = ОбъектМодели.Колонки();
	Ожидаем.Что(Колонки[0].ИмяПоля, "Первая колонка - внутренний идентификатор").Равно("ВнутреннийИдентификатор");

	Ожидаем.Что(Колонки[1].ИмяПоля, "Вторая колонка - Имя").Равно("Имя");
	Ожидаем.Что(Колонки[1].ИмяКолонки, "Имя поля второй колонки корректно").Равно("Имя");
	Ожидаем.Что(Колонки[1].ТипКолонки, "Тип второй колонки корректен").Равно(ТипыКолонок.Строка);
	
	Ожидаем.Что(Колонки[2].ИмяПоля, "Третья колонка - ВтороеИмя").Равно("ВтороеИмя");
	Ожидаем.Что(Колонки[2].ИмяКолонки, "Имя третье колонки корректно").Равно("Фамилия");
	Ожидаем.Что(Колонки[2].ТипКолонки, "Тип третьей колонки корректен").Равно(ТипыКолонок.Строка);

	Ожидаем.Что(Колонки[3].ИмяКолонки, "Четвертая колонка - ВнешняяСущность").Равно("ВнешняяСущность");
	Ожидаем.Что(Колонки[3].ТипКолонки, "Тип четвертой колонки корректен").Равно(ТипыКолонок.Ссылка);
	Ожидаем.Что(Колонки[3].ТипСсылки, "Тип ссылки четвертой колонки определился").Равно(Тип("СущностьБезГенерируемогоИдентификатора"));

	ИсточникиДанных = ОбъектМодели.ИсточникиДанных();
	Ожидаем.Что(ИсточникиДанных, "Объект модели имеет источники данных").ИмеетДлину(2);
	Ожидаем.Что(ИсточникиДанных[0], "Первый источник данных имеет корректное имя").Равно("Основной");
	Ожидаем.Что(ИсточникиДанных[1], "Второй источник данных имеет корректное имя").Равно("Дополнительный");

КонецПроцедуры

// Колонки() отдает копию: правка результата не меняет ни модель, ни приведение значений по ней.
&Тест
Процедура ИзменениеКопииКолонокНеМеняетПриведение() Экспорт

	ОбъектМодели = НовыйОбъектМоделиАвтора();

	Колонки = ОбъектМодели.Колонки();
	Колонки.Найти("Имя", "ИмяПоля").ТипКолонки = ТипыКолонок.Целое;

	Ожидаем.Что(ОбъектМодели.Колонки().Найти("Имя", "ИмяПоля").ТипКолонки, "Модель не видит правку копии")
		.Равно(ТипыКолонок.Строка);
	Ожидаем.Что(ОбъектМодели.ПривестиЗначениеПоля("12", "Имя"), "Поле приводится по типу модели")
		.Равно("12");

	Автор = Новый Автор;
	ОбъектМодели.УстановитьЗначениеКолонкиВПоле(Автор, "Имя", "12");
	Ожидаем.Что(Автор.Имя, "Колонка устанавливается по типу модели").Равно("12");

КонецПроцедуры

// Служебные колонки - сама таблица модели: так ОбработкаКоллекций донастраивает типы колонок
// объекта модели элемента коллекции. Правка видна и поиску колонки, и приведению значения.
&Тест
Процедура ИзменениеСлужебныхКолонокМеняетПриведение() Экспорт

	ОбъектМодели = НовыйОбъектМоделиАвтора();

	ОбъектМодели.Служебный_Колонки().Найти("Имя", "ИмяПоля").ТипКолонки = ТипыКолонок.Целое;

	Ожидаем.Что(ОбъектМодели.Колонки().Найти("Имя", "ИмяПоля").ТипКолонки, "Модель видит правку")
		.Равно(ТипыКолонок.Целое);
	Ожидаем.Что(ОбъектМодели.ПривестиЗначениеПоля("12", "Имя"), "Поле приводится по новому типу")
		.Равно(12);

	Автор = Новый Автор;
	ОбъектМодели.УстановитьЗначениеКолонкиВПоле(Автор, "Имя", "12");
	Ожидаем.Что(Автор.Имя, "Колонка устанавливается по новому типу").Равно(12);

	Автор.Имя = "34";
	Ожидаем.Что(ОбъектМодели.ПолучитьПриведенноеЗначениеПоля(Автор, "Имя"), "Значение поля приводится по новому типу")
		.Равно(34);

КонецПроцедуры

// Поле ищется по имени поля, колонка - по имени колонки: у поля ВтороеИмя колонка Фамилия.
&Тест
Процедура ПолеИКолонкаИщутсяКаждыйПоСвоемуИмени() Экспорт

	ОбъектМодели = НовыйОбъектМоделиАвтора();

	Автор = Новый Автор;
	ОбъектМодели.УстановитьЗначениеКолонкиВПоле(Автор, "Фамилия", "Иванов");
	Ожидаем.Что(Автор.ВтороеИмя, "Колонка Фамилия пишется в поле ВтороеИмя").Равно("Иванов");

	Ожидаем.Что(ОбъектМодели.ПривестиЗначениеПоля(5, "ВтороеИмя"), "Поле ВтороеИмя приводится к строке")
		.Равно("5");
	Ожидаем.Что(ОбъектМодели.ПолучитьПриведенноеЗначениеПоля(Автор, "ВтороеИмя"), "Поле ВтороеИмя читается")
		.Равно("Иванов");

КонецПроцедуры

// Исключение проверяется явной попыткой: ВыбрасываетИсключение() из asserts без фрагмента текста
// проходит и тогда, когда исключения не было, а текст этой ошибки зависит от локали.
&Тест
Процедура НеизвестноеПолеНеПриводится() Экспорт

	ОбъектМодели = НовыйОбъектМоделиАвтора();

	ИсключениеВозникло = Ложь;
	Попытка
		ОбъектМодели.ПривестиЗначениеПоля(1, "НетТакогоПоля");
	Исключение
		ИсключениеВозникло = Истина;
	КонецПопытки;

	Ожидаем.Что(ИсключениеВозникло, "Неизвестное поле не приводится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеизвестнаяКолонкаНеУстанавливается() Экспорт

	ОбъектМодели = НовыйОбъектМоделиАвтора();

	ИсключениеВозникло = Ложь;
	Попытка
		ОбъектМодели.УстановитьЗначениеКолонкиВПоле(Новый Автор, "НетТакойКолонки", 1);
	Исключение
		ИсключениеВозникло = Истина;
	КонецПопытки;

	Ожидаем.Что(ИсключениеВозникло, "Неизвестная колонка не устанавливается").ЭтоИстина();

КонецПроцедуры

// Идентификатор отдается неизменяемым: правка результата невозможна и модель не меняет.
&Тест
Процедура ИдентификаторНеизменяем() Экспорт

	ОбъектМодели = НовыйОбъектМоделиАвтора();

	Ожидаем.Что(ТипЗнч(ОбъектМодели.Идентификатор()), "Идентификатор - фиксированная структура")
		.Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(ОбъектМодели.Идентификатор().ИмяКолонки, "Идентификатор тот же при повторном обращении")
		.Равно("Идентификатор");

КонецПроцедуры

Функция НовыйОбъектМоделиАвтора()
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"), "Автор");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"), "СущностьБезГенерируемогоИдентификатора");
	Возврат Новый ОбъектМодели(Тип("Автор"), Неопределено);
КонецФункции
