// Наблюдатели источника данных: регистрация и события уровня операции.
//
// Наблюдатель регистрируется на источнике данных, а менеджер создается из источника и отдает
// наблюдателям события всех операций: самого менеджера, его хранилищ и Active Record.
// База - InMemory: события операций от коннектора не зависят.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// Источник данных, на котором зарегистрирован наблюдатель.
Перем Источник;
// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Наблюдатель, зарегистрированный на источнике до создания менеджера.
Перем Наблюдатель;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ПодключитьФикстуры();

	ХранилищеВПамяти.Очистить("наблюдатели");

	СоздатьМенеджерСНаблюдателем();

КонецПроцедуры

// Создает источник с зарегистрированным наблюдателем и менеджер из него, не трогая данные базы в памяти.
Процедура СоздатьМенеджерСНаблюдателем()

	Источник = Новый ИсточникДанных("наблюдатели", Тип("КоннекторInMemory"), "наблюдатели");
	// Подготовка и тест идут в разных потоках: с автозакрытием источник умер бы до теста.
	Источник.УстановитьАвтоЗакрытие(Ложь);
	Наблюдатель = Новый НаблюдательЗаписывающий;
	Источник.ДобавитьНаблюдателя(Наблюдатель);

	МенеджерСущностей = НовыйМенеджер(Источник);

КонецПроцедуры

// Создает и инициализирует менеджер из источника с моделью тестовых сущностей.
//
// Параметры:
//   ИсточникМенеджера - ИсточникДанных - Источник, из которого создается менеджер.
//
// Возвращаемое значение:
//   МенеджерСущностей - Инициализированный менеджер.
//
Функция НовыйМенеджер(Знач ИсточникМенеджера)

	Менеджер = Новый МенеджерСущностей(ИсточникМенеджера);
	Менеджер.ДобавитьКлассВМодель(Тип("ПростойОбъект"));
	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Возврат Менеджер;

КонецФункции

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	Источник.Закрыть();
КонецПроцедуры

// Регистрация

&Тест
Процедура ДобавитьНаблюдателяОтвергаетОбъектБезОбъявленияИнтерфейса() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Новый ПростойОбъект);

	Ожидаем.Что(Источник)
		.Метод("ДобавитьНаблюдателя", Параметры)
		.ВыбрасываетИсключение("НаблюдательИсточникаДанных");

КонецПроцедуры

&Тест
Процедура ДобавитьНаблюдателяОтвергаетНеполнуюРеализацию() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Новый НаблюдательНеполный);

	Ожидаем.Что(Источник)
		.Метод("ДобавитьНаблюдателя", Параметры)
		.ВыбрасываетИсключение("ПослеСобытия");

КонецПроцедуры

&Тест
Процедура УдаленныйНаблюдательСобытийНеПолучает() Экспорт

	Источник.УдалитьНаблюдателя(Наблюдатель);
	КоличествоДоУдаления = Наблюдатель.Записи.Количество();

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Ожидаем.Что(Наблюдатель.Записи).ИмеетДлину(КоличествоДоУдаления);

КонецПроцедуры

&Тест
Процедура МенеджерБеретРазмерПулаИзИсточника() Экспорт

	ИсточникСПулом = Новый ИсточникДанных("пул", Тип("КоннекторInMemory"), "наблюдатели", , 3);
	НаблюдательПула = Новый НаблюдательЗаписывающий;
	ИсточникСПулом.ДобавитьНаблюдателя(НаблюдательПула);

	Менеджер = НовыйМенеджер(ИсточникСПулом);
	Менеджер.Закрыть();

	Захваты = НаблюдательПула.Завершенные("Соединение", "Занять");
	Ожидаем.Что(Захваты, "Инициализация занимала соединение").Не_().ИмеетДлину(0);
	Ожидаем.Что(Захваты[0].Предел()).Равно(3);

КонецПроцедуры

&Тест
Процедура МенеджерыОдногоИсточникаДелятНаблюдателей() Экспорт

	Второй = НовыйМенеджер(Источник);

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	Второй.Сохранить(НовыйПростойОбъект(2));
	Второй.Закрыть();

	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Сохранить"), "События обоих менеджеров").ИмеетДлину(2);
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Инициализировать")).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура НаблюдательДобавленныйПослеСозданияМенеджераПолучаетСобытия() Экспорт

	Поздний = Новый НаблюдательЗаписывающий;
	Источник.ДобавитьНаблюдателя(Поздний);

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Ожидаем.Что(Поздний.Завершенные("Операция", "Сохранить"), "Реестр у источника и менеджера общий").ИмеетДлину(1);

КонецПроцедуры

// Операции

&Тест
Процедура СохранениеПорождаетСобытиеОперации() Экспорт

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Начатые = Наблюдатель.Начатые("Операция", "Сохранить");
	Завершенные = Наблюдатель.Завершенные("Операция", "Сохранить");

	Ожидаем.Что(Начатые).ИмеетДлину(1);
	Ожидаем.Что(Завершенные).ИмеетДлину(1);
	Ожидаем.Что(Завершенные[0], "В обеих фазах приходит один и тот же объект события").Равно(Начатые[0]);

	Событие = Завершенные[0];
	Ожидаем.Что(Событие).ИмеетТип("СобытиеИсточникаДанных");
	Ожидаем.Что(Событие.Вид()).Равно("Операция");
	Ожидаем.Что(Событие.Операция()).Равно("Сохранить");
	Ожидаем.Что(Событие.ТипСущности()).Равно(Тип("ПростойОбъект"));
	Ожидаем.Что(Событие.ИмяТаблицы()).Равно("ПростыеОбъекты");
	Ожидаем.Что(Событие.ТипКоннектора()).Равно(Тип("КоннекторInMemory"));
	Ожидаем.Что(Событие.Глубина()).Равно(0);
	Ожидаем.Что(Событие.Длительность()).Не_().Меньше(0);
	Ожидаем.Что(Событие.Ошибка()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЧтениеСообщаетКоличествоПрочитанныхСтрок() Экспорт

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	МенеджерСущностей.Сохранить(НовыйПростойОбъект(2));

	МенеджерСущностей.Получить(Тип("ПростойОбъект"));
	МенеджерСущностей.ПолучитьОдно(Тип("ПростойОбъект"), "2");

	Чтения = Наблюдатель.Завершенные("Операция", "Получить");
	Ожидаем.Что(Чтения).ИмеетДлину(1);
	Ожидаем.Что(Чтения[0].КоличествоСтрок()).Равно(2);

	ЧтенияОдного = Наблюдатель.Завершенные("Операция", "ПолучитьОдно");
	Ожидаем.Что(ЧтенияОдного).ИмеетДлину(1);
	Ожидаем.Что(ЧтенияОдного[0].КоличествоСтрок()).Равно(1);

КонецПроцедуры

&Тест
Процедура УдалениеПорождаетСобытиеОперации() Экспорт

	Объект = НовыйПростойОбъект(1);
	МенеджерСущностей.Сохранить(Объект);
	МенеджерСущностей.Удалить(Объект);

	Удаления = Наблюдатель.Завершенные("Операция", "Удалить");
	Ожидаем.Что(Удаления).ИмеетДлину(1);
	Ожидаем.Что(Удаления[0].ТипСущности()).Равно(Тип("ПростойОбъект"));

КонецПроцедуры

&Тест
Процедура ИнициализацияПорождаетСобытиеОперации() Экспорт

	Инициализации = Наблюдатель.Завершенные("Операция", "Инициализировать");

	Ожидаем.Что(Инициализации).ИмеетДлину(1);
	Ожидаем.Что(Инициализации[0].ТипСущности()).Равно(Неопределено);
	Ожидаем.Что(Инициализации[0].Ошибка()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПрямойДоступПорождаетСобытиеОперации() Экспорт

	Результат = МенеджерСущностей.ВычислитьСКоннектором("Коннектор -> ТипЗнч(Коннектор)");
	МенеджерСущностей.ВыполнитьСКоннектором("Коннектор -> Коннектор.Открыт()");

	Ожидаем.Что(Результат).Равно(Тип("КоннекторInMemory"));
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "ВычислитьСКоннектором")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "ВыполнитьСКоннектором")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура РазыменованиеСсылкиДаетВложенноеСобытие() Экспорт

	Внешняя = Новый СущностьБезГенерируемогоИдентификатора;
	Внешняя.ВнутреннийИдентификатор = 7;
	МенеджерСущностей.Сохранить(Внешняя);

	Автор = Новый Автор;
	Автор.Имя = "Пушкин";
	Автор.ВнешняяСущность = Внешняя;
	МенеджерСущностей.Сохранить(Автор);

	// Пул сущностей уже знает внешнюю сущность, поэтому читаем новым менеджером над теми же данными.
	МенеджерСущностей.Закрыть();
	СоздатьМенеджерСНаблюдателем();

	Авторы = МенеджерСущностей.Получить(Тип("Автор"));
	Ожидаем.Что(Авторы).ИмеетДлину(1);

	Внешнее = Наблюдатель.Завершенные("Операция", "Получить");
	Вложенные = Наблюдатель.Завершенные("Операция", "ПолучитьОдно");

	Ожидаем.Что(Внешнее).ИмеетДлину(1);
	Ожидаем.Что(Внешнее[0].Глубина()).Равно(0);
	Ожидаем.Что(Внешнее[0].ТипСущности()).Равно(Тип("Автор"));

	Ожидаем.Что(Вложенные).ИмеетДлину(1);
	Ожидаем.Что(Вложенные[0].Глубина()).Равно(1);
	Ожидаем.Что(Вложенные[0].ТипСущности()).Равно(Тип("СущностьБезГенерируемогоИдентификатора"));

КонецПроцедуры

&Тест
Процедура ОшибкаОперацииПопадаетВСобытиеИДоходитДоВызывающего() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("Коннектор -> Коннектор.НесуществующийМетод()");

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВыполнитьСКоннектором", Параметры)
		.ВыбрасываетИсключение("НесуществующийМетод");

	Ошибочные = Наблюдатель.Завершенные("Операция", "ВыполнитьСКоннектором");
	Ожидаем.Что(Ошибочные).ИмеетДлину(1);
	Ожидаем.Что(Ошибочные[0].Ошибка()).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(Ошибочные[0].Ошибка().Описание).Содержит("НесуществующийМетод");

КонецПроцедуры

&Тест
Процедура ИсключениеНаблюдателяНеЛомаетОперацию() Экспорт

	СломанныйНаблюдатель = Новый НаблюдательЗаписывающий(Истина);
	Источник.ДобавитьНаблюдателя(СломанныйНаблюдатель);

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Ожидаем.Что(МенеджерСущностей.Получить(Тип("ПростойОбъект"))).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Сохранить"), "Исправный наблюдатель события получает").ИмеетДлину(1);
	ЗавершенияСломанного = СломанныйНаблюдатель.Завершенные("Операция", "Сохранить");
	Ожидаем.Что(ЗавершенияСломанного, "Сломанному наблюдателю завершение все равно приходит").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура СобытияХранилищаИАктивнойЗаписиПриходятНаблюдателямИсточникаДанных() Экспорт

	Хранилище = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("ПростойОбъект"));
	Хранилище.Сохранить(НовыйПростойОбъект(1));

	Элемент = МенеджерСущностей.СоздатьЭлемент(Тип("ПростойОбъект"));
	Элемент.Идентификатор = 2;
	Элемент.Сохранить();

	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "Сохранить")).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура СостояниеНаблюдателяЖиветВСобытииМеждуФазами() Экспорт

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Событие = Наблюдатель.Завершенные("Операция", "Сохранить")[0];
	Ожидаем.Что(Событие.Состояние()).Равно(Неопределено);

	Событие.УстановитьСостояние("метка");
	Ожидаем.Что(Событие.Состояние()).Равно("метка");

КонецПроцедуры

&Тест
Процедура СостояниеУКаждогоНаблюдателяСвое() Экспорт

	// Дано - два наблюдателя кладут в событие разные метки
	Первый = Новый НаблюдательСМеткой("первый");
	Второй = Новый НаблюдательСМеткой("второй");
	Источник.ДобавитьНаблюдателя(Первый);
	Источник.ДобавитьНаблюдателя(Второй);

	// Когда
	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	// Тогда - каждый в ПослеСобытия читает свою метку, а не последнюю записанную
	Ожидаем.Что(Первый.Увиденные).Не_().ИмеетДлину(0);
	Ожидаем.Что(Второй.Увиденные).ИмеетДлину(Первый.Увиденные.Количество());
	Для Каждого Состояние Из Первый.Увиденные Цикл
		Ожидаем.Что(Состояние).Равно("первый");
	КонецЦикла;
	Для Каждого Состояние Из Второй.Увиденные Цикл
		Ожидаем.Что(Состояние).Равно("второй");
	КонецЦикла;

	// Записывающий наблюдатель ничего не клал - и ничего не видит
	Событие = Наблюдатель.Завершенные("Операция", "Сохранить")[0];
	Ожидаем.Что(Событие.Состояние()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СнятыйВоВремяСобытияНаблюдательПолучаетЕгоЗавершение() Экспорт

	// Дано - наблюдатель, который в первом же ПередСобытием снимает себя с регистрации
	Отписывающийся = Новый НаблюдательПереподписывающийся(Источник);
	Источник.ДобавитьНаблюдателя(Отписывающийся);

	// Когда
	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	// Тогда - состав получателей фиксируется при начале события
	Ожидаем.Что(Отписывающийся.Начатые, "Снял себя в первом событии, вложенных не видел").ИмеетДлину(1);
	Ожидаем.Что(Отписывающийся.Завершенные, "Начатое событие доходит до завершения").ИмеетДлину(1);
	Ожидаем.Что(Отписывающийся.Завершенные[0]).Равно(Отписывающийся.Начатые[0]);

КонецПроцедуры

&Тест
Процедура ДобавленныйВоВремяСобытияНаблюдательЕгоЗавершенияНеПолучает() Экспорт

	// Дано - наблюдатель, который в первом же ПередСобытием регистрирует другого
	Новичок = Новый НаблюдательЗаписывающий;
	Подписывающий = Новый НаблюдательПереподписывающийся(Источник, Новичок);
	Источник.ДобавитьНаблюдателя(Подписывающий);

	// Когда
	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	// Тогда
	Ожидаем.Что(Новичок.Завершенные("Операция", "Сохранить"), "Событие началось до регистрации").ИмеетДлину(0);
	Ожидаем.Что(Новичок.Завершенные("Запрос", "INSERT"), "Вложенные события начались после").ИмеетДлину(1);

КонецПроцедуры

// Коннектор

&Тест
Процедура ОшибкаПодключенияНаблюдателейЗакрываетОткрытыйКоннектор() Экспорт

	МенеджерСущностей.Закрыть();

	// Наблюдатели на источнике не нужны: коннектор подключается к реестру всегда.
	Источник = Новый ИсточникДанных("наблюдатели", Тип("КоннекторСЛоманымОписанием"), "наблюдатели");
	МенеджерСущностей = Новый МенеджерСущностей(Источник);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ПростойОбъект"));

	Ожидаем.Что(МенеджерСущностей)
		.Метод("Инициализировать", Новый Массив)
		.ВыбрасываетИсключение("Описание соединения недоступно");

	Закрыт = ТекущийПоток().Данные.Получить(Новый КоннекторСЛоманымОписанием().КлючЗакрыт());
	Ожидаем.Что(Закрыт, "Открытый коннектор закрыт после ошибки подключения наблюдателей").Равно(Истина);

КонецПроцедуры

&Тест
Процедура ОперацииКоннектораВПамятиПорождаютСобытияЗапросаБезТекста() Экспорт

	Объект = НовыйПростойОбъект(1);
	МенеджерСущностей.Сохранить(Объект);
	МенеджерСущностей.Получить(Тип("ПростойОбъект"));
	МенеджерСущностей.Удалить(Объект);

	Создания = Наблюдатель.Завершенные("Запрос", "CREATE TABLE");
	Ожидаем.Что(Создания, "По событию на каждую таблицу модели").ИмеетДлину(3);

	Вставки = Наблюдатель.Завершенные("Запрос", "INSERT");
	Ожидаем.Что(Вставки).ИмеетДлину(1);
	Ожидаем.Что(Вставки[0].ИмяТаблицы()).Равно("ПростыеОбъекты");
	Ожидаем.Что(Вставки[0].ТекстЗапроса(), "Коннектор без SQL текста запроса не формирует").Равно(Неопределено);

	Выборки = Наблюдатель.Завершенные("Запрос", "SELECT");
	Ожидаем.Что(Выборки).ИмеетДлину(1);
	Ожидаем.Что(Выборки[0].КоличествоСтрок()).Равно(1);

	Ожидаем.Что(Наблюдатель.Завершенные("Запрос", "DELETE")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура СобытияНесутОписаниеСоединения() Экспорт

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Событие = Наблюдатель.Завершенные("Операция", "Сохранить")[0];
	Ожидаем.Что(Событие.Система()).Равно("inmemory");
	Ожидаем.Что(Событие.БазаДанных()).Равно("наблюдатели");
	Ожидаем.Что(Событие.Адрес()).Равно("");
	Ожидаем.Что(Событие.Порт()).Равно(0);

	Запрос = Наблюдатель.Завершенные("Запрос", "INSERT")[0];
	Ожидаем.Что(Запрос.Система()).Равно("inmemory");
	Ожидаем.Что(Запрос.БазаДанных()).Равно("наблюдатели");

КонецПроцедуры

&Тест
Процедура СобытияДоОткрытияПервогоСоединенияПолучаютОписаниеКЗавершению() Экспорт

	// Инициализация и ее захват соединения начинаются, когда ни один коннектор еще не открыт
	// и описания соединения нет; к завершению события оно уже известно.
	Инициализация = Наблюдатель.Завершенные("Операция", "Инициализировать")[0];
	ПервыйЗахват = Наблюдатель.Завершенные("Соединение", "Занять")[0];

	Ожидаем.Что(Инициализация.БазаДанных()).Равно("наблюдатели");
	Ожидаем.Что(ПервыйЗахват.Система()).Равно("inmemory");
	Ожидаем.Что(ПервыйЗахват.БазаДанных()).Равно("наблюдатели");

КонецПроцедуры

&Тест
Процедура КоннекторБезИнтерфейсаНаблюдаемыйКоннекторДаетТолькоСобытияОпераций() Экспорт

	МенеджерСущностей.Закрыть();

	Источник = Новый ИсточникДанных("наблюдатели", Тип("КоннекторБезНаблюдения"), "наблюдатели");
	Наблюдатель = Новый НаблюдательЗаписывающий;
	Источник.ДобавитьНаблюдателя(Наблюдатель);
	МенеджерСущностей = Новый МенеджерСущностей(Источник);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ПростойОбъект"));
	МенеджерСущностей.Инициализировать();

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	Ожидаем.Что(МенеджерСущностей.Получить(Тип("ПростойОбъект"))).ИмеетДлину(1);

	Ожидаем.Что(Наблюдатель.Завершенные("Операция")).ИмеетДлину(3);
	Ожидаем.Что(Наблюдатель.Завершенные("Запрос")).ИмеетДлину(0);

	Событие = Наблюдатель.Завершенные("Операция", "Сохранить")[0];
	Ожидаем.Что(Событие.Система(), "Без описания от коннектора система выводится из имени типа")
		.Равно(НРег("КоннекторБезНаблюдения"));
	Ожидаем.Что(Событие.БазаДанных()).Равно("");

КонецПроцедуры

// Служебные

// Колонка идентификатора ПростойОбъект строковая: без &Колонка тип колонки - Строка.
//
// Параметры:
//   Идентификатор - Строка, Число - Идентификатор объекта, приводится к строке.
//
// Возвращаемое значение:
//   ПростойОбъект - Объект с заполненными идентификатором и полем.
//
Функция НовыйПростойОбъект(Знач Идентификатор)
	Объект = Новый ПростойОбъект;
	Объект.Идентификатор = Строка(Идентификатор);
	Объект.Поле = "поле " + Идентификатор;
	Возврат Объект;
КонецФункции

Процедура ПодключитьФикстуры()

	Фикстуры = Новый Массив;
	Фикстуры.Добавить("ПростойОбъект");
	Фикстуры.Добавить("СущностьБезГенерируемогоИдентификатора");
	Фикстуры.Добавить("Автор");
	Фикстуры.Добавить("НаблюдательЗаписывающий");
	Фикстуры.Добавить("НаблюдательНеполный");
	Фикстуры.Добавить("НаблюдательСМеткой");
	Фикстуры.Добавить("НаблюдательПереподписывающийся");
	Фикстуры.Добавить("КоннекторБезНаблюдения");
	Фикстуры.Добавить("КоннекторСЛоманымОписанием");

	Для Каждого Фикстура Из Фикстуры Цикл
		ПодключитьСценарий(
			ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", Фикстура + ".os"),
			Фикстура
		);
	КонецЦикла;

КонецПроцедуры
