// Модуль-перечисление ВидыСобытийСущностей: значения совпадают с видами событий, которые
// менеджер отдает наблюдателям, поэтому наблюдатель сравнивает Вид() с перечислением,
// а не со строковыми литералами.
//
// BSLLS:MagicNumber-off

#Использовать ".."
#Использовать "utils"

&Тест
Процедура ПеречислениеСодержитВсеВидыВПорядкеОбъявления() Экспорт

	Виды = ВидыСобытийСущностей.Виды();

	Ожидаем.Что(Виды).ИмеетДлину(4);
	Ожидаем.Что(Виды[0]).Равно(ВидыСобытийСущностей.Операция());
	Ожидаем.Что(Виды[1]).Равно(ВидыСобытийСущностей.Запрос());
	Ожидаем.Что(Виды[2]).Равно(ВидыСобытийСущностей.Соединение());
	Ожидаем.Что(Виды[3]).Равно(ВидыСобытийСущностей.Транзакция());

КонецПроцедуры

&Тест
Процедура ЗначенияПеречисленияСовпадаютСВидамиСобытийМенеджера() Экспорт

	ПодключитьФикстуры();

	// Операции, запросы и соединения - на InMemory; транзакции он не поддерживает,
	// их изображает тестовый коннектор поверх него.
	Наблюдатель = НаблюдательПослеРаботы(Тип("КоннекторInMemory"), "виды-событий");
	НаблюдательТранзакций = НаблюдательПослеРаботы(Тип("КоннекторТранзакцийДляТестов"), "виды-событий-транзакции");

	Ожидаем.Что(Наблюдатель.Завершенные(ВидыСобытийСущностей.Операция(), "Сохранить")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные(ВидыСобытийСущностей.Запрос(), "INSERT")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные(ВидыСобытийСущностей.Соединение(), "Занять")).Не_().ИмеетДлину(0);
	Ожидаем.Что(НаблюдательТранзакций.Завершенные(ВидыСобытийСущностей.Транзакция())).ИмеетДлину(1);

	// Каждое событие несет ровно одно из значений перечисления.
	Для Каждого Запись Из Наблюдатель.Записи Цикл
		Ожидаем.Что(ВидыСобытийСущностей.Виды().Найти(Запись.Событие.Вид()), Запись.Событие.Вид()).Не_().Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Служебные

// Прогоняет через менеджер на указанном коннекторе сохранение внутри транзакции и возвращает
// наблюдателя с записанными событиями.
Функция НаблюдательПослеРаботы(Знач ТипКоннектора, Знач СтрокаСоединения)

	ХранилищеВПамяти.Очистить(СтрокаСоединения);

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ПростойОбъект"));
	Наблюдатель = Новый НаблюдательЗаписывающий;
	МенеджерСущностей.ДобавитьНаблюдателя(Наблюдатель);
	МенеджерСущностей.Инициализировать();

	Если ТипКоннектора <> Тип("КоннекторInMemory") Тогда
		МенеджерСущностей.НачатьТранзакцию();
	КонецЕсли;
	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	Если ТипКоннектора <> Тип("КоннекторInMemory") Тогда
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	КонецЕсли;
	МенеджерСущностей.Закрыть();

	Возврат Наблюдатель;

КонецФункции

Функция НовыйПростойОбъект(Знач Идентификатор)
	Объект = Новый ПростойОбъект;
	Объект.Идентификатор = Строка(Идентификатор);
	Объект.Поле = "поле " + Идентификатор;
	Возврат Объект;
КонецФункции

Процедура ПодключитьФикстуры()

	Фикстуры = Новый Массив;
	Фикстуры.Добавить("ПростойОбъект");
	Фикстуры.Добавить("НаблюдательЗаписывающий");
	Фикстуры.Добавить("КоннекторТранзакцийДляТестов");

	Для Каждого Фикстура Из Фикстуры Цикл
		ПодключитьСценарий(
			ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", Фикстура + ".os"),
			Фикстура
		);
	КонецЦикла;

КонецПроцедуры
