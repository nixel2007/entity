// Хранилище сущностей: чтение, запись и транзакции.
//
// Транзакция принадлежит контексту исполнения, а не хранилищу: она открывается на соединении из
// пула менеджера и распространяется на все операции контекста. Хранилище, созданное в обход
// менеджера, работает собственным коннектором.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Хранилище авторов, полученное из менеджера.
Перем Хранилище;
// Строка соединения с тестовой БД.
Перем СтрокаСоединенияКоннектора;
// Тип коннектора тестовой БД.
Перем ТипКоннектораТестовойБазы;

Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ВыполнятьСбросТаблиц = Ложь;
	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединенияКоннектора = "FullUri=file::memory:?cache=shared";
		ТипКоннектораТестовойБазы = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединенияКоннектора = СтрокаСоединенияPostgres();
		ТипКоннектораТестовойБазы = Тип("КоннекторPostgreSQL");
		ВыполнятьСбросТаблиц = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования хранилища сущностей";
	КонецЕсли;

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектораТестовойБазы, СтрокаСоединенияКоннектора);

	Если ВыполнятьСбросТаблиц Тогда
		ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);
	КонецЕсли;

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

	Хранилище = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("Автор"));

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	Хранилище = Неопределено;
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
КонецПроцедуры

&Тест
Процедура ХранилищеЗнаетСвойОбъектМодели() Экспорт

	ОбъектМодели = Хранилище.ПолучитьОбъектМодели();

	Ожидаем.Что(ОбъектМодели.ТипСущности(), "Хранилище привязано к типу Автор").Равно(Тип("Автор"));

КонецПроцедуры

&Тест
Процедура ПолучитьБезОпцийВозвращаетВсеСущности() Экспорт

	СохранитьАвтора("Иван");
	СохранитьАвтора("Петр");

	Ожидаем.Что(Хранилище.Получить(), "Получены обе сущности").ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ПолучитьОдноБезОпцийВозвращаетСущность() Экспорт

	СохранитьАвтора("Иван");

	Ожидаем.Что(Хранилище.ПолучитьОдно().Имя, "Найден сохраненный автор").Равно("Иван");

КонецПроцедуры

&Тест
Процедура УдалениеЧерезХранилище() Экспорт

	Автор = СохранитьАвтора("Иван");
	Хранилище.Удалить(Автор);

	Ожидаем.Что(Хранилище.Получить(), "Сущность удалена").ИмеетДлину(0);

КонецПроцедуры

// Запись через хранилище должна попадать в транзакцию, начатую тем же контекстом, - иначе она
// уходила бы мимо транзакции и переживала откат.
//
&Тест
Процедура ЗаписьЧерезХранилищеПопадаетВТранзакциюКонтекста() Экспорт

	Хранилище.НачатьТранзакцию();
	СохранитьАвтора("Иван");
	Хранилище.ОтменитьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Откат отменил запись, сделанную через хранилище").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФиксацияТранзакцииХранилищаСохраняетЗапись() Экспорт

	Хранилище.НачатьТранзакцию();
	СохранитьАвтора("Иван");
	Хранилище.ЗафиксироватьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Запись зафиксирована").ИмеетДлину(1);

КонецПроцедуры

// Транзакция принадлежит контексту, поэтому начатая через хранилище видна операциям менеджера,
// и наоборот.
//
&Тест
Процедура ТранзакцияХранилищаИМенеджераОдна() Экспорт

	Хранилище.НачатьТранзакцию();

	Автор = Новый Автор;
	Автор.Имя = "Иван";
	Автор.ВтороеИмя = "Иванов";
	МенеджерСущностей.Сохранить(Автор);

	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Откат через менеджер отменил транзакцию, начатую хранилищем").ИмеетДлину(0);

КонецПроцедуры

// Сохраняет автора через хранилище.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
// Возвращаемое значение:
//   Произвольный - Сохраненный автор.
//
Функция СохранитьАвтора(Знач Имя)

	Автор = Хранилище.СоздатьЭлемент();
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";
	Автор.Сохранить();

	Возврат Автор;

КонецФункции

// Читает всех авторов собственным коннектором менеджера, вне транзакций контекстов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Строки таблицы авторов.
//
Функция ПрочитатьАвторов()
	Возврат ТестовыеУтилиты.ВыполнитьЗапрос(МенеджерСущностей, "SELECT * FROM Авторы");
КонецФункции

// Строка соединения с тестовой базой PostgreSQL.
//
// Пул сущностей живет ровно столько, сколько хранилище, и не оставляет за собой ничего в общих
// на процесс структурах.
//
// Блокировка пула бралась из общего реестра по ключу-объекту, а реестр ничего не вытесняет и
// прямо предупреждает против динамических ключей. Каждый цикл жизни менеджера оставлял в нем по
// блокировке на тип сущности - то есть тек тем сильнее, чем дольше работало приложение.
//
&Тест
Процедура ЦиклЖизниМенеджераНеОставляетБлокировокВРеестре() Экспорт

	// Первый цикл прогревает реестр: имена таблиц и строки соединения - ключи постоянные, их
	// блокировки создаются один раз и остаться в реестре должны.
	ПрожитьЦиклМенеджера();

	БылоБлокировок = БлокировкиЧтенияЗаписи.Количество();

	Для Индекс = 1 По 3 Цикл
		ПрожитьЦиклМенеджера();
	КонецЦикла;

	Ожидаем
		.Что(БлокировкиЧтенияЗаписи.Количество(), "Реестр блокировок не растет от цикла жизни менеджера")
		.Равно(БылоБлокировок);

КонецПроцедуры

// Создает менеджер, работает с сущностью и закрывает его.
//
Процедура ПрожитьЦиклМенеджера()

	Менеджер = Новый МенеджерСущностей(ТипКоннектораТестовойБазы, СтрокаСоединенияКоннектора);

	Попытка

		Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
		Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
		Менеджер.Инициализировать();

		// Пул сущностей заводится лениво, поэтому его нужно расшевелить чтением.
		Менеджер.Получить(Тип("Автор"));

	Исключение
		Менеджер.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Менеджер.Закрыть();

КонецПроцедуры

// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
