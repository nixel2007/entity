// Прямой доступ к БД в обход библиотеки: алгоритм выполняется коннектором из пула, соединение
// возвращается в пул по выходу.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// ИсточникДанных - Источник тестовой базы; закрывается после каждого теста.
Перем Источник;
// Тип - Тип коннектора тестовой базы.
Перем ТипКоннектора;
// Строка - Строка соединения с тестовой базой.
Перем СтрокаСоединения;
// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Хранилище авторов, полученное из менеджера.
Перем Хранилище;
// Значение, которое лямбда читает из захваченного объекта.
// Используется только в тексте лямбда-выражения, поэтому анализатор его не видит.
// BSLLS:UnusedLocalVariable-off
Перем ИмяИзЗахваченногоОбъекта;
// BSLLS:UnusedLocalVariable-on

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ВыполнятьСбросТаблиц = Ложь;
	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединения = "FullUri=file::memory:?cache=shared";
		ТипКоннектора = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединения = СтрокаСоединенияPostgres();
		ТипКоннектора = Тип("КоннекторPostgreSQL");
		ВыполнятьСбросТаблиц = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования доступа коннектором";
	КонецЕсли;

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	СоздатьМенеджер(10, ВыполнятьСбросТаблиц);

	ИмяИзЗахваченногоОбъекта = "Захваченный";

КонецПроцедуры

// Создает источник, менеджер с моделью авторов и хранилище авторов.
//
// Параметры:
//   РазмерПула - Число - Размер пула соединений источника.
//   ВыполнятьСбросТаблиц - Булево - Удалить таблицы базы до инициализации модели.
//
Процедура СоздатьМенеджер(Знач РазмерПула, Знач ВыполнятьСбросТаблиц = Ложь)

	Источник = Новый ИсточникДанных("Тесты", ТипКоннектора, СтрокаСоединения, , РазмерПула);
	// oneunit исполняет подготовку и тест в разных потоках: источник живет до ПослеКаждого.
	Источник.УстановитьАвтоЗакрытие(Ложь);
	МенеджерСущностей = Новый МенеджерСущностей(Источник);

	Если ВыполнятьСбросТаблиц Тогда
		ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);
	КонецЕсли;

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

	Хранилище = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("Автор"));

КонецПроцедуры

// Заменяет менеджер и источник теста новыми, с пулом из одного соединения: следующий захват
// гарантированно получит то же соединение, что и предыдущий.
//
// База SQLite в памяти живет, пока открыто хоть одно ее соединение. Новый источник открывается
// до закрытия прежнего, поэтому таблицы и строки переживают замену.
//
Процедура ЗаменитьМенеджерНаПулИзОдного()

	ПрежнийМенеджер = МенеджерСущностей;
	ПрежнийИсточник = Источник;

	СоздатьМенеджер(1);

	ПрежнийМенеджер.Закрыть();
	ПрежнийИсточник.Закрыть();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Хранилище = Неопределено;
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
	Источник.Закрыть();
КонецПроцедуры

&Тест
Процедура АлгоритмВыполняетсяКоннектором() Экспорт

	МенеджерСущностей.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Иван', 'Иванов')")
	);

	Ожидаем.Что(ПрочитатьАвторов(), "Запрос выполнен").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура АлгоритмВозвращаетРезультат() Экспорт

	СохранитьАвтора("Иван");

	Результат = МенеджерСущностей.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "SELECT * FROM Авторы")
	);

	Ожидаем.Что(Результат, "Результат запроса вернулся из алгоритма").ИмеетДлину(1);

КонецПроцедуры

// Поля структуры-контекста видны в алгоритме по именам ключей.
//
&Тест
Процедура КонтекстВиденВАлгоритмеПоИменамКлючей() Экспорт

	СохранитьАвтора("Иван");

	Контекст = Новый Структура("Запрос, ОжидаемоеКоличество", "SELECT * FROM Авторы", 1);

	Совпало = МенеджерСущностей.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос).Количество() = ОжидаемоеКоличество",
		Контекст
	);

	Ожидаем.Что(Совпало, "Оба поля контекста прочитаны в алгоритме").ЭтоИстина();

КонецПроцедуры

// Одну структуру-контекст переиспользуют между вызовами, меняя значения: каждый вызов должен видеть
// значения на момент своего вызова, а не первого.
//
&Тест
Процедура ПовторныйВызовСТемЖеКонтекстомВидитНовыеЗначения() Экспорт

	Контекст = Новый Структура("Значение", 1);
	Первое = МенеджерСущностей.ВычислитьСКоннектором("Коннектор -> Значение", Контекст);

	Контекст.Значение = 2;
	Второе = МенеджерСущностей.ВычислитьСКоннектором("Коннектор -> Значение", Контекст);

	Ожидаем.Что(Первое, "Первый вызов видит исходное значение").Равно(1);
	Ожидаем.Что(Второе, "Второй вызов видит новое значение").Равно(2);

КонецПроцедуры

// Захваченный объект дает алгоритму доступ к своим полям.
//
&Тест
Процедура ЗахваченныйОбъектДоступенВАлгоритме() Экспорт

	Прочитанное = МенеджерСущностей.ВычислитьСКоннектором(
		"Коннектор -> ИмяИзЗахваченногоОбъекта",
		Неопределено,
		ЭтотОбъект
	);

	Ожидаем.Что(Прочитанное, "Поле захваченного объекта прочитано").Равно("Захваченный");

КонецПроцедуры

// Алгоритм получает коннектор транзакции, начатой тем же потоком, поэтому откат отменяет и его.
//
&Тест
Процедура АлгоритмПопадаетВТранзакциюПотокаИсполнения() Экспорт

	МенеджерСущностей.НачатьТранзакцию();

	МенеджерСущностей.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Иван', 'Иванов')")
	);

	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Откат отменил запись, сделанную алгоритмом").ИмеетДлину(0);

КонецПроцедуры

// Транзакция, которую алгоритм начал методом коннектора и не завершил, не уходит с соединением
// к другому потоку: иначе его фиксация записала бы и строки алгоритма.
//
&Тест
Процедура БрошеннаяАлгоритмомТранзакцияНеДостаетсяДругомуПотоку() Экспорт
	ПроверитьОткатБрошеннойТранзакции("Коннектор -> Коннектор.НачатьТранзакцию(); Коннектор.ВыполнитьЗапрос(Запрос)");
КонецПроцедуры

// То же для транзакции, начатой текстом запроса.
//
&Тест
Процедура БрошеннаяЗапросомТранзакцияНеДостаетсяДругомуПотоку() Экспорт
	ПроверитьОткатБрошеннойТранзакции(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(""BEGIN""); Коннектор.ВыполнитьЗапрос(Запрос)"
	);
КонецПроцедуры

// Текст запроса узнается и в нижнем регистре, и с точкой с запятой.
//
&Тест
Процедура БрошеннаяЗапросомВНижнемРегистреТранзакцияНеДостаетсяДругомуПотоку() Экспорт
	ПроверитьОткатБрошеннойТранзакции(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(""begin;""); Коннектор.ВыполнитьЗапрос(Запрос)"
	);
КонецПроцедуры

// Откат к точке сохранения транзакцию не завершает: брошенная после него транзакция откатывается
// так же.
//
&Тест
Процедура ОткатКТочкеСохраненияНеЗавершаетБрошеннуюТранзакцию() Экспорт
	ПроверитьОткатБрошеннойТранзакции(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(""BEGIN""); Коннектор.ВыполнитьЗапрос(Запрос);
		|Коннектор.ВыполнитьЗапрос(""SAVEPOINT Точка""); Коннектор.ВыполнитьЗапрос(""ROLLBACK TO Точка"")"
	);
КонецПроцедуры

// Алгоритм, начавший и сам завершивший транзакцию, ничего не теряет: его строка зафиксирована.
//
&Тест
Процедура ЗавершеннаяАлгоритмомТранзакцияСохраняется() Экспорт

	ЗаменитьМенеджерНаПулИзОдного();

	МенеджерСущностей.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(""BEGIN""); Коннектор.ВыполнитьЗапрос(Запрос);
		|Коннектор.ВыполнитьЗапрос(""commit;"")",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Свой', 'Иванов')")
	);

	ЗафиксироватьАвтораВДругомПотоке("Чужой");

	Ожидаем.Что(ИменаАвторов(), "Строки обоих потоков на месте").ИмеетДлину(2);

КонецПроцедуры

// Ошибка внутри алгоритма не должна оставлять соединение занятым.
//
&Тест
Процедура ОшибкаВАлгоритмеОсвобождаетСоединение() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("Коннектор -> ВызватьИсключение ""Ошибка внутри алгоритма""");

	Ожидаем
		.Что(МенеджерСущностей, "Ошибка алгоритма выброшена наружу")
		.Метод("ВыполнитьСКоннектором", ПараметрыМетода)
		.ВыбрасываетИсключение();

	Ожидаем
		.Что(МенеджерСущностей.ИсточникДанных().ПулСоединений().КоличествоЗанятых(), "Соединение возвращено в пул")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ОшибкаВВычисленииОсвобождаетСоединение() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("Коннектор -> ВызватьИсключение ""Ошибка внутри алгоритма""");

	Ожидаем
		.Что(МенеджерСущностей, "Ошибка алгоритма выброшена наружу")
		.Метод("ВычислитьСКоннектором", ПараметрыМетода)
		.ВыбрасываетИсключение();

	Ожидаем
		.Что(МенеджерСущностей.ИсточникДанных().ПулСоединений().КоличествоЗанятых(), "Соединение возвращено в пул")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ХранилищеВыполняетАлгоритмКоннектором() Экспорт

	Хранилище.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Иван', 'Иванов')")
	);

	Ожидаем.Что(ПрочитатьАвторов(), "Запрос выполнен хранилищем").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ХранилищеВозвращаетРезультатАлгоритма() Экспорт

	СохранитьАвтора("Иван");

	Результат = Хранилище.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "SELECT * FROM Авторы")
	);

	Ожидаем.Что(Результат, "Результат вернулся из алгоритма хранилища").ИмеетДлину(1);

КонецПроцедуры

// Завершение транзакции, которой не было, уходит коннектору как есть, а соединение возвращается
// в пул независимо от того, что ответила СУБД. Реакция у СУБД разная: SQLite отвечает ошибкой,
// PostgreSQL - предупреждением, поэтому проверяется только возврат соединения.
//
&Тест
Процедура ЗавершениеБезНачалаТранзакцииОсвобождаетСоединение() Экспорт

	Попытка
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	Исключение
		СообщениеСУБД = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Ожидаем.Что(ЗначениеЗаполнено(СообщениеСУБД), "Ответ СУБД не проглочен").ЭтоИстина();
	КонецПопытки;

	Ожидаем
		.Что(МенеджерСущностей.ИсточникДанных().ПулСоединений().КоличествоЗанятых(), "Соединение возвращено в пул")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура НеожиданныйТипОпцийПоискаОтвергается() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Новый Массив);

	Ожидаем
		.Что(Хранилище, "Опции поиска неожиданного типа отвергнуты")
		.Метод("Получить", ПараметрыМетода)
		.ВыбрасываетИсключение("неожиданный тип опций поиска");

КонецПроцедуры

&Тест
Процедура ПолучитьОдноБезОпцийВозвращаетСущность() Экспорт

	СохранитьАвтора("Иван");

	Ожидаем.Что(МенеджерСущностей.ПолучитьОдно(Тип("Автор")).Имя, "Сущность найдена без опций").Равно("Иван");

КонецПроцедуры

&Тест
Процедура МодельДанныхДоступнаИзМенеджера() Экспорт

	МодельДанных = МенеджерСущностей.ПолучитьМодельДанных();

	Ожидаем
		.Что(МодельДанных.Получить(Тип("Автор")).ТипСущности(), "Модель знает про тип Автор")
		.Равно(Тип("Автор"));

КонецПроцедуры

// Соединение знает, начата ли им транзакция.
//
&Тест
Процедура СоединениеЗнаетОСвоейТранзакции() Экспорт

	Пул = МенеджерСущностей.ИсточникДанных().ПулСоединений();

	МенеджерСущностей.НачатьТранзакцию();

	Попытка
		Ожидаем.Что(Пул.СоединениеТекущегоПотокаИсполнения().ВТранзакции(), "Транзакция начата").ЭтоИстина();
	Исключение
		МенеджерСущностей.ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	МенеджерСущностей.ОтменитьТранзакцию();

КонецПроцедуры

// Сохраняет автора через менеджер.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
Процедура СохранитьАвтора(Знач Имя)

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	МенеджерСущностей.Сохранить(Автор);

КонецПроцедуры

// Читает всех авторов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Строки таблицы авторов.
//
Функция ПрочитатьАвторов()
	Возврат ТестовыеУтилиты.ВыполнитьЗапрос(МенеджерСущностей, "SELECT * FROM Авторы");
КонецФункции

// Читает имена всех авторов.
//
// Возвращаемое значение:
//   Массив из Строка - Имена авторов.
//
Функция ИменаАвторов()
	Возврат ПрочитатьАвторов().ВыгрузитьКолонку("Имя");
КонецФункции

// Выполняет алгоритм, бросающий начатую транзакцию со вставленной строкой, затем фиксирует свою
// транзакцию в другом потоке на том же соединении и проверяет, что в базе только строка
// другого потока.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение: начинает транзакцию и выполняет запрос из контекста.
//
Процедура ПроверитьОткатБрошеннойТранзакции(Знач Алгоритм)

	ЗаменитьМенеджерНаПулИзОдного();

	МенеджерСущностей.ВыполнитьСКоннектором(
		Алгоритм,
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Брошенный', 'Иванов')")
	);

	ЗафиксироватьАвтораВДругомПотоке("Чужой");

	Имена = ИменаАвторов();
	Ожидаем.Что(Имена, "Строка брошенной транзакции не зафиксирована чужой фиксацией").ИмеетДлину(1);
	Ожидаем.Что(Имена[0], "Зафиксирована строка другого потока").Равно("Чужой");

КонецПроцедуры

// Сохраняет автора в транзакции фонового задания и дожидается его.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
Процедура ЗафиксироватьАвтораВДругомПотоке(Знач Имя)

	Параметры = Новый Массив;
	Параметры.Добавить(МенеджерСущностей);
	Параметры.Добавить(Имя);

	Задания = Новый Массив;
	Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗафиксироватьАвтораВФоне", Параметры, Истина));

	ТестовыеУтилиты.ПроверитьЗадания(Задания);

КонецПроцедуры

// Сохраняет автора в своей транзакции. Выполняется фоновым заданием.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//   Имя - Строка - Имя автора.
//
Процедура ЗафиксироватьАвтораВФоне(Менеджер, Знач Имя) Экспорт

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Петров";

	Менеджер.НачатьТранзакцию();

	Попытка
		Менеджер.Сохранить(Автор);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Менеджер.ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Менеджер.ЗафиксироватьТранзакцию();

КонецПроцедуры

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
