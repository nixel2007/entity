// Прямой доступ к БД в обход библиотеки: алгоритм выполняется коннектором из пула, соединение
// возвращается в пул по выходу.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Хранилище авторов, полученное из менеджера.
Перем Хранилище;
// Значение, которое лямбда читает из захваченного объекта.
// Используется только в тексте лямбда-выражения, поэтому анализатор его не видит.
// BSLLS:UnusedLocalVariable-off
Перем ИмяИзЗахваченногоОбъекта;
// BSLLS:UnusedLocalVariable-on

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ВыполнятьСбросТаблиц = Ложь;
	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединения = "FullUri=file::memory:?cache=shared";
		ТипКоннектора = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединения = СтрокаСоединенияPostgres();
		ТипКоннектора = Тип("КоннекторPostgreSQL");
		ВыполнятьСбросТаблиц = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования доступа коннектором";
	КонецЕсли;

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);

	Если ВыполнятьСбросТаблиц Тогда
		ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);
	КонецЕсли;

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

	Хранилище = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("Автор"));
	ИмяИзЗахваченногоОбъекта = "Захваченный";

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	Хранилище = Неопределено;
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
КонецПроцедуры

&Тест
Процедура АлгоритмВыполняетсяКоннектором() Экспорт

	МенеджерСущностей.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Иван', 'Иванов')")
	);

	Ожидаем.Что(ПрочитатьАвторов(), "Запрос выполнен").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура АлгоритмВозвращаетРезультат() Экспорт

	СохранитьАвтора("Иван");

	Результат = МенеджерСущностей.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "SELECT * FROM Авторы")
	);

	Ожидаем.Что(Результат, "Результат запроса вернулся из алгоритма").ИмеетДлину(1);

КонецПроцедуры

// Поля структуры-контекста видны в алгоритме по именам ключей.
//
&Тест
Процедура КонтекстВиденВАлгоритмеПоИменамКлючей() Экспорт

	СохранитьАвтора("Иван");

	Контекст = Новый Структура("Запрос, ОжидаемоеКоличество", "SELECT * FROM Авторы", 1);

	Совпало = МенеджерСущностей.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос).Количество() = ОжидаемоеКоличество",
		Контекст
	);

	Ожидаем.Что(Совпало, "Оба поля контекста прочитаны в алгоритме").ЭтоИстина();

КонецПроцедуры

// Захваченный объект дает алгоритму доступ к своим полям.
//
&Тест
Процедура ЗахваченныйОбъектДоступенВАлгоритме() Экспорт

	Прочитанное = МенеджерСущностей.ВычислитьСКоннектором(
		"Коннектор -> ИмяИзЗахваченногоОбъекта",
		Неопределено,
		ЭтотОбъект
	);

	Ожидаем.Что(Прочитанное, "Поле захваченного объекта прочитано").Равно("Захваченный");

КонецПроцедуры

// Алгоритм получает коннектор транзакции, начатой тем же контекстом, поэтому откат отменяет и его.
//
&Тест
Процедура АлгоритмПопадаетВТранзакциюКонтекста() Экспорт

	МенеджерСущностей.НачатьТранзакцию();

	МенеджерСущностей.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Иван', 'Иванов')")
	);

	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Откат отменил запись, сделанную алгоритмом").ИмеетДлину(0);

КонецПроцедуры

// Ошибка внутри алгоритма не должна оставлять соединение занятым.
//
&Тест
Процедура ОшибкаВАлгоритмеОсвобождаетСоединение() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("Коннектор -> ВызватьИсключение ""Ошибка внутри алгоритма""");

	Ожидаем
		.Что(МенеджерСущностей, "Ошибка алгоритма выброшена наружу")
		.Метод("ВыполнитьСКоннектором", ПараметрыМетода)
		.ВыбрасываетИсключение();

	Ожидаем
		.Что(МенеджерСущностей.ПолучитьПулСоединений().КоличествоЗанятых(), "Соединение возвращено в пул")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ОшибкаВВычисленииОсвобождаетСоединение() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("Коннектор -> ВызватьИсключение ""Ошибка внутри алгоритма""");

	Ожидаем
		.Что(МенеджерСущностей, "Ошибка алгоритма выброшена наружу")
		.Метод("ВычислитьСКоннектором", ПараметрыМетода)
		.ВыбрасываетИсключение();

	Ожидаем
		.Что(МенеджерСущностей.ПолучитьПулСоединений().КоличествоЗанятых(), "Соединение возвращено в пул")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ХранилищеВыполняетАлгоритмКоннектором() Экспорт

	Хранилище.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "INSERT INTO Авторы (Имя, Фамилия) VALUES ('Иван', 'Иванов')")
	);

	Ожидаем.Что(ПрочитатьАвторов(), "Запрос выполнен хранилищем").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ХранилищеВозвращаетРезультатАлгоритма() Экспорт

	СохранитьАвтора("Иван");

	Результат = Хранилище.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "SELECT * FROM Авторы")
	);

	Ожидаем.Что(Результат, "Результат вернулся из алгоритма хранилища").ИмеетДлину(1);

КонецПроцедуры

// Завершение транзакции, которой не было, уходит коннектору как есть, а соединение возвращается
// в пул независимо от того, что ответила СУБД. Реакция у СУБД разная: SQLite отвечает ошибкой,
// PostgreSQL - предупреждением, поэтому проверяется только возврат соединения.
//
&Тест
Процедура ЗавершениеБезНачалаТранзакцииОсвобождаетСоединение() Экспорт

	Попытка
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	Исключение
		СообщениеСУБД = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Ожидаем.Что(ЗначениеЗаполнено(СообщениеСУБД), "Ответ СУБД не проглочен").ЭтоИстина();
	КонецПопытки;

	Ожидаем
		.Что(МенеджерСущностей.ПолучитьПулСоединений().КоличествоЗанятых(), "Соединение возвращено в пул")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура НеожиданныйТипОпцийПоискаОтвергается() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Новый Массив);

	Ожидаем
		.Что(Хранилище, "Опции поиска неожиданного типа отвергнуты")
		.Метод("Получить", ПараметрыМетода)
		.ВыбрасываетИсключение("неожиданный тип опций поиска");

КонецПроцедуры

&Тест
Процедура ПолучитьОдноБезОпцийВозвращаетСущность() Экспорт

	СохранитьАвтора("Иван");

	Ожидаем.Что(МенеджерСущностей.ПолучитьОдно(Тип("Автор")).Имя, "Сущность найдена без опций").Равно("Иван");

КонецПроцедуры

&Тест
Процедура МодельДанныхДоступнаИзМенеджера() Экспорт

	МодельДанных = МенеджерСущностей.ПолучитьМодельДанных();

	Ожидаем
		.Что(МодельДанных.Получить(Тип("Автор")).ТипСущности(), "Модель знает про тип Автор")
		.Равно(Тип("Автор"));

КонецПроцедуры

// Параметры коннектора, переданные в конструктор менеджера, доходят до пула.
//
&Тест
Процедура ПараметрыКоннектораДоходятДоПула() Экспорт

	ПараметрыКоннектора = Новый Массив;
	ПараметрыКоннектора.Добавить("ПроизвольныйПараметр");

	Менеджер = Новый МенеджерСущностей(Тип("КоннекторInMemory"), "проверка параметров", ПараметрыКоннектора);

	Попытка
		Ожидаем
			.Что(Менеджер.ПолучитьПулСоединений().ПараметрыКоннектора(), "Параметры дошли до пула")
			.Равно(ПараметрыКоннектора);
	Исключение
		Менеджер.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Менеджер.Закрыть();

КонецПроцедуры

// Соединение знает, начата ли им транзакция.
//
&Тест
Процедура СоединениеЗнаетОСвоейТранзакции() Экспорт

	Пул = МенеджерСущностей.ПолучитьПулСоединений();

	МенеджерСущностей.НачатьТранзакцию();

	Попытка
		Ожидаем.Что(Пул.СоединениеТекущегоКонтекста().ВТранзакции(), "Транзакция начата").ЭтоИстина();
	Исключение
		МенеджерСущностей.ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	МенеджерСущностей.ОтменитьТранзакцию();

КонецПроцедуры

// Сохраняет автора через менеджер.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
Процедура СохранитьАвтора(Знач Имя)

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	МенеджерСущностей.Сохранить(Автор);

КонецПроцедуры

// Читает всех авторов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Строки таблицы авторов.
//
Функция ПрочитатьАвторов()
	Возврат ТестовыеУтилиты.ВыполнитьЗапрос(МенеджерСущностей, "SELECT * FROM Авторы");
КонецФункции

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
