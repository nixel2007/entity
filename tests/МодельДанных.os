// Модель данных менеджера: регистрация классов и чтение объектов модели.
//
// Модель общая у всех потоков, работающих с менеджером: операции читают ее на каждом шаге, а
// классы можно регистрировать и после передачи менеджера другим потокам. Тесты проверяют, что
// поздняя регистрация не ломает идущие операции, а повторная не подменяет объект модели, с которым
// уже работают хранилища.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// ИсточникДанных - Источник тестовой базы; закрывается после каждого теста.
Перем Источник;
// МенеджерСущностей - Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Строка - Каталог классов, сгенерированных тестом; Неопределено, если тест их не создавал.
Перем КаталогКлассов;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ХранилищеВПамяти.Очистить("МодельДанных");
	ТестовыеУтилиты.ПодключитьКлассыСущностей();
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СигналСобытия.os"), "СигналСобытия");

	Источник = Новый ИсточникДанных("Тесты", Тип("КоннекторInMemory"), "МодельДанных");
	// oneunit исполняет подготовку и тест в разных потоках: источник живет до ПослеКаждого.
	Источник.УстановитьАвтоЗакрытие(Ложь);
	МенеджерСущностей = Новый МенеджерСущностей(Источник);

	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	КаталогКлассов = Неопределено;

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт

	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
	Источник.Закрыть();

	Если КаталогКлассов <> Неопределено Тогда
		УдалитьФайлы(КаталогКлассов);
		КаталогКлассов = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Класс регистрируют повторно, когда с ним уже работают. Модель должна вернуть тот же объект
// модели: иначе хранилище, созданное раньше, и новые операции работали бы с разными объектами
// одного типа.
//
&Тест
Процедура ПовторнаяРегистрацияНеПодменяетОбъектМодели() Экспорт

	Модель = МенеджерСущностей.ПолучитьМодельДанных();
	Прежний = Модель.Получить(Тип("Автор"));
	Хранилище = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("Автор"));

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	Ожидаем.Что(Модель.Получить(Тип("Автор")) = Прежний, "Модель отдает прежний объект модели").ЭтоИстина();
	Ожидаем.Что(
		Хранилище.ПолучитьОбъектМодели() = Модель.Получить(Тип("Автор")),
		"Хранилище и модель работают с одним объектом модели"
	).ЭтоИстина();
	Ожидаем.Что(
		Модель.СоздатьОбъектМодели(Тип("Автор")) = Прежний,
		"Создание объекта модели для известного типа возвращает существующий"
	).ЭтоИстина();

КонецПроцедуры

// Задание обходит модель так же, как Инициализировать, и ищет в ней каждый найденный тип, а тест в
// это время регистрирует 50 новых классов. Обход не должен падать на изменяемой модели, и все
// классы должны стать видны.
//
&Тест
Процедура РегистрацияКлассовПараллельноОбходуМоделиНеЛомаетОбход() Экспорт

	Типы = ПодключитьКлассыРегистрации(50);
	Модель = МенеджерСущностей.ПолучитьМодельДанных();
	ОжидаемоеКоличество = Модель.ПолучитьОбъектыМодели().Количество() + Типы.Количество();
	НачалОбход = Новый СигналСобытия;
	Стоп = Новый СигналСобытия;

	Параметры = Новый Массив;
	Параметры.Добавить(Модель);
	Параметры.Добавить(ОжидаемоеКоличество);
	Параметры.Добавить(НачалОбход);
	Параметры.Добавить(Стоп);
	Задания = Новый Массив;
	Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОбходитьМодельВФоне", Параметры, Истина));

	Попытка
		Ожидаем.Что(НачалОбход.Дождаться(), "Задание начало обход модели").ЭтоИстина();
		Для Каждого ТипСущности Из Типы Цикл
			МенеджерСущностей.ДобавитьКлассВМодель(ТипСущности);
		КонецЦикла;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Стоп.Отметить();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, СрокЗадания()));
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания, СрокЗадания());

	Для Каждого ТипСущности Из Типы Цикл
		ОбъектМодели = Модель.Получить(ТипСущности);
		Ожидаем.Что(ОбъектМодели <> Неопределено, СтрШаблон("Класс %1 есть в модели", ТипСущности)).ЭтоИстина();
		Ожидаем.Что(ОбъектМодели.ТипСущности(), "Объект модели описывает свой класс").Равно(ТипСущности);
	КонецЦикла;

КонецПроцедуры

// Обходит модель в цикле, пока в ней не окажутся все ожидаемые классы. Каждый найденный при обходе
// объект модели ищется в модели по типу и должен найтись тем же. Запускается в фоновом задании.
//
// Параметры:
//   Модель - МодельДанных - Модель менеджера теста.
//   ОжидаемоеКоличество - Число - Сколько объектов модели будет после регистрации всех классов.
//   НачалОбход - СигналСобытия - Отмечается после первого обхода.
//   Стоп - СигналСобытия - Отмечается тестом, если регистрация упала.
//
Процедура ОбходитьМодельВФоне(Модель, ОжидаемоеКоличество, НачалОбход, Стоп) Экспорт

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;

	Пока НЕ Стоп.Отмечен() Цикл

		ОбъектыМодели = Модель.ПолучитьОбъектыМодели();
		Для Каждого ОбъектМодели Из ОбъектыМодели Цикл
			Если Модель.Получить(ОбъектМодели.ТипСущности()) <> ОбъектМодели Тогда
				ВызватьИсключение СтрШаблон("Модель отдала по типу %1 другой объект", ОбъектМодели.ТипСущности());
			КонецЕсли;
		КонецЦикла;

		НачалОбход.Отметить();

		Если ОбъектыМодели.Количество() >= ОжидаемоеКоличество Тогда
			Возврат;
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= КрайнийСрок Тогда
			ВызватьИсключение СтрШаблон(
				"За 20 с в модели не появились все классы: %1 из %2",
				ОбъектыМодели.Количество(),
				ОжидаемоеКоличество
			);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Создает и подключает классы сущностей с уникальными в процессе именами.
//
// Подключение идет в потоке теста до запуска заданий: на движке 2.2 параллельное подключение
// сценариев само не потокобезопасно, а проверяется здесь модель, а не движок.
//
// Параметры:
//   Количество - Число - Сколько классов создать.
//
// Возвращаемое значение:
//   Массив из Тип - Типы подключенных классов.
//
Функция ПодключитьКлассыРегистрации(Знач Количество)

	КаталогКлассов = ОбъединитьПути(КаталогВременныхФайлов(), "entity-model-" + Новый УникальныйИдентификатор);
	СоздатьКаталог(КаталогКлассов);

	Типы = Новый Массив;
	Номер = 1;
	Пока Номер <= Количество Цикл

		ИмяКласса = "КлассРегистрацииВМодели" + Формат(Номер, "ЧГ=");
		ИмяФайла = ОбъединитьПути(КаталогКлассов, ИмяКласса + ".os");

		ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, "UTF-8");
		ЗаписьТекста.ЗаписатьСтроку("&Идентификатор");
		ЗаписьТекста.ЗаписатьСтроку("Перем Идентификатор Экспорт;");
		ЗаписьТекста.ЗаписатьСтроку("Перем Поле Экспорт;");
		ЗаписьТекста.ЗаписатьСтроку(СтрШаблон("&Сущность(ИмяТаблицы = ""%1"")", ИмяКласса));
		ЗаписьТекста.ЗаписатьСтроку("Процедура ПриСозданииОбъекта()");
		ЗаписьТекста.ЗаписатьСтроку("КонецПроцедуры");
		ЗаписьТекста.Закрыть();

		ПодключитьСценарий(ИмяФайла, ИмяКласса);
		Типы.Добавить(Тип(ИмяКласса));

		Номер = Номер + 1;

	КонецЦикла;

	Возврат Типы;

КонецФункции

// Срок ожидания задания теста.
//
// Возвращаемое значение:
//   Число - Срок в миллисекундах.
//
Функция СрокЗадания()
	Возврат 30000;
КонецФункции
