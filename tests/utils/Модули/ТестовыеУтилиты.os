// Помощники, общие для тестовых наборов.
//
// Значения по умолчанию для переменных среды - localhost и postgres - повторяются и выглядят
// для анализатора захардкоженным адресом и дублем литерала, поэтому обе диагностики здесь сняты:
// в наборах, откуда эти помощники переехали, они были сняты по той же причине.
//
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

Функция ПолучитьПеременнуюСредыИлиЗначение(ИмяПеременной, ЗначениеПоУмолчанию) Экспорт
	ПеременнаяСреды = ПолучитьПеременнуюСреды(ИмяПеременной);
	Если ПеременнаяСреды = Неопределено Тогда
		ПеременнаяСреды = ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат ПеременнаяСреды;
КонецФункции

Процедура УдалитьТаблицыВБазеДанных(Коннектор) Экспорт
	ТекстЗапроса = "DROP SCHEMA public CASCADE; CREATE SCHEMA public;";
	Коннектор.ВыполнитьЗапрос(ТекстЗапроса);
КонецПроцедуры

Процедура СохранитьСущностьСоВсемиТипамиКолонок(Коннектор, ОбъектМодели, Идентификатор) Экспорт

	Сущность = Новый СущностьСоВсемиТипамиКолонок;
	Сущность.Целое = Идентификатор;
	Коннектор.Сохранить(ОбъектМодели, Сущность);

КонецПроцедуры

// Выполняет запрос коннектором менеджера или хранилища сущностей.
//
// Параметры:
//   ОбъектСПулом - МенеджерСущностей, ХранилищеСущностей - Объект, у которого берется коннектор.
//   ТекстЗапроса - Строка - Текст запроса.
//
// Возвращаемое значение:
//   Произвольный - Результат запроса.
//
Функция ВыполнитьЗапрос(ОбъектСПулом, Знач ТекстЗапроса) Экспорт

	Возврат ОбъектСПулом.ВычислитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", ТекстЗапроса)
	);

КонецФункции

// Подключает классы сущностей Автор и СущностьБезГенерируемогоИдентификатора.
//
// Повторное подключение безвредно: наборы зовут его перед каждым тестом.
//
Процедура ПодключитьКлассыСущностей() Экспорт

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"), "Автор");

КонецПроцедуры

// Менеджер источника с моделью из Автора и того, на что Автор ссылается, и созданными таблицами.
//
// Параметры:
//   Источник - ИсточникДанных - Источник.
//
// Возвращаемое значение:
//   МенеджерСущностей - Менеджер с инициализированной моделью.
//
Функция МенеджерАвторов(Источник) Экспорт

	ПодключитьКлассыСущностей();

	Менеджер = Новый МенеджерСущностей(Источник);
	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Возврат Менеджер;

КонецФункции

// Источник на СУБД с транзакциями: SQLite в памяти, если тесты SQLite включены, иначе PostgreSQL
// по переменным среды.
//
// Возвращаемое значение:
//   ИсточникДанных - Источник.
//
Функция ИсточникСТранзакциями() Экспорт

	Если ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true") = "true" Тогда
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), "FullUri=file::memory:?cache=shared");
	КонецЕсли;

	Если ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true") = "true" Тогда
		СтрокаСоединения = СтрШаблон(
			"Host=%1;Port=%2;Username=%3;Password=%4;Database=%5",
			ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost"),
			ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432"),
			ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres"),
			ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres"),
			ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres")
		);
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторPostgreSQL"), СтрокаСоединения);
	КонецЕсли;

	ВызватьИсключение "Нет доступного коннектора с транзакциями";

КонецФункции

// Закрывает источники, созданные тестом, и очищает их перечень.
//
// Тест, заменивший источник новым, оставил бы прежний с открытыми соединениями до сборки мусора,
// поэтому закрываются все созданные, а не только последний. Повторное закрытие источник переживает,
// так что закрытый тестом сам попадает сюда безболезненно.
//
// Параметры:
//   Источники - Массив из ИсточникДанных - Перечень созданных тестом источников.
//
Процедура ЗакрытьИсточники(Источники) Экспорт

	Для Каждого Источник Из Источники Цикл
		Источник.Закрыть();
	КонецЦикла;

	Источники.Очистить();

КонецПроцедуры

// Дожидается фоновых заданий, ничего не бросая.
//
// Срок один на весь вызов: каждое следующее задание ждется только остаток до него, поэтому тест
// с несколькими повисшими заданиями стоит не дольше одного срока. Каждое задание проходит через
// ОжидатьЗавершения - это барьер: итоги задания, дождавшегося завершения, читаются законно, а итоги
// незавершенного не читаются вовсе. Ноль ОжидатьЗавершения понимает как "ждать вечно", поэтому
// ждется не меньше миллисекунды.
//
// Ничего не бросает намеренно: зовется и из обработчика исключения теста, где своя ошибка
// подменила бы исходную - ту, из-за которой задания и повисли.
//
// Параметры:
//   Задания - Массив из ФоновоеЗадание - Задания теста.
//   Срок - Число - Общий срок ожидания в миллисекундах.
//
// Возвращаемое значение:
//   Структура - Незавершенные и Упавшие: массивы заданий.
//
Функция ДождатьсяЗаданий(Задания, Знач Срок = 30000) Экспорт

	Итог = Новый Структура("Незавершенные, Упавшие", Новый Массив, Новый Массив);
	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Срок;

	Для Каждого Задание Из Задания Цикл
		Остаток = КрайнийСрок - ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если НЕ Задание.ОжидатьЗавершения(Макс(Остаток, 1)) Тогда
			Итог.Незавершенные.Добавить(Задание);
		ИначеЕсли Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Итог.Упавшие.Добавить(Задание);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Сообщает в вывод теста о заданиях, не завершившихся или упавших. Для обработчика исключения
// теста: исходная ошибка пробрасывается после, а итоги заданий только выводятся.
//
// Параметры:
//   Итог - Структура - Итог ДождатьсяЗаданий.
//
Процедура СообщитьОЗаданиях(Итог) Экспорт

	Если Итог.Незавершенные.Количество() > 0 Тогда
		Сообщить(СтрШаблон("Не завершились фоновые задания: %1", Итог.Незавершенные.Количество()));
	КонецЕсли;

	Для Каждого Задание Из Итог.Упавшие Цикл
		Сообщить("Фоновое задание завершилось ошибкой: "
			+ ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке));
	КонецЦикла;

КонецПроцедуры

// Дожидается фоновых заданий и бросает, если какое-то не завершилось за срок или упало. Для
// штатного пути теста, после его Попытка.
//
// Параметры:
//   Задания - Массив из ФоновоеЗадание - Задания теста.
//   Срок - Число - Общий срок ожидания в миллисекундах.
//
Процедура ПроверитьЗадания(Задания, Знач Срок = 30000) Экспорт

	Итог = ДождатьсяЗаданий(Задания, Срок);

	Если Итог.Незавершенные.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Фоновые задания не завершились за %1 мс: %2",
			Формат(Срок, "ЧГ="),
			Итог.Незавершенные.Количество()
		);
	КонецЕсли;

	Если Итог.Упавшие.Количество() > 0 Тогда
		ВызватьИсключение "Фоновое задание завершилось ошибкой: "
			+ ПодробноеПредставлениеОшибки(Итог.Упавшие[0].ИнформацияОбОшибке);
	КонецЕсли;

КонецПроцедуры

// Дожидается одного фонового задания и бросает, если оно не завершилось за срок. Ошибку самого
// задания не проверяет: ее проверяют тесты, которым она и нужна.
//
// Параметры:
//   Задание - ФоновоеЗадание - Задание.
//   Срок - Число - Срок ожидания в миллисекундах.
//
Процедура ДождатьсяЗадания(Задание, Знач Срок = 30000) Экспорт

	Если НЕ Задание.ОжидатьЗавершения(Макс(Срок, 1)) Тогда
		ВызватьИсключение СтрШаблон("Фоновое задание не завершилось за %1 мс", Формат(Срок, "ЧГ="));
	КонецЕсли;

КонецПроцедуры

// Удаляет таблицы в базе данных менеджера сущностей.
//
// Параметры:
//   ОбъектСПулом - МенеджерСущностей - Объект, у которого берется коннектор.
//
Процедура СброситьТаблицы(ОбъектСПулом) Экспорт

	ОбъектСПулом.ВыполнитьСКоннектором(
		"Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
		Новый Структура("Запрос", "DROP SCHEMA public CASCADE; CREATE SCHEMA public;")
	);

КонецПроцедуры
