// Синхронизация пула соединений: очередь ожидающих, порядок выдачи, сбои под блокировкой,
// проверка пригодности, наблюдатели, работающие с БД изнутри захвата, и закрытие пула при
// занятых соединениях других потоков.
//
// Правила тестов с фоновыми заданиями (docs и план переделки пула, раздел 8.1): задание получает
// все, что ему нужно, параметром-структурой и возвращает итог через Задание.Результат; общих
// изменяемых переменных модуля нет; все задания - с отдельным потоком и ждутся с общим сроком
// (ТестовыеУтилиты.ДождатьсяЗаданий); объекты, которые трогают несколько потоков, - фикстуры со
// своей блокировкой.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

#Использовать moskito

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	Для Каждого Имя Из СтрРазделить(
		"КоннекторУправляемоеОткрытие,НастройкиТестовогоКоннектора,ПланЗакрытийКоннектора,ОбрывСоединений,"
			+ "ПланСбоевКоннектора,БлокировкаПулаДляТестов,ПотокиСПодменой,АппендерПоЗаказу,ОбщийСписок,"
			+ "ОтметкиЗанятости,НаблюдательСДействием,НаблюдательЗадерживающий,НаблюдательПадающий,"
			+ "НаблюдательЗаписывающий,КоннекторСобытиемПриПодключении,СигналСобытия,ВложеннаяРабота",
		","
	) Цикл
		ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", Имя + ".os"), Имя);
	КонецЦикла;

КонецПроцедуры

#Область Блокировка_пула

// Быстрый путь - один участок под блокировкой пула на захват и один на возврат: снимок для события
// берется в том же участке, а не отдельным захватом.
//
&Тест
Процедура ЗахватИВозвратБерутБлокировкуПулаПоРазу() Экспорт

	Блокировка = Новый БлокировкаПулаДляТестов;
	Пул = НовыйПул(2, , Блокировка);

	Попытка

		// Первый захват открывает соединение по брони - путь длиннее; меряется повторный.
		Пул.Занять();
		Пул.Освободить();

		До = Блокировка.ЗахватовТекущегоПотока();
		Пул.Занять();
		Пул.Освободить();
		Захватов = Блокировка.ЗахватовТекущегоПотока() - До;

		Ожидаем.Что(Захватов, "Захват и возврат взяли блокировку пула по разу").Равно(2);

	Исключение
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Опрашивает пул только первый в очереди: остальные спят на блокировке заявки предшественника.
//
&Тест
Процедура СтоящиеЗаПервымНеБерутБлокировкуПула() Экспорт

	Пауза = 10;
	Блокировка = Новый БлокировкаПулаДляТестов;
	Пул = НовыйПул(1, , Блокировка, 30000, Пауза);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		Для Номер = 1 По 4 Цикл
			ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
			ДождатьсяОжидающих(Пул, Номер);
		КонецЦикла;

		// Окно без обращений теста к пулу: захваты в нем делают только стоящие в очереди.
		До = Блокировка.ПоПотокам();
		Окно = 300;
		Приостановить(Окно);
		После = Блокировка.ПоПотокам();

		Опрашивавших = 0;
		Захватов = 0;
		Для Каждого КлючИЗначение Из После Цикл
			Было = До.Получить(КлючИЗначение.Ключ);
			Разница = КлючИЗначение.Значение - ?(Было = Неопределено, 0, Было);
			Если Разница > 0 Тогда
				Опрашивавших = Опрашивавших + 1;
				Захватов = Захватов + Разница;
			КонецЕсли;
		КонецЦикла;

		Ожидаем.Что(Опрашивавших, "Блокировку пула в окне брал только первый в очереди").Не_().Больше(1);
		Ожидаем
			.Что(Захватов, "Первый в очереди опрашивает раз в паузу")
			.Не_().Больше(1.5 * Окно / Пауза + 2);

		Пул.Освободить();

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	ПроверитьЧтоВсеПолучили(Задания);
	Пул.Закрыть();

КонецПроцедуры

// Отказ захвата блокировки пула у первого в очереди - ошибка ему, а очередь идет дальше: его
// обработчик уменьшает счетчик ожидающих и снимает блокировку своей заявки.
//
&Тест
Процедура ОтказЗахватаУПервогоВОчередиОтпускаетОчередь() Экспорт

	Блокировка = Новый БлокировкаПулаДляТестов;
	Пул = НовыйПул(1, , Блокировка, 30000, 500);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		// Захваты первого: быстрый участок, медленный с постановкой, первый опрос, второй опрос -
		// он и отказывает, пока второй уже стоит за первым.
		Первый = ЗапуститьВФоне(Задания, "ЗанятьСОтказомВФоне",
			Новый Структура("Пул, Блокировка, Номера", Пул, Блокировка, 4));
		ДождатьсяОжидающих(Пул, 1);
		Второй = ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		ДождатьсяОжидающих(Пул, 2);

		ТестовыеУтилиты.ДождатьсяЗадания(Первый);
		Пул.Освободить();
		ТестовыеУтилиты.ДождатьсяЗадания(Второй);

		Ожидаем.Что(Первый.Результат.Ошибка, "Первый получил отказ захвата").Содержит("Отказ захвата");
		Ожидаем.Что(Второй.Результат.Ошибка, "Второй дождался соединения").Равно(Неопределено);
		Ожидаем.Что(Пул.КоличествоОжидающих(), "Очередь пуста").Равно(0);
		ПроверитьЧтоБлокировкаПулаСвободна(Пул);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Отказ захвата и в обработчике ошибки ожидания не оставляет счетчик ожидающих завышенным:
// следующий захват того же потока уменьшает его первым делом.
//
&Тест
Процедура НеуменьшенныйСчетчикНеОтрезаетОчередь() Экспорт

	Блокировка = Новый БлокировкаПулаДляТестов;
	Пул = НовыйПул(1, , Блокировка, 30000, 500);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		СигналОтказа = Новый СигналСобытия;
		СигналПовтора = Новый СигналСобытия;
		Задание = ЗапуститьВФоне(Задания, "ОтказатьИПовторитьВФоне", Новый Структура(
			"Пул, Блокировка, Номера, СигналОтказа, СигналПовтора",
			Пул, Блокировка, НомераПопыток(4, 5), СигналОтказа, СигналПовтора));

		Ожидаем.Что(СигналОтказа.Дождаться(), "Захват задания отказал").ЭтоИстина();
		Пул.Освободить();
		СигналПовтора.Отметить();
		ТестовыеУтилиты.ДождатьсяЗадания(Задание);

		Ожидаем.Что(Задание.Результат.ОшибкаПервого, "Первый захват отказал").Содержит("Отказ захвата");
		Ожидаем.Что(Задание.Результат.ОшибкаВторого, "Повторный захват прошел").Равно(Неопределено);
		Ожидаем.Что(Задание.Результат.ОжидающихПослеПовтора, "Счетчик ожидающих сошелся").Равно(0);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Отказ захвата медленного участка - ошибка вызывающему, событие захвата завершено, очередь не
// тронута.
//
&Тест
Процедура ОтказЗахватаМедленногоУчасткаНеОставляетСледов() Экспорт

	Блокировка = Новый БлокировкаПулаДляТестов;
	Пул = НовыйПул(1, , Блокировка);
	Записывающий = Новый НаблюдательЗаписывающий;
	Пул.Наблюдатели().Добавить(Записывающий);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		Задание = ЗапуститьВФоне(Задания, "ЗанятьСОтказомВФоне",
			Новый Структура("Пул, Блокировка, Номера, Записывающий", Пул, Блокировка, 2, Записывающий));
		ТестовыеУтилиты.ДождатьсяЗадания(Задание);

		Ожидаем.Что(Задание.Результат.Ошибка, "Захват отказал").Содержит("Отказ захвата");
		// Считается в самом задании сразу после отказа: к концу задания отложенное разослал бы и
		// захват обработчика завершения потока, и тест не увидел бы, что рассылка опоздала.
		Ожидаем
			.Что(Задание.Результат.ЗахватовСОшибкой, "Событие отказавшего захвата завершено до выхода из Занять")
			.Равно(1);
		Ожидаем.Что(Пул.КоличествоОжидающих(), "Очередь не тронута").Равно(0);
		ПроверитьЧтоБлокировкаПулаСвободна(Пул);

		Пул.Освободить();

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Отказ захвата при закреплении открытого соединения: открытое закрывается, бронь помечается
// неубранной, и следующий захват потока убирает ее - место не теряется.
//
&Тест
Процедура ОтказЗахватаВЗакрепитьОткрытоеНеТеряетМесто() Экспорт

	Блокировка = Новый БлокировкаПулаДляТестов;
	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланЗакрытий = Новый ПланЗакрытийКоннектора(1000);
	Пул = НовыйПул(1, Настройки, Блокировка);

	Попытка

		// Захваты: быстрый участок, медленный с бронью, закрепление открытого - отказывает он.
		Блокировка.ЗаказатьОтказ(3);
		Ожидаем
			.Что(Пул, "Захват отказал при закреплении")
			.Метод("Занять")
			.ВыбрасываетИсключение("Отказ захвата");

		Ожидаем
			.Что(Настройки.ПланЗакрытий.ВыполненоЗакрытий(), "Открытое соединение закрыто")
			.Равно(1);

		Пул.Занять();

		Ожидаем.Что(Пул.КоличествоСозданных(), "Место неубранной брони вернулось").Равно(1);

		Пул.Освободить();

		Ожидаем.Что(Пул.КоличествоСвободных(), "Соединение вернулось в пул").Равно(1);

	Исключение
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Порядок_очереди

// Соединения достаются ожидающим в порядке постановки в очередь.
//
&Тест
Процедура СоединенияДостаютсяВПорядкеПостановки() Экспорт

	Пул = НовыйПул(1);
	Порядок = Новый ОбщийСписок;
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		Для Номер = 1 По 5 Цикл
			ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
				Новый Структура("Пул, Порядок, Метка", Пул, Порядок, Номер));
			ДождатьсяОжидающих(Пул, Номер);
		КонецЦикла;

		Пул.Освободить();
		ПроверитьЧтоВсеПолучили(Задания);

		Ожидаем.Что(СтрСоединить(Порядок.Копия(), ","), "Порядок получения").Равно("1,2,3,4,5");

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Место оборванного соединения достается первому в очереди, а не пришедшему после него: при
// ожидающих новый поток ничего не берет сам. Пауза опроса большая, чтобы ожидающий не успевал
// проснуться раньше пришедшего.
//
&Тест
Процедура НовыйПотокНеОбгоняетОчередьЗаМестомОборванногоСоединения() Экспорт

	Обрыв = Новый ОбрывСоединений;
	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ОбрывСоединений = Обрыв;
	Пул = НовыйПул(1, Настройки, , 30000, 5000);
	Порядок = Новый ОбщийСписок;
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
			Новый Структура("Пул, Порядок, Метка", Пул, Порядок, "ожидающий"));
		ДождатьсяОжидающих(Пул, 1);

		Обрыв.ОборватьОткрытые();
		Пул.Освободить();

		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
			Новый Структура("Пул, Порядок, Метка", Пул, Порядок, "новый"));

		ПроверитьЧтоВсеПолучили(Задания);

		Ожидаем.Что(СтрСоединить(Порядок.Копия(), ","), "Порядок получения").Равно("ожидающий,новый");

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Место упавшего открытия достается первому в очереди, а не пришедшему после него.
//
&Тест
Процедура НовыйПотокНеОбгоняетОчередьЗаМестомУпавшегоОткрытия() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПаузаОткрытия = 500;
	Настройки.ПланОткрытий = Новый ПланСбоевКоннектора;
	Настройки.ПланОткрытий.Взвести(1);
	Пул = НовыйПул(1, Настройки, , 30000, 5000);
	Порядок = Новый ОбщийСписок;
	Задания = Новый Массив;

	Попытка

		// Первое задание берет место и открывает соединение, которое упадет.
		Открывающий = ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
			Новый Структура("Пул, Порядок, Метка", Пул, Порядок, "упавший"));
		ДождатьсяСозданных(Пул, 1);

		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
			Новый Структура("Пул, Порядок, Метка", Пул, Порядок, "ожидающий"));
		ДождатьсяОжидающих(Пул, 1);

		ТестовыеУтилиты.ДождатьсяЗадания(Открывающий);
		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
			Новый Структура("Пул, Порядок, Метка", Пул, Порядок, "новый"));

		ТестовыеУтилиты.ПроверитьЗадания(Задания, 60000);

		Ожидаем.Что(Открывающий.Результат.Ошибка, "Открытие упало").Содержит("Открытие соединения не удалось");
		Ожидаем.Что(СтрСоединить(Порядок.Копия(), ","), "Порядок получения").Равно("ожидающий,новый");

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, 60000));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Срок ожидания каждого считается от его постановки в очередь, включая сон на блокировке
// предшественника: k-й в очереди не ждет k пределов.
//
&Тест
Процедура СрокСчитаетсяОтПостановки() Экспорт

	Предел = 500;
	Пауза = 10;
	Пул = НовыйПул(1, , , Предел, Пауза);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Для Номер = 1 По 8 Цикл
			ЗапуститьВФоне(Задания, "ЗанятьСЗамеромВФоне", Новый Структура("Пул", Пул));
		КонецЦикла;

		ТестовыеУтилиты.ПроверитьЗадания(Задания);
		Всего = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Для Каждого Задание Из Задания Цикл
			Итог = Задание.Результат;
			Ожидаем.Что(Итог.Ошибка, "Ожидающий не дождался").Содержит("не дождался");
			Ожидаем
				.Что(Итог.Конец - Итог.Начало, "Ожидание уложилось в свой предел")
				.Не_().Больше(Предел + Пауза + 200);
		КонецЦикла;

		Ожидаем.Что(Всего, "Очередь ушла за один предел").Меньше(1500);

		Пул.Освободить();

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Не дождавшийся завершает событие захвата ровно один раз - ошибкой, - и откладывание рассылки за
// ним не остается: следующий захват того же потока проходит и рассылается как обычно.
//
&Тест
Процедура НеДождавшийсяЗавершаетСобытиеОдинРаз() Экспорт

	Пул = НовыйПул(1, , , 500);
	Записывающий = Новый НаблюдательЗаписывающий;
	Пул.Наблюдатели().Добавить(Записывающий);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		СигналОтказа = Новый СигналСобытия;
		СигналПовтора = Новый СигналСобытия;
		Задание = ЗапуститьВФоне(Задания, "НеДождатьсяИПовторитьВФоне", Новый Структура(
			"Пул, Записывающий, СигналОтказа, СигналПовтора", Пул, Записывающий, СигналОтказа, СигналПовтора));

		Ожидаем.Что(СигналОтказа.Дождаться(), "Задание не дождалось").ЭтоИстина();
		Пул.Освободить();
		СигналПовтора.Отметить();
		ТестовыеУтилиты.ДождатьсяЗадания(Задание);

		Ожидаем.Что(Задание.Результат.ОшибкаПервого, "Первый захват не дождался").Содержит("не дождался");
		Ожидаем.Что(Задание.Результат.ОшибкаВторого, "Повторный захват прошел").Равно(Неопределено);
		Ожидаем
			.Что(Задание.Результат.ЗахватовДоОсвобождения, "Событие повторного захвата разослано сразу")
			.Равно(3);
		Ожидаем
			.Что(Записывающий.Завершенные("Соединение", "Занять").Количество(), "Событий захвата три")
			.Равно(3);
		Ожидаем.Что(ЗахватовСОшибкой(Записывающий), "Событие не дождавшегося - одно, с ошибкой").Равно(1);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Закрытие пула отпускает всю очередь: каждый ожидающий получает ошибку о закрытом пуле и свое
// завершенное событие.
//
&Тест
Процедура ЗакрытиеПулаОтпускаетВсюОчередь() Экспорт

	Пул = НовыйПул(1);
	Записывающий = Новый НаблюдательЗаписывающий;
	Пул.Наблюдатели().Добавить(Записывающий);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		Для Номер = 1 По 5 Цикл
			ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		КонецЦикла;
		ДождатьсяОжидающих(Пул, 5);

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пул.Закрыть();
		ТестовыеУтилиты.ПроверитьЗадания(Задания);
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Для Каждого Задание Из Задания Цикл
			Ожидаем.Что(Задание.Результат.Ошибка, "Ожидающий узнал о закрытии").Содержит("Пул соединений закрыт");
		КонецЦикла;
		Ожидаем.Что(Длительность, "Очередь ушла быстро").Меньше(2000);
		Ожидаем.Что(ЗахватовСОшибкой(Записывающий), "По событию на каждого ожидающего").Равно(5);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Упавшее открытие первого в очереди не держит очередь: следующий открывает свое и получает.
//
&Тест
Процедура УпавшееОткрытиеПервогоВОчередиОтпускаетОчередь() Экспорт

	Обрыв = Новый ОбрывСоединений;
	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ОбрывСоединений = Обрыв;
	Настройки.ПланОткрытий = Новый ПланСбоевКоннектора;
	Пул = НовыйПул(1, Настройки, , 2000);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		ДождатьсяОжидающих(Пул, 1);
		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		ДождатьсяОжидающих(Пул, 2);

		// Место освобождается оборванным соединением держателя; первое открытие после взвода падает.
		Настройки.ПланОткрытий.Взвести(1);
		Обрыв.ОборватьОткрытые();
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пул.Освободить();

		ТестовыеУтилиты.ПроверитьЗадания(Задания);
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Упавших = 0;
		Получивших = 0;
		Для Каждого Задание Из Задания Цикл
			Если Задание.Результат.Ошибка = Неопределено Тогда
				Получивших = Получивших + 1;
			ИначеЕсли СтрНайти(Задание.Результат.Ошибка, "Открытие соединения не удалось") > 0 Тогда
				Упавших = Упавших + 1;
			КонецЕсли;
		КонецЦикла;

		Ожидаем.Что(Упавших, "Одному досталось упавшее открытие").Равно(1);
		Ожидаем.Что(Получивших, "Другой открыл свое и получил").Равно(1);
		Ожидаем.Что(Длительность, "Очередь не повисла").Меньше(2000);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Свободные соединения выдаются стеком: последнее возвращенное - первым.
//
&Тест
Процедура ПоследнееВозвращенноеВыдаетсяПервым() Экспорт

	Потоки = Мок.Получить(Тип("ПотокиИсполнения"));
	Пул = НовыйПул(3, , , 1000, 10, Потоки);

	Попытка

		Соединения = Новый Массив;
		ПотокиСоединений = Новый Массив;
		Для Номер = 1 По 3 Цикл
			Поток = Мок.Получить(Тип("ПотокИсполнения"));
			ПотокиСоединений.Добавить(Поток);
			Потоки.Когда().Текущий().ТогдаВозвращает(Поток);
			Соединения.Добавить(Пул.Занять());
		КонецЦикла;

		Для Каждого Поток Из ПотокиСоединений Цикл
			Потоки.Когда().Текущий().ТогдаВозвращает(Поток);
			Пул.Освободить();
			Приостановить(5);
		КонецЦикла;

		Потоки.Когда().Текущий().ТогдаВозвращает(Мок.Получить(Тип("ПотокИсполнения")));
		Ожидаем.Что(Пул.Занять() = Соединения[2], "Выдано возвращенное последним").ЭтоИстина();

	Исключение
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Стоимость_очереди

// Возврат соединения при длинной очереди стоит столько же, сколько без нее: соединение кладется
// в свободные, очередь не перебирается.
//
&Тест
Процедура ВозвратСоединенияНеДорожаетСДлинойОчереди() Экспорт
	ПроверитьСтоимостьПриОчереди("Освободить");
КонецПроцедуры

// Завершение потока, державшего соединение, при длинной очереди стоит столько же, сколько без нее.
//
&Тест
Процедура ЗавершениеПотокаНеДорожаетСДлинойОчереди() Экспорт
	ПроверитьСтоимостьПриОчереди("Завершить");
КонецПроцедуры

// Меряет 20 возвратов соединений поддельными потоками без очереди и при 200 ожидающих.
//
// Параметры:
//   Способ - Строка - "Освободить" или "Завершить": чем поддельный поток отдает соединение.
//
Процедура ПроверитьСтоимостьПриОчереди(Знач Способ)

	РазмерПула = 20;
	Потоки = Новый ПотокиСПодменой;
	Пул = НовыйПул(РазмерПула, , , 120000, 1000, Потоки);
	Задания = Новый Массив;

	Попытка

		Держатели = ЗанятьПоддельнымиПотоками(Пул, Потоки, РазмерПула);
		БезОчереди = ОтдатьСЗамером(Держатели, Потоки, Пул, Способ);

		Держатели = ЗанятьПоддельнымиПотоками(Пул, Потоки, РазмерПула);
		Для Номер = 1 По 200 Цикл
			ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		КонецЦикла;
		ДождатьсяОжидающих(Пул, 200, 60000);

		ПриОчереди = ОтдатьСЗамером(Держатели, Потоки, Пул, Способ);

		Ожидаем
			.Что(ПриОчереди, СтрШаблон("Возврат при очереди: %1 мс, без очереди: %2 мс", ПриОчереди, БезОчереди))
			.Не_().Больше(3 * БезОчереди + 50);

		ТестовыеУтилиты.ПроверитьЗадания(Задания, 120000);

	Исключение
		Потоки.СнятьПодмену();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, 120000));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Проверка_пригодности

// Исключение из проверки пригодности свободного соединения значит "непригодно": соединение
// закрывается, место возвращается, захват получает новое.
//
&Тест
Процедура СбойПроверкиСвободногоСоединенияНеТеряетМесто() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Пул = НовыйПул(1, Настройки);
	Аппендер = ПодключитьАппендер("oscript.lib.entity.pool");

	Попытка

		Пул.Занять();
		Пул.Освободить();

		Настройки.ПланПроверок.Взвести(1);
		Соединение = Пул.Занять();

		Ожидаем.Что(Соединение.ПолучитьКоннектор().Открыт(), "Выдано живое соединение").ЭтоИстина();
		Ожидаем.Что(Пул.КоличествоСозданных(), "Место не потеряно").Равно(1);
		Ожидаем.Что(Аппендер.Записей(), "Сбой проверки записан в журнал").Больше(0);

		Пул.Освободить();

	Исключение
		ОтключитьАппендер("oscript.lib.entity.pool", Аппендер);
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	ОтключитьАппендер("oscript.lib.entity.pool", Аппендер);
	Пул.Закрыть();

КонецПроцедуры

// Исключение из проверки пригодности при возврате: Освободить не бросает, соединение закрыто,
// место возвращено.
//
&Тест
Процедура СбойПроверкиПриВозвратеНеТеряетМесто() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Пул = НовыйПул(1, Настройки);

	Попытка

		Соединение = Пул.Занять();
		Настройки.ПланПроверок.Взвести(1);
		Пул.Освободить();

		Ожидаем.Что(Соединение.ПолучитьКоннектор().Открыт(), "Соединение закрыто").ЭтоЛожь();
		Ожидаем.Что(Пул.КоличествоСозданных(), "Место вернулось").Равно(0);

	Исключение
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Исключение из проверки пригодности при завершении потока: соединение закрыто, место возвращено,
// подписчики завершения после пула вызваны.
//
&Тест
Процедура СбойПроверкиПриЗавершенииПотокаНеТеряетМесто() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Потоки = Мок.Получить(Тип("ПотокиИсполнения"));
	Поток = Мок.Получить(Тип("ПотокИсполнения"));
	Пул = НовыйПул(1, Настройки, , 1000, 10, Потоки);

	Попытка

		Потоки.Когда().Текущий().ТогдаВозвращает(Поток);
		Соединение = Пул.Занять();

		ПодписчикПослеПула = Новый СигналСобытия;
		ДобавитьОбработчик Поток.ПриЗавершении, ПодписчикПослеПула.Отметить;

		Настройки.ПланПроверок.Взвести(1);
		Поток.ВызватьСобытие("ПриЗавершении", Новый Массив);

		Ожидаем.Что(Соединение.ПолучитьКоннектор().Открыт(), "Соединение закрыто").ЭтоЛожь();
		Ожидаем.Что(Пул.КоличествоСозданных(), "Место вернулось").Равно(0);
		Ожидаем.Что(ПодписчикПослеПула.Отмечен(), "Подписчик после пула вызван").ЭтоИстина();

	Исключение
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Исключение из проверки пригодности при живой транзакции: Освободить не бросает, соединение и
// транзакция остаются за потоком, фиксация проходит.
//
&Тест
Процедура СбойПроверкиПриЖивойТранзакцииНеОбрываетТранзакцию() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Источник = НовыйИсточник(1, Настройки);
	Пул = Источник.ПулСоединений();

	Попытка

		РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(Источник);

		Пул.Занять();
		Настройки.ПланПроверок.Взвести(1);
		Пул.Освободить();

		Ожидаем.Что(Пул.ЕстьСоединениеТекущегоПотокаИсполнения(), "Соединение за потоком").ЭтоИстина();

		РаботаСКоннекторами.ЗафиксироватьТранзакциюПотокаИсполнения(Источник);

		Ожидаем.Что(Пул.КоличествоЗанятых(), "После фиксации соединение вернулось").Равно(0);

	Исключение
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

// Исключение из проверки пригодности внутри начала транзакции: начало не бросает, фиксация
// проходит.
//
&Тест
Процедура СбойПроверкиПриНачалеТранзакции() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Источник = НовыйИсточник(1, Настройки);
	Пул = Источник.ПулСоединений();

	Попытка

		Настройки.ПланПроверок.Взвести(1);
		РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(Источник);
		РаботаСКоннекторами.ЗафиксироватьТранзакциюПотокаИсполнения(Источник);

		Ожидаем.Что(Пул.КоличествоЗанятых(), "После фиксации соединение вернулось").Равно(0);

	Исключение
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

// Сбой драйвера у первого в очереди - и проверка, и закрытие непригодного падают - не держит
// очередь: первый открывает новое соединение, второй получает его после первого.
//
&Тест
Процедура СбойДрайвераУПервогоВОчередиНеДержитОчередь() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Настройки.ПланЗакрытий = Новый ПланЗакрытийКоннектора(1, 1);
	Пул = НовыйПул(1, Настройки);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		ДождатьсяОжидающих(Пул, 1);
		ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		ДождатьсяОжидающих(Пул, 2);

		// Первая проверка - при возврате держателем, вторая - у первого в очереди: она и падает.
		Настройки.ПланПроверок.Взвести(2);
		Пул.Освободить();

		ПроверитьЧтоВсеПолучили(Задания);

		Ожидаем.Что(Пул.КоличествоСозданных(), "Живо одно соединение").Равно(1);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Закрытие пула доводится до конца и тогда, когда вопрос о состоянии соединения сам падает: такое
// соединение закрывается без проверки.
//
&Тест
Процедура ЗакрытиеПулаПриСбоеОткрытДоводитсяДоКонца() Экспорт

	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ПланПроверок = Новый ПланСбоевКоннектора;
	Пул = НовыйПул(1, Настройки);

	Пул.Занять();
	Пул.Освободить();

	Настройки.ПланПроверок.Взвести(1);
	Пул.Закрыть();

	Ожидаем.Что(Пул.КоличествоСозданных(), "Соединение закрыто").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Наблюдатели_внутри_захвата

// Наблюдатель в начале захвата открыл транзакцию через менеджер - вложенный захват оставил
// соединение за потоком. Внешний захват получает то же соединение углублением.
//
&Тест
Процедура ВложенныйЗахватОставилСоединениеМедленныйУчастокУглубляет() Экспорт

	Источник = НовыйИсточник(2);
	Менеджер = Новый МенеджерСущностей(Источник);
	Пул = Источник.ПулСоединений();

	Записывающий = Новый НаблюдательЗаписывающий;
	Открывающий = Новый НаблюдательСДействием("Соединение", "Занять", "До",
		Новый Действие(Менеджер, "НачатьТранзакцию"), Истина);
	Источник.ДобавитьНаблюдателя(Записывающий);
	Источник.ДобавитьНаблюдателя(Открывающий);

	Попытка

		Соединение = Пул.Занять();

		Ожидаем.Что(Открывающий.Ошибки(), "Транзакция в наблюдателе открылась").ИмеетДлину(0);
		Ожидаем.Что(Соединение.ВТранзакции(), "Внешний захват получил соединение транзакции").ЭтоИстина();
		Ожидаем.Что(Пул.КоличествоСозданных(), "Открыто одно соединение").Равно(1);

		Захваты = Записывающий.Завершенные("Соединение", "Занять");
		Внешний = Захваты[Захваты.ВГраница()];
		Ожидаем.Что(Внешний.Открыто(), "Внешний захват соединения не открывал").ЭтоЛожь();
		Ожидаем.Что(Внешний.Ожидание(), "Внешний захват не ждал").Равно(0);

		Пул.Освободить();
		Менеджер.ОтменитьТранзакцию();

	Исключение
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

// Медленный наблюдатель в начале захвата у одного потока не держит очередь: пока он работает,
// поток еще не в очереди, и соединение достается следующему.
//
&Тест
Процедура МедленныйНаблюдательУОжидающегоНеДержитОчередь() Экспорт

	Пул = НовыйПул(1, , , 3000);
	СигналДошел = Новый СигналСобытия;
	СигналОтпустить = Новый СигналСобытия;
	Задерживающий = Новый НаблюдательЗадерживающий(СигналДошел, СигналОтпустить);
	Пул.Наблюдатели().Добавить(Задерживающий);
	Задания = Новый Массив;

	Попытка

		Пул.Занять();

		Задержанный = ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне",
			Новый Структура("Пул, КлючПометки", Пул, Задерживающий.КлючПометки()));
		Ожидаем.Что(СигналДошел.Дождаться(), "Наблюдатель задержал поток").ЭтоИстина();

		Следующий = ЗапуститьВФоне(Задания, "ЗанятьИОсвободитьВФоне", Новый Структура("Пул", Пул));
		ДождатьсяОжидающих(Пул, 1);
		Приостановить(200);

		Пул.Освободить();
		ТестовыеУтилиты.ДождатьсяЗадания(Следующий);
		СигналОтпустить.Отметить();
		ТестовыеУтилиты.ДождатьсяЗадания(Задержанный);

		Ожидаем.Что(Следующий.Результат.Ошибка, "Следующий получил соединение").Равно(Неопределено);
		Ожидаем.Что(Задержанный.Результат.Ошибка, "Задержанный тоже получил").Равно(Неопределено);

	Исключение
		СигналОтпустить.Отметить();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

// Наблюдатель в начале захвата работает с БД через менеджер на пути брони: вложенная операция
// проходит, лишнего места не занято.
//
&Тест
Процедура НаблюдательРаботаетСБДВНачалеЗахватаПоБрони() Экспорт

	Источник = НовыйИсточник(2);
	Менеджер = Новый МенеджерСущностей(Источник);
	Пул = Источник.ПулСоединений();

	Работающий = Новый НаблюдательСДействием("Соединение", "Занять", "До",
		Новый Действие(Новый ВложеннаяРабота(Менеджер), "Сделать"), Истина);
	Источник.ДобавитьНаблюдателя(Работающий);

	Попытка

		Пул.Занять();
		Пул.Освободить();

		Ожидаем.Что(Работающий.Выполнено(), "Наблюдатель поработал с БД").Равно(1);
		Ожидаем.Что(Работающий.Ошибки(), "Вложенная операция прошла").ИмеетДлину(0);
		Ожидаем
			.Что(Пул.КоличествоСозданных(), "Мест занято столько, сколько живых соединений")
			.Равно(Пул.КоличествоСвободных());

	Исключение
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

// Наблюдатель в начале захвата работает с БД на пути очереди: вложенный захват не встает за
// заявкой своего же потока и получает соединение.
//
&Тест
Процедура НаблюдательРаботаетСБДВНачалеЗахватаВОчереди() Экспорт

	Пул = НовыйПул(1, , , 2000);
	Задания = Новый Массив;

	Попытка

		СигналЗанял = Новый СигналСобытия;
		ЗапуститьВФоне(Задания, "ПодержатьВФоне", Новый Структура("Пул, СигналЗанял, Пауза", Пул, СигналЗанял, 500));
		Ожидаем.Что(СигналЗанял.Дождаться(), "Держатель занял соединение").ЭтоИстина();

		Работающий = Новый НаблюдательСДействием("Соединение", "Занять", "До",
			Новый Действие(Новый ВложеннаяРабота(Пул), "Сделать"), Истина);
		Пул.Наблюдатели().Добавить(Работающий);

		Пул.Занять();
		Пул.Освободить();

		Ожидаем.Что(Работающий.Выполнено(), "Наблюдатель поработал с БД").Равно(1);
		Ожидаем.Что(Работающий.Ошибки(), "Вложенный захват получил соединение").ИмеетДлину(0);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания);
	Пул.Закрыть();

КонецПроцедуры

// Событие коннектора посреди открытия соединения по брони дожидается закрепления: наблюдатель,
// работающий на нем с БД, получает то же соединение, а не вторую бронь.
//
&Тест
Процедура СобытиеКоннектораПриОткрытииНеДаетВторойБрони() Экспорт

	Источник = Новый ИсточникДанных("С событием при подключении", Тип("КоннекторСобытиемПриПодключении"), "", , 2);
	Менеджер = Новый МенеджерСущностей(Источник);
	Пул = Источник.ПулСоединений();

	Работающий = Новый НаблюдательСДействием("Запрос", "CONNECT", "До",
		Новый Действие(Новый ВложеннаяРабота(Менеджер), "Сделать"), Истина);
	Источник.ДобавитьНаблюдателя(Работающий);

	Попытка

		Пул.Занять();
		Пул.Освободить();

		Ожидаем.Что(Работающий.Выполнено(), "Наблюдатель поработал с БД").Равно(1);
		Ожидаем.Что(Работающий.Ошибки(), "Вложенная операция прошла").ИмеетДлину(0);
		Ожидаем
			.Что(Пул.КоличествоСозданных(), "Мест занято столько, сколько живых соединений")
			.Равно(Пул.КоличествоСвободных());

	Исключение
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

// Сбой рассылки после того, как соединение закреплено, не отменяет захват: журнал упал на записи
// ошибки наблюдателя, а Занять() все равно возвращает соединение.
//
&Тест
Процедура СбойРассылкиНеОтменяетЗахватСвободного() Экспорт
	ПроверитьСбойРассылки("Свободное");
КонецПроцедуры

&Тест
Процедура СбойРассылкиНеОтменяетЗахватВОчереди() Экспорт
	ПроверитьСбойРассылки("Очередь");
КонецПроцедуры

&Тест
Процедура СбойРассылкиНеОтменяетЗахватПоБрони() Экспорт
	ПроверитьСбойРассылки("Бронь");
КонецПроцедуры

// Проверяет захват и возврат при падающем журнале наблюдателей на заданном пути захвата.
//
// Параметры:
//   Путь - Строка - "Свободное", "Очередь" или "Бронь".
//
Процедура ПроверитьСбойРассылки(Знач Путь)

	Пул = НовыйПул(1, , , 30000);
	Записывающий = Новый НаблюдательЗаписывающий;
	Пул.Наблюдатели().Добавить(Записывающий);
	Пул.Наблюдатели().Добавить(Новый НаблюдательПадающий);
	Задания = Новый Массив;
	Аппендер = ПодключитьАппендер("oscript.lib.entity.observers");

	Попытка

		Если Путь = "Свободное" Тогда
			Пул.Занять();
			Пул.Освободить();
		ИначеЕсли Путь = "Очередь" Тогда
			СигналЗанял = Новый СигналСобытия;
			ЗапуститьВФоне(Задания, "ПодержатьВФоне",
				Новый Структура("Пул, СигналЗанял, Пауза", Пул, СигналЗанял, 300));
			Ожидаем.Что(СигналЗанял.Дождаться(), "Держатель занял соединение").ЭтоИстина();
		КонецЕсли;

		ЗахватовДо = Записывающий.Завершенные("Соединение", "Занять").Количество();
		Аппендер.Взвести();

		Соединение = Пул.Занять();
		Пул.Освободить();

		Аппендер.Взвести(Ложь);

		Захваты = Записывающий.Завершенные("Соединение", "Занять");
		Ожидаем.Что(Соединение <> Неопределено, "Захват вернул соединение").ЭтоИстина();
		Ожидаем.Что(Аппендер.Падений(), "Журнал падал").Больше(0);
		Ожидаем.Что(Захваты.Количество() - ЗахватовДо, "Событие захвата завершено один раз").Равно(1);
		Ожидаем.Что(Захваты[Захваты.ВГраница()].Ошибка(), "Событие захвата без ошибки").Равно(Неопределено);
		Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение вернулось в пул").Равно(0);

	Исключение
		ОтключитьАппендер("oscript.lib.entity.observers", Аппендер);
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	ОтключитьАппендер("oscript.lib.entity.observers", Аппендер);
	ТестовыеУтилиты.ПроверитьЗадания(Задания);
	Пул.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Закрытие

// Закрытие пула не трогает соединение, которым другой поток пользуется прямо сейчас: его закроет
// сам владелец, вернув.
//
&Тест
Процедура ЗакрытиеПулаНеТрогаетЧужиеЗанятыеСоединения() Экспорт

	Источник = НовыйИсточник(1);
	Пул = Источник.ПулСоединений();
	Задания = Новый Массив;

	Попытка

		СигналЗанял = Новый СигналСобытия;
		СигналЗакрыли = Новый СигналСобытия;
		Задание = ЗапуститьВФоне(Задания, "ПользоватьсяПослеЗакрытияВФоне",
			Новый Структура("Пул, СигналЗанял, СигналЗакрыли", Пул, СигналЗанял, СигналЗакрыли));
		Ожидаем.Что(СигналЗанял.Дождаться(), "Задание заняло соединение").ЭтоИстина();

		Источник.Закрыть();
		СигналЗакрыли.Отметить();
		ТестовыеУтилиты.ДождатьсяЗадания(Задание);

		Итог = Задание.Результат;
		Ожидаем.Что(Итог.Ошибка, "Задание отработало").Равно(Неопределено);
		Ожидаем.Что(Итог.ОткрытоПослеЗакрытия, "Соединение задания не закрыто чужим закрытием").ЭтоИстина();
		Ожидаем.Что(Итог.ЗакрытоПослеВозврата, "Возврат закрыл соединение").ЭтоИстина();
		Ожидаем.Что(Итог.ОшибкаПовторногоЗахвата, "Закрытый пул новых не выдает").Содержит("Пул соединений закрыт");
		Ожидаем.Что(Пул.КоличествоСозданных(), "Место вернулось").Равно(0);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Транзакцию, открытую до закрытия источника, ее владелец может отменить: соединение затем
// закрывается.
//
&Тест
Процедура ТранзакцияДругогоПотокаОтменяетсяПослеЗакрытияИсточника() Экспорт
	ПроверитьЗавершениеТранзакцииПослеЗакрытия("Источник", Ложь);
КонецПроцедуры

// То же при обычном порядке остановки: сначала менеджер, потом источник.
//
&Тест
Процедура ТранзакцияДругогоПотокаОтменяетсяПослеЗакрытияМенеджераИИсточника() Экспорт
	ПроверитьЗавершениеТранзакцииПослеЗакрытия("МенеджерИИсточник", Ложь);
КонецПроцедуры

// То же с фиксацией.
//
&Тест
Процедура ТранзакцияДругогоПотокаФиксируетсяПослеЗакрытияМенеджераИИсточника() Экспорт
	ПроверитьЗавершениеТранзакцииПослеЗакрытия("МенеджерИИсточник", Истина);
КонецПроцедуры

// Закрыт только менеджер: транзакция завершается, соединение возвращается в открытый пул.
//
&Тест
Процедура ТранзакцияДругогоПотокаОтменяетсяПослеЗакрытияМенеджера() Экспорт
	ПроверитьЗавершениеТранзакцииПослеЗакрытия("Менеджер", Ложь);
КонецПроцедуры

// Проверяет завершение транзакции фонового задания после закрытия.
//
// Параметры:
//   Закрываются - Строка - "Источник", "МенеджерИИсточник" или "Менеджер".
//   Фиксировать - Булево - Истина - фиксировать, Ложь - отменять.
//
Процедура ПроверитьЗавершениеТранзакцииПослеЗакрытия(Знач Закрываются, Знач Фиксировать)

	Источник = НовыйИсточник(1);
	Менеджер = Новый МенеджерСущностей(Источник);
	Пул = Источник.ПулСоединений();
	Задания = Новый Массив;

	Попытка

		СигналНачал = Новый СигналСобытия;
		СигналЗакрыли = Новый СигналСобытия;
		Задание = ЗапуститьВФоне(Задания, "ЗавершитьТранзакциюПослеЗакрытияВФоне", Новый Структура(
			"Менеджер, СигналНачал, СигналЗакрыли, Фиксировать",
			Менеджер, СигналНачал, СигналЗакрыли, Фиксировать));
		Ожидаем.Что(СигналНачал.Дождаться(), "Задание начало транзакцию").ЭтоИстина();

		Если Закрываются <> "Источник" Тогда
			Менеджер.Закрыть();
		КонецЕсли;
		Если Закрываются <> "Менеджер" Тогда
			Источник.Закрыть();
		КонецЕсли;

		СигналЗакрыли.Отметить();
		ТестовыеУтилиты.ДождатьсяЗадания(Задание);

		Итог = Задание.Результат;
		Ожидаем.Что(Итог.ОшибкаЗавершения, "Транзакция завершилась").Равно(Неопределено);

		Если Закрываются = "Менеджер" Тогда
			Ожидаем.Что(Пул.КоличествоЗанятых(), "Соединение вернулось").Равно(0);
			Ожидаем.Что(Пул.КоличествоСвободных(), "Соединение в свободных").Равно(1);
			Ожидаем.Что(Итог.ОшибкаОперации, "Операции закрытого менеджера отвергаются").Содержит("Менеджер сущностей закрыт");
		Иначе
			Ожидаем.Что(Пул.КоличествоСозданных(), "Соединение закрыто").Равно(0);
			Ожидаем.Что(Итог.ОшибкаОперации, "Операции после закрытия отвергаются").Содержит("закрыт");
		КонецЕсли;

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

// Завершение транзакции без соединения у закрытого источника - прежняя ошибка о закрытии.
//
&Тест
Процедура ЗавершениеТранзакцииБезСоединенияУЗакрытогоИсточника() Экспорт

	Источник = НовыйИсточник(1);
	Менеджер = Новый МенеджерСущностей(Источник);
	Источник.Закрыть();

	Ожидаем
		.Что(Менеджер, "Отмена без транзакции у закрытого источника")
		.Метод("ОтменитьТранзакцию")
		.ВыбрасываетИсключение("Источник данных <Синхронизация> закрыт");

КонецПроцедуры

// Завершение транзакции без соединения у закрытого менеджера - прежняя ошибка о закрытии.
//
&Тест
Процедура ЗавершениеТранзакцииБезСоединенияУЗакрытогоМенеджера() Экспорт

	Источник = НовыйИсточник(1);
	Менеджер = Новый МенеджерСущностей(Источник);
	Менеджер.Закрыть();

	Попытка
		Ожидаем
			.Что(Менеджер, "Отмена без транзакции у закрытого менеджера")
			.Метод("ОтменитьТранзакцию")
			.ВыбрасываетИсключение("Менеджер сущностей закрыт");
	Исключение
		ЗакрытьИсточникТихо(Источник);
		ВызватьИсключение;
	КонецПопытки;

	Источник.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Нагрузка

// Под нагрузкой соединение выдается одному потоку: 12 заданий по 200 кругов, повторные захваты,
// треть заданий завершается с занятым соединением, параллельно сервер обрывает соединения.
//
&Тест
Процедура ПодНагрузкойСоединениеВыдаетсяОдномуПотоку() Экспорт

	Обрыв = Новый ОбрывСоединений;
	Настройки = Новый НастройкиТестовогоКоннектора;
	Настройки.ОбрывСоединений = Обрыв;
	Пул = НовыйПул(3, Настройки, , 120000, 1);
	Отметки = Новый ОтметкиЗанятости;
	Задания = Новый Массив;

	Попытка

		Для Номер = 1 По 12 Цикл
			ЗапуститьВФоне(Задания, "НагрузитьВФоне", Новый Структура(
				"Пул, Отметки, Кругов, БроситьЗанятым", Пул, Отметки, 200, Номер % 3 = 0));
		КонецЦикла;
		ЗапуститьВФоне(Задания, "ОбрыватьВФоне", Новый Структура("Обрыв, Раз", Обрыв, 50));

		ТестовыеУтилиты.ПроверитьЗадания(Задания, 300000);

		Ошибок = 0;
		Для Каждого Задание Из Задания Цикл
			Если ТипЗнч(Задание.Результат) = Тип("Структура") Тогда
				Ошибок = Ошибок + Задание.Результат.Ошибок;
			КонецЕсли;
		КонецЦикла;

		Ожидаем.Что(Отметки.Нарушений(), "Соединение ни разу не досталось двум потокам").Равно(0);
		Ожидаем.Что(Ошибок, "Ошибок захвата нет").Равно(0);
		Ожидаем.Что(Пул.КоличествоЗанятых(), "Занятых не осталось").Равно(0);
		Ожидаем.Что(Пул.КоличествоОжидающих(), "Ожидающих не осталось").Равно(0);
		Ожидаем.Что(Пул.КоличествоСозданных(), "Места сошлись со свободными").Равно(Пул.КоличествоСвободных());
		Ожидаем.Что(Пул.КоличествоСозданных(), "Предел не превышен").Не_().Больше(3);

	Исключение
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, 300000));
		ЗакрытьПулТихо(Пул);
		ВызватьИсключение;
	КонецПопытки;

	Пул.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Задания

// Занимает и освобождает соединение. Метка, если задана, пишется в Порядок сразу после захвата;
// КлючПометки, если задан, помечает поток для задерживающего наблюдателя.
//
// Параметры:
//   Контекст - Структура - Пул, необязательные Порядок, Метка, КлючПометки.
//
// Возвращаемое значение:
//   Структура - Ошибка: текст ошибки или Неопределено.
//
Функция ЗанятьИОсвободитьВФоне(Контекст) Экспорт

	Итог = Новый Структура("Ошибка");

	Если Контекст.Свойство("КлючПометки") Тогда
		ТекущийПоток().Данные.Вставить(Контекст.КлючПометки, Истина);
	КонецЕсли;

	Попытка
		Контекст.Пул.Занять();
		Если Контекст.Свойство("Порядок") Тогда
			Контекст.Порядок.Добавить(Контекст.Метка);
		КонецЕсли;
		Контекст.Пул.Освободить();
	Исключение
		Итог.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Заказывает себе отказы захвата блокировки пула и занимает соединение. Если задан записывающий
// наблюдатель, сразу после захвата считает его завершенные с ошибкой события захвата.
//
// Параметры:
//   Контекст - Структура - Пул, Блокировка, Номера, необязательный Записывающий.
//
// Возвращаемое значение:
//   Структура - Ошибка: текст ошибки или Неопределено; ЗахватовСОшибкой.
//
Функция ЗанятьСОтказомВФоне(Контекст) Экспорт

	Итог = Новый Структура("Ошибка, ЗахватовСОшибкой");
	Контекст.Блокировка.ЗаказатьОтказ(Контекст.Номера);

	Попытка
		Контекст.Пул.Занять();
		Контекст.Пул.Освободить();
	Исключение
		Итог.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Контекст.Свойство("Записывающий") Тогда
		Итог.ЗахватовСОшибкой = ЗахватовСОшибкой(Контекст.Записывающий);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Получает отказ захвата в очереди, дожидается сигнала теста и занимает снова.
//
// Параметры:
//   Контекст - Структура - Пул, Блокировка, Номера, СигналОтказа, СигналПовтора.
//
// Возвращаемое значение:
//   Структура - ОшибкаПервого, ОшибкаВторого, ОжидающихПослеПовтора.
//
Функция ОтказатьИПовторитьВФоне(Контекст) Экспорт

	Итог = Новый Структура("ОшибкаПервого, ОшибкаВторого, ОжидающихПослеПовтора");
	Контекст.Блокировка.ЗаказатьОтказ(Контекст.Номера);

	Попытка
		Контекст.Пул.Занять();
		Контекст.Пул.Освободить();
	Исключение
		Итог.ОшибкаПервого = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Контекст.СигналОтказа.Отметить();
	Контекст.СигналПовтора.Дождаться();

	Попытка
		Контекст.Пул.Занять();
		Итог.ОжидающихПослеПовтора = Контекст.Пул.КоличествоОжидающих();
		Контекст.Пул.Освободить();
	Исключение
		Итог.ОшибкаВторого = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Не дожидается соединения, дожидается сигнала теста и занимает снова, считая завершенные события
// захвата до своего освобождения.
//
// Параметры:
//   Контекст - Структура - Пул, Записывающий, СигналОтказа, СигналПовтора.
//
// Возвращаемое значение:
//   Структура - ОшибкаПервого, ОшибкаВторого, ЗахватовДоОсвобождения.
//
Функция НеДождатьсяИПовторитьВФоне(Контекст) Экспорт

	Итог = Новый Структура("ОшибкаПервого, ОшибкаВторого, ЗахватовДоОсвобождения");

	Попытка
		Контекст.Пул.Занять();
		Контекст.Пул.Освободить();
	Исключение
		Итог.ОшибкаПервого = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Контекст.СигналОтказа.Отметить();
	Контекст.СигналПовтора.Дождаться();

	Попытка
		Контекст.Пул.Занять();
		Итог.ЗахватовДоОсвобождения = Контекст.Записывающий.Завершенные("Соединение", "Занять").Количество();
		Контекст.Пул.Освободить();
	Исключение
		Итог.ОшибкаВторого = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Занимает соединение, замеряя, когда вошел и когда вышел.
//
// Параметры:
//   Контекст - Структура - Пул.
//
// Возвращаемое значение:
//   Структура - Ошибка, Начало, Конец.
//
Функция ЗанятьСЗамеромВФоне(Контекст) Экспорт

	Итог = Новый Структура("Ошибка, Начало, Конец");
	Итог.Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Контекст.Пул.Занять();
		Контекст.Пул.Освободить();
	Исключение
		Итог.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Итог.Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Возврат Итог;

КонецФункции

// Занимает соединение, отмечает сигнал, держит соединение заданную паузу и освобождает.
//
// Параметры:
//   Контекст - Структура - Пул, СигналЗанял, Пауза.
//
Процедура ПодержатьВФоне(Контекст) Экспорт

	Контекст.Пул.Занять();
	Контекст.СигналЗанял.Отметить();
	Приостановить(Контекст.Пауза);
	Контекст.Пул.Освободить();

КонецПроцедуры

// Занимает соединение и пользуется им после того, как тест закрыл источник: проверяет, что
// соединение живо, возвращает его и пробует занять снова.
//
// Параметры:
//   Контекст - Структура - Пул, СигналЗанял, СигналЗакрыли.
//
// Возвращаемое значение:
//   Структура - Ошибка, ОткрытоПослеЗакрытия, ЗакрытоПослеВозврата, ОшибкаПовторногоЗахвата.
//
Функция ПользоватьсяПослеЗакрытияВФоне(Контекст) Экспорт

	Итог = Новый Структура("Ошибка, ОткрытоПослеЗакрытия, ЗакрытоПослеВозврата, ОшибкаПовторногоЗахвата");

	Попытка
		Соединение = Контекст.Пул.Занять();
		Контекст.СигналЗанял.Отметить();
		Контекст.СигналЗакрыли.Дождаться();
		Итог.ОткрытоПослеЗакрытия = Соединение.ПолучитьКоннектор().Открыт();
		Контекст.Пул.Освободить();
		Итог.ЗакрытоПослеВозврата = НЕ Соединение.ПолучитьКоннектор().Открыт();
	Исключение
		Итог.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Контекст.Пул.Занять();
	Исключение
		Итог.ОшибкаПовторногоЗахвата = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Начинает транзакцию, ждет, пока тест закроет менеджер или источник, завершает транзакцию и
// пробует следующую операцию.
//
// Параметры:
//   Контекст - Структура - Менеджер, СигналНачал, СигналЗакрыли, Фиксировать.
//
// Возвращаемое значение:
//   Структура - ОшибкаЗавершения, ОшибкаОперации.
//
Функция ЗавершитьТранзакциюПослеЗакрытияВФоне(Контекст) Экспорт

	Итог = Новый Структура("ОшибкаЗавершения, ОшибкаОперации");

	Контекст.Менеджер.НачатьТранзакцию();
	Контекст.СигналНачал.Отметить();
	Контекст.СигналЗакрыли.Дождаться();

	Попытка
		Если Контекст.Фиксировать Тогда
			Контекст.Менеджер.ЗафиксироватьТранзакцию();
		Иначе
			Контекст.Менеджер.ОтменитьТранзакцию();
		КонецЕсли;
	Исключение
		Итог.ОшибкаЗавершения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Контекст.Менеджер.ВыполнитьСКоннектором("Коннектор -> Коннектор.Открыт()");
	Исключение
		Итог.ОшибкаОперации = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Круги захвата и освобождения с отметками занятости. Каждый третий круг - с повторным захватом.
//
// Параметры:
//   Контекст - Структура - Пул, Отметки, Кругов, БроситьЗанятым.
//
// Возвращаемое значение:
//   Структура - Ошибок: число ошибок захвата.
//
Функция НагрузитьВФоне(Контекст) Экспорт

	Итог = Новый Структура("Ошибок", 0);

	Для Круг = 1 По Контекст.Кругов Цикл
		Попытка
			Соединение = Контекст.Пул.Занять();
			Повторно = Круг % 3 = 0;
			Если Повторно Тогда
				Контекст.Пул.Занять();
			КонецЕсли;
			Контекст.Отметки.Отметить(Соединение);
			Контекст.Отметки.СнятьОтметку(Соединение);
			Если Повторно Тогда
				Контекст.Пул.Освободить();
			КонецЕсли;
			Контекст.Пул.Освободить();
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецПопытки;
	КонецЦикла;

	// Поток, завершившийся с занятым соединением: его вернет обработчик завершения потока.
	Если Контекст.БроситьЗанятым Тогда
		Попытка
			Контекст.Пул.Занять();
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
		КонецПопытки;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Обрывает соединения пула заданное число раз с короткой паузой.
//
// Параметры:
//   Контекст - Структура - Обрыв, Раз.
//
Процедура ОбрыватьВФоне(Контекст) Экспорт

	Для Номер = 1 По Контекст.Раз Цикл
		Контекст.Обрыв.ОборватьОткрытые();
		Приостановить(10);
	КонецЦикла;

КонецПроцедуры

// Читает счетчик пула. Проверка "блокировка пула свободна" - из отдельного потока: в своем
// потоке блокировка реентерабельна и пустила бы и захваченная.
//
// Параметры:
//   Контекст - Структура - Пул.
//
// Возвращаемое значение:
//   Число - Количество занятых.
//
Функция ПрочитатьСчетчикВФоне(Контекст) Экспорт
	Возврат Контекст.Пул.КоличествоЗанятых();
КонецФункции

#КонецОбласти

#Область Помощники

// Новый пул на КоннекторУправляемоеОткрытие или КоннекторInMemory.
//
// Параметры:
//   Размер - Число - Размер пула.
//   Настройки - НастройкиТестовогоКоннектора, Неопределено - Неопределено - КоннекторInMemory.
//   Блокировка - БлокировкаПулаДляТестов, Неопределено - Блокировка пула; Неопределено - своя.
//   Предел - Число - Предел ожидания в миллисекундах.
//   Пауза - Число - Пауза опроса в миллисекундах.
//   Потоки - Произвольный - Поставщик текущего потока; Неопределено - настоящий.
//
// Возвращаемое значение:
//   ПулСоединенийСБД - Пул.
//
Функция НовыйПул(Знач Размер, Знач Настройки = Неопределено, Знач Блокировка = Неопределено,
	Знач Предел = 30000, Знач Пауза = 10, Знач Потоки = Неопределено)

	Если Настройки = Неопределено Тогда
		ТипКоннектора = Тип("КоннекторInMemory");
		Параметры = Новый Массив;
	Иначе
		ТипКоннектора = Тип("КоннекторУправляемоеОткрытие");
		Параметры = Настройки.ПараметрыКоннектора();
	КонецЕсли;

	Если Блокировка = Неопределено Тогда
		Возврат Новый ПулСоединенийСБД(Размер, ТипКоннектора, "", Параметры, Предел, Пауза, Потоки);
	КонецЕсли;

	Возврат Новый ПулСоединенийСБД(Размер, ТипКоннектора, "", Параметры, Предел, Пауза, Потоки, , Блокировка);

КонецФункции

// Новый источник "Синхронизация" на КоннекторУправляемоеОткрытие.
//
// Параметры:
//   Размер - Число - Размер пула.
//   Настройки - НастройкиТестовогоКоннектора, Неопределено - Настройки коннектора.
//
// Возвращаемое значение:
//   ИсточникДанных - Источник.
//
Функция НовыйИсточник(Знач Размер, Знач Настройки = Неопределено)

	Если Настройки = Неопределено Тогда
		Настройки = Новый НастройкиТестовогоКоннектора;
	КонецЕсли;

	Возврат Новый ИсточникДанных(
		"Синхронизация",
		Тип("КоннекторУправляемоеОткрытие"),
		"",
		Настройки.ПараметрыКоннектора(),
		Размер
	);

КонецФункции

// Запускает фоновое задание с отдельным потоком и добавляет его в задания теста.
//
// Параметры:
//   Задания - Массив из ФоновоеЗадание - Задания теста.
//   ИмяМетода - Строка - Метод этого набора.
//   Контекст - Структура - Единственный параметр метода.
//
// Возвращаемое значение:
//   ФоновоеЗадание - Запущенное задание.
//
Функция ЗапуститьВФоне(Задания, Знач ИмяМетода, Знач Контекст)

	Параметры = Новый Массив;
	Параметры.Добавить(Контекст);

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры, Истина);
	Задания.Добавить(Задание);

	Возврат Задание;

КонецФункции

// Ждет, пока в очереди пула встанет не меньше заданного числа потоков.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул.
//   Количество - Число - Сколько ожидающих ждать.
//   Срок - Число - Предел ожидания в миллисекундах.
//
Процедура ДождатьсяОжидающих(Пул, Знач Количество, Знач Срок = 30000)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Срок;
	Пока Пул.КоличествоОжидающих() < Количество Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= КрайнийСрок Тогда
			ВызватьИсключение СтрШаблон("В очередь не встали %1 потоков за %2 мс", Количество, Срок);
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

КонецПроцедуры

// Ждет, пока пул займет не меньше заданного числа мест.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул.
//   Количество - Число - Сколько мест ждать.
//
Процедура ДождатьсяСозданных(Пул, Знач Количество)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
	Пока Пул.КоличествоСозданных() < Количество Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= КрайнийСрок Тогда
			ВызватьИсключение СтрШаблон("Пул не занял %1 мест за 30 секунд", Количество);
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

КонецПроцедуры

// Дожидается заданий и проверяет, что каждое получило соединение без ошибки.
//
// Параметры:
//   Задания - Массив из ФоновоеЗадание - Задания ЗанятьИОсвободитьВФоне.
//
Процедура ПроверитьЧтоВсеПолучили(Задания)

	ТестовыеУтилиты.ПроверитьЗадания(Задания);

	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.Результат.Ошибка, "Задание получило соединение").Равно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// Проверяет из отдельного потока, что блокировка пула не осталась захваченной. Не дождавшись
// ответа, бросает: пул заблокирован навсегда, и закрывать его в уборке нельзя - закрытие повиснет.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул.
//
Процедура ПроверитьЧтоБлокировкаПулаСвободна(Пул)

	Если НЕ БлокировкаПулаСвободна(Пул) Тогда
		ВызватьИсключение "Блокировка пула осталась захваченной";
	КонецЕсли;

КонецПроцедуры

// Определяет из отдельного потока, свободна ли блокировка пула.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул.
//
// Возвращаемое значение:
//   Булево - Истина, если другой поток прочитал счетчик пула за 5 секунд.
//
Функция БлокировкаПулаСвободна(Пул)

	Параметры = Новый Массив;
	Параметры.Добавить(Новый Структура("Пул", Пул));
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПрочитатьСчетчикВФоне", Параметры, Истина);

	Возврат Задание.ОжидатьЗавершения(5000);

КонецФункции

// Закрывает пул в уборке упавшего теста, не выпуская ошибок: исходная ошибка теста важнее. Если
// блокировка пула осталась захваченной, закрывать не пытается - закрытие повисло бы.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул.
//
Процедура ЗакрытьПулТихо(Пул)

	Попытка
		Если БлокировкаПулаСвободна(Пул) Тогда
			Пул.Закрыть();
		Иначе
			Сообщить("Блокировка пула осталась захваченной, пул не закрыт");
		КонецЕсли;
	Исключение
		Сообщить("Не удалось закрыть пул в уборке: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Закрывает источник в уборке упавшего теста, не выпуская ошибок.
//
// Параметры:
//   Источник - ИсточникДанных - Источник.
//
Процедура ЗакрытьИсточникТихо(Источник)

	Попытка
		Если БлокировкаПулаСвободна(Источник.ПулСоединений()) Тогда
			Источник.Закрыть();
		Иначе
			Сообщить("Блокировка пула осталась захваченной, источник не закрыт");
		КонецЕсли;
	Исключение
		Сообщить("Не удалось закрыть источник в уборке: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Вешает на логгер аппендер по заказу.
//
// Параметры:
//   ИмяЛога - Строка - Имя логгера.
//
// Возвращаемое значение:
//   АппендерПоЗаказу - Аппендер.
//
Функция ПодключитьАппендер(Знач ИмяЛога)

	Аппендер = Новый АппендерПоЗаказу;
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер);

	Возврат Аппендер;

КонецФункции

// Снимает аппендер с логгера, не выпуская ошибок: зовется и из уборки упавшего теста.
//
// Параметры:
//   ИмяЛога - Строка - Имя логгера.
//   Аппендер - АппендерПоЗаказу - Аппендер.
//
Процедура ОтключитьАппендер(Знач ИмяЛога, Аппендер)

	Попытка
		Аппендер.Взвести(Ложь);
		Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Исключение
		Сообщить("Не удалось снять аппендер: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Занимает соединения поддельными потоками: каждый - одно.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул.
//   Потоки - ПотокиСПодменой - Поставщик потоков пула.
//   Количество - Число - Сколько потоков.
//
// Возвращаемое значение:
//   Массив - Поддельные потоки, держащие соединения.
//
Функция ЗанятьПоддельнымиПотоками(Пул, Потоки, Знач Количество)

	Держатели = Новый Массив;
	Для Номер = 1 По Количество Цикл
		Поток = Мок.Получить(Тип("ПотокИсполнения"));
		Потоки.Подменить(Поток);
		Пул.Занять();
		Держатели.Добавить(Поток);
	КонецЦикла;
	Потоки.СнятьПодмену();

	Возврат Держатели;

КонецФункции

// Отдает соединения поддельных потоков - освобождением или завершением потока - и меряет время.
//
// Параметры:
//   Держатели - Массив - Поддельные потоки.
//   Потоки - ПотокиСПодменой - Поставщик потоков пула.
//   Пул - ПулСоединенийСБД - Пул.
//   Способ - Строка - "Освободить" или "Завершить".
//
// Возвращаемое значение:
//   Число - Длительность в миллисекундах.
//
Функция ОтдатьСЗамером(Держатели, Потоки, Пул, Знач Способ)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Для Каждого Поток Из Держатели Цикл
		Потоки.Подменить(Поток);
		Если Способ = "Освободить" Тогда
			Пул.Освободить();
		Иначе
			Поток.ВызватьСобытие("ПриЗавершении", Новый Массив);
		КонецЕсли;
	КонецЦикла;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Потоки.СнятьПодмену();

	Возврат Длительность;

КонецФункции

// Число завершенных с ошибкой событий захвата.
//
// Параметры:
//   Записывающий - НаблюдательЗаписывающий - Наблюдатель.
//
// Возвращаемое значение:
//   Число - Количество.
//
Функция ЗахватовСОшибкой(Записывающий)

	Результат = 0;
	Для Каждого Событие Из Записывающий.Завершенные("Соединение", "Занять") Цикл
		Если Событие.Ошибка() <> Неопределено Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Массив номеров попыток.
//
// Параметры:
//   Первый - Число - Номер.
//   Второй - Число - Номер.
//
// Возвращаемое значение:
//   Массив из Число - Номера.
//
Функция НомераПопыток(Знач Первый, Знач Второй)

	Номера = Новый Массив;
	Номера.Добавить(Первый);
	Номера.Добавить(Второй);

	Возврат Номера;

КонецФункции

#КонецОбласти
