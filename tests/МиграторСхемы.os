// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:LineLength-off

#Использовать ".."
#Использовать "utils"

Перем ТипКоннектора;
Перем СтрокаСоединения;
Перем ИмяФайлаБазы;

Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ИмяФайлаБазы = Неопределено;

	Если ЗапускатьТестыSQLite = "true" Тогда
		// Для проверки миграций нужна БД, переживающая закрытие соединения,
		// поэтому вместо БД в памяти используется временный файл
		ИмяФайлаБазы = ПолучитьИмяВременногоФайла("db");
		СтрокаСоединения = "Data Source=" + ИмяФайлаБазы;
		ТипКоннектора = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
		Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
		Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
		Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
		ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");
		СтрокаСоединения = СтрШаблон(
			"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
			Хост,
			Пользователь,
			Пароль,
			ИмяБД,
			Порт
		);
		ТипКоннектора = Тип("КоннекторPostgreSQL");

		МенеджерДляСброса = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
		Коннектор = МенеджерДляСброса.ПолучитьКоннектор();
		Коннектор.Открыть(СтрокаСоединения, Новый Массив);
		ТестовыеУтилиты.УдалитьТаблицыВБазеДанных(Коннектор);
		Коннектор.Закрыть();
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования мигратора схемы";
	КонецЕсли;

	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "МигрируемаяСущностьВерсия1.os"), "МигрируемаяСущностьВерсия1");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "МигрируемаяСущностьВерсия2.os"), "МигрируемаяСущностьВерсия2");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "МигрируемаяСущностьСменаТипа1.os"), "МигрируемаяСущностьСменаТипа1");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "МигрируемаяСущностьСменаТипа2.os"), "МигрируемаяСущностьСменаТипа2");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "ОбработчикЗаполненияПриоритета.os"), "ОбработчикЗаполненияПриоритета");

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	Если ИмяФайлаБазы <> Неопределено Тогда
		УдалитьФайлы(ИмяФайлаБазы);
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура АктивныйКоннекторРеализуетИнтерфейсМиграций() Экспорт
	ИнтерфейсМиграций = Новый ИнтерфейсОбъекта();
	ИнтерфейсМиграций.ИзОбъекта(Тип("АбстрактныйКоннекторМиграций"));

	РефлекторОбъекта = Новый РефлекторОбъекта(ТипКоннектора);
	РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсМиграций, Истина);
КонецПроцедуры

&Тест
Процедура ДобавлениеКолонкиПриОбновленииСхемы() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия1;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.Инициализировать();

	Результат = Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM МигрируемыеСущности");
	Ожидаем.Что(Результат.Колонки.Количество(), "В таблице появилась новая колонка").Равно(3);
	Ожидаем.Что(ЕстьКолонка(Результат, "Приоритет"), "Новая колонка называется Приоритет").ЭтоИстина();
	Ожидаем.Что(Результат, "Данные таблицы сохранились при миграции").ИмеетДлину(1);

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьВерсия2"), 1);
	Ожидаем.Что(ПолученнаяСущность.Наименование, "Данные сущности читаются после миграции").Равно("Первая");

	Менеджер.Закрыть();

КонецПроцедуры

&Тест
Процедура ИзменениеТипаКолонкиПриОбновленииСхемы() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьСменаТипа1"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьСменаТипа1;
	Сущность.Идентификатор = 1;
	Сущность.Значение = "42";
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьСменаТипа2"));
	Менеджер.Инициализировать();

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьСменаТипа2"), 1);
	Ожидаем.Что(ПолученнаяСущность.Значение, "Данные приведены к новому типу колонки").Равно(42);

	Менеджер.Закрыть();

КонецПроцедуры

&Тест
Процедура ЛишняяКолонкаСохраняетсяПоУмолчанию() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия2;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Сущность.Приоритет = 5;
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.Инициализировать();

	Результат = Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM МигрируемыеСущности");
	Ожидаем.Что(ЕстьКолонка(Результат, "Приоритет"), "Лишняя колонка сохранена в таблице").ЭтоИстина();

	Менеджер.Закрыть();

КонецПроцедуры

&Тест
Процедура ЛишняяКолонкаУдаляетсяПриВключеннойОпции() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия2;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Сущность.Приоритет = 5;
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.ПолучитьМиграторСхемы().УстановитьУдалениеЛишнихКолонок(Истина);
	Менеджер.Инициализировать();

	Результат = Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM МигрируемыеСущности");
	Ожидаем.Что(Результат.Колонки.Количество(), "Лишняя колонка удалена из таблицы").Равно(2);
	Ожидаем.Что(ЕстьКолонка(Результат, "Приоритет"), "Удалена именно лишняя колонка").ЭтоЛожь();

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьВерсия1"), 1);
	Ожидаем.Что(ПолученнаяСущность.Наименование, "Данные остальных колонок сохранились").Равно("Первая");

	Менеджер.Закрыть();

КонецПроцедуры

&Тест
Процедура ВерсияСхемыФиксируетсяВСлужебнойТаблице() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.1.0");
	Менеджер.Инициализировать();

	Ожидаем
		.Что(Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы(), "Версия схемы зафиксирована")
		.Равно("0.1.0");

	Результат = Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM entity_ВерсияСхемы");
	Ожидаем.Что(Результат, "Служебная таблица содержит одну запись о версии").ИмеетДлину(1);

	Менеджер.Закрыть();

КонецПроцедуры

&Тест
Процедура ОбработчикЗаполняетДанныеПриПовышенииВерсии() Экспорт

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия1"));
	Менеджер.УстановитьВерсиюСхемы("0.1.0");
	Менеджер.Инициализировать();

	Сущность = Новый МигрируемаяСущностьВерсия1;
	Сущность.Идентификатор = 1;
	Сущность.Наименование = "Первая";
	Менеджер.Сохранить(Сущность);

	Менеджер.Закрыть();

	Менеджер = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	Менеджер.ДобавитьКлассВМодель(Тип("МигрируемаяСущностьВерсия2"));
	Менеджер.УстановитьВерсиюСхемы("0.2.0");
	Менеджер.ДобавитьОбработчикМиграции(Новый ОбработчикЗаполненияПриоритета);
	Менеджер.Инициализировать();

	ПолученнаяСущность = Менеджер.ПолучитьОдно(Тип("МигрируемаяСущностьВерсия2"), 1);
	Ожидаем.Что(ПолученнаяСущность.Приоритет, "Обработчик миграции заполнил данные новой колонки").Равно(1);
	Ожидаем
		.Что(Менеджер.ПолучитьМиграторСхемы().ХранимаяВерсияСхемы(), "Зафиксирована новая версия схемы")
		.Равно("0.2.0");

	Менеджер.Закрыть();

КонецПроцедуры

Функция ЕстьКолонка(Результат, Знач ИмяКолонки)
	Для Каждого Колонка Из Результат.Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(ИмяКолонки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
КонецФункции
