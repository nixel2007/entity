// Экземпляры прочитанных сущностей в разных потоках исполнения.
//
// Пул сущностей ведется на поток исполнения: внутри потока на идентификатор один экземпляр и между
// вызовами, а разные потоки получают разные экземпляры одной строки. Иначе чтение в одном потоке
// перезаписывало бы поля экземпляра, с которым работает другой: стирало несохраненные правки и
// смешивало снимки строки, прочитанные в разное время.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// ИсточникДанных - Источник тестовой базы; закрывается после каждого теста.
Перем Источник;
// МенеджерСущностей - Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ХранилищеВПамяти.Очистить("ЭкземплярыСущностейВПотоках");
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СигналСобытия.os"), "СигналСобытия");
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "НаблюдательЗадержкиЧтения.os"),
		"НаблюдательЗадержкиЧтения"
	);

	Источник = Новый ИсточникДанных("Тесты", Тип("КоннекторInMemory"), "ЭкземплярыСущностейВПотоках");
	// oneunit исполняет подготовку и тест в разных потоках: источник живет до ПослеКаждого.
	Источник.УстановитьАвтоЗакрытие(Ложь);
	МенеджерСущностей = ТестовыеУтилиты.МенеджерАвторов(Источник);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
	Источник.Закрыть();
КонецПроцедуры

// Поток правит прочитанный экземпляр и еще не сохранил его, а другой поток читает ту же строку.
// Правка не должна пропасть: чужое чтение заполняет свой экземпляр.
//
&Тест
Процедура ЧтениеВДругомПотокеНеЗатираетПравкуЭкземпляра() Экспорт

	Идентификатор = СохранитьАвтора("Исходное");

	Автор = МенеджерСущностей.ПолучитьОдно(Тип("Автор"), Идентификатор);
	Автор.Имя = "Правка";

	Задания = Новый Массив;
	Задания.Добавить(ЗапуститьЗадание("ПрочитатьИмяАвтора", Идентификатор));
	ТестовыеУтилиты.ПроверитьЗадания(Задания, СрокЗаданий());

	Ожидаем.Что(Задания[0].Результат, "Другой поток прочитал строку из БД").Равно("Исходное");
	Ожидаем.Что(Автор.Имя, "Несохраненная правка осталась").Равно("Правка");

КонецПроцедуры

// В своем потоке строка читается одним и тем же экземпляром, а другой поток получает свой.
//
&Тест
Процедура ПотокиПолучаютРазныеЭкземплярыОднойСтроки() Экспорт

	Идентификатор = СохранитьАвтора("Исходное");

	Автор = МенеджерСущностей.ПолучитьОдно(Тип("Автор"), Идентификатор);
	Ожидаем.Что(МенеджерСущностей.ПолучитьОдно(Тип("Автор"), Идентификатор) = Автор, "В потоке теста один экземпляр")
		.ЭтоИстина();

	Задания = Новый Массив;
	Задания.Добавить(ЗапуститьЗадание("ПрочитатьАвтораДважды", Идентификатор));
	ТестовыеУтилиты.ПроверитьЗадания(Задания, СрокЗаданий());

	Прочитанные = Задания[0].Результат;
	Ожидаем.Что(Прочитанные[0] = Прочитанные[1], "В потоке задания один экземпляр").ЭтоИстина();
	Ожидаем.Что(Прочитанные[0] = Автор, "У потока задания свой экземпляр").ЭтоЛожь();

КонецПроцедуры

// Задание собирает автора и останавливается на чтении его ссылки: часть полей уже заполнена из
// старого снимка строки. Тем временем строка меняется в БД, и тест читает ее заново. Задание
// должно получить свой снимок целиком, а не смесь со снимком теста.
//
&Тест
Процедура ЧтениеПосредиСборкиВДругомПотокеНеСмешиваетСнимки() Экспорт

	Идентификатор = СохранитьАвтора("Старое");

	Дошел = Новый СигналСобытия;
	Отпустить = Новый СигналСобытия;
	Наблюдатель = Новый НаблюдательЗадержкиЧтения(Тип("СущностьБезГенерируемогоИдентификатора"), Дошел, Отпустить);
	Источник.ДобавитьНаблюдателя(Наблюдатель);

	Задания = Новый Массив;
	Попытка

		Задания.Добавить(ЗапуститьЗадание("ПрочитатьИмяАвтораСЗадержкой", Идентификатор, Наблюдатель.КлючПометки()));
		Ожидаем.Что(Дошел.Дождаться(), "Задание остановилось на чтении ссылки").ЭтоИстина();

		ЗаписатьИмяАвтораМимоМенеджера(Идентификатор, "Новое");
		Прочитанный = МенеджерСущностей.ПолучитьОдно(Тип("Автор"), Идентификатор);
		Ожидаем.Что(Прочитанный.Имя, "Тест прочитал новый снимок").Равно("Новое");

		Отпустить.Отметить();

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Отпустить.Отметить();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, СрокЗаданий()));
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания, СрокЗаданий());

	Ожидаем.Что(Задания[0].Результат, "Задание получило свой снимок строки").Равно("Старое");

КонецПроцедуры

// Очистка хранилища в одном потоке отбрасывает и экземпляры, прочитанные другими потоками до нее:
// их следующее чтение берет строку из БД в новый экземпляр.
//
&Тест
Процедура ОчисткаХранилищаОтбрасываетЭкземплярыДругихПотоков() Экспорт

	Идентификатор = СохранитьАвтора("Исходное");

	Прочитал = Новый СигналСобытия;
	Очищено = Новый СигналСобытия;

	Параметры = Новый Массив;
	Параметры.Добавить(МенеджерСущностей);
	Параметры.Добавить(Идентификатор);
	Параметры.Добавить(Прочитал);
	Параметры.Добавить(Очищено);
	Задания = Новый Массив;
	Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПрочитатьАвтораДоИПослеОчистки", Параметры, Истина));

	Попытка
		Ожидаем.Что(Прочитал.Дождаться(), "Задание прочитало автора").ЭтоИстина();
		МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("Автор")).Закрыть();
		Очищено.Отметить();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Очищено.Отметить();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, СрокЗаданий()));
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания, СрокЗаданий());

	Прочитанные = Задания[0].Результат;
	Ожидаем.Что(Прочитанные[0] = Прочитанные[1], "После очистки задание получило новый экземпляр").ЭтоЛожь();

КонецПроцедуры

// Читает автора и возвращает его имя. Запускается в фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//   Идентификатор - Число - Идентификатор автора.
//
// Возвращаемое значение:
//   Строка - Имя прочитанного автора.
//
Функция ПрочитатьИмяАвтора(Менеджер, Идентификатор) Экспорт
	Возврат Менеджер.ПолучитьОдно(Тип("Автор"), Идентификатор).Имя;
КонецФункции

// Читает автора два раза. Запускается в фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//   Идентификатор - Число - Идентификатор автора.
//
// Возвращаемое значение:
//   Массив - Экземпляры первого и второго чтения.
//
Функция ПрочитатьАвтораДважды(Менеджер, Идентификатор) Экспорт

	Прочитанные = Новый Массив;
	Прочитанные.Добавить(Менеджер.ПолучитьОдно(Тип("Автор"), Идентификатор));
	Прочитанные.Добавить(Менеджер.ПолучитьОдно(Тип("Автор"), Идентификатор));

	Возврат Прочитанные;

КонецФункции

// Помечает свой поток для наблюдателя задержки, читает автора и возвращает его имя. Запускается в
// фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//   Идентификатор - Число - Идентификатор автора.
//   КлючПометки - Строка - Ключ пометки потока для наблюдателя.
//
// Возвращаемое значение:
//   Строка - Имя прочитанного автора.
//
Функция ПрочитатьИмяАвтораСЗадержкой(Менеджер, Идентификатор, КлючПометки) Экспорт
	ТекущийПоток().Данные.Вставить(КлючПометки, Истина);
	Возврат Менеджер.ПолучитьОдно(Тип("Автор"), Идентификатор).Имя;
КонецФункции

// Читает автора, ждет очистки хранилища тестом и читает снова. Запускается в фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//   Идентификатор - Число - Идентификатор автора.
//   Прочитал - СигналСобытия - Отмечается после первого чтения.
//   Очищено - СигналСобытия - Отмечает тест после очистки хранилища.
//
// Возвращаемое значение:
//   Массив - Экземпляры чтений до и после очистки.
//
Функция ПрочитатьАвтораДоИПослеОчистки(Менеджер, Идентификатор, Прочитал, Очищено) Экспорт

	Прочитанные = Новый Массив;
	Прочитанные.Добавить(Менеджер.ПолучитьОдно(Тип("Автор"), Идентификатор));
	Прочитал.Отметить();

	Если НЕ Очищено.Дождаться() Тогда
		ВызватьИсключение "Тест не очистил хранилище за 30 с";
	КонецЕсли;

	Прочитанные.Добавить(Менеджер.ПолучитьОдно(Тип("Автор"), Идентификатор));

	Возврат Прочитанные;

КонецФункции

// Сохраняет автора со ссылкой на внешнюю сущность.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
// Возвращаемое значение:
//   Число - Идентификатор сохраненного автора.
//
Функция СохранитьАвтора(Знач Имя)

	ВнешняяСущность = Новый СущностьБезГенерируемогоИдентификатора;
	ВнешняяСущность.ВнутреннийИдентификатор = 7;
	МенеджерСущностей.Сохранить(ВнешняяСущность);

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";
	Автор.ВнешняяСущность = ВнешняяСущность;
	МенеджерСущностей.Сохранить(Автор);

	Возврат Автор.ВнутреннийИдентификатор;

КонецФункции

// Меняет имя автора в БД, не трогая экземпляры менеджера: строка пишется коннектором напрямую.
//
// Параметры:
//   Идентификатор - Число - Идентификатор автора.
//   Имя - Строка - Новое имя.
//
Процедура ЗаписатьИмяАвтораМимоМенеджера(Знач Идентификатор, Знач Имя)

	ВнешняяСущность = Новый СущностьБезГенерируемогоИдентификатора;
	ВнешняяСущность.ВнутреннийИдентификатор = 7;

	Автор = Новый Автор;
	Автор.ВнутреннийИдентификатор = Идентификатор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";
	Автор.ВнешняяСущность = ВнешняяСущность;

	Контекст = Новый Структура;
	Контекст.Вставить("ОбъектМодели", МенеджерСущностей.ПолучитьМодельДанных().Получить(Тип("Автор")));
	Контекст.Вставить("Автор", Автор);
	МенеджерСущностей.ВыполнитьСКоннектором("Коннектор -> Коннектор.Сохранить(ОбъектМодели, Автор)", Контекст);

КонецПроцедуры

// Запускает фоновое задание, которому передаются менеджер теста и параметры метода.
//
// Параметры:
//   ИмяМетода - Строка - Метод, выполняемый заданием.
//   Идентификатор - Число - Идентификатор автора.
//   Дополнительный - Произвольный - Третий параметр метода; Неопределено - метод принимает два.
//
// Возвращаемое значение:
//   ФоновоеЗадание - Запущенное задание.
//
Функция ЗапуститьЗадание(Знач ИмяМетода, Знач Идентификатор, Знач Дополнительный = Неопределено)

	Параметры = Новый Массив;
	Параметры.Добавить(МенеджерСущностей);
	Параметры.Добавить(Идентификатор);
	Если Дополнительный <> Неопределено Тогда
		Параметры.Добавить(Дополнительный);
	КонецЕсли;

	Возврат ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры, Истина);

КонецФункции

// Общий срок ожидания заданий теста.
//
// Возвращаемое значение:
//   Число - Срок в миллисекундах.
//
Функция СрокЗаданий()
	Возврат 30000;
КонецФункции
