// Внутреннее API библиотеки работает через источник данных, а не через его пул соединений.
//
// Пул остается деталью источника: с ним напрямую работают только методы, занимающие и
// освобождающие соединения. Кэш хранилищ и операции над сущностями получают источник.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "../src/internal"
#Использовать "utils"

// Хранилища принадлежат менеджеру: он выдает одно и то же хранилище на тип и закрывает свои
// хранилища сам.
&Тест
Процедура МенеджерВыдаетОдноХранилищеНаТип() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "хранилище менеджера");
	Менеджер = ТестовыеУтилиты.МенеджерАвторов(Источник);

	Хранилище = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));

	Ожидаем.Что(Хранилище.Получить(), "Хранилище менеджера работает").ИмеетДлину(0);
	Ожидаем.Что(Хранилище = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор")), "Повторное обращение дает то же хранилище")
		.ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

// Хранилище закрытого источника получить можно: к БД это обращение не идет. Ошибку дает первая
// же операция, когда хранилище просит у источника соединение.
&Тест
Процедура ОперацияХранилищаЗакрытогоИсточникаЗавершаетсяОшибкой() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "хранилище после закрытия");
	Менеджер = ТестовыеУтилиты.МенеджерАвторов(Источник);
	Хранилище = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));

	Источник.Закрыть();

	ТекстОшибки = "";
	Попытка
		Хранилище.Получить();
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "Операция через закрытый источник завершается ошибкой").Содержит("закрыт");

КонецПроцедуры

&Тест
Процедура АлгоритмВыполняетсяКоннекторомЧерезИсточник() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "алгоритм через источник");

	ТипКоннектора = РаботаСКоннекторами.ВычислитьСКоннектором(Источник, "Коннектор -> ТипЗнч(Коннектор)");

	Ожидаем.Что(ТипКоннектора, "Алгоритм получил коннектор источника").Равно(Тип("КоннекторInMemory"));

	Источник.Закрыть();

КонецПроцедуры

// Операция идет соединением источника, а метаданные и пул сущностей берутся у хранилища: оба
// принадлежат одному менеджеру, поэтому рассогласоваться не могут.
&Тест
Процедура СущностьСохраняетсяИЧитаетсяЧерезХранилище() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "операции через хранилище");
	Менеджер = ТестовыеУтилиты.МенеджерАвторов(Источник);
	Хранилище = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));

	Автор = Новый Автор;
	Автор.Имя = "Иван";
	Автор.ВтороеИмя = "Иванов";
	Хранилище.Сохранить(Автор);

	Ожидаем.Что(Хранилище.Получить(), "Сохраненный автор прочитан хранилищем").ИмеетДлину(1);
	Ожидаем
		.Что(Хранилище.ПолучитьОбъектМодели() = Менеджер.ПолучитьМодельДанных().Получить(Тип("Автор")),
			"Хранилище работает с объектом модели своего менеджера")
		.ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

// Транзакции нужен коннектор СУБД: КоннекторInMemory их не поддерживает.
&Тест
Процедура ТранзакцияПотокаОткрываетсяЧерезИсточник() Экспорт

	Источник = ИсточникСТранзакциями();

	РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(Источник);
	Первый = РаботаСКоннекторами.ВычислитьСКоннектором(Источник, "Коннектор -> Коннектор");
	Второй = РаботаСКоннекторами.ВычислитьСКоннектором(Источник, "Коннектор -> Коннектор");
	РаботаСКоннекторами.ОтменитьТранзакциюПотокаИсполнения(Источник);

	Ожидаем.Что(Первый = Второй, "Операции потока попадают на коннектор транзакции").ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

// Источник на СУБД с транзакциями: SQLite в памяти, если тесты SQLite включены, иначе PostgreSQL
// по переменным среды.
//
// Возвращаемое значение:
//   ИсточникДанных - Источник.
//
Функция ИсточникСТранзакциями()

	Если ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true") = "true" Тогда
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), "FullUri=file::memory:?cache=shared");
	КонецЕсли;

	Если ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true") = "true" Тогда
		СтрокаСоединения = СтрШаблон(
			"Host=%1;Port=%2;Username=%3;Password=%4;Database=%5",
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres")
		);
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторPostgreSQL"), СтрокаСоединения);
	КонецЕсли;

	ВызватьИсключение "Нет доступного коннектора с транзакциями";

КонецФункции
