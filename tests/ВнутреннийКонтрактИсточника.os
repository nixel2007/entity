// Внутреннее API библиотеки работает через источник данных, а не через его пул соединений.
//
// Пул остается деталью источника: с ним напрямую работают только методы, занимающие и
// освобождающие соединения. Кэш хранилищ и операции над сущностями получают источник.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "../src/internal"
#Использовать "utils"

&Тест
Процедура КэшХранилищВыдаетХранилищеПоИсточнику() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "хранилище по источнику");
	Менеджер = МенеджерАвторов(Источник);
	ОбъектМодели = Менеджер.ПолучитьМодельДанных().Получить(Тип("Автор"));

	Хранилище = ХранилищаСущностей.Получить(ОбъектМодели, Источник);

	Ожидаем.Что(Хранилище.Получить(), "Хранилище, полученное по источнику, работает").ИмеетДлину(0);
	Ожидаем.Что(Хранилище = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор")), "Менеджер выдает то же хранилище")
		.ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура КэшХранилищЗакрываетсяПоИсточнику() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "закрытие по источнику");
	Менеджер = МенеджерАвторов(Источник);
	ХранилищеДоЗакрытия = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));

	ХранилищаСущностей.Закрыть(Источник);

	Ожидаем.Что(ХранилищеДоЗакрытия = Менеджер.ПолучитьХранилищеСущностей(Тип("Автор")), "Хранилище создано заново")
		.ЭтоЛожь();

	Источник.Закрыть();

КонецПроцедуры

// Получение хранилища к БД не обращается, поэтому закрытый источник должен отказывать в нем сам:
// иначе хранилище закрытого источника легло бы в кэш, откуда его уже никто не уберет.
&Тест
Процедура ЗакрытыйИсточникХранилищНеВыдает() Экспорт

	ПодключитьКлассыСущностей();

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "хранилище после закрытия");
	Менеджер = Новый МенеджерСущностей(Источник);
	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));

	Источник.Закрыть();

	ТекстОшибки = "";
	Попытка
		Менеджер.ПолучитьХранилищеСущностей(Тип("Автор"));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(ТекстОшибки, "Хранилище закрытого источника не выдается и в кэш не попадает").Содержит("закрыт");

КонецПроцедуры

&Тест
Процедура АлгоритмВыполняетсяКоннекторомЧерезИсточник() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "алгоритм через источник");

	ТипКоннектора = РаботаСКоннекторами.ВычислитьСКоннектором(Источник, "Коннектор -> ТипЗнч(Коннектор)");

	Ожидаем.Что(ТипКоннектора, "Алгоритм получил коннектор источника").Равно(Тип("КоннекторInMemory"));

	Источник.Закрыть();

КонецПроцедуры

&Тест
Процедура СущностьСохраняетсяИЧитаетсяЧерезИсточник() Экспорт

	Источник = Новый ИсточникДанных("Основной", Тип("КоннекторInMemory"), "операции через источник");
	Менеджер = МенеджерАвторов(Источник);
	ОбъектМодели = Менеджер.ПолучитьМодельДанных().Получить(Тип("Автор"));
	ПулСущностей = Менеджер.ПолучитьПулСущностей(Тип("Автор"));

	Автор = Новый Автор;
	Автор.Имя = "Иван";
	Автор.ВтороеИмя = "Иванов";
	РаботаСКоннекторами.Сохранить(Источник, ОбъектМодели, ПулСущностей, Автор);

	Авторы = РаботаСКоннекторами.Получить(Источник, ОбъектМодели, ПулСущностей, Новый ОпцииПоиска);

	Ожидаем.Что(Авторы, "Сохраненный автор прочитан через источник").ИмеетДлину(1);

	Источник.Закрыть();

КонецПроцедуры

// Транзакции нужен коннектор СУБД: КоннекторInMemory их не поддерживает.
&Тест
Процедура ТранзакцияПотокаОткрываетсяЧерезИсточник() Экспорт

	Источник = ИсточникСТранзакциями();

	РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(Источник);
	Первый = РаботаСКоннекторами.ВычислитьСКоннектором(Источник, "Коннектор -> Коннектор");
	Второй = РаботаСКоннекторами.ВычислитьСКоннектором(Источник, "Коннектор -> Коннектор");
	РаботаСКоннекторами.ОтменитьТранзакциюПотокаИсполнения(Источник);

	Ожидаем.Что(Первый = Второй, "Операции потока попадают на коннектор транзакции").ЭтоИстина();

	Источник.Закрыть();

КонецПроцедуры

// Менеджер с типом Автор в модели, созданный из источника.
//
// Параметры:
//   Источник - ИсточникДанных - Источник.
//
// Возвращаемое значение:
//   МенеджерСущностей - Менеджер с инициализированной моделью.
//
Функция МенеджерАвторов(Источник)

	ПодключитьКлассыСущностей();

	Менеджер = Новый МенеджерСущностей(Источник);
	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	Менеджер.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	Менеджер.ДобавитьКлассВМодель(Тип("Автор"));
	Менеджер.Инициализировать();

	Возврат Менеджер;

КонецФункции

// Подключает классы сущностей Автор и СущностьБезГенерируемогоИдентификатора.
//
Процедура ПодключитьКлассыСущностей()

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);
	ПодключитьСценарий(ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"), "Автор");

КонецПроцедуры

// Источник на СУБД с транзакциями: SQLite в памяти, если тесты SQLite включены, иначе PostgreSQL
// по переменным среды.
//
// Возвращаемое значение:
//   ИсточникДанных - Источник.
//
Функция ИсточникСТранзакциями()

	Если ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true") = "true" Тогда
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), "FullUri=file::memory:?cache=shared");
	КонецЕсли;

	Если ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true") = "true" Тогда
		СтрокаСоединения = СтрШаблон(
			"Host=%1;Port=%2;Username=%3;Password=%4;Database=%5",
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres"),
			ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres")
		);
		Возврат Новый ИсточникДанных("Основной", Тип("КоннекторPostgreSQL"), СтрокаСоединения);
	КонецЕсли;

	ВызватьИсключение "Нет доступного коннектора с транзакциями";

КонецФункции
