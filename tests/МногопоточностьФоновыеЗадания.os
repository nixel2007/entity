// Транзакции, начатые в разных контекстах исполнения, независимы друг от друга.
//
// До появления пула соединений менеджер работал одним коннектором на всех: фиксация транзакции
// в фоновом задании завершала и транзакцию основного контекста, а откат - отменял ее.
// Тесты проверяют, что этого больше не происходит.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;

Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ВыполнятьСбросТаблиц = Ложь;
	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединения = "FullUri=file::memory:?cache=shared";
		ТипКоннектора = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединения = СтрокаСоединенияPostgres();
		ТипКоннектора = Тип("КоннекторPostgreSQL");
		ВыполнятьСбросТаблиц = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования многопоточной работы";
	КонецЕсли;

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);

	Если ВыполнятьСбросТаблиц Тогда
		Коннектор = МенеджерСущностей.ПолучитьКоннектор();
		Коннектор.Открыть(СтрокаСоединения, Новый Массив);
		ТестовыеУтилиты.УдалитьТаблицыВБазеДанных(Коннектор);
		Коннектор.Закрыть();
	КонецЕсли;

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
КонецПроцедуры

// Фоновое задание фиксирует свою транзакцию, а основной контекст затем откатывает свою.
// Записи основного контекста в базе остаться не должно: чужая фиксация его транзакции не касается.
//
&Тест
Процедура ФиксацияВФоновомЗаданииНеЗавершаетТранзакциюОсновногоКонтекста() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	СохранитьАвтора("Основной");

	ВыполнитьВФоне("ЗафиксироватьПустуюТранзакциюВФоне");

	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем
		.Что(ПрочитатьАвторов(), "Фиксация в фоновом задании не должна была зафиксировать чужую запись")
		.ИмеетДлину(0);

КонецПроцедуры

// Фоновое задание откатывает свою транзакцию, а основной контекст затем фиксирует свою.
// Запись основного контекста должна сохраниться: чужой откат его транзакции не касается.
//
&Тест
Процедура ОткатВФоновомЗаданииНеОтменяетТранзакциюОсновногоКонтекста() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	СохранитьАвтора("Основной");

	ВыполнитьВФоне("ОткатитьПустуюТранзакциюВФоне");

	МенеджерСущностей.ЗафиксироватьТранзакцию();

	Авторы = ПрочитатьАвторов();
	Ожидаем.Что(Авторы, "Откат в фоновом задании не должен был отменить чужую запись").ИмеетДлину(1);
	Ожидаем.Что(Авторы[0].Имя, "В базе остался автор основного контекста").Равно("Основной");

КонецПроцедуры

// Фоновое задание, оборвавшееся с ошибкой посреди транзакции, не мешает основному контексту
// завершить свою.
//
&Тест
Процедура ОшибкаВФоновомЗаданииНеЛомаетТранзакциюОсновногоКонтекста() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	СохранитьАвтора("Основной");

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОборватьТранзакциюВФоне", Новый Массив, Истина);
	Задание.ОжидатьЗавершения();

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Фоновое задание должно было завершиться ошибкой")
		.ЭтоИстина();

	МенеджерСущностей.ЗафиксироватьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Транзакция основного контекста зафиксирована").ИмеетДлину(1);

КонецПроцедуры

// Фоновое задание пишет в собственной транзакции, и запись видна после ее фиксации.
//
&Тест
Процедура ФоновоеЗаданиеПишетВСобственнойТранзакции() Экспорт

	ВыполнитьВФоне("СохранитьАвтораВФоне");

	Авторы = ПрочитатьАвторов();
	Ожидаем.Что(Авторы, "Фоновое задание сохранило автора").ИмеетДлину(1);
	Ожидаем.Что(Авторы[0].Имя, "Сохранился автор фонового задания").Равно("Фоновый");

КонецПроцедуры

// Один контекст выполняет несколько транзакций подряд: соединение возвращается в пул после
// каждой и берется заново для следующей.
//
&Тест
Процедура НесколькоТранзакцийПодрядВОдномКонтексте() Экспорт

	Для Индекс = 1 По 3 Цикл
		МенеджерСущностей.НачатьТранзакцию();
		СохранитьАвтора("Автор" + Индекс);
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	КонецЦикла;

	Ожидаем.Что(ПрочитатьАвторов(), "Зафиксированы все три транзакции").ИмеетДлину(3);

КонецПроцедуры

// Фиксирует в фоновом задании транзакцию, в которой ничего не записано.
//
Процедура ЗафиксироватьПустуюТранзакциюВФоне() Экспорт
	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.ЗафиксироватьТранзакцию();
КонецПроцедуры

// Откатывает в фоновом задании транзакцию, в которой ничего не записано.
//
Процедура ОткатитьПустуюТранзакциюВФоне() Экспорт
	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.ОтменитьТранзакцию();
КонецПроцедуры

// Начинает в фоновом задании транзакцию и обрывается, не завершив ее.
//
Процедура ОборватьТранзакциюВФоне() Экспорт
	МенеджерСущностей.НачатьТранзакцию();
	ВызватьИсключение "Обрыв фонового задания";
КонецПроцедуры

// Сохраняет автора в отдельной транзакции фонового задания.
//
Процедура СохранитьАвтораВФоне() Экспорт

	МенеджерСущностей.НачатьТранзакцию();

	Попытка
		СохранитьАвтора("Фоновый");
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	Исключение
		МенеджерСущностей.ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Выполняет процедуру в фоновом задании и дожидается ее завершения.
//
// Параметры:
//   ИмяПроцедуры - Строка - Имя процедуры текущего модуля.
//
Процедура ВыполнитьВФоне(Знач ИмяПроцедуры)

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяПроцедуры, Новый Массив, Истина);
	Задание.ОжидатьЗавершения();

	Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;

КонецПроцедуры

// Сохраняет автора с указанным именем.
//
// Параметры:
//   Имя - Строка - Имя автора.
//
Процедура СохранитьАвтора(Знач Имя)

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	МенеджерСущностей.Сохранить(Автор);

КонецПроцедуры

// Читает всех авторов собственным коннектором менеджера, вне транзакций контекстов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Строки таблицы авторов.
//
Функция ПрочитатьАвторов()
	Возврат МенеджерСущностей.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT * FROM Авторы ORDER BY Идентификатор");
КонецФункции

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
