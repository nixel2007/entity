// Транзакции, начатые в разных потоках исполнения, независимы друг от друга.
//
// До появления пула соединений менеджер работал одним коннектором на всех: фиксация транзакции
// в фоновом задании завершала и транзакцию основного потока, а откат - отменял ее.
// Тесты проверяют, что этого больше не происходит.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// ИсточникДанных - Источник тестовой базы; закрывается после каждого теста.
Перем Источник;
// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ЗапускатьТестыPostgres = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true");
	ЗапускатьТестыSQLite = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true");

	ВыполнятьСбросТаблиц = Ложь;
	Если ЗапускатьТестыSQLite = "true" Тогда
		СтрокаСоединения = "FullUri=file::memory:?cache=shared";
		ТипКоннектора = Тип("КоннекторSQLite");
	ИначеЕсли ЗапускатьТестыPostgres = "true" Тогда
		СтрокаСоединения = СтрокаСоединенияPostgres();
		ТипКоннектора = Тип("КоннекторPostgreSQL");
		ВыполнятьСбросТаблиц = Истина;
	Иначе
		ВызватьИсключение "Нет доступного коннектора для тестирования многопоточной работы";
	КонецЕсли;

	Источник = Новый ИсточникДанных("Тесты", ТипКоннектора, СтрокаСоединения);
	// oneunit исполняет подготовку и тест в разных потоках: источник живет до ПослеКаждого.
	Источник.УстановитьАвтоЗакрытие(Ложь);
	МенеджерСущностей = Новый МенеджерСущностей(Источник);

	Если ВыполнятьСбросТаблиц Тогда
		ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);
	КонецЕсли;

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "Автор.os"),
		"Автор"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьБезГенерируемогоИдентификатора.os"),
		"СущностьБезГенерируемогоИдентификатора"
	);

	// Автор ссылается на СущностьБезГенерируемогоИдентификатора, поэтому в модели нужны обе.
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	МенеджерСущностей.Инициализировать();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
	МенеджерСущностей = Неопределено;
	Источник.Закрыть();
КонецПроцедуры

// Фоновое задание фиксирует свою транзакцию, а основной поток затем откатывает свою.
// Записи основного потока в базе остаться не должно: чужая фиксация его транзакции не касается.
//
&Тест
Процедура ФиксацияВФоновомЗаданииНеЗавершаетТранзакциюОсновногоПотока() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	СохранитьАвтора("Основной");

	ВыполнитьВФоне("ЗафиксироватьПустуюТранзакциюВФоне");

	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем
		.Что(ПрочитатьАвторов(), "Фиксация в фоновом задании не должна была зафиксировать чужую запись")
		.ИмеетДлину(0);

КонецПроцедуры

// Фоновое задание откатывает свою транзакцию, а основной поток затем фиксирует свою.
// Запись основного потока должна сохраниться: чужой откат его транзакции не касается.
//
&Тест
Процедура ОткатВФоновомЗаданииНеОтменяетТранзакциюОсновногоПотока() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	СохранитьАвтора("Основной");

	ВыполнитьВФоне("ОткатитьПустуюТранзакциюВФоне");

	МенеджерСущностей.ЗафиксироватьТранзакцию();

	Авторы = ПрочитатьАвторов();
	Ожидаем.Что(Авторы, "Откат в фоновом задании не должен был отменить чужую запись").ИмеетДлину(1);
	Ожидаем.Что(Авторы[0].Имя, "В базе остался автор основного потока").Равно("Основной");

КонецПроцедуры

// Фоновое задание, оборвавшееся с ошибкой посреди транзакции, не мешает основному потоку
// завершить свою.
//
&Тест
Процедура ОшибкаВФоновомЗаданииНеЛомаетТранзакциюОсновногоПотока() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	СохранитьАвтора("Основной");

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОборватьТранзакциюВФоне", ПараметрыЗадания(), Истина);
	ТестовыеУтилиты.ДождатьсяЗадания(Задание);

	Ожидаем
		.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Фоновое задание должно было завершиться ошибкой")
		.ЭтоИстина();

	МенеджерСущностей.ЗафиксироватьТранзакцию();

	Ожидаем.Что(ПрочитатьАвторов(), "Транзакция основного потока зафиксирована").ИмеетДлину(1);

КонецПроцедуры

// Операции вне транзакций тоже идут по разным соединениям. Раньше они шли по общему коннектору
// менеджера, и параллельные запросы рвали протокол обмена с СУБД.
//
&Тест
Процедура ОперацииРазныхПотоковВнеТранзакцийНеМешаютДругДругу() Экспорт

	СохранитьАвтора("Общий");

	// Упавший запуск не оставляет уже запущенные задания работать дальше: они дожидаются, и только
	// потом исходная ошибка уходит дальше.
	Задания = Новый Массив;
	Попытка
		Запущено = 0;
		Пока Запущено < 4 Цикл
			Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЧитатьАвторовВФоне", ПараметрыЗадания(), Истина));
			Запущено = Запущено + 1;
		КонецЦикла;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания));
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания);

	Ожидаем.Что(ПрочитатьАвторов(), "Данные на месте, ни один читатель не сломался").ИмеетДлину(1);

КонецПроцедуры

// Многократно читает авторов. Запускается в фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//
Процедура ЧитатьАвторовВФоне(Менеджер) Экспорт
	Прочитано = 0;
	Пока Прочитано < 50 Цикл
		Менеджер.Получить(Тип("Автор"));
		Прочитано = Прочитано + 1;
	КонецЦикла;
КонецПроцедуры

// Фоновое задание пишет в собственной транзакции, и запись видна после ее фиксации.
//
&Тест
Процедура ФоновоеЗаданиеПишетВСобственнойТранзакции() Экспорт

	ВыполнитьВФоне("СохранитьАвтораВФоне");

	Авторы = ПрочитатьАвторов();
	Ожидаем.Что(Авторы, "Фоновое задание сохранило автора").ИмеетДлину(1);
	Ожидаем.Что(Авторы[0].Имя, "Сохранился автор фонового задания").Равно("Фоновый");

КонецПроцедуры

// Один поток выполняет несколько транзакций подряд: соединение возвращается в пул после
// каждой и берется заново для следующей.
//
&Тест
Процедура НесколькоТранзакцийПодрядВОдномПотоке() Экспорт

	Для Индекс = 1 По 3 Цикл
		МенеджерСущностей.НачатьТранзакцию();
		СохранитьАвтора("Автор" + Индекс);
		МенеджерСущностей.ЗафиксироватьТранзакцию();
	КонецЦикла;

	Ожидаем.Что(ПрочитатьАвторов(), "Зафиксированы все три транзакции").ИмеетДлину(3);

КонецПроцедуры

// Фиксирует в фоновом задании транзакцию, в которой ничего не записано.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//
Процедура ЗафиксироватьПустуюТранзакциюВФоне(Менеджер) Экспорт
	Менеджер.НачатьТранзакцию();
	Менеджер.ЗафиксироватьТранзакцию();
КонецПроцедуры

// Откатывает в фоновом задании транзакцию, в которой ничего не записано.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//
Процедура ОткатитьПустуюТранзакциюВФоне(Менеджер) Экспорт
	Менеджер.НачатьТранзакцию();
	Менеджер.ОтменитьТранзакцию();
КонецПроцедуры

// Начинает в фоновом задании транзакцию и обрывается, не завершив ее.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//
Процедура ОборватьТранзакциюВФоне(Менеджер) Экспорт
	Менеджер.НачатьТранзакцию();
	ВызватьИсключение "Обрыв фонового задания";
КонецПроцедуры

// Сохраняет автора в отдельной транзакции фонового задания.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//
Процедура СохранитьАвтораВФоне(Менеджер) Экспорт

	Менеджер.НачатьТранзакцию();

	Попытка
		СохранитьАвтора("Фоновый", Менеджер);
		Менеджер.ЗафиксироватьТранзакцию();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Менеджер.ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Выполняет процедуру в фоновом задании и дожидается ее завершения.
//
// Параметры:
//   ИмяПроцедуры - Строка - Имя процедуры текущего модуля; менеджер теста она получает параметром.
//
Процедура ВыполнитьВФоне(Знач ИмяПроцедуры)

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяПроцедуры, ПараметрыЗадания(), Истина);
	ТестовыеУтилиты.ДождатьсяЗадания(Задание);

	Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;

КонецПроцедуры

// Параметры фонового задания: менеджер теста. Задание получает его параметром, а не читает
// переменную модуля, - задание, пережившее свой тест, так и не увидит менеджер следующего.
//
// Возвращаемое значение:
//   Массив - Параметры для ФоновыеЗадания.Выполнить.
//
Функция ПараметрыЗадания()

	Параметры = Новый Массив;
	Параметры.Добавить(МенеджерСущностей);

	Возврат Параметры;

КонецФункции

// Сохраняет автора с указанным именем.
//
// Параметры:
//   Имя - Строка - Имя автора.
//   Менеджер - МенеджерСущностей, Неопределено - Менеджер; по умолчанию менеджер теста.
//
Процедура СохранитьАвтора(Знач Имя, Знач Менеджер = Неопределено)

	Если Менеджер = Неопределено Тогда
		Менеджер = МенеджерСущностей;
	КонецЕсли;

	Автор = Новый Автор;
	Автор.Имя = Имя;
	Автор.ВтороеИмя = "Иванов";

	Менеджер.Сохранить(Автор);

КонецПроцедуры

// Читает всех авторов собственным коннектором менеджера, вне транзакций потоков.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Строки таблицы авторов.
//
Функция ПрочитатьАвторов()
	Возврат ТестовыеУтилиты.ВыполнитьЗапрос(МенеджерСущностей, "SELECT * FROM Авторы ORDER BY Идентификатор");
КонецФункции

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
