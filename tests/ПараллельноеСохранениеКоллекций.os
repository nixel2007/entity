// Параллельное сохранение одной сущности с подчиненной таблицей из разных потоков исполнения.
//
// Сохранение сущности с коллекцией - несколько запросов: строка сущности, удаление прежних строк
// коллекции, вставка новых. Без изоляции два сохранения одной сущности перемежаются, и в коллекции
// оказываются строки обоих, а чтение посередине видит коллекцию пустой. Тесты проверяют, что
// каждое чтение и итог видят коллекцию ровно из того числа элементов, которое сохраняется.
//
// SQLite - файловая база: база в памяти с общим кэшем параллельных писателей не допускает.
//
// BSLLS:MagicNumber-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать ".."
#Использовать "utils"

// Массив из ИсточникДанных - Источники, созданные тестом.
Перем СозданныеИсточники;
// МенеджерСущностей - Менеджер теста; закрывается после теста.
Перем МенеджерСущностей;
// Массив из Строка - Файлы и каталоги баз, которые тест создал и удаляет после себя.
Перем ФайлыБаз;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "СущностьСКоллекцией.os"),
		"СущностьСКоллекцией"
	);
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", "НаблюдательПаузыПослеЗапроса.os"),
		"НаблюдательПаузыПослеЗапроса"
	);

	СозданныеИсточники = Новый Массив;
	ФайлыБаз = Новый Массив;
	МенеджерСущностей = Неопределено;

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт

	Если МенеджерСущностей <> Неопределено Тогда
		МенеджерСущностей.Закрыть();
		МенеджерСущностей = Неопределено;
	КонецЕсли;

	ТестовыеУтилиты.ЗакрытьИсточники(СозданныеИсточники);

	Для Каждого Путь Из ФайлыБаз Цикл
		УдалитьФайлы(Путь);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПараллельноеСохранениеКоллекцииInMemory() Экспорт

	ИмяБазы = "ПараллельноеСохранениеКоллекций";
	ХранилищеВПамяти.Очистить(ИмяБазы);

	ПроверитьПараллельноеСохранение(Тип("КоннекторInMemory"), ИмяБазы);

КонецПроцедуры

&Тест
Процедура ПараллельноеСохранениеКоллекцииJSON() Экспорт

	Каталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Каталог);
	ФайлыБаз.Добавить(Каталог);

	ПроверитьПараллельноеСохранение(Тип("КоннекторJSON"), Каталог);

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗапускатьТестыSQLite()")
Процедура ПараллельноеСохранениеКоллекцииSQLite() Экспорт

	ФайлБазы = ПолучитьИмяВременногоФайла("sqlite");
	ФайлыБаз.Добавить(ФайлБазы);

	ПроверитьПараллельноеСохранение(Тип("КоннекторSQLite"), "Data Source=" + ФайлБазы);

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЗапускатьТестыPostgreSQL()")
Процедура ПараллельноеСохранениеКоллекцииPostgreSQL() Экспорт
	ПроверитьПараллельноеСохранение(Тип("КоннекторPostgreSQL"), СтрокаСоединенияPostgres(), Истина);
КонецПроцедуры

// Определяет, доступна ли в текущем окружении база SQLite.
//
// Возвращаемое значение:
//   Булево - Истина, если тест нужно выполнять.
//
Функция ЗапускатьТестыSQLite() Экспорт
	Возврат ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_SQLITE_TESTS", "true") = "true";
КонецФункции

// Определяет, доступна ли в текущем окружении база PostgreSQL.
//
// Возвращаемое значение:
//   Булево - Истина, если тест нужно выполнять.
//
Функция ЗапускатьТестыPostgreSQL() Экспорт
	Возврат ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("TESTRUNNER_RUN_POSTGRES_TESTS", "true") = "true";
КонецФункции

// Два задания сохраняют одну сущность с коллекцией, третье в это время ее читает. Каждое чтение и
// итог должны видеть коллекцию ровно из ЭлементовВКоллекции() элементов.
//
// Параметры:
//   ТипКоннектора - Тип - Тип коннектора базы.
//   СтрокаСоединения - Строка - Строка соединения с базой.
//   СброситьТаблицы - Булево - Удалить таблицы базы до инициализации модели.
//
Процедура ПроверитьПараллельноеСохранение(Знач ТипКоннектора, Знач СтрокаСоединения, Знач СброситьТаблицы = Ложь)

	Источник = Новый ИсточникДанных("Тесты", ТипКоннектора, СтрокаСоединения);
	СозданныеИсточники.Добавить(Источник);
	// oneunit исполняет подготовку и тест в разных потоках: источник живет до ПослеКаждого.
	Источник.УстановитьАвтоЗакрытие(Ложь);

	МенеджерСущностей = Новый МенеджерСущностей(Источник);
	Если СброситьТаблицы Тогда
		ТестовыеУтилиты.СброситьТаблицы(МенеджерСущностей);
	КонецЕсли;
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьСКоллекцией"));
	МенеджерСущностей.Инициализировать();

	МенеджерСущностей.Сохранить(НоваяСущность("Начало"));

	// Пауза между удалением прежних строк коллекции и вставкой новых: без изоляции в это окно
	// попадают и второе сохранение, и чтение.
	Источник.ДобавитьНаблюдателя(Новый НаблюдательПаузыПослеЗапроса("DELETE", 5));

	// Задания получают менеджер параметром, а не читают переменную модуля: задание, пережившее
	// свой тест, не увидит менеджер следующего. Упавший запуск не оставляет уже запущенные
	// задания работать дальше: они дожидаются, и только потом ошибка уходит дальше.
	Задания = Новый Массив;
	Попытка
		Задания.Добавить(ЗапуститьЗадание("СохранитьСущностьВФоне", "Первый"));
		Задания.Добавить(ЗапуститьЗадание("СохранитьСущностьВФоне", "Второй"));
		Читатель = ЗапуститьЗадание("ПрочитатьКоллекцииВФоне");
		Задания.Добавить(Читатель);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ТестовыеУтилиты.СообщитьОЗаданиях(ТестовыеУтилиты.ДождатьсяЗаданий(Задания, СрокЗаданий()));
		ВызватьИсключение;
	КонецПопытки;

	ТестовыеУтилиты.ПроверитьЗадания(Задания, СрокЗаданий());

	Ожидаем.Что(Читатель.Результат, "Каждое чтение видело коллекцию целиком").ИмеетДлину(0);

	Итог = МенеджерСущностей.ПолучитьОдно(Тип("СущностьСКоллекцией"), 1);
	Ожидаем.Что(Итог.Элементы, "Итоговая коллекция - элементы одного сохранения").ИмеетДлину(ЭлементовВКоллекции());
	Для Каждого Элемент Из Итог.Элементы Цикл
		Ожидаем.Что(СтрНачинаетсяС(Элемент, Итог.Метка + "-"), "Элемент сохранен вместе со строкой сущности")
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Запускает фоновое задание с менеджером теста первым параметром.
//
// Параметры:
//   ИмяМетода - Строка - Метод, выполняемый заданием.
//   Метка - Строка, Неопределено - Второй параметр метода; Неопределено - второго параметра нет.
//
// Возвращаемое значение:
//   ФоновоеЗадание - Запущенное задание.
//
Функция ЗапуститьЗадание(Знач ИмяМетода, Знач Метка = Неопределено)

	Параметры = Новый Массив;
	Параметры.Добавить(МенеджерСущностей);
	Если Метка <> Неопределено Тогда
		Параметры.Добавить(Метка);
	КонецЕсли;

	Возврат ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры, Истина);

КонецФункции

// Сохраняет одну и ту же сущность в цикле. Запускается в фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//   Метка - Строка - Метка задания: ею помечены строка сущности и элементы коллекции.
//
Процедура СохранитьСущностьВФоне(Менеджер, Знач Метка) Экспорт

	Сохранено = 0;
	Пока Сохранено < СохраненийВЗадании() Цикл
		Менеджер.Сохранить(НоваяСущность(Метка + Сохранено));
		Сохранено = Сохранено + 1;
	КонецЦикла;

КонецПроцедуры

// Читает сущность в цикле и запоминает каждое чтение, увидевшее коллекцию не целиком.
// Запускается в фоновом задании.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер теста.
//
// Возвращаемое значение:
//   Массив из Число - Размеры коллекции в неверных чтениях; пустой, если все чтения верны.
//
Функция ПрочитатьКоллекцииВФоне(Менеджер) Экспорт

	НеверныеЧтения = Новый Массив;

	Прочитано = 0;
	Пока Прочитано < СохраненийВЗадании() Цикл
		Сущность = Менеджер.ПолучитьОдно(Тип("СущностьСКоллекцией"), 1);
		Размер = Сущность.Элементы.Количество();
		Если Размер <> ЭлементовВКоллекции() Тогда
			НеверныеЧтения.Добавить(Размер);
		КонецЕсли;
		Прочитано = Прочитано + 1;
	КонецЦикла;

	Возврат НеверныеЧтения;

КонецФункции

// Создает сущность с коллекцией, элементы которой помечены меткой сущности.
//
// Параметры:
//   Метка - Строка - Метка сущности.
//
// Возвращаемое значение:
//   СущностьСКоллекцией - Новая сущность.
//
Функция НоваяСущность(Знач Метка)

	Сущность = Новый СущностьСКоллекцией;
	Сущность.Код = 1;
	Сущность.Метка = Метка;
	Сущность.Элементы = Новый Массив;

	Номер = 0;
	Пока Номер < ЭлементовВКоллекции() Цикл
		Сущность.Элементы.Добавить(Метка + "-" + Номер);
		Номер = Номер + 1;
	КонецЦикла;

	Возврат Сущность;

КонецФункции

// Число элементов в коллекции каждого сохранения.
//
// Возвращаемое значение:
//   Число - Число элементов.
//
Функция ЭлементовВКоллекции()
	Возврат 5;
КонецФункции

// Число сохранений в каждом пишущем задании и чтений в читающем.
//
// Возвращаемое значение:
//   Число - Число повторов.
//
Функция СохраненийВЗадании()
	Возврат 40;
КонецФункции

// Общий срок ожидания заданий теста.
//
// Возвращаемое значение:
//   Число - Срок в миллисекундах.
//
Функция СрокЗаданий()
	Возврат 120000;
КонецФункции

// Строка соединения с тестовой базой PostgreSQL.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединенияPostgres()

	Хост = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_HOST", "localhost");
	Порт = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PORT", "5432");
	Пользователь = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_USERNAME", "postgres");
	Пароль = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_PASSWORD", "postgres");
	ИмяБД = ТестовыеУтилиты.ПолучитьПеременнуюСредыИлиЗначение("POSTGRES_DATABASE", "postgres");

	Возврат СтрШаблон(
		"Host=%1;Username=%2;Password=%3;Database=%4;port=%5;",
		Хост,
		Пользователь,
		Пароль,
		ИмяБД,
		Порт
	);

КонецФункции
