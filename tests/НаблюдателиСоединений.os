// Наблюдатели сущностей: события соединений пула и транзакций.
//
// База - InMemory за коннектором-обёрткой, изображающим транзакции: события соединений и
// транзакций рождаются в пуле и в обёртке соединения, от СУБД они не зависят.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "utils"

// Менеджер, который тесты создают заново перед каждым тестом.
Перем МенеджерСущностей;
// Наблюдатель, зарегистрированный на менеджере до инициализации.
Перем Наблюдатель;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ПодключитьФикстуры();
	ХранилищеВПамяти.Очистить("соединения");

	СоздатьМенеджер(Ложь, 10);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	МенеджерСущностей.Закрыть();
КонецПроцедуры

// Соединения

&Тест
Процедура ЗахватИОсвобождениеСоединенияПорождаютСобытия() Экспорт

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));

	Захваты = Наблюдатель.Завершенные("Соединение", "Занять");
	Освобождения = Наблюдатель.Завершенные("Соединение", "Освободить");

	Ожидаем.Что(Захваты, "Инициализация и сохранение занимают соединение по разу").ИмеетДлину(2);
	Ожидаем.Что(Освобождения).ИмеетДлину(2);

	Первый = Захваты[0];
	Ожидаем.Что(Первый.Открыто(), "Первый захват открывает новое соединение").Равно(Истина);
	Ожидаем.Что(Первый.ВремяОткрытия()).Не_().Меньше(0);
	Ожидаем.Что(Первый.Ожидание()).Равно(0);
	Ожидаем.Что(Первый.Ошибка()).Равно(Неопределено);

	Второй = Захваты[1];
	Ожидаем.Что(Второй.Открыто(), "Второй захват берет свободное соединение").Равно(Ложь);
	Ожидаем.Что(Второй.ВремяОткрытия()).Равно(0);
	Ожидаем.Что(Второй.Занято(), "Снимок пула после захвата").Равно(1);
	Ожидаем.Что(Второй.Свободно()).Равно(0);

	Последнее = Освобождения[1];
	Ожидаем.Что(Последнее.Занято(), "Снимок пула после освобождения").Равно(0);
	Ожидаем.Что(Последнее.Свободно()).Равно(1);
	Ожидаем.Что(Последнее.Ожидает()).Равно(0);
	Ожидаем.Что(Последнее.Предел()).Равно(10);

КонецПроцедуры

&Тест
Процедура ПовторныйЗахватТогоЖеПотокаСобытийНеПорождает() Экспорт

	Внешняя = Новый СущностьБезГенерируемогоИдентификатора;
	Внешняя.ВнутреннийИдентификатор = 7;
	МенеджерСущностей.Сохранить(Внешняя);

	Автор = Новый Автор;
	Автор.Имя = "Пушкин";
	Автор.ВнешняяСущность = Внешняя;
	МенеджерСущностей.Сохранить(Автор);

	МенеджерСущностей.Закрыть();
	СоздатьМенеджер(Ложь, 10);

	ЗахватовДо = Наблюдатель.Завершенные("Соединение", "Занять").Количество();
	МенеджерСущностей.Получить(Тип("Автор"));

	Ожидаем.Что(Наблюдатель.Завершенные("Операция", "ПолучитьОдно"), "Ссылка разыменована вложенной операцией").ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Соединение", "Занять").Количество() - ЗахватовДо, "Вложенная операция идет по тому же соединению").Равно(1);

КонецПроцедуры

&Тест
Процедура ОжиданиеСоединенияПопадаетВСобытие() Экспорт

	МенеджерСущностей.Закрыть();
	СоздатьМенеджер(Ложь, 1);

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДержатьСоединениеВФоне", Новый Массив, Истина);
	Приостановить(100);

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	ДождатьсяЗадания(Задание);

	Захваты = Наблюдатель.Завершенные("Соединение", "Занять");
	Последний = Захваты[Захваты.ВГраница()];

	Ожидаем.Что(Последний.Ожидание(), "Основной поток ждал соединение, занятое заданием").Не_().Меньше(100);
	Ожидаем.Что(Последний.Открыто()).Равно(Ложь);

КонецПроцедуры

// Транзакции

&Тест
Процедура ФиксацияДаетСобытиеТранзакцииСИсходомCommit() Экспорт

	МенеджерСущностей.НачатьТранзакцию();

	Ожидаем.Что(Наблюдатель.Начатые("Транзакция")).ИмеетДлину(1);
	Ожидаем.Что(Наблюдатель.Завершенные("Транзакция")).ИмеетДлину(0);

	МенеджерСущностей.Сохранить(НовыйПростойОбъект(1));
	МенеджерСущностей.ЗафиксироватьТранзакцию();

	Транзакции = Наблюдатель.Завершенные("Транзакция");
	Ожидаем.Что(Транзакции).ИмеетДлину(1);
	Ожидаем.Что(Транзакции[0].Исход()).Равно("commit");
	Ожидаем.Что(Транзакции[0].Ошибка()).Равно(Неопределено);
	Ожидаем.Что(Транзакции[0].Длительность()).Не_().Меньше(0);
	Ожидаем.Что(Транзакции[0], "В обеих фазах один объект").Равно(Наблюдатель.Начатые("Транзакция")[0]);

КонецПроцедуры

&Тест
Процедура ОтменаДаетСобытиеТранзакцииСИсходомRollback() Экспорт

	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.ОтменитьТранзакцию();

	Транзакции = Наблюдатель.Завершенные("Транзакция");
	Ожидаем.Что(Транзакции).ИмеетДлину(1);
	Ожидаем.Что(Транзакции[0].Исход()).Равно("rollback");

КонецПроцедуры

&Тест
Процедура ОшибкаЗавершенияДаетИсходFailed() Экспорт

	МенеджерСущностей.Закрыть();
	СоздатьМенеджер(Истина, 10);

	МенеджерСущностей.НачатьТранзакцию();

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ЗафиксироватьТранзакцию", Новый Массив)
		.ВыбрасываетИсключение("Завершение транзакции не удалось");

	Транзакции = Наблюдатель.Завершенные("Транзакция");
	Ожидаем.Что(Транзакции).ИмеетДлину(1);
	Ожидаем.Что(Транзакции[0].Исход()).Равно("failed");
	Ожидаем.Что(Транзакции[0].Ошибка()).ИмеетТип("ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура БрошеннаяТранзакцияЗавершаетсяИсходомAbandoned() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОборватьТранзакциюВФоне", Новый Массив, Истина);
	ДождатьсяЗадания(Задание);

	Ожидаем.Что(Задание.ИнформацияОбОшибке <> Неопределено, "Задание должно было оборваться").ЭтоИстина();

	// Соединение возвращается обработчиком завершения потока; ему дается время сработать.
	Транзакции = ДождатьсяЗавершенныхТранзакций(1);

	Ожидаем.Что(Транзакции).ИмеетДлину(1);
	Ожидаем.Что(Транзакции[0].Исход()).Равно("abandoned");

КонецПроцедуры

// Фоновые процедуры

// Держит соединение транзакцией, пока основной поток пытается его занять.
//
Процедура ДержатьСоединениеВФоне() Экспорт
	МенеджерСущностей.НачатьТранзакцию();
	Приостановить(400);
	МенеджерСущностей.ЗафиксироватьТранзакцию();
КонецПроцедуры

// Начинает транзакцию и обрывается, не завершив ее.
//
Процедура ОборватьТранзакциюВФоне() Экспорт
	МенеджерСущностей.НачатьТранзакцию();
	ВызватьИсключение "Обрыв фонового задания";
КонецПроцедуры

// Служебные

Процедура СоздатьМенеджер(Знач ПадатьПриЗавершенииТранзакции, Знач РазмерПула)

	ПараметрыКоннектора = Новый Массив;
	ПараметрыКоннектора.Добавить(ПадатьПриЗавершенииТранзакции);

	МенеджерСущностей = Новый МенеджерСущностей(
		Тип("КоннекторТранзакцийДляТестов"),
		"соединения",
		ПараметрыКоннектора,
		РазмерПула
	);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ПростойОбъект"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьБезГенерируемогоИдентификатора"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("Автор"));

	Наблюдатель = Новый НаблюдательЗаписывающий;
	МенеджерСущностей.ДобавитьНаблюдателя(Наблюдатель);

	МенеджерСущностей.Инициализировать();

КонецПроцедуры

Функция ДождатьсяЗавершенныхТранзакций(Знач Количество)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;

	Пока Истина Цикл
		Транзакции = Наблюдатель.Завершенные("Транзакция");
		Если Транзакции.Количество() >= Количество ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() > КрайнийСрок Тогда
			Возврат Транзакции;
		КонецЕсли;
		Приостановить(20);
	КонецЦикла;

КонецФункции

Процедура ДождатьсяЗадания(Задание)
	Если НЕ Задание.ОжидатьЗавершения(30000) Тогда
		ВызватьИсключение "Фоновое задание не завершилось за 30 секунд";
	КонецЕсли;
КонецПроцедуры

// Колонка идентификатора ПростойОбъект строковая: без &Колонка тип колонки - Строка.
Функция НовыйПростойОбъект(Знач Идентификатор)
	Объект = Новый ПростойОбъект;
	Объект.Идентификатор = Строка(Идентификатор);
	Объект.Поле = "поле " + Идентификатор;
	Возврат Объект;
КонецФункции

Процедура ПодключитьФикстуры()

	Фикстуры = Новый Массив;
	Фикстуры.Добавить("ПростойОбъект");
	Фикстуры.Добавить("СущностьБезГенерируемогоИдентификатора");
	Фикстуры.Добавить("Автор");
	Фикстуры.Добавить("НаблюдательЗаписывающий");
	Фикстуры.Добавить("КоннекторТранзакцийДляТестов");

	Для Каждого Фикстура Из Фикстуры Цикл
		ПодключитьСценарий(
			ОбъединитьПути(ТекущийКаталог(), "tests", "fixtures", Фикстура + ".os"),
			Фикстура
		);
	КонецЦикла;

КонецПроцедуры
