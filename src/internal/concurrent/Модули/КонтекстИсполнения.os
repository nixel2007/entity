// Идентификация контекста исполнения.
//
// Контекстом считается фоновое задание, а весь код вне фоновых заданий - одним общим контекстом.
// Это единственный доступный из встроенного языка способ различать параллельно работающий код:
// идентификатор потока операционной системы в скрипт не выведен.
//
// Из этого следуют два ограничения:
//   - код, запущенный в потоках в обход "ФоновыеЗадания", между собой не различается;
//   - "ФоновыеЗадания.Очистить()" очищает список заданий, после чего работающее задание
//     перестает опознаваться и сливается с кодом вне заданий.
//
// Строка - Ключ контекста, в котором выполняется код вне фоновых заданий.
Перем КлючВнеФоновогоЗадания;
// Число - Сколько раз повторяется обращение к списку заданий, сорванное параллельным изменением
// списка.
Перем ПределПовторов;
// Число - Пауза между повторами в миллисекундах.
Перем ПаузаПовтора;
// Действие - Обращение к движку за текущим заданием.
Перем ОбращениеЗаТекущимЗаданием;
// Действие - Обращение к движку за списком заданий.
Перем ОбращениеЗаВсемиЗаданиями;

// Возвращает ключ текущего контекста исполнения.
//
// Возвращаемое значение:
//   Строка - Идентификатор текущего фонового задания либо общий ключ для кода вне заданий.
//
Функция Ключ() Экспорт

	ТекущееЗадание = ТекущееЗадание();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат КлючВнеФоновогоЗадания;
	КонецЕсли;

	Возврат Строка(ТекущееЗадание.УникальныйИдентификатор);

КонецФункции

// Определяет, работает ли еще контекст с указанным ключом.
//
// Код вне фоновых заданий считается работающим всегда. Фоновое задание ищется среди известных
// менеджеру заданий: если оно не найдено или уже не активно, контекст считается завершенным.
//
// После "ФоновыеЗадания.Очистить()" список заданий пуст, и работающее задание будет признано
// завершенным. Вызывающий код должен учитывать это, если освобождает по этому признаку ресурсы.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ, полученный ранее из "Ключ()".
//
// Возвращаемое значение:
//   Булево - Истина, если контекст еще работает.
//
Функция Работает(Знач КлючКонтекста) Экспорт

	Если КлючКонтекста = КлючВнеФоновогоЗадания Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Задание Из ВсеЗадания() Цикл
		Если Строка(Задание.УникальныйИдентификатор) = КлючКонтекста Тогда
			Возврат Задание.Состояние = СостояниеФоновогоЗадания.Активно;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// BSLLS:UsingServiceTag-off
// @internal
// BSLLS:UsingServiceTag-on
// Для служебного пользования.
//
// Выполняет обращение к списку фоновых заданий, повторяя его при срыве перебора.
//
// Список заданий движок перебирает без синхронизации: если в этот момент другой поток запускает
// или завершает задание, перебор срывается с "Collection was modified". Со стороны библиотеки
// сделать с этим можно только одно - повторить.
//
// Параметры:
//   Обращение - Действие - Обращение к списку заданий, которое нужно повторять.
//
// Возвращаемое значение:
//   Произвольный - Результат обращения.
//
Функция ВыполнитьСПовтором(Обращение) Экспорт

	Попыток = 0;

	Пока Истина Цикл

		Попытка
			Возврат Обращение.Выполнить();
		Исключение
			Попыток = Попыток + 1;
			Если Попыток >= ПределПовторов Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;

		Приостановить(ПаузаПовтора);

	КонецЦикла;

КонецФункции

// Возвращает текущее фоновое задание.
//
// Возвращаемое значение:
//   ФоновоеЗадание - Задание, в котором выполняется код.
//   Неопределено - Код выполняется вне фоновых заданий.
//
Функция ТекущееЗадание()
	Возврат ВыполнитьСПовтором(ОбращениеЗаТекущимЗаданием);
КонецФункции

// Возвращает список известных менеджеру фоновых заданий.
//
// Возвращаемое значение:
//   Массив - Фоновые задания.
//
Функция ВсеЗадания()
	Возврат ВыполнитьСПовтором(ОбращениеЗаВсемиЗаданиями);
КонецФункции

// Обращается к движку за текущим заданием. Вызывается только через ВыполнитьСПовтором.
//
// Возвращаемое значение:
//   ФоновоеЗадание - Задание, в котором выполняется код.
//   Неопределено - Код выполняется вне фоновых заданий.
//
Функция ПолучитьТекущееЗадание() Экспорт
	Возврат ФоновыеЗадания.ПолучитьТекущее();
КонецФункции

// Обращается к движку за списком заданий. Вызывается только через ВыполнитьСПовтором.
//
// Возвращаемое значение:
//   Массив - Фоновые задания.
//
Функция ПолучитьВсеЗадания() Экспорт
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания();
КонецФункции

КлючВнеФоновогоЗадания = "*";
ПределПовторов = 100;
ПаузаПовтора = 1;

// Обращения строятся один раз: они на пути каждого захвата соединения.
ОбращениеЗаТекущимЗаданием = Новый Действие(ЭтотОбъект, "ПолучитьТекущееЗадание");
ОбращениеЗаВсемиЗаданиями = Новый Действие(ЭтотОбъект, "ПолучитьВсеЗадания");
