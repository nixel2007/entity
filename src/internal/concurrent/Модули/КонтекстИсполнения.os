// Идентификация контекста исполнения.
//
// Контекстом считается фоновое задание, а весь код вне фоновых заданий - одним общим контекстом.
// Это единственный доступный из встроенного языка способ различать параллельно работающий код:
// идентификатор потока операционной системы в скрипт не выведен.
//
// Из этого следуют два ограничения:
//   - код, запущенный в потоках в обход "ФоновыеЗадания", между собой не различается;
//   - "ФоновыеЗадания.Очистить()" очищает список заданий, после чего работающее задание
//     перестает опознаваться и сливается с кодом вне заданий.
//
// Ключ контекста, в котором выполняется код вне фоновых заданий.
Перем КлючВнеФоновогоЗадания;

// Ключ текущего контекста исполнения.
//
// Возвращаемое значение:
//   Строка - Идентификатор текущего фонового задания либо общий ключ для кода вне заданий.
//
Функция Ключ() Экспорт

	ТекущееЗадание = ФоновыеЗадания.ПолучитьТекущее();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат КлючВнеФоновогоЗадания;
	КонецЕсли;

	Возврат Строка(ТекущееЗадание.УникальныйИдентификатор);

КонецФункции

// Определяет, работает ли еще контекст с указанным ключом.
//
// Код вне фоновых заданий считается работающим всегда. Фоновое задание ищется среди известных
// менеджеру заданий: если оно не найдено или уже не активно, контекст считается завершенным.
//
// После "ФоновыеЗадания.Очистить()" список заданий пуст, и работающее задание будет признано
// завершенным. Вызывающий код должен учитывать это, если освобождает по этому признаку ресурсы.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ, полученный ранее из "Ключ()".
//
// Возвращаемое значение:
//   Булево - Истина, если контекст еще работает.
//
Функция Работает(Знач КлючКонтекста) Экспорт

	Если КлючКонтекста = КлючВнеФоновогоЗадания Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания() Цикл
		Если Строка(Задание.УникальныйИдентификатор) = КлючКонтекста Тогда
			Возврат Задание.Состояние = СостояниеФоновогоЗадания.Активно;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

КлючВнеФоновогоЗадания = "*";
