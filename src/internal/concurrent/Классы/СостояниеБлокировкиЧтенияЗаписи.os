// Строка - Ключ владельца, удерживающего блокировку записи. Пустая строка - блокировка записи свободна.
//
Перем ВладелецЗаписи;

// Число - Число захватов блокировки записи ее владельцем.
//
Перем ГлубинаЗаписи;

// Соответствие из КлючИЗначение:
//  * Ключ - Строка - ключ блокировки.
//  * Значение - Число - число захватов им блокировки чтения.
//
Перем ГлубиныЧтения;

// Число - Число владельцев, ожидающих блокировку записи. Пока положительно, новые читатели не проходят.
//
Перем ОжидающиеПисатели;

// БлокировкаРесурса - Защищает поля состояния. Удерживается только на время их чтения и изменения.
//
Перем БлокировкаСостояния;

// Число - Пауза между попытками захвата в миллисекундах.
//
Перем РазмерПаузы;

// Состояние блокировки чтения-записи и вся логика захвата.
//
// Служебный класс: создается объектом "БлокировкаЧтенияЗаписи" и разделяется между его
// половинами - "БлокировкаЧтения" и "БлокировкаЗаписи". Напрямую не используется.
//
Процедура ПриСозданииОбъекта()

	ВладелецЗаписи = "";
	ГлубинаЗаписи = 0;
	ГлубиныЧтения = Новый Соответствие();
	ОжидающиеПисатели = 0;

	БлокировкаСостояния = Новый БлокировкаРесурса();
	РазмерПаузы = 10;


КонецПроцедуры

// Захватить блокировку чтения, ожидая освобождения сколько потребуется.
//
Процедура ЗаблокироватьЧтение() Экспорт
	ЗаблокироватьЧтениеСОжиданием(0, Истина);
КонецПроцедуры

// Попытаться захватить блокировку чтения.
//
// Параметры:
//   ТаймаутОжидания - Число - Предельное время ожидания в миллисекундах.
//                   - Неопределено - Одна попытка без ожидания.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ПопытатьсяЗаблокироватьЧтение(Знач ТаймаутОжидания = Неопределено) Экспорт

	Если ТаймаутОжидания = Неопределено Тогда
		Возврат ПопытатьсяЗахватитьЧтение(КлючВладельца(), Истина);
	КонецЕсли;

	Возврат ЗаблокироватьЧтениеСОжиданием(ТаймаутОжидания, Ложь);

КонецФункции

// Освободить блокировку чтения.
//
Процедура РазблокироватьЧтение() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();

	Попытка

		ТекущаяГлубина = ГлубиныЧтения.Получить(Ключ);
		Если ТекущаяГлубина = Неопределено Тогда
			ВызватьИсключение "Блокировка чтения не захвачена текущим контекстом исполнения";
		КонецЕсли;

		Если ТекущаяГлубина = 1 Тогда
			ГлубиныЧтения.Удалить(Ключ);
		Иначе
			ГлубиныЧтения.Вставить(Ключ, ТекущаяГлубина - 1);
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

КонецПроцедуры

// Захватить блокировку записи, ожидая освобождения сколько потребуется.
//
Процедура ЗаблокироватьЗапись() Экспорт
	ЗаблокироватьЗаписьСОжиданием(0, Истина);
КонецПроцедуры

// Попытаться захватить блокировку записи.
//
// Параметры:
//   ТаймаутОжидания - Число - Предельное время ожидания в миллисекундах.
//                   - Неопределено - Одна попытка без ожидания.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ПопытатьсяЗаблокироватьЗапись(Знач ТаймаутОжидания = Неопределено) Экспорт

	Если ТаймаутОжидания = Неопределено Тогда
		Ключ = КлючВладельца();
		ПроверитьЧтоНеТребуетсяПовышение(Ключ);
		Возврат ПопытатьсяЗахватитьЗапись(Ключ);
	КонецЕсли;

	Возврат ЗаблокироватьЗаписьСОжиданием(ТаймаутОжидания, Ложь);

КонецФункции

// Освободить блокировку записи.
//
Процедура РазблокироватьЗапись() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();

	Попытка

		Если ВладелецЗаписи <> Ключ Тогда
			ВызватьИсключение "Блокировка записи не захвачена текущим контекстом исполнения";
		КонецЕсли;

		ГлубинаЗаписи = ГлубинаЗаписи - 1;
		Если ГлубинаЗаписи = 0 Тогда
			ВладелецЗаписи = "";
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

КонецПроцедуры

// Определяет, удерживает ли кто-либо блокировку записи.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка записи захвачена.
//
Функция ЗахваченаЗапись() Экспорт

	БлокировкаСостояния.Заблокировать();
	Результат = ВладелецЗаписи <> "";
	БлокировкаСостояния.Разблокировать();

	Возврат Результат;

КонецФункции

// Определяет, удерживает ли блокировку записи текущий контекст исполнения.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка записи захвачена текущим контекстом.
//
Функция ЗахваченаЗаписьТекущимКонтекстом() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();
	Результат = ВладелецЗаписи = Ключ;
	БлокировкаСостояния.Разблокировать();

	Возврат Результат;

КонецФункции

// Общее число захватов блокировки чтения.
//
// Считаются все захваты всех контекстов исполнения: контекст, вошедший вложенно трижды, дает
// три захвата.
//
// Возвращаемое значение:
//   Число - Количество захватов блокировки чтения.
//
Функция КоличествоЗахватовЧтения() Экспорт

	БлокировкаСостояния.Заблокировать();

	Результат = 0;
	Для Каждого КлючИЗначение Из ГлубиныЧтения Цикл
		Результат = Результат + КлючИЗначение.Значение;
	КонецЦикла;

	БлокировкаСостояния.Разблокировать();

	Возврат Результат;

КонецФункции

// Число захватов блокировки чтения текущим контекстом исполнения.
//
// Возвращаемое значение:
//   Число - Глубина захвата. Ноль, если текущий контекст не читает.
//
Функция ГлубинаЗахватаЧтения() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();
	ТекущаяГлубина = ГлубиныЧтения.Получить(Ключ);
	БлокировкаСостояния.Разблокировать();

	Возврат ?(ТекущаяГлубина = Неопределено, 0, ТекущаяГлубина);

КонецФункции

// Число захватов блокировки записи текущим контекстом исполнения.
//
// Возвращаемое значение:
//   Число - Глубина захвата. Ноль, если текущий контекст не удерживает запись.
//
Функция ГлубинаЗахватаЗаписи() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();
	Результат = ?(ВладелецЗаписи = Ключ, ГлубинаЗаписи, 0);
	БлокировкаСостояния.Разблокировать();

	Возврат Результат;

КонецФункции

// Захват блокировки чтения с ожиданием.
//
// Параметры:
//   ТаймаутОжидания - Число - Предельное время ожидания в миллисекундах.
//   БезОграничения - Булево - Истина, если ожидать до захвата без учета таймаута.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ЗаблокироватьЧтениеСОжиданием(Знач ТаймаутОжидания, Знач БезОграничения)

	Ключ = КлючВладельца();
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока НЕ ПопытатьсяЗахватитьЧтение(Ключ, Ложь) Цикл

		Если НЕ БезОграничения И ОжиданиеИстекло(ВремяНачала, ТаймаутОжидания) Тогда
			Возврат Ложь;
		КонецЕсли;

		Приостановить(РазмерПаузы);

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Захват блокировки записи с ожиданием.
//
// Параметры:
//   ТаймаутОжидания - Число - Предельное время ожидания в миллисекундах.
//   БезОграничения - Булево - Истина, если ожидать до захвата без учета таймаута.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ЗаблокироватьЗаписьСОжиданием(Знач ТаймаутОжидания, Знач БезОграничения)

	Ключ = КлючВладельца();
	ПроверитьЧтоНеТребуетсяПовышение(Ключ);

	ИзменитьЧислоОжидающихПисателей(1);

	Попытка

		Захвачено = Истина;
		ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Пока НЕ ПопытатьсяЗахватитьЗапись(Ключ) Цикл

			Если НЕ БезОграничения И ОжиданиеИстекло(ВремяНачала, ТаймаутОжидания) Тогда
				Захвачено = Ложь;
				Прервать;
			КонецЕсли;

			Приостановить(РазмерПаузы);

		КонецЦикла;

	Исключение

		ИзменитьЧислоОжидающихПисателей(-1);

		ВызватьИсключение;

	КонецПопытки;

	ИзменитьЧислоОжидающихПисателей(-1);

	Возврат Захвачено;

КонецФункции

// Однократная попытка захватить блокировку чтения.
//
// Параметры:
//   Ключ - Строка - Ключ владельца, запрашивающего блокировку.
//   ИгнорироватьОжидающихПисателей - Булево - Истина, если проходить мимо очереди писателей.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ПопытатьсяЗахватитьЧтение(Знач Ключ, Знач ИгнорироватьОжидающихПисателей = Ложь)

	БлокировкаСостояния.Заблокировать();

	Попытка

		ТекущаяГлубина = ГлубиныЧтения.Получить(Ключ);

		// Повторный захват не ждет очереди писателей: иначе владелец, обратившийся к блокировке
		// вложенно, ждал бы писателя, который ждет освобождения этого же владельца.
		Захвачено = ТекущаяГлубина <> Неопределено
			ИЛИ ВладелецЗаписи = Ключ
			ИЛИ (ВладелецЗаписи = "" И (ИгнорироватьОжидающихПисателей ИЛИ ОжидающиеПисатели = 0));

		Если Захвачено Тогда
			ГлубиныЧтения.Вставить(Ключ, ?(ТекущаяГлубина = Неопределено, 0, ТекущаяГлубина) + 1);
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

	Возврат Захвачено;

КонецФункции

// Однократная попытка захватить блокировку записи.
//
// Параметры:
//   Ключ - Строка - Ключ владельца, запрашивающего блокировку.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ПопытатьсяЗахватитьЗапись(Знач Ключ)

	БлокировкаСостояния.Заблокировать();

	Попытка

		Захвачено = (ВладелецЗаписи = "" ИЛИ ВладелецЗаписи = Ключ) И НетПостороннихЧитателей(Ключ);

		Если Захвачено Тогда
			ВладелецЗаписи = Ключ;
			ГлубинаЗаписи = ГлубинаЗаписи + 1;
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

	Возврат Захвачено;

КонецФункции

// Определяет, отсутствуют ли читатели, кроме указанного владельца.
//
// Вызывается при захваченной "БлокировкаСостояния".
//
// Параметры:
//   Ключ - Строка - Ключ владельца, который не учитывается.
//
// Возвращаемое значение:
//   Булево - Истина, если других читателей нет.
//
Функция НетПостороннихЧитателей(Знач Ключ)

	Для Каждого КлючИЗначение Из ГлубиныЧтения Цикл
		Если КлючИЗначение.Ключ <> Ключ Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Убеждается, что запрос блокировки записи не является повышением блокировки чтения.
//
// Параметры:
//   Ключ - Строка - Ключ владельца, запрашивающего блокировку записи.
//
Процедура ПроверитьЧтоНеТребуетсяПовышение(Знач Ключ)

	БлокировкаСостояния.Заблокировать();

	Попытка
		ТребуетсяПовышение = ГлубиныЧтения.Получить(Ключ) <> Неопределено И ВладелецЗаписи <> Ключ;
	Исключение
		БлокировкаСостояния.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

	Если ТребуетсяПовышение Тогда
		ТекстОшибки = "Повышение блокировки чтения до блокировки записи не поддерживается.
			|Освободите блокировку чтения перед захватом блокировки записи";
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

// Изменяет счетчик писателей, стоящих в очереди. Пока счетчик положителен, новые читатели
// не допускаются.
//
// Параметры:
//   Приращение - Число - Величина, на которую изменяется счетчик.
//
Процедура ИзменитьЧислоОжидающихПисателей(Знач Приращение)

	БлокировкаСостояния.Заблокировать();

	Попытка
		ОжидающиеПисатели = ОжидающиеПисатели + Приращение;
	Исключение
		БлокировкаСостояния.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

КонецПроцедуры

// Определяет, истекло ли отведенное время ожидания.
//
// Параметры:
//   ВремяНачала - Число - Момент начала ожидания в миллисекундах.
//   ТаймаутОжидания - Число - Предельное время ожидания в миллисекундах.
//
// Возвращаемое значение:
//   Булево - Истина, если ожидание исчерпано.
//
Функция ОжиданиеИстекло(Знач ВремяНачала, Знач ТаймаутОжидания)
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала >= ТаймаутОжидания;
КонецФункции

// Ключ текущего контекста исполнения.
//
// Возвращаемое значение:
//   Строка - Идентификатор текущего фонового задания либо общий ключ для кода вне заданий.
//
Функция КлючВладельца()
	Возврат КонтекстИсполнения.Ключ();
КонецФункции
