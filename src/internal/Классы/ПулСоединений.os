// Пул соединений с базой данных.
//
// Выдает соединение контексту исполнения и хранит эту привязку, пока контекст не освободит
// соединение. Благодаря этому операции разных фоновых заданий идут по разным коннекторам, и
// транзакция одного задания не может быть зафиксирована или отменена другим.
//
// Свободные соединения лежат в приоритетной очереди: первым выдается то, которое вернули в пул
// последним. Так рабочий набор соединений остается малым, а простаивающие стареют.
//
// Размер пула - это то, сколько соединений придерживается для переиспользования, а не предел
// одновременно живущих. В выдаче пул не отказывает никогда: контекст, которому соединения не
// хватило, получит новое, и оно закроется при возврате. Нулевой размер поэтому означает не
// отключенный пул, а пул без переиспользования: соединение живет ровно одну транзакцию.
//
// Пул разделяется всеми потоками, поэтому его состояние защищено блокировкой чтения-записи.
//
#Использовать "../concurrent"

#Использовать collectionos

// Очередь свободных соединений. Первым выдается возвращенное последним.
Перем Свободные;
// Соответствие: ключ контекста исполнения - выданное ему соединение.
Перем СоединенияКонтекстов;
// Защищает очередь и соответствие: пул разделяется потоками.
Перем Блокировка;

// Сколько соединений придерживается для переиспользования.
Перем РазмерПула;
// Число созданных и еще не закрытых соединений.
Перем СозданоСоединений;

// Тип класса, реализующего интерфейс коннектора.
Перем ТипКоннектора;
// Строка соединения, с которой открываются коннекторы пула.
Перем СтрокаСоединения;
// Дополнительные параметры коннекторов пула.
Перем ПараметрыКоннектора;

// Конструктор.
//
// Параметры:
//   ПРазмерПула - Число - Предельное число одновременно живущих соединений.
//   ПТипКоннектора - Тип - Тип класса, реализующего интерфейс коннектора.
//   ПСтрокаСоединения - Строка - Строка соединения с БД.
//   ППараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//
Процедура ПриСозданииОбъекта(Знач ПРазмерПула, Знач ПТипКоннектора, Знач ПСтрокаСоединения, Знач ППараметрыКоннектора)

	РазмерПула = ПРазмерПула;
	ТипКоннектора = ПТипКоннектора;
	СтрокаСоединения = ПСтрокаСоединения;
	ПараметрыКоннектора = ППараметрыКоннектора;

	// Возвращенное позже считается меньшим, поэтому оказывается в голове очереди.
	Свободные = Новый ПриоритетнаяОчередь(
		"(Первое, Второе) -> ?(Первое.МоментВозврата() > Второе.МоментВозврата(), -1,"
			+ " ?(Первое.МоментВозврата() < Второе.МоментВозврата(), 1, 0))"
	);

	СоединенияКонтекстов = Новый Соответствие();
	Блокировка = Новый БлокировкаЧтенияЗаписи();
	СозданоСоединений = 0;

КонецПроцедуры

// Соединение текущего контекста исполнения.
//
// Пока контекст не освободит соединение, он получает то же самое: операции одного задания идут
// по одному коннектору, и начатая им транзакция видна всем его операциям.
//
// Возвращаемое значение:
//   СоединениеСущности - Соединение, закрепленное за текущим контекстом.
//
Функция ПолучитьДляТекущегоКонтекста() Экспорт

	КлючКонтекста = КонтекстИсполнения.Ключ();

	Блокировка.Запись().Заблокировать();

	Попытка

		Соединение = СоединенияКонтекстов.Получить(КлючКонтекста);
		Если Соединение = Неопределено Тогда
			Соединение = ВыдатьСоединение();
			СоединенияКонтекстов.Вставить(КлючКонтекста, Соединение);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Возврат Соединение;

КонецФункции

// Освободить соединение текущего контекста исполнения.
//
// Вызывается по завершении транзакции: держать соединение закрепленным между транзакциями
// незачем, оно нужно другим контекстам.
//
Процедура ОсвободитьТекущийКонтекст() Экспорт
	ОсвободитьКонтекст(КонтекстИсполнения.Ключ());
КонецПроцедуры

// Определяет, закреплено ли за текущим контекстом соединение.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение выдано и еще не освобождено.
//
Функция ЕстьСоединениеТекущегоКонтекста() Экспорт

	КлючКонтекста = КонтекстИсполнения.Ключ();

	Блокировка.Чтение().Заблокировать();
	Результат = СоединенияКонтекстов.Получить(КлючКонтекста) <> Неопределено;
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Число соединений, закрепленных за контекстами.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество занятых соединений.
//
Функция КоличествоЗанятых() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = СоединенияКонтекстов.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Число свободных соединений в очереди.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество свободных соединений.
//
Функция КоличествоСвободных() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Свободные.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Закрыть все соединения пула.
//
Процедура Закрыть() Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		Для Каждого КлючИЗначение Из СоединенияКонтекстов Цикл
			КлючИЗначение.Значение.Закрыть();
		КонецЦикла;
		СоединенияКонтекстов.Очистить();

		Пока Свободные.Количество() > 0 Цикл
			Свободные.Взять().Получить().Закрыть();
		КонецЦикла;

		СозданоСоединений = 0;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Освобождает соединение указанного контекста.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
Процедура ОсвободитьКонтекст(Знач КлючКонтекста)

	Блокировка.Запись().Заблокировать();

	Попытка

		Соединение = СоединенияКонтекстов.Получить(КлючКонтекста);
		Если Соединение <> Неопределено Тогда
			СоединенияКонтекстов.Удалить(КлючКонтекста);
			ВернутьВОчередь(Соединение);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Выдает свободное соединение: из очереди, созданием нового или отбирая у завершившихся
// контекстов. Вызывается при захваченной блокировке записи.
//
// Возвращаемое значение:
//   СоединениеСущности - Соединение, не закрепленное ни за одним контекстом.
//
Функция ВыдатьСоединение()

	Если Свободные.Количество() > 0 Тогда
		Возврат Свободные.Взять().Получить();
	КонецЕсли;

	Если СозданоСоединений >= РазмерПула Тогда
		ОсвободитьЗавершенныеКонтексты();
	КонецЕсли;

	Если Свободные.Количество() > 0 Тогда
		Возврат Свободные.Взять().Получить();
	КонецЕсли;

	// Придерживаемых соединений не хватило, но отказать нельзя: операция уже начата. Такое
	// соединение закрывается при возврате, а не встает в очередь.
	СозданоСоединений = СозданоСоединений + 1;

	Возврат Новый СоединениеСущности(ТипКоннектора, СтрокаСоединения, ПараметрыКоннектора);

КонецФункции

// Возвращает соединение в очередь свободных либо закрывает его, если пул переполнен.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   Соединение - СоединениеСущности - Освобожденное соединение.
//
Процедура ВернутьВОчередь(Соединение)

	Соединение.ОтметитьВозврат();

	// Соединение сверх размера пула открывалось потому, что придерживаемых не хватило. Держать
	// его дальше незачем: при нулевом размере так закрывается каждое.
	Если СозданоСоединений > РазмерПула Тогда
		Соединение.Закрыть();
		СозданоСоединений = СозданоСоединений - 1;
		Возврат;
	КонецЕсли;

	Свободные.Положить(Соединение);

КонецПроцедуры

// Отбирает соединения у контекстов, которые больше не работают.
//
// Нужно для транзакций, которые никто не завершил: фоновое задание упало или вернуло управление,
// не вызвав ни фиксацию, ни отмену. Без этого соединение осталось бы закреплено за мертвым
// контекстом навсегда.
//
// Вызывается при захваченной блокировке записи.
//
Процедура ОсвободитьЗавершенныеКонтексты()

	Завершенные = Новый Массив;
	Для Каждого КлючИЗначение Из СоединенияКонтекстов Цикл
		Если НЕ КонтекстИсполнения.Работает(КлючИЗначение.Ключ) Тогда
			Завершенные.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючКонтекста Из Завершенные Цикл
		Соединение = СоединенияКонтекстов.Получить(КлючКонтекста);
		СоединенияКонтекстов.Удалить(КлючКонтекста);
		ВернутьВОчередь(Соединение);
	КонецЦикла;

КонецПроцедуры
