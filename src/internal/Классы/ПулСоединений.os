// Пул соединений с базой данных.
//
// Через пул идут все обращения к БД. Соединение выдается контексту исполнения на время операции
// или транзакции и не разделяется с другими контекстами: у драйверов СУБД соединение не
// потокобезопасно, и параллельные запросы по одному соединению рвут протокол обмена.
//
// Захват реентерабельный. Операция внутри транзакции получает то же соединение, что и сама
// транзакция, поэтому попадает в нее, а не идет мимо. Соединение возвращается в пул, когда
// контекст освободил его столько же раз, сколько занимал.
//
// Размер пула - это предел одновременно живущих соединений. Когда все заняты, контекст встает в
// очередь ожидающих, и освобожденное соединение достается тому, кто ждет дольше всех. Нулевой
// размер снимает предел и отключает постоянно живущие соединения: каждый захват открывает
// соединение, каждое освобождение его закрывает, ждать при таком размере некого.
//
// Свободные соединения лежат в приоритетной очереди: первым выдается то, которое вернули
// последним. Так рабочий набор соединений остается малым, а простаивающие стареют.
//
// Пул разделяется всеми потоками, поэтому его состояние защищено блокировкой чтения-записи.
//
#Использовать "../concurrent"

#Использовать collectionos

// ПриоритетнаяОчередь - Очередь свободных соединений. Первым выдается возвращенное последним.
Перем Свободные;
// ПриоритетнаяОчередь - Очередь заявок на соединение. В голове - самая ранняя.
Перем Ожидающие;
// Число - Номер последней выданной заявки. Задает порядок в очереди ожидающих.
Перем НомерПоследнейЗаявки;

// Соответствие - Ключ контекста исполнения и выданное ему соединение.
Перем СоединенияКонтекстов;
// Соответствие - Ключ контекста исполнения и сколько раз он занял соединение, не освободив.
Перем ГлубиныЗахвата;
// БлокировкаЧтенияЗаписи - Защищает очереди и соответствия: пул разделяется потоками.
Перем Блокировка;

// Число - Предел одновременно живущих соединений. Ноль снимает предел.
Перем РазмерПула;
// Число - Число созданных и еще не закрытых соединений.
Перем СозданоСоединений;

// Соответствие - Ключи контекстов, которые прямо сейчас открывают себе соединение. Место в пуле
// за ними уже занято, а самого соединения еще нет: открытие идет вне блокировки.
Перем Брони;

// Число - Пауза между проверками своей заявки в очереди, в миллисекундах.
Перем ПаузаОжидания;

// Тип - Тип класса, реализующего интерфейс коннектора.
Перем ТипКоннектора;
// Строка - Строка соединения, с которой открываются коннекторы пула.
Перем СтрокаСоединения;
// Массив - Дополнительные параметры коннекторов пула.
Перем ПараметрыКоннектора;

// Создает пул с заданным пределом одновременно живущих соединений.
//
// Параметры:
//   ПРазмерПула - Число - Предел одновременно живущих соединений. Ноль снимает предел и отключает
//     постоянно живущие соединения.
//   ПТипКоннектора - Тип - Тип класса, реализующего интерфейс коннектора.
//   ПСтрокаСоединения - Строка - Строка соединения с БД.
//   ППараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//
Процедура ПриСозданииОбъекта(Знач ПРазмерПула, Знач ПТипКоннектора, Знач ПСтрокаСоединения, Знач ППараметрыКоннектора)

	// Отрицательный размер не отвергает ни один захват явно: предел просто никогда не позволяет
	// открыть соединение, и контекст уходит ждать в очередь, где его никто не дождется.
	Если НЕ (ТипЗнч(ПРазмерПула) = Тип("Число") И ПРазмерПула >= 0) Тогда
		ВызватьИсключение СтрШаблон(
			"Размер пула соединений должен быть неотрицательным числом, передано <%1>",
			ПРазмерПула
		);
	КонецЕсли;

	РазмерПула = ПРазмерПула;
	ТипКоннектора = ПТипКоннектора;
	СтрокаСоединения = ПСтрокаСоединения;
	ПараметрыКоннектора = ППараметрыКоннектора;

	// Возвращенное позже считается меньшим, поэтому оказывается в голове очереди.
	Свободные = Новый ПриоритетнаяОчередь(
		"(Первое, Второе) -> ?(Первое.МоментВозврата() > Второе.МоментВозврата(), -1,"
			+ " ?(Первое.МоментВозврата() < Второе.МоментВозврата(), 1, 0))"
	);

	// Заявка с меньшим номером подана раньше и оказывается в голове очереди.
	Ожидающие = Новый ПриоритетнаяОчередь(
		"(Первое, Второе) -> ?(Первое.Номер < Второе.Номер, -1, ?(Первое.Номер > Второе.Номер, 1, 0))"
	);

	НомерПоследнейЗаявки = 0;
	СоединенияКонтекстов = Новый Соответствие();
	ГлубиныЗахвата = Новый Соответствие();
	Блокировка = Новый БлокировкаЧтенияЗаписи();
	СозданоСоединений = 0;
	Брони = Новый Соответствие();
	ПаузаОжидания = 10;

КонецПроцедуры

// Занимает соединение для текущего контекста исполнения.
//
// Захват реентерабельный: контекст, уже занявший соединение, получает то же самое, а освобождать
// его нужно столько же раз, сколько занимал.
//
// Если предел пула исчерпан, вызов встает в очередь и ждет, пока соединение освободит другой
// контекст. Освобожденное соединение достается тому, кто ждет дольше всех.
//
// Возвращаемое значение:
//   СоединениеСущности - Соединение, закрепленное за текущим контекстом.
//
Функция Занять() Экспорт

	КлючКонтекста = КонтекстИсполнения.Ключ();

	Блокировка.Запись().Заблокировать();

	Попытка
		Итог = ПопытатьсяЗанять(КлючКонтекста);
		Если Итог.Соединение = Неопределено И НЕ Итог.Бронь Тогда
			Заявка = ВстатьВОчередь(КлючКонтекста);
		КонецЕсли;
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Если Итог.Соединение <> Неопределено Тогда
		Возврат Итог.Соединение;
	КонецЕсли;

	Если Итог.Бронь Тогда
		Возврат ОткрытьПоБрони(КлючКонтекста);
	КонецЕсли;

	Возврат ДождатьсяПоЗаявке(КлючКонтекста, Заявка);

КонецФункции

// Освобождает соединение текущего контекста исполнения.
//
// Соединение возвращается в пул только после того, как контекст освободил его столько же раз,
// сколько занимал. Освобождение без захвата ничего не делает.
//
Процедура Освободить() Экспорт

	КлючКонтекста = КонтекстИсполнения.Ключ();

	Блокировка.Запись().Заблокировать();

	Попытка
		ОсвободитьЗахват(КлючКонтекста);
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Возвращает соединение, занятое текущим контекстом исполнения.
//
// Глубину захвата не меняет, поэтому подходит для завершения транзакции: соединение нужно
// освободить ровно один раз, парно к его захвату.
//
// Возвращаемое значение:
//   СоединениеСущности - Соединение текущего контекста.
//   Неопределено - Текущий контекст соединения не занимал.
//
Функция СоединениеТекущегоКонтекста() Экспорт

	КлючКонтекста = КонтекстИсполнения.Ключ();

	Блокировка.Чтение().Заблокировать();
	Результат = СоединенияКонтекстов.Получить(КлючКонтекста);
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Определяет, занято ли соединение текущим контекстом исполнения.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение занято и еще не освобождено.
//
Функция ЕстьСоединениеТекущегоКонтекста() Экспорт
	Возврат СоединениеТекущегоКонтекста() <> Неопределено;
КонецФункции

// Возвращает число соединений, занятых контекстами.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество занятых соединений.
//
Функция КоличествоЗанятых() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = СоединенияКонтекстов.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число свободных соединений в очереди.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество свободных соединений.
//
Функция КоличествоСвободных() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Свободные.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число занятых пулом мест: открытых соединений и броней под те, что открываются
// прямо сейчас.
//
// Предназначено для диагностики и проверок: именно это число сравнивается с размером пула,
// и именно оно протекает, если неудачное открытие не вернет свое место.
//
// Возвращаемое значение:
//   Число - Количество занятых мест в пуле.
//
Функция КоличествоСозданных() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = СозданоСоединений;
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число контекстов, ожидающих освобождения соединения.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество ожидающих.
//
Функция КоличествоОжидающих() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Ожидающие.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает тип коннектора, которым пул открывает соединения.
//
// Возвращаемое значение:
//   Тип - Тип класса, реализующего интерфейс коннектора.
//
Функция ТипКоннектора() Экспорт
	Возврат ТипКоннектора;
КонецФункции

// Возвращает строку соединения, с которой пул открывает соединения.
//
// Возвращаемое значение:
//   Строка - Строка соединения с БД.
//
Функция СтрокаСоединения() Экспорт
	Возврат СтрокаСоединения;
КонецФункции

// Возвращает дополнительные параметры коннекторов пула.
//
// Возвращаемое значение:
//   Массив - Параметры коннектора.
//
Функция ПараметрыКоннектора() Экспорт
	Возврат ПараметрыКоннектора;
КонецФункции

// Закрывает все соединения пула.
//
Процедура Закрыть() Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		Для Каждого КлючИЗначение Из СоединенияКонтекстов Цикл
			КлючИЗначение.Значение.Закрыть();
		КонецЦикла;
		СоединенияКонтекстов.Очистить();
		ГлубиныЗахвата.Очистить();

		Пока Свободные.Количество() > 0 Цикл
			Свободные.Взять().Получить().Закрыть();
		КонецЦикла;

		// Соединение, уже отданное заявке, не лежит ни за контекстом, ни в свободных: заберет его
		// ожидающий, до которого очередь дошла. Без разбора заявок оно пережило бы закрытие пула.
		Пока Ожидающие.Количество() > 0 Цикл
			Заявка = Ожидающие.Взять().Получить();
			Заявка.Снята = Истина;
			Если Заявка.Соединение <> Неопределено Тогда
				Заявка.Соединение.Закрыть();
				Заявка.Соединение = Неопределено;
			КонецЕсли;
		КонецЦикла;

		// Брони снимаются последними: по снятой броне открывающий контекст поймет, что пул
		// закрыт, и закроет свое соединение сам - здесь его еще нет.
		Брони.Очистить();

		СозданоСоединений = 0;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Одна попытка занять соединение. Вызывается при захваченной блокировке записи.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
// Возвращаемое значение:
//   Структура - Итог попытки, см. Конструктор_ИтогПопытки.
//
Функция ПопытатьсяЗанять(Знач КлючКонтекста)

	Итог = Конструктор_ИтогПопытки();

	Соединение = СоединенияКонтекстов.Получить(КлючКонтекста);
	Если Соединение <> Неопределено Тогда
		ГлубиныЗахвата.Вставить(КлючКонтекста, ГлубиныЗахвата.Получить(КлючКонтекста) + 1);
		Итог.Соединение = Соединение;
		Возврат Итог;
	КонецЕсли;

	Соединение = ВзятьСвободное();
	Если Соединение <> Неопределено Тогда
		ЗакрепитьЗаКонтекстом(КлючКонтекста, Соединение);
		Итог.Соединение = Соединение;
		Возврат Итог;
	КонецЕсли;

	// Свободных нет. Если предел позволяет, за контекстом бронируется место, а открывать
	// соединение он будет уже без блокировки.
	Если РазмерПула = 0 ИЛИ СозданоСоединений < РазмерПула Тогда
		Брони.Вставить(КлючКонтекста, Истина);
		СозданоСоединений = СозданоСоединений + 1;
		Итог.Бронь = Истина;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Достает соединение из очереди свободных.
// Вызывается при захваченной блокировке записи.
//
// Возвращаемое значение:
//   СоединениеСущности - Соединение, не закрепленное ни за одним контекстом.
//   Неопределено - Свободных соединений нет.
//
Функция ВзятьСвободное()

	Если Свободные.Количество() > 0 Тогда
		Возврат Свободные.Взять().Получить();
	КонецЕсли;

	Если РазмерПула = 0 ИЛИ СозданоСоединений < РазмерПула Тогда
		// Место под новое соединение есть - его займет бронь, а не очередь свободных.
		Возврат Неопределено;
	КонецЕсли;

	// Предел исчерпан - только теперь имеет смысл искать соединения контекстов, которые уже не
	// работают: освободить их сам контекст не может. На общем пути этот поиск не нужен, а стоит
	// он перебора всех фоновых заданий движка.
	ОсвободитьЗавершенныеКонтексты();

	Если Свободные.Количество() > 0 Тогда
		Возврат Свободные.Взять().Получить();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Открывает соединение по ранее взятой брони и закрепляет его за контекстом.
//
// Открытие идет БЕЗ блокировки пула: это сетевой вызов, и его длительность не должна ничего
// останавливать. Иначе недоступная база морозила бы весь пул на таймаут подключения, причем
// последовательно для каждого контекста, и заодно не давала бы никому вернуть исправное
// соединение - `Освободить()` берет ту же блокировку. Место в пуле на это время держит бронь.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
// Возвращаемое значение:
//   СоединениеСущности - Открытое соединение, закрепленное за контекстом.
//
Функция ОткрытьПоБрони(Знач КлючКонтекста)

	Попытка
		Соединение = Новый СоединениеСущности(ТипКоннектора, СтрокаСоединения, ПараметрыКоннектора);
	Исключение
		СнятьБронь(КлючКонтекста);
		ВызватьИсключение;
	КонецПопытки;

	Возврат ЗакрепитьОткрытое(КлючКонтекста, Соединение);

КонецФункции

// Снимает бронь, не открыв по ней соединения, и возвращает место в пул.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
Процедура СнятьБронь(Знач КлючКонтекста)

	Блокировка.Запись().Заблокировать();

	Попытка
		Если Брони.Получить(КлючКонтекста) <> Неопределено Тогда
			Брони.Удалить(КлючКонтекста);
			СозданоСоединений = СозданоСоединений - 1;
		КонецЕсли;
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Закрепляет за контекстом соединение, открытое по брони.
//
// Пропавшая бронь означает, что пул закрыли или контекст сочли завершенным, пока шло открытие:
// место под это соединение уже отдано, и оставлять его в пуле нельзя.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//   Соединение - СоединениеСущности - Только что открытое соединение.
//
// Возвращаемое значение:
//   СоединениеСущности - То же соединение, закрепленное за контекстом.
//
Функция ЗакрепитьОткрытое(Знач КлючКонтекста, Соединение)

	Блокировка.Запись().Заблокировать();

	Попытка
		БроньЖива = Брони.Получить(КлючКонтекста) <> Неопределено;
		Если БроньЖива Тогда
			Брони.Удалить(КлючКонтекста);
			ЗакрепитьЗаКонтекстом(КлючКонтекста, Соединение);
		КонецЕсли;
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Если НЕ БроньЖива Тогда
		Соединение.Закрыть();
		ВызватьИсключение "Пул соединений закрыт, пока открывалось соединение";
	КонецЕсли;

	Возврат Соединение;

КонецФункции

// Ставит контекст в очередь ожидающих. Вызывается при захваченной блокировке записи.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
// Возвращаемое значение:
//   Структура - Заявка на соединение.
//
Функция ВстатьВОчередь(Знач КлючКонтекста)

	НомерПоследнейЗаявки = НомерПоследнейЗаявки + 1;

	Заявка = Новый Структура("Номер, КлючКонтекста, Соединение, Снята");
	Заявка.Номер = НомерПоследнейЗаявки;
	Заявка.КлючКонтекста = КлючКонтекста;
	Заявка.Соединение = Неопределено;
	Заявка.Снята = Ложь;
	Ожидающие.Положить(Заявка);

	Возврат Заявка;

КонецФункции

// Ждет, пока по заявке выдадут соединение.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//   Заявка - Структура - Заявка, поданная в очередь ожидающих.
//
// Возвращаемое значение:
//   СоединениеСущности - Соединение, закрепленное за контекстом.
//
Функция ДождатьсяПоЗаявке(Знач КлючКонтекста, Заявка)

	Пока Истина Цикл

		// Ждать нужно вне блокировки, иначе освободить соединение стало бы некому.
		Приостановить(ПаузаОжидания);

		Блокировка.Запись().Заблокировать();

		Попытка
			Итог = ПопытатьсяПолучитьПоЗаявке(Заявка, КлючКонтекста);
		Исключение
			// Иначе выданное по брошенной заявке соединение не забрал бы никто.
			Заявка.Снята = Истина;
			Блокировка.Запись().Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

		Блокировка.Запись().Разблокировать();

		Если Итог.Соединение <> Неопределено Тогда
			Возврат Итог.Соединение;
		КонецЕсли;

		// Место освободилось, пока ждали: открываем свое соединение так же, как обычный захват -
		// без блокировки.
		Если Итог.Бронь Тогда
			Возврат ОткрытьПоБрони(КлючКонтекста);
		КонецЕсли;

	КонецЦикла;

КонецФункции

// Одна попытка получить соединение ожидающим контекстом.
//
// Сначала берется соединение, выданное по заявке. Если его нет, контекст пробует занять
// соединение сам: заявку могли отбросить как ничью - например, задание еще не попало в список
// фоновых и не считалось работающим, - и тогда без этой попытки контекст ждал бы вечно.
//
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   Заявка - Структура - Заявка, поданная в очередь ожидающих.
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
// Возвращаемое значение:
//   Структура - Итог попытки, см. Конструктор_ИтогПопытки.
//
Функция ПопытатьсяПолучитьПоЗаявке(Заявка, Знач КлючКонтекста)

	Если Заявка.Соединение <> Неопределено Тогда
		Заявка.Снята = Истина;
		ЗакрепитьЗаКонтекстом(КлючКонтекста, Заявка.Соединение);

		Итог = Конструктор_ИтогПопытки();
		Итог.Соединение = Заявка.Соединение;

		Возврат Итог;
	КонецЕсли;

	Итог = ПопытатьсяЗанять(КлючКонтекста);
	Если Итог.Соединение = Неопределено И НЕ Итог.Бронь Тогда
		Возврат Итог;
	КонецЕсли;

	// Заявка больше не нужна: выданное по ней соединение осталось бы невостребованным.
	Заявка.Снята = Истина;

	// Пока шла попытка, соединение могли назначить этой же заявке: при исчерпанном пределе
	// ПопытатьсяЗанять разбирает завершенные контексты, а их соединения возвращаются в пул
	// через очередь ожидающих. В снятой заявке такое соединение забрать больше некому.
	Если Заявка.Соединение <> Неопределено Тогда
		СоединениеЗаявки = Заявка.Соединение;
		Заявка.Соединение = Неопределено;
		ВернутьВПул(СоединениеЗаявки);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Закрепляет соединение за контекстом с первой глубиной захвата.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//   Соединение - СоединениеСущности - Выданное соединение.
//
Процедура ЗакрепитьЗаКонтекстом(Знач КлючКонтекста, Соединение)

	СоединенияКонтекстов.Вставить(КлючКонтекста, Соединение);
	ГлубиныЗахвата.Вставить(КлючКонтекста, 1);

КонецПроцедуры

// Уменьшает глубину захвата и возвращает соединение в пул, когда она дошла до нуля.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
Процедура ОсвободитьЗахват(Знач КлючКонтекста)

	Глубина = ГлубиныЗахвата.Получить(КлючКонтекста);
	Если Глубина = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Глубина = Глубина - 1;
	Если Глубина > 0 Тогда
		ГлубиныЗахвата.Вставить(КлючКонтекста, Глубина);
		Возврат;
	КонецЕсли;

	// Начатую транзакцию соединение переживает: она принадлежит контексту и держит соединение за
	// ним до фиксации или отмены, сколько бы операций между ними ни прошло. Иначе завершение
	// транзакции пришлось бы считать захватом, а повторное начало оставляло бы лишний.
	Соединение = СоединенияКонтекстов.Получить(КлючКонтекста);
	Если Соединение <> Неопределено И Соединение.ВТранзакции() Тогда
		ГлубиныЗахвата.Вставить(КлючКонтекста, 0);
		Возврат;
	КонецЕсли;

	ОтобратьСоединение(КлючКонтекста);

КонецПроцедуры

// Отбирает соединение у контекста и передает его дальше.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   КлючКонтекста - Строка - Ключ контекста исполнения.
//
Процедура ОтобратьСоединение(Знач КлючКонтекста)

	Соединение = СоединенияКонтекстов.Получить(КлючКонтекста);

	ГлубиныЗахвата.Удалить(КлючКонтекста);
	СоединенияКонтекстов.Удалить(КлючКонтекста);

	ВернутьВПул(Соединение);

КонецПроцедуры

// Отдает освобожденное соединение голове очереди ожидающих, а если никто не ждет - в очередь
// свободных либо на закрытие. Вызывается при захваченной блокировке записи.
//
// Параметры:
//   Соединение - СоединениеСущности - Освобожденное соединение.
//
Процедура ВернутьВПул(Соединение)

	// Соединение, на котором не удалось завершить транзакцию, переиспользовать нельзя: в каком
	// состоянии осталась транзакция, неизвестно. Такое соединение закрывается, а его место
	// возвращается в пул - следующий контекст откроет себе новое.
	Если Соединение.Испорчено() Тогда
		Соединение.Закрыть();
		СозданоСоединений = СозданоСоединений - 1;
		Возврат;
	КонецЕсли;

	Соединение.ОтметитьВозврат();

	Заявка = ПервыйОжидающий();
	Если Заявка <> Неопределено Тогда
		Заявка.Соединение = Соединение;
		Возврат;
	КонецЕсли;

	Если РазмерПула = 0 Тогда
		Соединение.Закрыть();
		СозданоСоединений = СозданоСоединений - 1;
		Возврат;
	КонецЕсли;

	Свободные.Положить(Соединение);

КонецПроцедуры

// Достает из очереди самую раннюю заявку, по которой еще ждут.
//
// Живость контекста здесь не проверяется: это перебор всех фоновых заданий движка, а вызывается
// возврат соединения на каждой операции. Соединение, назначенное заявке оборвавшегося контекста,
// подбирает ОсвободитьЗаявкиЗавершенныхКонтекстов при исчерпанном пределе.
//
// Вызывается при захваченной блокировке записи.
//
// Возвращаемое значение:
//   Структура - Заявка на соединение.
//   Неопределено - Ожидающих нет.
//
Функция ПервыйОжидающий()

	Если Ожидающие.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заявки = Новый Массив;
	Пока Ожидающие.Количество() > 0 Цикл
		Заявки.Добавить(Ожидающие.Взять().Получить());
	КонецЦикла;

	Выбранная = Неопределено;
	Для Каждого Заявка Из Заявки Цикл

		// Снятую заявку удовлетворять нечем: контекст уже получил соединение другим путем, и
		// выданное по ней никто бы не забрал. В очередь она не возвращается.
		Если Заявка.Снята Тогда
			Продолжить;
		КонецЕсли;

		// Заявка возвращается в очередь в любом случае, в том числе с уже назначенным
		// соединением. Пока ожидающий его не забрал, очередь - единственное место, где это
		// соединение видно закрытию пула и разбору заявок брошенных контекстов.
		Ожидающие.Положить(Заявка);

		Если Выбранная = Неопределено И Заявка.Соединение = Неопределено Тогда
			Выбранная = Заявка;
		КонецЕсли;

	КонецЦикла;

	Возврат Выбранная;

КонецФункции

// Отбирает соединения у контекстов, которые больше не работают.
//
// Нужно для операций и транзакций, которые никто не завершил: фоновое задание упало или вернуло
// управление, не освободив соединение. Без этого при исчерпанном пределе его ждали бы вечно.
//
// Вызывается только при исчерпанном пределе: перебор фоновых заданий движка дорог, а на общем
// пути не нужен. При нулевом размере предела нет, поэтому соединение контекста, оборвавшегося
// посреди операции, закрывается только вместе с пулом.
//
// Разбираются и заявки: ожидающий обычно жив - он в этот момент исполняет цикл ожидания и свою
// заявку при ошибке снимает сам, - но убитое задание не снимет ничего. Соединение, назначенное
// такой заявке, не лежит ни за контекстом, ни в свободных, и забрать его больше некому.
//
// Вызывается при захваченной блокировке записи.
//
Процедура ОсвободитьЗавершенныеКонтексты()

	Завершенные = Новый Массив;
	Для Каждого КлючИЗначение Из СоединенияКонтекстов Цикл
		Если НЕ КонтекстИсполнения.Работает(КлючИЗначение.Ключ) Тогда
			Завершенные.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючКонтекста Из Завершенные Цикл
		ОтобратьСоединение(КлючКонтекста);
	КонецЦикла;

	ОсвободитьЗаявкиЗавершенныхКонтекстов();
	СнятьБрониЗавершенныхКонтекстов();

КонецПроцедуры

// Снимает брони оборвавшихся контекстов, возвращая занятые ими места в пул.
//
// Контекст, убитый посреди открытия соединения, свою бронь не снимет, а место в пуле она держит.
// Само соединение при этом либо не открылось, либо будет закрыто самим открывающим: пропавшую
// бронь он увидит в ЗакрепитьОткрытое.
//
// Вызывается при захваченной блокировке записи.
//
Процедура СнятьБрониЗавершенныхКонтекстов()

	Завершенные = Новый Массив;
	Для Каждого КлючИЗначение Из Брони Цикл
		Если НЕ КонтекстИсполнения.Работает(КлючИЗначение.Ключ) Тогда
			Завершенные.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючКонтекста Из Завершенные Цикл
		Брони.Удалить(КлючКонтекста);
		СозданоСоединений = СозданоСоединений - 1;
	КонецЦикла;

КонецПроцедуры

// Снимает заявки оборвавшихся контекстов и возвращает в пул назначенные им соединения.
//
// Очередь перебирается сливом и обратной укладкой: живые заявки возвращаются на место первыми,
// чтобы отобранное соединение досталось тому, кто его действительно ждет.
//
// Вызывается при захваченной блокировке записи.
//
Процедура ОсвободитьЗаявкиЗавершенныхКонтекстов()

	Заявки = Новый Массив;
	Пока Ожидающие.Количество() > 0 Цикл
		Заявки.Добавить(Ожидающие.Взять().Получить());
	КонецЦикла;

	Брошенные = Новый Массив;
	Для Каждого Заявка Из Заявки Цикл

		// Снятая заявка ничего не ждет и соединения не удержит: в очередь она не возвращается.
		Если Заявка.Снята Тогда
			Продолжить;
		КонецЕсли;

		Если КонтекстИсполнения.Работает(Заявка.КлючКонтекста) Тогда
			Ожидающие.Положить(Заявка);
		Иначе
			Заявка.Снята = Истина;
			Брошенные.Добавить(Заявка);
		КонецЕсли;

	КонецЦикла;

	Для Каждого Заявка Из Брошенные Цикл
		Если Заявка.Соединение <> Неопределено Тогда
			Соединение = Заявка.Соединение;
			Заявка.Соединение = Неопределено;
			ВернутьВПул(Соединение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Создает структуру итога попытки занять соединение.
//
// Возвращаемое значение:
//   Структура - Итог попытки:
//     * Соединение - СоединениеСущности - Занятое соединение.
//                  - Неопределено - Занять не удалось.
//     * Бронь - Булево - Истина, если за контекстом забронировано место и он должен открыть
//         соединение сам, вне блокировки пула.
//
Функция Конструктор_ИтогПопытки()

	Итог = Новый Структура;
	Итог.Вставить("Соединение");
	Итог.Вставить("Бронь", Ложь);

	Возврат Итог;

КонецФункции
