#Использовать annotations
#Использовать reflector
#Использовать extends
#Использовать logos

// ФиксированныйМассив - Зарегистрированные наблюдатели. Меняется целиком, поэтому рассылка
// работает со своим снимком и блокировки не нужны.
Перем Наблюдатели;
// Тип - Тип коннектора пула.
Перем ТипКоннектора;
// Структура - Система, Адрес, Порт, БазаДанных: чем и куда подключается пул.
Перем ОписаниеСоединения;
// Строка - Ключ вложенности операций в данных потока исполнения.
Перем КлючГлубины;
// Лог - Журнал наблюдателей.
Перем Лог;
// ВалидаторРеализации - Проверяет реализацию интерфейса при регистрации.
Перем Валидатор;
// ОпределениеАннотации - Определение аннотации &Реализует для чтения имени интерфейса.
Перем ОпределениеАннотацииРеализует;
// Булево - Объявляет ли коннектор пула интерфейс НаблюдаемыйКоннектор. Неопределено - еще не проверялось.
Перем КоннекторНаблюдаем;

// Реестр наблюдателей пула соединений.
//
// Один на менеджер сущностей: пул общий у менеджера и его хранилищ, поэтому события всех
// операций, запросов, соединений и транзакций идут через один реестр. При пустом реестре
// события не создаются: НачатьОперацию возвращает Неопределено, а Завершить с ним ничего не
// делает.
//
// Исключение наблюдателя пишется в лог и не прерывает операцию: наблюдение не должно ломать
// то, за чем наблюдает.
//
// Параметры:
//   ПТипКоннектора - Тип - Тип коннектора пула.
//
Процедура ПриСозданииОбъекта(Знач ПТипКоннектора)

	Наблюдатели = Новый ФиксированныйМассив(Новый Массив);
	ТипКоннектора = ПТипКоннектора;
	ОписаниеСоединения = Новый Структура("Система, Адрес, Порт, БазаДанных", СистемаПоТипу(ПТипКоннектора), "", 0, "");
	КлючГлубины = "entity.observers." + Строка(Новый УникальныйИдентификатор);
	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.observers");

	КонтейнерАннотаций = Новый КонтейнерАннотаций();
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияРеализует"));
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияИнтерфейс"));
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияРасширяет"));
	ОпределениеАннотацииРеализует = КонтейнерАннотаций.ПолучитьОпределениеАннотации("Реализует");
	Валидатор = Новый ВалидаторРеализации(КонтейнерАннотаций);

КонецПроцедуры

// Регистрирует наблюдателя.
//
// Наблюдатель должен объявить интерфейс аннотацией &Реализует("НаблюдательСущностей") и
// реализовать его целиком; иначе регистрация завершается ошибкой. Повторная регистрация того
// же объекта ничего не меняет.
//
// Параметры:
//   Наблюдатель - Произвольный - Объект, реализующий НаблюдательСущностей.
//
Процедура Добавить(Наблюдатель) Экспорт

	ПроверитьОбъявлениеИнтерфейса(Наблюдатель);
	ПроверитьРеализациюИнтерфейса(Наблюдатель);
	Валидатор.ИнтерфейсыРеализованыКорректно(Наблюдатель);

	Если Наблюдатели.Найти(Наблюдатель) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Новые = Новый Массив(Наблюдатели);
	Новые.Добавить(Наблюдатель);
	Наблюдатели = Новый ФиксированныйМассив(Новые);

КонецПроцедуры

// Снимает наблюдателя с регистрации.
//
// Параметры:
//   Наблюдатель - Произвольный - Ранее зарегистрированный наблюдатель. Незарегистрированный пропускается.
//
Процедура Удалить(Наблюдатель) Экспорт

	Индекс = Наблюдатели.Найти(Наблюдатель);
	Если Индекс = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Новые = Новый Массив(Наблюдатели);
	Новые.Удалить(Индекс);
	Наблюдатели = Новый ФиксированныйМассив(Новые);

КонецПроцедуры

// Определяет, зарегистрирован ли хоть один наблюдатель.
//
// Возвращаемое значение:
//   Булево - Истина, если наблюдателей нет.
//
Функция Пусто() Экспорт
	Возврат Наблюдатели.Количество() = 0;
КонецФункции

// Число зарегистрированных наблюдателей.
//
// Возвращаемое значение:
//   Число - Количество.
//
Функция Количество() Экспорт
	Возврат Наблюдатели.Количество();
КонецФункции

// Описание соединения, которым помечаются события.
//
// Возвращаемое значение:
//   Структура - Система, Адрес, Порт, БазаДанных.
//
Функция ОписаниеСоединения() Экспорт
	Возврат ОписаниеСоединения;
КонецФункции

// Запоминает описание соединения, полученное от коннектора.
//
// Параметры:
//   Описание - Структура - Система, Адрес, Порт, БазаДанных.
//
Процедура УстановитьОписаниеСоединения(Знач Описание) Экспорт
	ОписаниеСоединения = Описание;
КонецПроцедуры

// Подключает к реестру только что открытый коннектор пула.
//
// Коннектор, объявивший интерфейс НаблюдаемыйКоннектор, получает реестр и сообщает описание
// соединения; остальные работают без событий уровня запроса. Объявление проверяется один раз
// на тип коннектора, реализация - валидатором extends.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Открытый коннектор.
//
Процедура ПодключитьКоннектор(Коннектор) Экспорт

	Если КоннекторНаблюдаем = Неопределено Тогда
		КоннекторНаблюдаем = ОбъявляетИнтерфейс(Коннектор, "НаблюдаемыйКоннектор");
		Если КоннекторНаблюдаем Тогда
			Валидатор.ИнтерфейсыРеализованыКорректно(Коннектор);
		КонецЕсли;
	КонецЕсли;

	Если НЕ КоннекторНаблюдаем Тогда
		Возврат;
	КонецЕсли;

	Коннектор.УстановитьНаблюдателей(ЭтотОбъект);
	ОписаниеСоединения = Коннектор.ОписаниеСоединения();

КонецПроцедуры

// Начинает событие запроса к СУБД и рассылает его наблюдателям.
//
// Параметры:
//   ОперацияСУБД - Строка - SELECT, INSERT, DELETE, CREATE TABLE, BEGIN, COMMIT, ROLLBACK.
//   ИмяТаблицы - Строка - Таблица запроса; пустая строка, если таблицы нет.
//   ТекстЗапроса - Строка, Неопределено - Текст запроса; Неопределено у коннекторов без SQL.
//
// Возвращаемое значение:
//   СобытиеСущностей - Начатое событие.
//   Неопределено - Наблюдателей нет, событие не создавалось.
//
Функция НачатьЗапрос(Знач ОперацияСУБД, Знач ИмяТаблицы = "", Знач ТекстЗапроса = Неопределено) Экспорт

	Событие = СоздатьСобытие("Запрос", ОперацияСУБД);
	Если Событие = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Событие.УстановитьЗапрос(ИмяТаблицы, ТекстЗапроса);
	Разослать("ПередСобытием", Событие);

	Возврат Событие;

КонецФункции

// Завершает событие запроса и рассылает его наблюдателям.
//
// Параметры:
//   Событие - СобытиеСущностей, Неопределено - Событие из НачатьЗапрос. С Неопределено ничего не делает.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершился запрос.
//   КоличествоСтрок - Число, Неопределено - Число строк результата.
//
Процедура ЗавершитьЗапрос(Событие, Знач ИнформацияОбОшибке = Неопределено, Знач КоличествоСтрок = Неопределено) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если КоличествоСтрок <> Неопределено Тогда
		Событие.УстановитьКоличествоСтрок(КоличествоСтрок);
	КонецЕсли;

	ЗавершитьСобытие(Событие, ИнформацияОбОшибке);

КонецПроцедуры

// Начинает событие операции и рассылает его наблюдателям.
//
// Параметры:
//   Операция - Строка - Имя операции.
//   ОбъектМодели - ОбъектМодели, Неопределено - Модель сущности операции.
//
// Возвращаемое значение:
//   СобытиеСущностей - Начатое событие.
//   Неопределено - Наблюдателей нет, событие не создавалось.
//
Функция НачатьОперацию(Знач Операция, Знач ОбъектМодели = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Событие = СоздатьСобытие("Операция", Операция, ТекущаяГлубина());
	ИзменитьГлубину(1);

	Если ОбъектМодели <> Неопределено Тогда
		Событие.УстановитьСущность(ОбъектМодели.ТипСущности(), ОбъектМодели.ИмяТаблицы());
	КонецЕсли;

	Разослать("ПередСобытием", Событие);

	Возврат Событие;

КонецФункции

// Завершает событие операции и рассылает его наблюдателям.
//
// Параметры:
//   Событие - СобытиеСущностей, Неопределено - Событие из НачатьОперацию. С Неопределено ничего не делает.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершилась операция.
//   КоличествоСтрок - Число, Неопределено - Число прочитанных строк.
//
Процедура ЗавершитьОперацию(Событие, Знач ИнформацияОбОшибке = Неопределено, Знач КоличествоСтрок = Неопределено) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзменитьГлубину(-1);

	Если КоличествоСтрок <> Неопределено Тогда
		Событие.УстановитьКоличествоСтрок(КоличествоСтрок);
	КонецЕсли;

	ЗавершитьСобытие(Событие, ИнформацияОбОшибке);

КонецПроцедуры

// Создает событие любого вида, помеченное коннектором пула.
//
// Параметры:
//   Вид - Строка - Вид события.
//   Операция - Строка - Операция события.
//   Глубина - Число - Вложенность.
//
// Возвращаемое значение:
//   СобытиеСущностей - Событие, еще не разосланное.
//   Неопределено - Наблюдателей нет.
//
Функция СоздатьСобытие(Знач Вид, Знач Операция, Знач Глубина = 0) Экспорт

	Если Пусто() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Событие = Новый СобытиеСущностей(Вид, Операция, Глубина);
	Событие.УстановитьКоннектор(ТипКоннектора, ОписаниеСоединения);

	Возврат Событие;

КонецФункции

// Рассылает начало события.
//
// Параметры:
//   Событие - СобытиеСущностей, Неопределено - Событие из СоздатьСобытие.
//
Процедура НачатьСобытие(Событие) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Разослать("ПередСобытием", Событие);

КонецПроцедуры

// Завершает событие и рассылает его завершение.
//
// Параметры:
//   Событие - СобытиеСущностей, Неопределено - Начатое событие.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершилось событие.
//
Процедура ЗавершитьСобытие(Событие, Знач ИнформацияОбОшибке = Неопределено) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Событие.Завершить(ИнформацияОбОшибке);
	Разослать("ПослеСобытия", Событие);

КонецПроцедуры

Процедура Разослать(Знач ИмяМетода, Событие)

	Для Каждого Наблюдатель Из Наблюдатели Цикл

		Попытка
			Если ИмяМетода = "ПередСобытием" Тогда
				Наблюдатель.ПередСобытием(Событие);
			Иначе
				Наблюдатель.ПослеСобытия(Событие);
			КонецЕсли;
		Исключение
			Лог.Предупреждение(
				"Наблюдатель %1 завершился ошибкой в %2 события %3 %4: %5",
				ТипЗнч(Наблюдатель),
				ИмяМетода,
				Событие.Вид(),
				Событие.Операция(),
				ОписаниеОшибки()
			);
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Функция ТекущаяГлубина()

	Глубина = ТекущийПоток().Данные.Получить(КлючГлубины);

	Возврат ?(Глубина = Неопределено, 0, Глубина);

КонецФункции

Процедура ИзменитьГлубину(Знач Приращение)
	ТекущийПоток().Данные.Вставить(КлючГлубины, Макс(ТекущаяГлубина() + Приращение, 0));
КонецПроцедуры

// Определяет, объявляет ли объект интерфейс аннотацией &Реализует на любом своем методе.
//
// Параметры:
//   Объект - Произвольный - Проверяемый объект.
//   ИмяИнтерфейса - Строка - Имя интерфейса.
//
// Возвращаемое значение:
//   Булево - Истина, если объявление найдено.
//
Функция ОбъявляетИнтерфейс(Объект, Знач ИмяИнтерфейса)

	Рефлектор = Новый РефлекторОбъекта(Объект);
	МетодыСАннотацией = Рефлектор.ПолучитьТаблицуМетодов("Реализует", Ложь);

	Для Каждого Метод Из МетодыСАннотацией Цикл
		Аннотации = РаботаСАннотациями.НайтиАннотации(Метод.Аннотации, "Реализует");
		Для Каждого Аннотация Из Аннотации Цикл
			ОбъектАннотации = ОпределениеАннотацииРеализует.СоздатьОбъектАннотации(Аннотация);
			Если ОбъектАннотации.ИмяИнтерфейса() = ИмяИнтерфейса Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьОбъявлениеИнтерфейса(Наблюдатель)

	Если ОбъявляетИнтерфейс(Наблюдатель, "НаблюдательСущностей") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Объект типа <%1> не объявляет интерфейс НаблюдательСущностей: нужна аннотация &Реализует(""НаблюдательСущностей"") на конструкторе",
		ТипЗнч(Наблюдатель)
	);

КонецПроцедуры

// Проверяет, что все методы интерфейса НаблюдательСущностей реализованы, и называет недостающие.
//
// ВалидаторРеализации ту же проверку делает, но об ошибке сообщает общими словами; здесь
// сообщение называет метод, которого не хватает.
//
Процедура ПроверитьРеализациюИнтерфейса(Наблюдатель)

	Интерфейс = Новый ИнтерфейсОбъекта();
	Интерфейс.ИзОбъекта(Тип("НаблюдательСущностей"));

	Рефлектор = Новый РефлекторОбъекта(Наблюдатель);
	Реализация = Рефлектор.РеализованныеМетодыИнтерфейса(Интерфейс);

	Недостающие = Новый Массив;
	Для Каждого КлючИЗначение Из Реализация Цикл
		Если НЕ КлючИЗначение.Значение Тогда
			Недостающие.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Недостающие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Объект типа <%1> не реализует интерфейс НаблюдательСущностей: нет методов %2 или у них другое число параметров",
		ТипЗнч(Наблюдатель),
		СтрСоединить(Недостающие, ", ")
	);

КонецПроцедуры

Функция СистемаПоТипу(Знач ПТипКоннектора)

	ИмяТипа = Строка(ПТипКоннектора);

	Если ИмяТипа = "КоннекторPostgreSQL" Тогда
		Возврат "postgresql";
	ИначеЕсли ИмяТипа = "КоннекторSQLite" Тогда
		Возврат "sqlite";
	ИначеЕсли ИмяТипа = "КоннекторInMemory" Тогда
		Возврат "inmemory";
	ИначеЕсли ИмяТипа = "КоннекторJSON" Тогда
		Возврат "json";
	КонецЕсли;

	Возврат НРег(ИмяТипа);

КонецФункции
