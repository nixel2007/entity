#Использовать annotations
#Использовать reflector
#Использовать extends
#Использовать logos

// ФиксированныйМассив - Зарегистрированные наблюдатели. Меняется целиком: событие при создании
// берет текущий снимок и рассылается ему в обеих фазах, какие бы регистрации ни случились между ними.
// Читается и заменяется только под БлокировкаРеестра.
Перем Наблюдатели;
// БлокировкаРесурса - Защищает Наблюдатели, ОписаниеСоединения и КоннекторНаблюдаем: их читают и
// пишут все потоки, работающие через источник. Под ней не берется ничего и не зовется чужой код:
// ни наблюдатели, ни коннектор, ни журнал.
Перем БлокировкаРеестра;
// Тип - Тип коннектора пула.
Перем ТипКоннектора;
// Структура - Система, Адрес, Порт, БазаДанных: чем и куда подключается пул. Под БлокировкаРеестра.
Перем ОписаниеСоединения;
// Строка - Ключ вложенности операций в данных потока исполнения.
Перем КлючГлубины;
// Строка - Ключ отложенных рассылок в данных потока исполнения.
Перем КлючОтложенных;
// Лог - Журнал наблюдателей.
Перем Лог;
// ВалидаторРеализации - Проверяет реализацию интерфейса при регистрации.
Перем Валидатор;
// ОпределениеАннотации - Определение аннотации &Реализует для чтения имени интерфейса.
Перем ОпределениеАннотацииРеализует;
// Булево - Объявляет ли коннектор пула интерфейс НаблюдаемыйКоннектор. Неопределено - еще не
// проверялось. Под БлокировкаРеестра.
Перем КоннекторНаблюдаем;

// Реестр наблюдателей источника данных.
//
// Один на источник данных: пул соединений общий у менеджера и его хранилищ, поэтому события
// всех операций, запросов, соединений и транзакций идут через один реестр. При пустом реестре
// события не создаются: НачатьОперацию возвращает Неопределено, а Завершить с ним ничего не
// делает.
//
// Исключение наблюдателя пишется в лог и не прерывает операцию: наблюдение не должно ломать
// то, за чем наблюдает.
//
// Параметры:
//   ПТипКоннектора - Тип - Тип коннектора пула.
//
Процедура ПриСозданииОбъекта(Знач ПТипКоннектора)

	Наблюдатели = Новый ФиксированныйМассив(Новый Массив);
	БлокировкаРеестра = Новый БлокировкаРесурса;
	ТипКоннектора = ПТипКоннектора;
	ОписаниеСоединения = СтрокиСоединения.ОписаниеБезСервера(СистемаПоТипу(ПТипКоннектора), "");
	КлючГлубины = "entity.observers." + Строка(Новый УникальныйИдентификатор);
	КлючОтложенных = "entity.observers.deferred." + Строка(Новый УникальныйИдентификатор);
	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.observers");

	КонтейнерАннотаций = Новый КонтейнерАннотаций();
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияРеализует"));
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияИнтерфейс"));
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияРасширяет"));
	ОпределениеАннотацииРеализует = КонтейнерАннотаций.ПолучитьОпределениеАннотации("Реализует");
	Валидатор = Новый ВалидаторРеализации(КонтейнерАннотаций);

КонецПроцедуры

// Регистрирует наблюдателя.
//
// Наблюдатель должен объявить интерфейс аннотацией &Реализует("НаблюдательИсточникаДанных") и
// реализовать его целиком; иначе регистрация завершается ошибкой. Повторная регистрация того
// же объекта ничего не меняет.
//
// Параметры:
//   Наблюдатель - Произвольный - Объект, реализующий НаблюдательИсточникаДанных.
//
Процедура Добавить(Наблюдатель) Экспорт

	ПроверитьОбъявлениеИнтерфейса(Наблюдатель);
	Валидатор.ИнтерфейсыРеализованыКорректно(Наблюдатель);

	// Замена снимка - чтение-изменение-запись: без блокировки две одновременные регистрации
	// построили бы новый снимок из одного старого, и одна из них потерялась бы.
	БлокировкаРеестра.Заблокировать();

	Попытка

		Если Наблюдатели.Найти(Наблюдатель) = Неопределено Тогда
			Новые = Новый Массив(Наблюдатели);
			Новые.Добавить(Наблюдатель);
			Наблюдатели = Новый ФиксированныйМассив(Новые);
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		БлокировкаРеестра.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаРеестра.Разблокировать();

КонецПроцедуры

// Снимает наблюдателя с регистрации.
//
// Параметры:
//   Наблюдатель - Произвольный - Ранее зарегистрированный наблюдатель. Незарегистрированный пропускается.
//
Процедура Удалить(Наблюдатель) Экспорт

	БлокировкаРеестра.Заблокировать();

	Попытка

		Индекс = Наблюдатели.Найти(Наблюдатель);
		Если Индекс <> Неопределено Тогда
			Новые = Новый Массив(Наблюдатели);
			Новые.Удалить(Индекс);
			Наблюдатели = Новый ФиксированныйМассив(Новые);
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		БлокировкаРеестра.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаРеестра.Разблокировать();

КонецПроцедуры

// Определяет, зарегистрирован ли хоть один наблюдатель.
//
// Возвращаемое значение:
//   Булево - Истина, если наблюдателей нет.
//
Функция Пусто() Экспорт
	Возврат Количество() = 0;
КонецФункции

// Число зарегистрированных наблюдателей.
//
// Возвращаемое значение:
//   Число - Количество.
//
Функция Количество() Экспорт

	БлокировкаРеестра.Заблокировать();
	Результат = Наблюдатели.Количество();
	БлокировкаРеестра.Разблокировать();

	Возврат Результат;

КонецФункции

// Описание соединения, которым помечаются события.
//
// Возвращаемое значение:
//   Структура - Система, Адрес, Порт, БазаДанных.
//
Функция ОписаниеСоединения() Экспорт

	БлокировкаРеестра.Заблокировать();
	Результат = ОписаниеСоединения;
	БлокировкаРеестра.Разблокировать();

	Возврат Результат;

КонецФункции

// Запоминает описание соединения, полученное от коннектора.
//
// Параметры:
//   Описание - Структура - Система, Адрес, Порт, БазаДанных.
//
Процедура УстановитьОписаниеСоединения(Знач Описание) Экспорт

	БлокировкаРеестра.Заблокировать();
	ОписаниеСоединения = Описание;
	БлокировкаРеестра.Разблокировать();

КонецПроцедуры

// Подключает к реестру только что открытый коннектор пула.
//
// Коннектор, объявивший интерфейс НаблюдаемыйКоннектор, получает реестр и сообщает описание
// соединения; остальные работают без событий уровня запроса. Объявление проверяется один раз
// на тип коннектора, реализация - валидатором extends.
//
// Ответ запоминается только после успешной проверки: иначе коннектор, объявивший интерфейс и не
// реализовавший его, прошел бы валидатор единожды, а следующие открытия соединения жаловались бы
// на ненайденный метод вместо интерфейса.
//
// Под блокировкой реестра - только чтение и запись признака и описания. Проверка объявления и
// валидатор идут до захвата: два потока могут проверить одновременно, ответ у них один. Вызовы
// коннектора - чужой код - идут вне блокировки.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Открытый коннектор.
//
Процедура ПодключитьКоннектор(Коннектор) Экспорт

	БлокировкаРеестра.Заблокировать();
	Наблюдаем = КоннекторНаблюдаем;
	БлокировкаРеестра.Разблокировать();

	Если Наблюдаем = Неопределено Тогда

		Наблюдаем = ОбъявляетИнтерфейс(Коннектор, "НаблюдаемыйКоннектор");
		Если Наблюдаем Тогда
			Валидатор.ИнтерфейсыРеализованыКорректно(Коннектор);
		КонецЕсли;

		БлокировкаРеестра.Заблокировать();
		КоннекторНаблюдаем = Наблюдаем;
		БлокировкаРеестра.Разблокировать();

	КонецЕсли;

	Если НЕ Наблюдаем Тогда
		Возврат;
	КонецЕсли;

	Коннектор.УстановитьНаблюдателей(ЭтотОбъект);
	УстановитьОписаниеСоединения(Коннектор.ОписаниеСоединения());

КонецПроцедуры

// Начинает событие запроса к СУБД и рассылает его наблюдателям.
//
// Параметры:
//   ОперацияСУБД - Строка - SELECT, INSERT, DELETE, CREATE TABLE, BEGIN, COMMIT, ROLLBACK.
//   ИмяТаблицы - Строка - Таблица запроса; пустая строка, если таблицы нет.
//   ТекстЗапроса - Строка, Неопределено - Текст запроса; Неопределено у коннекторов без SQL.
//
// Возвращаемое значение:
//   СобытиеИсточникаДанных - Начатое событие.
//   Неопределено - Наблюдателей нет, событие не создавалось.
//
Функция НачатьЗапрос(Знач ОперацияСУБД, Знач ИмяТаблицы = "", Знач ТекстЗапроса = Неопределено) Экспорт

	Событие = СоздатьСобытие(ВидыСобытийИсточникаДанных.Запрос(), ОперацияСУБД);
	Если Событие = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Событие.УстановитьЗапрос(ИмяТаблицы, ТекстЗапроса);
	Разослать("ПередСобытием", Событие);

	Возврат Событие;

КонецФункции

// Завершает событие запроса и рассылает его наблюдателям.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных, Неопределено - Событие из НачатьЗапрос. С Неопределено ничего не делает.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершился запрос.
//   КоличествоСтрок - Число, Неопределено - Число строк результата.
//
Процедура ЗавершитьЗапрос(Событие, Знач ИнформацияОбОшибке = Неопределено, Знач КоличествоСтрок = Неопределено) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если КоличествоСтрок <> Неопределено Тогда
		Событие.УстановитьКоличествоСтрок(КоличествоСтрок);
	КонецЕсли;

	ЗавершитьСобытие(Событие, ИнформацияОбОшибке);

КонецПроцедуры

// Начинает событие операции и рассылает его наблюдателям.
//
// Параметры:
//   Операция - Строка - Имя операции.
//   ОбъектМодели - ОбъектМодели, Неопределено - Модель сущности операции.
//
// Возвращаемое значение:
//   СобытиеИсточникаДанных - Начатое событие.
//   Неопределено - Наблюдателей нет, событие не создавалось.
//
Функция НачатьОперацию(Знач Операция, Знач ОбъектМодели = Неопределено) Экспорт

	// Нужно ли событие, решает одна проверка - внутри СоздатьСобытие. Спроси мы отдельно, есть ли
	// наблюдатели, между вопросом и ответом последнего могли бы снять: событие не создалось бы,
	// а глубина уже была бы увеличена, и снять ее было бы некому - ЗавершитьОперацию без события
	// ничего не делает.
	Событие = СоздатьСобытие(ВидыСобытийИсточникаДанных.Операция(), Операция, ТекущаяГлубина());
	Если Событие = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИзменитьГлубину(1);

	Если ОбъектМодели <> Неопределено Тогда
		Событие.УстановитьСущность(ОбъектМодели.ТипСущности(), ОбъектМодели.ИмяТаблицы());
	КонецЕсли;

	Разослать("ПередСобытием", Событие);

	Возврат Событие;

КонецФункции

// Завершает событие операции и рассылает его наблюдателям.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных, Неопределено - Событие из НачатьОперацию. С Неопределено ничего не делает.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершилась операция.
//   КоличествоСтрок - Число, Неопределено - Число прочитанных строк.
//
Процедура ЗавершитьОперацию(Событие, Знач ИнформацияОбОшибке = Неопределено,
	Знач КоличествоСтрок = Неопределено) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзменитьГлубину(-1);

	Если КоличествоСтрок <> Неопределено Тогда
		Событие.УстановитьКоличествоСтрок(КоличествоСтрок);
	КонецЕсли;

	ЗавершитьСобытие(Событие, ИнформацияОбОшибке);

КонецПроцедуры

// Создает событие любого вида, помеченное коннектором пула.
//
// Событие запоминает снимок наблюдателей на момент создания и обеим фазам рассылается ему:
// наблюдатель, снятый между фазами, все равно получает завершение начатого при нем события,
// а добавленный между фазами видит только события, начатые после регистрации.
//
// Параметры:
//   Вид - Строка - Вид события.
//   Операция - Строка - Операция события.
//   Глубина - Число - Вложенность.
//   НачалоСобытия - Число - Момент начала работы в миллисекундах, если она началась раньше, чем
//     стало известно, нужно ли событие вообще. Неопределено - началом считается создание события.
//
// Возвращаемое значение:
//   СобытиеИсточникаДанных - Событие, еще не разосланное.
//   Неопределено - Наблюдателей нет.
//
Функция СоздатьСобытие(Знач Вид, Знач Операция, Знач Глубина = 0, Знач НачалоСобытия = Неопределено) Экспорт

	// Список и описание - одним захватом: событие помечается тем, что было на один момент.
	БлокировкаРеестра.Заблокировать();
	Получатели = Наблюдатели;
	Описание = ОписаниеСоединения;
	БлокировкаРеестра.Разблокировать();

	Если Получатели.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Событие = Новый СобытиеИсточникаДанных(Вид, Операция, Глубина, НачалоСобытия);
	Событие.УстановитьКоннектор(ТипКоннектора, Описание);
	Событие.УстановитьПолучателей(Получатели);

	Возврат Событие;

КонецФункции

// Рассылает начало события.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных, Неопределено - Событие из СоздатьСобытие.
//
Процедура НачатьСобытие(Событие) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Разослать("ПередСобытием", Событие);

КонецПроцедуры

// Завершает событие и рассылает его завершение.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных, Неопределено - Начатое событие.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершилось событие.
//
Процедура ЗавершитьСобытие(Событие, Знач ИнформацияОбОшибке = Неопределено) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Событие, начатое до открытия первого соединения (инициализация и ее захват), создавалось
	// без описания от коннектора; к завершению описание уже известно.
	Событие.УстановитьКоннектор(ТипКоннектора, ОписаниеСоединения());
	Событие.Завершить(ИнформацияОбОшибке);
	Разослать("ПослеСобытия", Событие);

КонецПроцедуры

// Откладывает рассылку событий текущего потока исполнения до РазослатьОтложенное.
//
// Нужно тому, кто держит блокировку: наблюдатель - чужой код, и звать его, не отпустив
// блокировку, нельзя. События, случившиеся под ней, дождутся своей рассылки в порядке
// возникновения, обе фазы каждого события в свой черед.
//
Процедура НачатьОтложеннуюРассылку() Экспорт

	Если ТекущийПоток().Данные.Получить(КлючОтложенных) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущийПоток().Данные.Вставить(КлючОтложенных, Новый Массив);

КонецПроцедуры

// Рассылает то, что накопилось с НачатьОтложеннуюРассылку, и выключает откладывание.
//
// Вызывается сразу после снятия блокировки. Без пары к НачатьОтложеннуюРассылку ничего не делает.
//
// Ключ удаляется до обхода: наблюдатель, которому рассылается событие, может сам работать с
// источником, и его события должны уходить сразу, а не копиться в уже разбираемый список. Каждое
// событие рассылается отдельно и не бросает: сбой на одном не теряет остальные.
//
Процедура РазослатьОтложенное() Экспорт

	Отложенные = ТекущийПоток().Данные.Получить(КлючОтложенных);
	Если Отложенные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущийПоток().Данные.Удалить(КлючОтложенных);

	Для Каждого Рассылка Из Отложенные Цикл
		РазослатьНадежно(Рассылка.ИмяМетода, Рассылка.Событие);
	КонецЦикла;

КонецПроцедуры

// Определяет, откладывается ли сейчас рассылка событий текущего потока исполнения.
//
// Возвращаемое значение:
//   Булево - Истина, если события текущего потока копятся до РазослатьОтложенное.
//
Функция РассылкаОтложена() Экспорт
	Возврат ТекущийПоток().Данные.Получить(КлючОтложенных) <> Неопределено;
КонецФункции

// Рассылает одно событие, не выпуская ошибок: сбой рассылки одного события не должен отменять
// рассылку остальных.
//
// Параметры:
//   ИмяМетода - Строка - ПередСобытием или ПослеСобытия.
//   Событие - СобытиеИсточникаДанных - Событие.
//
Процедура РазослатьНадежно(Знач ИмяМетода, Событие)

	Попытка
		Разослать(ИмяМетода, Событие);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьПредупреждение("Не удалось разослать событие: " + ПодробноеПредставлениеОшибки(Ошибка));
	КонецПопытки;

КонецПроцедуры

Процедура Разослать(Знач ИмяМетода, Событие)

	Отложенные = ТекущийПоток().Данные.Получить(КлючОтложенных);
	Если Отложенные <> Неопределено Тогда
		Отложенные.Добавить(Новый Структура("ИмяМетода, Событие", ИмяМетода, Событие));
		Возврат;
	КонецЕсли;

	Для Каждого Наблюдатель Из Событие.Получатели() Цикл

		// Состояние события у каждого наблюдателя свое: событие должно знать, кому оно сейчас отдано.
		Событие.УстановитьТекущегоНаблюдателя(Наблюдатель);
		Попытка
			Если ИмяМетода = "ПередСобытием" Тогда
				Наблюдатель.ПередСобытием(Событие);
			Иначе
				Наблюдатель.ПослеСобытия(Событие);
			КонецЕсли;
		Исключение
			Ошибка = ИнформацияОбОшибке();
			// Упавший журнал не должен прервать цикл: наблюдатели после упавшего событие получат.
			ЗаписатьПредупреждение(СтрШаблон(
				"Наблюдатель %1 завершился ошибкой в %2 события %3 %4: %5",
				ТипЗнч(Наблюдатель),
				ИмяМетода,
				Событие.Вид(),
				Событие.Операция(),
				Ошибка.Описание
			));
		КонецПопытки;

	КонецЦикла;

	Событие.УстановитьТекущегоНаблюдателя(Неопределено);

КонецПроцедуры

// Пишет предупреждение в журнал, молча глотая сбой самого журнала: запись идет из обработчиков
// сбоев, и упавший журнал не должен ронять обработчик.
//
// Параметры:
//   Сообщение - Строка - Текст предупреждения.
//
Процедура ЗаписатьПредупреждение(Знач Сообщение)

	Попытка
		Лог.Предупреждение(Сообщение);
	Исключение
		// Журнал недоступен: сообщить о сбое больше некуда.
		Возврат;
	КонецПопытки;

КонецПроцедуры

Функция ТекущаяГлубина()

	Глубина = ТекущийПоток().Данные.Получить(КлючГлубины);

	Возврат ?(Глубина = Неопределено, 0, Глубина);

КонецФункции

Процедура ИзменитьГлубину(Знач Приращение)
	ТекущийПоток().Данные.Вставить(КлючГлубины, Макс(ТекущаяГлубина() + Приращение, 0));
КонецПроцедуры

// Определяет, объявляет ли объект интерфейс аннотацией &Реализует на любом своем методе.
//
// Параметры:
//   Объект - Произвольный - Проверяемый объект.
//   ИмяИнтерфейса - Строка - Имя интерфейса.
//
// Возвращаемое значение:
//   Булево - Истина, если объявление найдено.
//
Функция ОбъявляетИнтерфейс(Объект, Знач ИмяИнтерфейса)

	Рефлектор = Новый РефлекторОбъекта(Объект);
	МетодыСАннотацией = Рефлектор.ПолучитьТаблицуМетодов("Реализует", Ложь);

	Для Каждого Метод Из МетодыСАннотацией Цикл
		Аннотации = РаботаСАннотациями.НайтиАннотации(Метод.Аннотации, "Реализует");
		Для Каждого Аннотация Из Аннотации Цикл
			ОбъектАннотации = ОпределениеАннотацииРеализует.СоздатьОбъектАннотации(Аннотация);
			Если ОбъектАннотации.ИмяИнтерфейса() = ИмяИнтерфейса Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьОбъявлениеИнтерфейса(Наблюдатель)

	Если ОбъявляетИнтерфейс(Наблюдатель, "НаблюдательИсточникаДанных") Тогда
		Возврат;
	КонецЕсли;

	ТипНаблюдателя = ТипЗнч(Наблюдатель);
	ВызватьИсключение СтрШаблон(
		"Объект типа <%1> не объявляет интерфейс НаблюдательИсточникаДанных: "
			+ "нужна аннотация &Реализует(""НаблюдательИсточникаДанных"") на конструкторе",
		ТипНаблюдателя
	);

КонецПроцедуры

Функция СистемаПоТипу(Знач ПТипКоннектора)

	ИмяТипа = Строка(ПТипКоннектора);

	Если ИмяТипа = "КоннекторPostgreSQL" Тогда
		Возврат "postgresql";
	ИначеЕсли ИмяТипа = "КоннекторSQLite" Тогда
		Возврат "sqlite";
	ИначеЕсли ИмяТипа = "КоннекторInMemory" Тогда
		Возврат "inmemory";
	ИначеЕсли ИмяТипа = "КоннекторJSON" Тогда
		Возврат "json";
	Иначе
		Возврат НРег(ИмяТипа);
	КонецЕсли;

КонецФункции
