#Использовать logos

// Массив - Свободные соединения стеком: кладется в конец, берется с конца. Первым выдается
// возвращенное последним. Под блокировкой пула.
//
Перем Свободные;

// Число - Сколько потоков исполнения стоит в очереди ожидающих. Под блокировкой пула.
//
Перем Ожидающих;

// БлокировкаРесурса - Блокировка заявки, поставленной в очередь последней; Неопределено - очередь
// еще не ставилась. Следующий вставший ждет на ней. Под блокировкой пула.
//
Перем БлокировкаПоследнейЗаявки;

// Соответствие - Поток исполнения и выданное ему соединение. Под блокировкой пула.
//
Перем СоединенияПотоковИсполнения;

// Соответствие - Поток исполнения и сколько раз он занял соединение, не освободив. Под блокировкой
// пула.
//
Перем ГлубиныЗахвата;

// БлокировкаРесурса - Блокировка пула: защищает все его изменяемое состояние.
//
Перем Блокировка;

// Число - Предел одновременно живущих соединений. Ноль снимает предел.
//
Перем РазмерПула;

// Число - Число занятых мест: открытых соединений и броней. Под блокировкой пула.
//
Перем СозданоСоединений;

// Соответствие - Потоки исполнения, которые прямо сейчас открывают себе соединение. Место в пуле
// за ними уже занято, а самого соединения еще нет: открытие идет вне блокировки. Под блокировкой
// пула.
//
Перем Брони;

// Булево - Признак закрытого пула. Закрытие терминально: новых соединений пул больше не выдает.
// Под блокировкой пула.
//
Перем Закрыт;

// Число - Пауза между опросами пула первым в очереди, в миллисекундах.
//
Перем ПаузаОжидания;

// Число - Предел ожидания соединения в очереди, в миллисекундах.
//
Перем ПределОжидания;

// Тип - Тип класса, реализующего интерфейс коннектора.
//
Перем ТипКоннектора;

// Строка - Строка соединения, с которой открываются коннекторы пула.
//
Перем СтрокаСоединения;

// Массив - Дополнительные параметры коннекторов пула.
//
Перем ПараметрыКоннектора;

// ПотокиИсполнения - Поставщик текущего потока исполнения. Пул спрашивает поток у него, а не у
// глобального контекста: в тестах на его место становится поддельный поставщик.
//
Перем Потоки;

// Лог - Журнал пула. Пишется только вне блокировки пула.
//
Перем Лог;

// НаблюдателиИсточникаДанных - Наблюдатели источника данных: получают события операций,
// запросов, соединений и транзакций, идущих через пул.
//
Перем Наблюдатели;

// Строка - Ключ состояния потока исполнения в этом пуле, см. СостояниеПотока. Свой у каждого пула.
//
Перем КлючСостояния;

// Пул соединений с базой данных.
//
// Через пул идут все обращения к БД. Соединение выдается потоку исполнения на время операции
// или транзакции и не разделяется с другими потоками исполнения: у драйверов СУБД соединение не
// потокобезопасно, и параллельные запросы по одному соединению рвут протокол обмена.
//
// Поток исполнения движок выделяет каждой независимой единице исполнения - основному скрипту,
// каждому фоновому заданию и каждому обрабатываемому запросу веб-сервера. Поток, не освободивший
// соединение сам, возвращает его по событию своего завершения: см. ПриЗавершенииПотокаИсполнения.
//
// Захват реентерабельный. Операция внутри транзакции получает то же соединение, что и сама
// транзакция, поэтому попадает в нее, а не идет мимо. Соединение возвращается в пул, когда
// поток освободил его столько же раз, сколько занимал.
//
// Размер пула - это предел параллельной работы с БД. Когда все места заняты, поток встает в
// очередь ожидающих, и соединения достаются в порядке постановки. Пока очередь не пуста, никто
// не берет соединение или место в обход нее. Нулевой размер снимает предел и отключает постоянно
// живущие соединения: каждый захват открывает соединение, каждое освобождение его закрывает,
// ждать при таком размере некого.
//
// Очередь. Разбудить ждущий поток движок не умеет - единственный механизм синхронизации,
// БлокировкаРесурса, ждет только своего освобождения. Поэтому пул опрашивает первый в очереди, а
// остальные спят: у каждой заявки своя блокировка, ее держит хозяин, пока стоит в очереди, а
// вставший следующим ждет на ней в Заблокировать(). Уходя из очереди, хозяин отпускает ее - и
// следующий становится первым.
//
// Ожидание в очереди ограничено по времени: не дождавшийся поток получает ошибку, а не висит
// бесконечно. Соединение мог не освободить живой поток, а у живого пул его не отбирает.
//
// Свободные соединения лежат стеком: первым выдается то, которое вернули последним. Так рабочий
// набор соединений остается малым, а простаивающие стареют.
//
// Параметры:
//   ПРазмерПула - Число - Предел одновременно живущих соединений. Ноль снимает предел и отключает
//     постоянно живущие соединения.
//   ПТипКоннектора - Тип - Тип класса, реализующего интерфейс коннектора.
//   ПСтрокаСоединения - Строка - Строка соединения с БД.
//   ППараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//   ППределОжидания - Число - Предел ожидания соединения в очереди, в миллисекундах.
//   ППаузаОжидания - Число - Пауза между опросами пула первым в очереди, в миллисекундах.
//   ППотоки - ПотокиИсполнения - Поставщик текущего потока исполнения. По умолчанию настоящий.
//   ПНаблюдатели - НаблюдателиИсточникаДанных - Реестр наблюдателей. По умолчанию новый.
//   ПБлокировка - БлокировкаРесурса - Блокировка пула. По умолчанию новая; задается тестами.
//
Процедура ПриСозданииОбъекта(
	Знач ПРазмерПула,
	Знач ПТипКоннектора,
	Знач ПСтрокаСоединения,
	Знач ППараметрыКоннектора,
	Знач ППределОжидания = 30000,
	Знач ППаузаОжидания = 1,
	Знач ППотоки = Неопределено,
	Знач ПНаблюдатели = Неопределено,
	Знач ПБлокировка = Неопределено
)

	// Отрицательный размер не отвергает ни один захват явно: предел просто никогда не позволяет
	// открыть соединение, и поток исполнения уходит ждать в очередь, где его никто не дождется.
	Если НЕ (ТипЗнч(ПРазмерПула) = Тип("Число") И ПРазмерПула >= 0) Тогда
		ВызватьИсключение СтрШаблон(
			"Размер пула соединений должен быть неотрицательным числом, передано <%1>",
			ПРазмерПула
		);
	КонецЕсли;

	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.pool");

	РазмерПула = ПРазмерПула;
	ТипКоннектора = ПТипКоннектора;
	СтрокаСоединения = ПСтрокаСоединения;
	ПараметрыКоннектора = ППараметрыКоннектора;
	Потоки = ?(ППотоки = Неопределено, Новый ПотокиИсполнения(), ППотоки);
	Наблюдатели = ?(ПНаблюдатели = Неопределено, Новый НаблюдателиИсточникаДанных(ПТипКоннектора), ПНаблюдатели);
	Блокировка = ?(ПБлокировка = Неопределено, Новый БлокировкаРесурса(), ПБлокировка);
	ПаузаОжидания = ППаузаОжидания;
	ПределОжидания = ППределОжидания;
	КлючСостояния = "entity.pool." + Строка(Новый УникальныйИдентификатор);

	Свободные = Новый Массив();
	Ожидающих = 0;
	БлокировкаПоследнейЗаявки = Неопределено;
	СоединенияПотоковИсполнения = Новый Соответствие();
	ГлубиныЗахвата = Новый Соответствие();
	СозданоСоединений = 0;
	Брони = Новый Соответствие();
	Закрыт = Ложь;

КонецПроцедуры

// Возвращает реестр наблюдателей пула.
//
// Возвращаемое значение:
//   НаблюдателиИсточникаДанных - Наблюдатели источника данных, которому принадлежит пул.
//
Функция Наблюдатели() Экспорт
	Возврат Наблюдатели;
КонецФункции

#Область Завершение_потока

// Обрабатывает завершение потока исполнения, который занимал ресурсы пула.
//
// Вызывается движком по событию завершения потока, в самом завершающемся потоке. К этому моменту
// код потока уже отработал, поэтому все, что он не освободил сам, освобождается здесь:
// закрепленное соединение и бронь под еще не открытое. Заявок потока в очереди не бывает:
// настоящий поток не завершается, стоя в очереди.
//
// Объявлен до "Занять()" намеренно: движок разрешает имя обработчика в один проход, и подписка
// на метод, объявленный ниже по модулю, не компилируется.
//
// Вызов через "ДобавитьОбработчик" статический анализ не видит, отсюда подавление диагностики.
//
// BSLLS:UnusedLocalMethod-off
Процедура ПриЗавершенииПотокаИсполнения()

	// Подписчиков у завершения потока столько, сколько пулов и источников его застали, и движок
	// обходит их одним циклом, не перехватывая ошибки обработчиков. Выпусти этот обработчик
	// исключение, и до подписавшихся позже очередь не дойдет: их соединения так и остались бы
	// за завершившимся потоком. Ошибка уходит в лог: поток кончился, и сообщать о ней некому.
	Попытка
		ОсвободитьРесурсыЗавершенногоПотока();
	Исключение
		ЗаписатьОшибку("Не удалось освободить ресурсы завершившегося потока исполнения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры
// BSLLS:UnusedLocalMethod-on

// Возвращает в пул все, что удерживал завершившийся поток исполнения, и публикует освобождение.
//
Процедура ОсвободитьРесурсыЗавершенногоПотока()

	ПотокИсполнения = Потоки.Текущий();
	Состояние = СостояниеПотока();

	// Возврат соединения за умершим потоком - такое же освобождение, как и явное, и начинается
	// оно здесь: см. Освободить.
	НачалоОсвобождения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Конструктор_ИтогУчастка();

	ЗахватитьПул(Состояние);

	Попытка

		Если СоединенияПотоковИсполнения.Получить(ПотокИсполнения) <> Неопределено Тогда
			ОтобратьИВернуть(ПотокИсполнения, Итог);
		КонецЕсли;

		// Поток, завершившийся посреди открытия соединения, свою бронь не снимет, а место в пуле она
		// держит. Само соединение либо не открылось, либо будет закреплено самим открывающим:
		// пропавшую бронь он увидит в ЗакрепитьОткрытое.
		Если Брони.Получить(ПотокИсполнения) <> Неопределено Тогда
			Брони.Удалить(ПотокИсполнения);
			СозданоСоединений = СозданоСоединений - 1;
		КонецЕсли;

		Итог.Снимок = СнимокПула();

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Итог.Снимок = СнимокПула();
		ОтпуститьПул(Состояние);
		ЗаписатьСообщения(Итог);
		ОпубликоватьОсвобождение(Итог, НачалоОсвобождения, Ошибка);
		ВызватьИсключение;
	КонецПопытки;

	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(Итог);

	// Наблюдателям интересно возвращение соединения в пул, а чье оно было - живого потока или
	// умершего - нет: без этого события его захват остался бы без пары.
	ОпубликоватьОсвобождение(Итог, НачалоОсвобождения);

КонецПроцедуры

#КонецОбласти

#Область Захват

// Занимает соединение для текущего потока исполнения.
//
// Захват реентерабельный: поток, уже занявший соединение, получает то же самое, а освобождать
// его нужно столько же раз, сколько занимал.
//
// Если предел пула исчерпан, вызов встает в очередь и ждет, пока соединение освободит другой
// поток исполнения. Соединения достаются в порядке постановки в очередь.
//
// Занять(), завершившийся ошибкой, не оставляет за потоком ни захвата, ни живой брони.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение, закрепленное за текущим потоком исполнения.
//
Функция Занять() Экспорт

	ПотокИсполнения = Потоки.Текущий();

	// Поток исполнения может не дойти до Освободить(): оборваться, забыть освободить или просто
	// закончиться. Подписка снимает с пула обязанность выяснять это опросом - о завершении
	// сообщит сам поток исполнения. Повторная подписка тем же обработчиком ничего не добавляет.
	ДобавитьОбработчик ПотокИсполнения.ПриЗавершении, ПриЗавершенииПотокаИсполнения;

	// Захват начинается здесь, а событие появится ниже: пока пул не отработал под блокировкой,
	// неизвестно даже, нужно ли событие - углубление захвата его не порождает. Время, проведенное
	// на блокировке, входит в захват соединения так же, как ожидание в очереди.
	НачалоЗахвата = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние = СостояниеПотока();

	ИтогЗахвата = Конструктор_ИтогЗахвата();
	БыстрыйУчасток(ПотокИсполнения, Состояние, ИтогЗахвата);

	// Углубление захвата соединения не меняет и наблюдателям не интересно.
	Если ИтогЗахвата.Повторно Тогда
		Возврат ИтогЗахвата.Соединение;
	КонецЕсли;

	Если ИтогЗахвата.Соединение <> Неопределено Тогда
		ОпубликоватьЗахват(ИтогЗахвата, НачалоЗахвата);
		Возврат ИтогЗахвата.Соединение;
	КонецЕсли;

	// Начало события рассылается сразу: поток ничего не держит - ни блокировок, ни брони, - и
	// наблюдатель, работающий с БД через менеджер, делает обычный захват того же потока.
	Событие = Наблюдатели.СоздатьСобытие(ВидыСобытийИсточникаДанных.Соединение(), "Занять", 0, НачалоЗахвата);
	Наблюдатели.НачатьСобытие(Событие);

	// Ошибкой событие завершает только этот обработчик; штатно - код после КонецПопытки.
	Попытка
		ЗанятьМедленно(ПотокИсполнения, Состояние, ИтогЗахвата);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОтменитьНезавершенныйЗахват(ПотокИсполнения, Состояние, ИтогЗахвата);
		ЗавершитьСобытиеЗахвата(Событие, ИтогЗахвата, Ошибка);
		ВызватьИсключение;
	КонецПопытки;

	// Точка невозврата: соединение закреплено, и сбой рассылки захват уже не отменяет.
	ЗавершитьСобытиеЗахвата(Событие, ИтогЗахвата);

	Возврат ИтогЗахвата.Соединение;

КонецФункции

// Быстрый участок захвата: углубление, отказ закрытого пула или свободное соединение, если
// очереди нет. Ничего не нашлось - итог без соединения.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура БыстрыйУчасток(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	ЗахватитьПул(Состояние);

	Попытка

		// Углубление стоит до проверки закрытия: поток, чья транзакция открыта до закрытия пула,
		// должен ее зафиксировать или отменить.
		Если НЕ Углубить(ПотокИсполнения, ИтогЗахвата) Тогда

			ПроверитьЧтоПулНеЗакрыт();

			// При ожидающих никто не берет соединение сам: оно достанется первому в очереди.
			Если Ожидающих = 0 Тогда
				Соединение = ВзятьСвободное(ИтогЗахвата);
				Если Соединение <> Неопределено Тогда
					ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение, ИтогЗахвата);
					ИтогЗахвата.Снимок = СнимокПула();
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОтпуститьПул(Состояние);
		ЗаписатьСообщения(ИтогЗахвата);
		ВызватьИсключение;
	КонецПопытки;

	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(ИтогЗахвата);

КонецПроцедуры

// Медленный путь захвата: медленный участок и, по его исходу, открытие по брони или очередь.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура ЗанятьМедленно(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	Исход = МедленныйУчасток(ПотокИсполнения, Состояние, ИтогЗахвата);

	Если Исход = "Очередь" Тогда
		Исход = Ожидать(ПотокИсполнения, Состояние, ИтогЗахвата);
	КонецЕсли;

	Если Исход = "Бронь" Тогда
		ОткрытьПоБрони(ПотокИсполнения, Состояние, ИтогЗахвата);
	ИначеЕсли Исход = "Закрыт" Тогда
		ВызватьИсключение "Пул соединений закрыт";
	ИначеЕсли Исход = "Срок" Тогда
		ВызватьИсключение СтрШаблон(
			"Поток исполнения не дождался свободного соединения за %1 мс",
			Формат(ПределОжидания, "ЧГ=")
		);
	КонецЕсли;

КонецПроцедуры

// Медленный участок захвата: все, что пул может сделать сразу, иначе постановка в очередь.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
// Возвращаемое значение:
//   Строка - Исход: "Соединение", "Бронь" или "Очередь".
//
Функция МедленныйУчасток(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	ЗахватитьПул(Состояние);

	Попытка

		Исход = "";

		// Соединение мог оставить вложенный захват из наблюдателя начала события - например,
		// открыв транзакцию. Углубление - до проверки закрытия, как и в быстром участке.
		Если Углубить(ПотокИсполнения, ИтогЗахвата) Тогда
			ИтогЗахвата.Снимок = СнимокПула();
			Исход = "Соединение";
		КонецЕсли;

		Если Исход = "" И Закрыт Тогда
			ИтогЗахвата.Снимок = СнимокПула();
			ВызватьИсключение "Пул соединений закрыт";
		КонецЕсли;

		Если Исход = "" Тогда
			// Неубранную бронь потока уже убрал захват; живая бронь и место в очереди здесь
			// невозможны: пока поток их держит, код наблюдателей не исполняется.
			Если Брони.Получить(ПотокИсполнения) <> Неопределено Тогда
				ВызватьИсключение "Поток исполнения уже открывает соединение этого пула";
			КонецЕсли;
			Если Состояние.Этап = ЭтапВОчереди() Тогда
				ВызватьИсключение "Поток исполнения уже ждет соединения этого пула";
			КонецЕсли;
		КонецЕсли;

		Если Исход = "" И Ожидающих = 0 Тогда

			Соединение = ВзятьСвободное(ИтогЗахвата);
			Если Соединение <> Неопределено Тогда
				ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение, ИтогЗахвата);
				ИтогЗахвата.Снимок = СнимокПула();
				Исход = "Соединение";
			ИначеЕсли ВзятьМесто(ПотокИсполнения) Тогда
				Состояние.Этап = ЭтапОткрываетПоБрони();
				ИтогЗахвата.Снимок = СнимокПула();
				Исход = "Бронь";
			КонецЕсли;

		КонецЕсли;

		Если Исход = "" Тогда
			ВстатьВОчередь(Состояние);
			Исход = "Очередь";
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОтпуститьПул(Состояние);
		ЗаписатьСообщения(ИтогЗахвата);
		ВызватьИсключение;
	КонецПопытки;

	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(ИтогЗахвата);

	Возврат Исход;

КонецФункции

// Отменяет то, что захват успел сделать до ошибки: снимает живую бронь, уходит из очереди,
// возвращает закрепленное или углубленное этим вызовом соединение. Вызывающий, получив ошибку,
// Освободить не позовет.
//
// Ничего не бросает: зовется из обработчика ошибки захвата, исходная ошибка важнее.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура ОтменитьНезавершенныйЗахват(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	Попытка

		Если Состояние.Этап = ЭтапВОчереди() Тогда
			ПокинутьОчередьПослеОшибки(Состояние);
		КонецЕсли;

		Если Состояние.Этап = ЭтапОткрываетПоБрони() Тогда
			СнятьБронь(ПотокИсполнения, Состояние, ИтогЗахвата);
		КонецЕсли;

		// Событие освобождения не публикуется: ошибочный захват пары не требует.
		Если ИтогЗахвата.Закреплено Тогда
			ИтогЗахвата.Закреплено = Ложь;
			ОсвободитьБезСобытия(ПотокИсполнения, Состояние);
		КонецЕсли;

	Исключение
		ЗаписатьОшибку("Не удалось отменить незавершенный захват соединения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Углубляет захват, если за потоком уже закреплено соединение. Вызывается под блокировкой пула.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
// Возвращаемое значение:
//   Булево - Истина, если захват углублен.
//
Функция Углубить(Знач ПотокИсполнения, ИтогЗахвата)

	Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
	Если Соединение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ГлубиныЗахвата.Вставить(ПотокИсполнения, ГлубиныЗахвата.Получить(ПотокИсполнения) + 1);
	ИтогЗахвата.Соединение = Соединение;
	ИтогЗахвата.Повторно = Истина;
	ИтогЗахвата.Закреплено = Истина;

	Возврат Истина;

КонецФункции

// Бросает ошибку, если пул закрыт. Вызывается под блокировкой пула.
//
Процедура ПроверитьЧтоПулНеЗакрыт()

	Если Закрыт Тогда
		ВызватьИсключение "Пул соединений закрыт";
	КонецЕсли;

КонецПроцедуры

// Достает пригодное соединение с вершины стека свободных. Непригодные по дороге снимаются с мест
// и закрываются. Вызывается под блокировкой пула.
//
// Параметры:
//   Итог - Структура - Итог участка: сюда пишутся сообщения для журнала.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение, не закрепленное ни за одним потоком исполнения.
//   Неопределено - Свободных пригодных соединений нет.
//
Функция ВзятьСвободное(Итог)

	Пока Свободные.Количество() > 0 Цикл

		Вершина = Свободные.ВГраница();
		Соединение = Свободные[Вершина];
		Свободные.Удалить(Вершина);

		Если ПроверитьПригодность(Соединение, Итог) Тогда
			Возврат Соединение;
		КонецЕсли;

		// Соединение оборвал сервер, пока оно лежало свободным: при возврате в пул оно было еще
		// живым. Место освобождается до закрытия, и новое соединение по нему откроет бронь, уже
		// вне блокировки. Ошибка закрытия вызывающему не нужна: соединение ему не выдавалось.
		СозданоСоединений = СозданоСоединений - 1;
		ЗакрытьВЖурнал(Соединение, Итог);

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Бронирует место под новое соединение, если предел позволяет. Вызывается под блокировкой пула.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
// Возвращаемое значение:
//   Булево - Истина, если место забронировано.
//
Функция ВзятьМесто(Знач ПотокИсполнения)

	Если РазмерПула <> 0 И СозданоСоединений >= РазмерПула Тогда
		Возврат Ложь;
	КонецЕсли;

	Брони.Вставить(ПотокИсполнения, Истина);
	СозданоСоединений = СозданоСоединений + 1;

	Возврат Истина;

КонецФункции

// Закрепляет соединение за потоком исполнения с первой глубиной захвата. Вызывается под
// блокировкой пула.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Соединение - СоединениеСБД - Выданное соединение.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура ЗакрепитьЗаПотокомИсполнения(Знач ПотокИсполнения, Соединение, ИтогЗахвата)

	СоединенияПотоковИсполнения.Вставить(ПотокИсполнения, Соединение);
	ГлубиныЗахвата.Вставить(ПотокИсполнения, 1);
	ИтогЗахвата.Соединение = Соединение;
	ИтогЗахвата.Закреплено = Истина;

КонецПроцедуры

#КонецОбласти

#Область Очередь

// Ставит поток в очередь ожидающих. Вызывается под блокировкой пула.
//
// Блокировка новой заявки захватывается здесь, под блокировкой пула, - до того, как ее кто-то
// увидит: свободна она по построению. Публикация - замена БлокировкаПоследнейЗаявки - последний
// шаг; сбой до нее откатывает сделанное.
//
// Параметры:
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//
Процедура ВстатьВОчередь(Состояние)

	Заявка = Конструктор_Заявка();
	Заявка.Блокировка.Заблокировать();

	СчетчикУвеличен = Ложь;

	Попытка

		Заявка.Предшественник = БлокировкаПоследнейЗаявки;
		Ожидающих = Ожидающих + 1;
		СчетчикУвеличен = Истина;
		Состояние.Заявка = Заявка;
		Состояние.Этап = ЭтапВОчереди();
		БлокировкаПоследнейЗаявки = Заявка.Блокировка;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если СчетчикУвеличен Тогда
			Ожидающих = Ожидающих - 1;
		КонецЕсли;
		Состояние.Заявка = Неопределено;
		Состояние.Этап = ЭтапВне();
		Заявка.Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Ждет своей очереди и опрашивает пул, став первым.
//
// Поток держит блокировку своей заявки и откладывание рассылки: код наблюдателей не исполняется.
// Исходы участков - значения, а не ошибки: ошибки ожидания бросает вызывающий, уже уйдя из
// очереди.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
// Возвращаемое значение:
//   Строка - Исход: "Соединение", "Бронь", "Закрыт" или "Срок".
//
Функция Ожидать(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	Заявка = Состояние.Заявка;

	Попытка

		ПройтиПредшественника(Заявка);

		Исход = Неопределено;
		Пока Истина Цикл

			Исход = ОпроситьПул(ПотокИсполнения, Состояние, ИтогЗахвата);
			Если Исход <> Неопределено Тогда
				Прервать;
			КонецЕсли;

			Приостановить(ПаузаОжидания);

		КонецЦикла;

		ИтогЗахвата.Ожидание = ТекущаяУниверсальнаяДатаВМиллисекундах() - Заявка.Начало;
		УйтиИзОчереди(Состояние, Исход);

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ИтогЗахвата.Ожидание = ТекущаяУниверсальнаяДатаВМиллисекундах() - Заявка.Начало;
		ПокинутьОчередьПослеОшибки(Состояние);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Исход;

КонецФункции

// Проходит блокировку заявки предшественника: захватывает и сразу отпускает. Вернувшись, поток -
// первый в очереди. Вызывается вне блокировки пула.
//
// Параметры:
//   Заявка - Структура - Своя заявка, см. Конструктор_Заявка.
//
Процедура ПройтиПредшественника(Заявка)

	Если Заявка.ПредшественникПройден Тогда
		Возврат;
	КонецЕсли;

	Если Заявка.Предшественник <> Неопределено Тогда
		Заявка.Предшественник.Заблокировать();
		Заявка.Предшественник.Разблокировать();
	КонецЕсли;
	Заявка.ПредшественникПройден = Истина;

КонецПроцедуры

// Один опрос пула первым в очереди. Выход без рассылки: поток в очереди.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
// Возвращаемое значение:
//   Строка - Исход: "Соединение", "Бронь", "Закрыт", "Срок".
//   Неопределено - Ждать дальше.
//
Функция ОпроситьПул(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	Заявка = Состояние.Заявка;

	ЗахватитьПул(Состояние);

	Попытка

		Исход = Неопределено;

		Если Закрыт Тогда
			Исход = "Закрыт";
		Иначе
			Соединение = ВзятьСвободное(ИтогЗахвата);
			Если Соединение <> Неопределено Тогда
				ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение, ИтогЗахвата);
				Исход = "Соединение";
			ИначеЕсли ВзятьМесто(ПотокИсполнения) Тогда
				Исход = "Бронь";
			ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() >= Заявка.КрайнийСрок Тогда
				Исход = "Срок";
			КонецЕсли;
		КонецЕсли;

		Если Исход <> Неопределено Тогда
			Ожидающих = Ожидающих - 1;
			Заявка.СчетчикУменьшен = Истина;
			ИтогЗахвата.Снимок = СнимокПула();
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОтпуститьПул(Состояние);
		ЗаписатьСообщения(ИтогЗахвата);
		ВызватьИсключение;
	КонецПопытки;

	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(ИтогЗахвата);

	Возврат Исход;

КонецФункции

// Уходит из очереди по исходу: проходит предшественника, если еще не прошел, отпускает свою
// заявку - следующий становится первым. При исходе "Бронь" поток идет открывать соединение,
// иначе рассылает отложенное.
//
// Каждое действие делается только раз: признаки заявки ставятся сразу после действия.
//
// Параметры:
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   Исход - Строка, Неопределено - Исход ожидания; Неопределено - уход после ошибки.
//
Процедура УйтиИзОчереди(Состояние, Знач Исход)

	Заявка = Состояние.Заявка;

	// Свою заявку отпускает только прошедший предшественника: иначе первыми в очереди оказались
	// бы двое.
	ПройтиПредшественника(Заявка);

	Если НЕ Заявка.СвояСнята Тогда
		Заявка.Блокировка.Разблокировать();
		Заявка.СвояСнята = Истина;
	КонецЕсли;

	Состояние.Заявка = Неопределено;

	Если Исход = "Бронь" Тогда
		Состояние.Этап = ЭтапОткрываетПоБрони();
	Иначе
		Состояние.Этап = ЭтапВне();
		Наблюдатели.РазослатьОтложенное();
	КонецЕсли;

КонецПроцедуры

// Уходит из очереди после ошибки ожидания: уменьшает счетчик ожидающих, если он еще не уменьшен,
// и уходит. Не сумев взять блокировку пула, помечает счетчик неуменьшенным - его уменьшит
// следующий захват этого потока.
//
// Параметры:
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//
Процедура ПокинутьОчередьПослеОшибки(Состояние)

	Заявка = Состояние.Заявка;

	Если НЕ Заявка.СчетчикУменьшен Тогда

		Захвачен = Ложь;
		Попытка
			ЗахватитьПул(Состояние);
			Захвачен = Истина;
		Исключение
			Состояние.НеуменьшенСчетчик = Истина;
			Заявка.СчетчикУменьшен = Истина;
			ЗаписатьОшибку("Не удалось уменьшить счетчик ожидающих, его уменьшит следующий захват: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если Захвачен Тогда
			ОшибкаУменьшения = Неопределено;
			Попытка
				УменьшитьСчетчикОжидающих(Заявка);
			Исключение
				ОшибкаУменьшения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
			// Поток еще в очереди: выход без рассылки.
			ОтпуститьПул(Состояние);
			Если ОшибкаУменьшения <> Неопределено Тогда
				ЗаписатьОшибку("Не удалось уменьшить счетчик ожидающих: " + ОшибкаУменьшения);
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	УйтиИзОчереди(Состояние, Неопределено);

КонецПроцедуры

// Уменьшает счетчик ожидающих за свою заявку. Вызывается под блокировкой пула.
//
// Параметры:
//   Заявка - Структура - Своя заявка, см. Конструктор_Заявка.
//
Процедура УменьшитьСчетчикОжидающих(Заявка)

	Ожидающих = Ожидающих - 1;
	Заявка.СчетчикУменьшен = Истина;

КонецПроцедуры

#КонецОбласти

#Область Бронь

// Открывает соединение по брони и закрепляет его за потоком исполнения.
//
// Открытие идет БЕЗ блокировки пула: это сетевой вызов, и его длительность не должна ничего
// останавливать. Место в пуле на это время держит бронь. Рассылка событий отложена до
// закрепления: наблюдатель, работающий с БД на событии коннектора, иначе взял бы вторую бронь.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура ОткрытьПоБрони(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	НачалоОткрытия = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Соединение = Новый СоединениеСБД(ТипКоннектора, СтрокаСоединения, ПараметрыКоннектора, Наблюдатели);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		СнятьБронь(ПотокИсполнения, Состояние, ИтогЗахвата);
		ВызватьИсключение;
	КонецПопытки;

	ИтогЗахвата.Открыто = Истина;
	ИтогЗахвата.ВремяОткрытия = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОткрытия;

	ЗакрепитьОткрытое(ПотокИсполнения, Состояние, Соединение, ИтогЗахвата);

КонецПроцедуры

// Снимает бронь, не открыв по ней соединения, и возвращает место в пул. Не бросает: зовется,
// когда исходная ошибка уже есть. Не сумев взять блокировку пула, помечает бронь неубранной - ее
// уберет следующий захват этого потока.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура СнятьБронь(Знач ПотокИсполнения, Состояние, ИтогЗахвата)

	Попытка
		ЗахватитьПул(Состояние);
	Исключение
		Состояние.НеубранаБронь = ПотокИсполнения;
		Состояние.Этап = ЭтапВне();
		Наблюдатели.РазослатьОтложенное();
		ЗаписатьОшибку("Не удалось снять бронь, ее снимет следующий захват: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		// Бронь могли убрать закрытие пула или обработчик завершения потока: место за нее уже
		// вернули.
		Если Брони.Получить(ПотокИсполнения) <> Неопределено Тогда
			Брони.Удалить(ПотокИсполнения);
			СозданоСоединений = СозданоСоединений - 1;
		КонецЕсли;
		ИтогЗахвата.Снимок = СнимокПула();
	Исключение
		ЗаписатьОшибку("Не удалось снять бронь: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Состояние.Этап = ЭтапВне();
	ОтпуститьПул(Состояние);

КонецПроцедуры

// Закрепляет за потоком исполнения соединение, открытое по брони.
//
// Проверки строго по порядку. Закрытый пул - отказ: соединение закрывается, бронь закрытие пула
// уже убрало и место за нее вернуло. Бронь есть - она убирается, соединение закрепляется. Брони
// нет - ее снял обработчик завершения потока (поддельного, в тестах): место занимается заново.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//   Соединение - СоединениеСБД - Только что открытое соединение.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//
Процедура ЗакрепитьОткрытое(Знач ПотокИсполнения, Состояние, Соединение, ИтогЗахвата)

	Попытка
		ЗахватитьПул(Состояние);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗакрытьВЖурнал(Соединение, ИтогЗахвата);
		Состояние.НеубранаБронь = ПотокИсполнения;
		Состояние.Этап = ЭтапВне();
		Наблюдатели.РазослатьОтложенное();
		ЗаписатьСообщения(ИтогЗахвата);
		ВызватьИсключение;
	КонецПопытки;

	ПулЗакрыт = Ложь;

	Попытка

		Если Закрыт Тогда
			ПулЗакрыт = Истина;
			Соединение.ЗакрытьНадежно();
		ИначеЕсли Брони.Получить(ПотокИсполнения) <> Неопределено Тогда
			Брони.Удалить(ПотокИсполнения);
			ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение, ИтогЗахвата);
		Иначе
			СозданоСоединений = СозданоСоединений + 1;
			ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение, ИтогЗахвата);
		КонецЕсли;

		ИтогЗахвата.Снимок = СнимокПула();
		Состояние.Этап = ЭтапВне();

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Состояние.Этап = ЭтапВне();
		ОтпуститьПул(Состояние);
		ЗаписатьСообщения(ИтогЗахвата);
		ВызватьИсключение;
	КонецПопытки;

	// Соединение закреплено: вложенный захват из наблюдателя реентерабелен, рассылать можно.
	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(ИтогЗахвата);

	Если ПулЗакрыт Тогда
		ВызватьИсключение "Пул соединений закрыт, пока открывалось соединение";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Освобождение

// Освобождает соединение текущего потока исполнения.
//
// Соединение возвращается в пул только после того, как поток освободил его столько же раз,
// сколько занимал. Освобождение без захвата ничего не делает.
//
Процедура Освободить() Экспорт

	ПотокИсполнения = Потоки.Текущий();
	Состояние = СостояниеПотока();

	// Как и захват, освобождение начинается до блокировки: под ней идет и возврат соединения,
	// и закрытие непригодного - обращение к СУБД. Нужно ли событие, известно только после,
	// поэтому оно создается ниже, но с этим моментом начала.
	НачалоОсвобождения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Конструктор_ИтогУчастка();

	ЗахватитьПул(Состояние);

	Попытка
		ОсвободитьЗахват(ПотокИсполнения, Итог);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Итог.Снимок = СнимокПула();
		ОтпуститьПул(Состояние);
		ЗаписатьСообщения(Итог);
		// Соединение к этому моменту могло быть уже отобрано у потока: упасть возврат может и
		// на закрытии непригодного соединения, когда пулу оно больше не принадлежит.
		ОпубликоватьОсвобождение(Итог, НачалоОсвобождения, Ошибка);
		ВызватьИсключение;
	КонецПопытки;

	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(Итог);

	// Наблюдателям интересно возвращение соединения в пул, а не снятие одного уровня захвата.
	ОпубликоватьОсвобождение(Итог, НачалоОсвобождения);

КонецПроцедуры

// Возвращает захват без события освобождения: для отмены захвата, завершенного ошибкой. Не
// бросает.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//
Процедура ОсвободитьБезСобытия(Знач ПотокИсполнения, Состояние)

	Итог = Конструктор_ИтогУчастка();

	Попытка
		ЗахватитьПул(Состояние);
	Исключение
		ЗаписатьОшибку("Не удалось вернуть захват соединения: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		ОсвободитьЗахват(ПотокИсполнения, Итог);
	Исключение
		Итог.Сообщения.Добавить("Не удалось вернуть захват соединения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ОтпуститьПул(Состояние);
	ЗаписатьСообщения(Итог);

КонецПроцедуры

// Уменьшает глубину захвата и возвращает соединение в пул, когда она дошла до нуля.
// Вызывается под блокировкой пула.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Итог - Структура - См. Конструктор_ИтогУчастка.
//
Процедура ОсвободитьЗахват(Знач ПотокИсполнения, Итог)

	Глубина = ГлубиныЗахвата.Получить(ПотокИсполнения);
	Если Глубина = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Глубина = Глубина - 1;
	Если Глубина > 0 Тогда
		ГлубиныЗахвата.Вставить(ПотокИсполнения, Глубина);
		Возврат;
	КонецЕсли;

	// Начатую транзакцию соединение переживает: она принадлежит потоку и держит соединение за
	// ним до фиксации или отмены, сколько бы операций между ними ни прошло. Иначе завершение
	// транзакции пришлось бы считать захватом, а повторное начало оставляло бы лишний.
	//
	// Непригодное соединение так не держится: транзакция на нем все равно потеряна. Если же
	// драйвер не может ответить, пригодно ли соединение, оно остается за потоком: следующая
	// операция или фиксация на нем покажет его настоящее состояние. Освобождение при этом не
	// бросает - иначе глубина осталась бы ненулевой, а соединение за потоком навсегда.
	Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
	Если Соединение.ВТранзакции() Тогда
		ГлубиныЗахвата.Вставить(ПотокИсполнения, 0);
		Если ПроверитьПригодность(Соединение, Итог, Истина) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОтобратьИВернуть(ПотокИсполнения, Итог);
	Итог.Снимок = СнимокПула();

КонецПроцедуры

// Отбирает соединение у потока исполнения и возвращает его. Вызывается под блокировкой пула.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Итог - Структура - См. Конструктор_ИтогУчастка.
//
Процедура ОтобратьИВернуть(Знач ПотокИсполнения, Итог)

	Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);

	ГлубиныЗахвата.Удалить(ПотокИсполнения);
	СоединенияПотоковИсполнения.Удалить(ПотокИсполнения);

	// Соединение у потока исполнения отобрано, и дальше оно ему не вернется: для наблюдателей
	// освобождение состоялось. Отметка стоит до возврата в пул, потому что возврат закрывает
	// непригодное соединение и вместе с закрытием может упасть.
	Итог.Возвращено = Истина;

	ВернутьОтобранное(Соединение, Итог);

КонецПроцедуры

// Возвращает отобранное соединение в свободные либо закрывает его. Вызывается под блокировкой
// пула.
//
// Место возвращается до закрытия: соединение уже отобрано у потока исполнения и пулу больше не
// видно, поэтому упади закрытие после уменьшения счетчика - место так и осталось бы занятым
// соединением, которого нет. Ошибка закрытия уходит вызывающему.
//
// Параметры:
//   Соединение - СоединениеСБД - Отобранное соединение.
//   Итог - Структура - См. Конструктор_ИтогУчастка.
//
Процедура ВернутьОтобранное(Соединение, Итог)

	// Возврат откатывает транзакцию, которую поток исполнения не завершил сам, и о пригодности
	// соединения до этого судить рано: неудачный откат делает соединение непригодным.
	Соединение.ОтметитьВозврат();

	// Закрытый пул соединения не держит: их закрывают владельцы, возвращая. Пул без предела не
	// держит тоже.
	Если Закрыт ИЛИ РазмерПула = 0 ИЛИ НЕ ПроверитьПригодность(Соединение, Итог) Тогда
		СозданоСоединений = СозданоСоединений - 1;
		Соединение.ЗакрытьНадежно();
		Возврат;
	КонецЕсли;

	Свободные.Добавить(Соединение);

КонецПроцедуры

#КонецОбласти

#Область Состояние_и_закрытие

// Возвращает соединение, занятое текущим потоком исполнения.
//
// Глубину захвата не меняет, поэтому подходит для завершения транзакции: соединение нужно
// освободить ровно один раз, парно к его захвату.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение текущего потока исполнения.
//   Неопределено - Текущий поток исполнения соединения не занимал.
//
Функция СоединениеТекущегоПотокаИсполнения() Экспорт

	ПотокИсполнения = Потоки.Текущий();

	Блокировка.Заблокировать();
	Результат = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Определяет, занято ли соединение текущим потоком исполнения.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение занято и еще не освобождено.
//
Функция ЕстьСоединениеТекущегоПотокаИсполнения() Экспорт
	Возврат СоединениеТекущегоПотокаИсполнения() <> Неопределено;
КонецФункции

// Возвращает число соединений, занятых потоками исполнения.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество занятых соединений.
//
Функция КоличествоЗанятых() Экспорт

	Блокировка.Заблокировать();
	Результат = СоединенияПотоковИсполнения.Количество();
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число свободных соединений.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество свободных соединений.
//
Функция КоличествоСвободных() Экспорт

	Блокировка.Заблокировать();
	Результат = Свободные.Количество();
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число занятых пулом мест: открытых соединений и броней под те, что открываются
// прямо сейчас.
//
// Предназначено для диагностики и проверок: именно это число сравнивается с размером пула,
// и именно оно протекает, если неудачное открытие не вернет свое место.
//
// Возвращаемое значение:
//   Число - Количество занятых мест в пуле.
//
Функция КоличествоСозданных() Экспорт

	Блокировка.Заблокировать();
	Результат = СозданоСоединений;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число потоков исполнения, стоящих в очереди за соединением.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество ожидающих.
//
Функция КоличествоОжидающих() Экспорт

	Блокировка.Заблокировать();
	Результат = Ожидающих;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Закрывает пул.
//
// Закрываются соединение закрывающего потока, свободные соединения и брони. Соединения, занятые
// другими потоками, закрывающий не трогает: ими прямо сейчас пользуется владелец, и закрыть их из
// чужого потока значило бы работать с соединением и драйвером параллельно с ним. Их закрывает сам
// владелец, возвращая: освобождение и завершение потока у закрытого пула закрывают соединение
// вместо возврата.
//
// Закрытие терминально: после него пул новых соединений не выдает. Углубить захват уже
// закрепленного соединения поток может - иначе владелец транзакции, открытой до закрытия, не смог
// бы ее ни зафиксировать, ни отменить. Стоящие в очереди уходят с ошибкой по одному.
//
Процедура Закрыть() Экспорт

	ПотокИсполнения = Потоки.Текущий();
	Состояние = СостояниеПотока();

	ЗахватитьПул(Состояние);

	Попытка

		// Соединение выбывает со своего места после того, как закрыто, и тут же возвращает пулу
		// занятое им место. Споткнись закрытие, оно остается там, где лежало: его состояние
		// неизвестно, и повтор должен попробовать снова.
		Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
		Если Соединение <> Неопределено Тогда
			Соединение.ЗакрытьНадежно();
			СоединенияПотоковИсполнения.Удалить(ПотокИсполнения);
			ГлубиныЗахвата.Удалить(ПотокИсполнения);
			СозданоСоединений = СозданоСоединений - 1;
		КонецЕсли;

		Пока Свободные.Количество() > 0 Цикл
			Вершина = Свободные.ВГраница();
			Свободные[Вершина].ЗакрытьНадежно();
			Свободные.Удалить(Вершина);
			СозданоСоединений = СозданоСоединений - 1;
		КонецЦикла;

		// По убранной броне открывающий поток поймет, что пул закрыт, и закроет свое соединение
		// сам - здесь его еще нет. Место за бронь возвращается сейчас.
		Для Каждого КлючИЗначение Из Брони Цикл
			СозданоСоединений = СозданоСоединений - 1;
		КонецЦикла;
		Брони.Очистить();

		Закрыт = Истина;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОтпуститьПул(Состояние);
		ВызватьИсключение;
	КонецПопытки;

	ОтпуститьПул(Состояние);

КонецПроцедуры

#КонецОбласти

#Область Участки

// Захватывает блокировку пула для участка. Откладывает рассылку событий: под блокировкой пула
// наблюдатели - чужой код - не исполняются.
//
// Перед захватом поток проверяет, что не вызван из-под своей же блокировки, и лечит утекшее
// откладывание. После захвата - уборка того, что не удалось сделать прежним участкам этого
// потока из-за отказа захвата: неуменьшенный счетчик ожидающих, неубранная бронь.
//
// Упал сам захват - откладывание остается таким, каким было бы после участка на этом этапе.
//
// Параметры:
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//
Процедура ЗахватитьПул(Состояние)

	Если Состояние.ВУчастке Тогда
		ВызватьИсключение "Пул соединений вызван из-под своей блокировки";
	КонецЕсли;

	Если Состояние.Этап = ЭтапВне() И Наблюдатели.РассылкаОтложена() Тогда
		// Откладывание включено, а поток ничего не держит - его забыл выключить сбой.
		Наблюдатели.РазослатьОтложенное();
		ЗаписатьОшибку("Рассылка событий пула осталась отложенной; отложенное разослано");
	КонецЕсли;

	Наблюдатели.НачатьОтложеннуюРассылку();

	Попытка
		Блокировка.Заблокировать();
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если Состояние.Этап = ЭтапВне() Тогда
			Наблюдатели.РазослатьОтложенное();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Попытка

		Состояние.ВУчастке = Истина;

		Если Состояние.НеуменьшенСчетчик Тогда
			Ожидающих = Ожидающих - 1;
			Состояние.НеуменьшенСчетчик = Ложь;
		КонецЕсли;

		Если Состояние.НеубранаБронь <> Неопределено Тогда
			Если Брони.Получить(Состояние.НеубранаБронь) <> Неопределено Тогда
				Брони.Удалить(Состояние.НеубранаБронь);
				СозданоСоединений = СозданоСоединений - 1;
			КонецЕсли;
			Состояние.НеубранаБронь = Неопределено;
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		ОтпуститьПул(Состояние);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Снимает блокировку пула. Если поток после участка ничего не держит - ни места в очереди, ни
// незакрепленной брони, - рассылает отложенное: вложенный захват из наблюдателя тогда либо
// реентерабелен, либо обычный. Иначе откладывание остается.
//
// Параметры:
//   Состояние - Структура - Состояние потока в пуле, см. СостояниеПотока.
//
Процедура ОтпуститьПул(Состояние)

	Состояние.ВУчастке = Ложь;
	Блокировка.Разблокировать();

	Если Состояние.Этап = ЭтапВне() Тогда
		Наблюдатели.РазослатьОтложенное();
	КонецЕсли;

КонецПроцедуры

// Состояние текущего потока исполнения в этом пуле. Хранится в данных потока исполнения: пишет и
// читает его только сам поток, блокировка не нужна.
//
// Возвращаемое значение:
//   Структура - Состояние:
//     * Этап - Строка - Вне, ВОчереди или ОткрываетПоБрони.
//     * ВУчастке - Булево - Поток держит блокировку пула.
//     * Заявка - Структура, Неопределено - Своя заявка, пока поток в очереди.
//     * НеуменьшенСчетчик - Булево - Уход из очереди не смог уменьшить счетчик ожидающих.
//     * НеубранаБронь - ПотокИсполнения, Неопределено - Чью бронь не удалось убрать.
//
Функция СостояниеПотока()

	Данные = ТекущийПоток().Данные;
	Состояние = Данные.Получить(КлючСостояния);

	Если Состояние = Неопределено Тогда
		Состояние = Новый Структура;
		Состояние.Вставить("Этап", ЭтапВне());
		Состояние.Вставить("ВУчастке", Ложь);
		Состояние.Вставить("Заявка", Неопределено);
		Состояние.Вставить("НеуменьшенСчетчик", Ложь);
		Состояние.Вставить("НеубранаБронь", Неопределено);
		Данные.Вставить(КлючСостояния, Состояние);
	КонецЕсли;

	Возврат Состояние;

КонецФункции

Функция ЭтапВне()
	Возврат "Вне";
КонецФункции

Функция ЭтапВОчереди()
	Возврат "ВОчереди";
КонецФункции

Функция ЭтапОткрываетПоБрони()
	Возврат "ОткрываетПоБрони";
КонецФункции

// Проверяет пригодность соединения, не выпуская исключения драйвера. Вызывается под блокировкой
// пула; сообщение о сбое уходит в итог участка и пишется в журнал после снятия блокировки.
//
// Параметры:
//   Соединение - СоединениеСБД - Проверяемое соединение.
//   Итог - Структура - Итог участка.
//   ПриСбое - Булево - Что считать ответом, если проверка бросила исключение.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение пригодно.
//
Функция ПроверитьПригодность(Соединение, Итог, Знач ПриСбое = Ложь)

	Попытка
		Возврат Соединение.Пригодно();
	Исключение
		Итог.Сообщения.Добавить("Проверка пригодности соединения завершилась ошибкой: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ПриСбое;

КонецФункции

// Закрывает соединение, отправляя ошибку закрытия в итог участка, а не вызывающему.
//
// Параметры:
//   Соединение - СоединениеСБД - Закрываемое соединение.
//   Итог - Структура - Итог участка.
//
Процедура ЗакрытьВЖурнал(Соединение, Итог)

	Попытка
		Соединение.ЗакрытьНадежно();
	Исключение
		Итог.Сообщения.Добавить("Не удалось закрыть непригодное соединение: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Снимок пула для события. Вызывается под блокировкой пула - в том участке, где пул последний раз
// менялся, - поэтому значения согласованы между собой.
//
// Возвращаемое значение:
//   Структура - Занято, Свободно, Ожидает, Предел.
//
Функция СнимокПула()

	Снимок = Новый Структура;
	Снимок.Вставить("Занято", СоединенияПотоковИсполнения.Количество());
	Снимок.Вставить("Свободно", Свободные.Количество());
	Снимок.Вставить("Ожидает", Ожидающих);
	Снимок.Вставить("Предел", РазмерПула);

	Возврат Снимок;

КонецФункции

#КонецОбласти

#Область События_и_журнал

// Публикует событие захвата, случившегося на быстром участке. Не бросает: соединение уже
// закреплено.
//
// Параметры:
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//   НачалоЗахвата - Число - Универсальная дата входа в пул в миллисекундах.
//
Процедура ОпубликоватьЗахват(ИтогЗахвата, Знач НачалоЗахвата)

	Попытка
		Событие = Наблюдатели.СоздатьСобытие(ВидыСобытийИсточникаДанных.Соединение(), "Занять", 0, НачалоЗахвата);
		Наблюдатели.НачатьСобытие(Событие);
	Исключение
		ЗаписатьОшибку("Не удалось разослать событие захвата соединения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗавершитьСобытиеЗахвата(Событие, ИтогЗахвата);

КонецПроцедуры

// Завершает событие захвата данными захвата и снимком пула. Не бросает.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных, Неопределено - Событие захвата.
//   ИтогЗахвата - Структура - См. Конструктор_ИтогЗахвата.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка захвата.
//
Процедура ЗавершитьСобытиеЗахвата(Событие, ИтогЗахвата, Знач ИнформацияОбОшибке = Неопределено)

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Событие.УстановитьДанныеЗахвата(ИтогЗахвата.Ожидание, ИтогЗахвата.Открыто, ИтогЗахвата.ВремяОткрытия);
		УстановитьСнимок(Событие, ИтогЗахвата.Снимок);
		Наблюдатели.ЗавершитьСобытие(Событие, ИнформацияОбОшибке);
	Исключение
		ЗаписатьОшибку("Не удалось разослать завершение захвата соединения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Рассылает наблюдателям событие освобождения соединения, если оно состоялось. Не бросает:
// соединение уже вернулось в пул, и ошибка рассылки сказала бы вызывающему обратное.
//
// Параметры:
//   Итог - Структура - См. Конструктор_ИтогУчастка.
//   НачалоОсвобождения - Число - Универсальная дата входа в пул в миллисекундах.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка возврата, обычно неудачного
//     закрытия непригодного соединения.
//
Процедура ОпубликоватьОсвобождение(Итог, Знач НачалоОсвобождения, Знач ИнформацияОбОшибке = Неопределено)

	Если НЕ Итог.Возвращено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Событие = Наблюдатели.СоздатьСобытие(
			ВидыСобытийИсточникаДанных.Соединение(), "Освободить", 0, НачалоОсвобождения);
		Если Событие <> Неопределено Тогда
			Наблюдатели.НачатьСобытие(Событие);
			УстановитьСнимок(Событие, Итог.Снимок);
			Наблюдатели.ЗавершитьСобытие(Событие, ИнформацияОбОшибке);
		КонецЕсли;
	Исключение
		ЗаписатьОшибку("Не удалось разослать событие освобождения соединения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Кладет снимок пула в событие, если снимок есть.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных - Событие.
//   Снимок - Структура, Неопределено - Снимок, см. СнимокПула.
//
Процедура УстановитьСнимок(Событие, Снимок)

	Если Снимок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Событие.УстановитьСнимокПула(Снимок.Занято, Снимок.Свободно, Снимок.Ожидает, Снимок.Предел);

КонецПроцедуры

// Пишет в журнал сообщения, накопленные участком под блокировкой. Вызывается после ее снятия.
//
// Параметры:
//   Итог - Структура - Итог участка с массивом Сообщения.
//
Процедура ЗаписатьСообщения(Итог)

	Для Каждого Сообщение Из Итог.Сообщения Цикл
		ЗаписатьОшибку(Сообщение);
	КонецЦикла;
	Итог.Сообщения.Очистить();

КонецПроцедуры

// Пишет ошибку в журнал, молча глотая сбой самого журнала: запись идет из обработчиков сбоев, и
// упавший журнал не должен ронять ни обработчик, ни захват. Вызывается только вне блокировки пула.
//
// Параметры:
//   Сообщение - Строка - Текст ошибки.
//
Процедура ЗаписатьОшибку(Знач Сообщение)

	Попытка
		Лог.Ошибка(Сообщение);
	Исключение
		// Журнал недоступен: сообщить о сбое больше некуда.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Конструкторы

// Сведения о захвате соединения потоком исполнения.
//
// Возвращаемое значение:
//   Структура - Итог захвата:
//     * Соединение - СоединениеСБД, Неопределено - Выданное соединение.
//     * Повторно - Булево - Захват углубил уже закрепленное соединение.
//     * Закреплено - Булево - Этот вызов закрепил или углубил соединение: при ошибке захват
//         нужно вернуть.
//     * Открыто - Булево - Открыто новое соединение.
//     * ВремяОткрытия - Число - Время открытия, мс.
//     * Ожидание - Число - Время в очереди, мс.
//     * Снимок - Структура, Неопределено - Последний снимок пула.
//     * Сообщения - Массив из Строка - Сообщения для журнала, накопленные под блокировкой.
//
Функция Конструктор_ИтогЗахвата()

	Итог = Новый Структура;
	Итог.Вставить("Соединение");
	Итог.Вставить("Повторно", Ложь);
	Итог.Вставить("Закреплено", Ложь);
	Итог.Вставить("Открыто", Ложь);
	Итог.Вставить("ВремяОткрытия", 0);
	Итог.Вставить("Ожидание", 0);
	Итог.Вставить("Снимок");
	Итог.Вставить("Сообщения", Новый Массив);

	Возврат Итог;

КонецФункции

// Итог участка освобождения.
//
// Возвращаемое значение:
//   Структура - Итог:
//     * Возвращено - Булево - Соединение отобрано у потока исполнения.
//     * Снимок - Структура, Неопределено - Снимок пула.
//     * Сообщения - Массив из Строка - Сообщения для журнала, накопленные под блокировкой.
//
Функция Конструктор_ИтогУчастка()

	Итог = Новый Структура;
	Итог.Вставить("Возвращено", Ложь);
	Итог.Вставить("Снимок");
	Итог.Вставить("Сообщения", Новый Массив);

	Возврат Итог;

КонецФункции

// Заявка потока в очереди ожидающих. Живет в состоянии своего потока; другим потокам видна
// только ее блокировка - через БлокировкаПоследнейЗаявки.
//
// Возвращаемое значение:
//   Структура - Заявка:
//     * Блокировка - БлокировкаРесурса - Держит хозяин, пока стоит в очереди.
//     * Начало - Число - Момент постановки, мс.
//     * КрайнийСрок - Число - Момент постановки плюс предел ожидания, мс.
//     * Предшественник - БлокировкаРесурса, Неопределено - Блокировка заявки, вставшей раньше.
//     * ПредшественникПройден, СчетчикУменьшен, СвояСнята - Булево - Сделанные шаги ухода.
//
Функция Конструктор_Заявка()

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Заявка = Новый Структура;
	Заявка.Вставить("Блокировка", Новый БлокировкаРесурса);
	Заявка.Вставить("Начало", Начало);
	Заявка.Вставить("КрайнийСрок", Начало + ПределОжидания);
	Заявка.Вставить("Предшественник");
	Заявка.Вставить("ПредшественникПройден", Ложь);
	Заявка.Вставить("СчетчикУменьшен", Ложь);
	Заявка.Вставить("СвояСнята", Ложь);

	Возврат Заявка;

КонецФункции

#КонецОбласти
