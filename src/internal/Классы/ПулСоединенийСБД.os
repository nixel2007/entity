#Использовать "../concurrent"

#Использовать collectionos

// ПриоритетнаяОчередь - Очередь свободных соединений. Первым выдается возвращенное последним.
//
Перем Свободные;

// ПриоритетнаяОчередь - Очередь заявок на соединение. В голове - самая ранняя.
//
Перем Ожидающие;

// Число - Номер последней выданной заявки. Задает порядок в очереди ожидающих.
//
Перем НомерПоследнейЗаявки;

// Соответствие - ПотокИсполнения исполнения и выданное ему соединение.
//
Перем СоединенияПотоковИсполнения;

// Соответствие - ПотокИсполнения исполнения и сколько раз он занял соединение, не освободив.
//
Перем ГлубиныЗахвата;

// БлокировкаЧтенияЗаписи - Защищает очереди и соответствия: пул разделяется потоками.
//
Перем Блокировка;

// Число - Предел одновременно живущих соединений. Ноль снимает предел.
//
Перем РазмерПула;

// Число - Число созданных и еще не закрытых соединений.
//
Перем СозданоСоединений;

// Соответствие - ПотокиИсполнения, которые прямо сейчас открывают себе соединение. Место в пуле
// за ними уже занято, а самого соединения еще нет: открытие идет вне блокировки.
//
Перем Брони;

// Булево - Признак закрытого пула. Закрытие терминально: соединений пул больше не выдает.
//
Перем Закрыт;

// Число - Пауза между проверками своей заявки в очереди, в миллисекундах.
//
Перем ПаузаОжидания;

// Число - Предел ожидания соединения в очереди, в миллисекундах.
//
Перем ПределОжидания;

// Тип - Тип класса, реализующего интерфейс коннектора.
//
Перем ТипКоннектора;

// Строка - Строка соединения, с которой открываются коннекторы пула.
//
Перем СтрокаСоединения;

// Массив - Дополнительные параметры коннекторов пула.
//
Перем ПараметрыКоннектора;

// Пул соединений с базой данных.
//
// Через пул идут все обращения к БД. Соединение выдается потоку исполнения на время операции
// или транзакции и не разделяется с другими потоками исполнения: у драйверов СУБД соединение не
// потокобезопасно, и параллельные запросы по одному соединению рвут протокол обмена.
//
// Поток исполнения движок выделяет каждой независимой единице исполнения - основному скрипту,
// каждому фоновому заданию и каждому обрабатываемому запросу веб-сервера. Поток, не освободивший
// соединение сам, возвращает его по событию своего завершения: см. ПриЗавершенииПотокаИсполнения.
//
// Захват реентерабельный. Операция внутри транзакции получает то же соединение, что и сама
// транзакция, поэтому попадает в нее, а не идет мимо. Соединение возвращается в пул, когда
// поток освободил его столько же раз, сколько занимал.
//
// Размер пула - это предел параллельной работы с БД. Когда все места заняты, поток встает в
// очередь ожидающих, и освобожденное соединение достается тому, кто ждет дольше всех. Нулевой
// размер снимает предел и отключает постоянно живущие соединения: каждый захват открывает
// соединение, каждое освобождение его закрывает, ждать при таком размере некого.
//
// Ожидание в очереди ограничено по времени: не дождавшийся поток получает ошибку, а не висит
// бесконечно. Соединение мог не освободить живой поток, а у живого пул его не отбирает.
//
// Свободные соединения лежат в приоритетной очереди: первым выдается то, которое вернули
// последним. Так рабочий набор соединений остается малым, а простаивающие стареют.
//
// Пул разделяется всеми потоками, поэтому его состояние защищено блокировкой чтения-записи.
//
// Параметры:
//   ПРазмерПула - Число - Предел одновременно живущих соединений. Ноль снимает предел и отключает
//     постоянно живущие соединения.
//   ПТипКоннектора - Тип - Тип класса, реализующего интерфейс коннектора.
//   ПСтрокаСоединения - Строка - Строка соединения с БД.
//   ППараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//   ППределОжидания - Число - Предел ожидания соединения в очереди, в миллисекундах.
//   ППаузаОжидания - Число - Пауза между проверками своей заявки ожидающим, в миллисекундах.
//
Процедура ПриСозданииОбъекта(
	Знач ПРазмерПула,
	Знач ПТипКоннектора,
	Знач ПСтрокаСоединения,
	Знач ППараметрыКоннектора,
	Знач ППределОжидания = 30000,
	Знач ППаузаОжидания = 10
)

	// Отрицательный размер не отвергает ни один захват явно: предел просто никогда не позволяет
	// открыть соединение, и поток исполнения уходит ждать в очередь, где его никто не дождется.
	Если НЕ (ТипЗнч(ПРазмерПула) = Тип("Число") И ПРазмерПула >= 0) Тогда
		ВызватьИсключение СтрШаблон(
			"Размер пула соединений должен быть неотрицательным числом, передано <%1>",
			ПРазмерПула
		);
	КонецЕсли;

	РазмерПула = ПРазмерПула;
	ТипКоннектора = ПТипКоннектора;
	СтрокаСоединения = ПСтрокаСоединения;
	ПараметрыКоннектора = ППараметрыКоннектора;

	// Возвращенное позже считается меньшим, поэтому оказывается в голове очереди.
	Свободные = Новый ПриоритетнаяОчередь(
		"(Первое, Второе) -> ?(Первое.МоментВозврата() > Второе.МоментВозврата(), -1,"
			+ " ?(Первое.МоментВозврата() < Второе.МоментВозврата(), 1, 0))"
	);

	// Заявка с меньшим номером подана раньше и оказывается в голове очереди.
	Ожидающие = Новый ПриоритетнаяОчередь(
		"(Первое, Второе) -> ?(Первое.Номер < Второе.Номер, -1, ?(Первое.Номер > Второе.Номер, 1, 0))"
	);

	НомерПоследнейЗаявки = 0;
	СоединенияПотоковИсполнения = Новый Соответствие();
	ГлубиныЗахвата = Новый Соответствие();
	Блокировка = Новый БлокировкаЧтенияЗаписи();
	СозданоСоединений = 0;
	Брони = Новый Соответствие();
	Закрыт = Ложь;
	ПаузаОжидания = ППаузаОжидания;
	ПределОжидания = ППределОжидания;

КонецПроцедуры

// Обрабатывает завершение потока исполнения, который занимал ресурсы пула.
//
// Вызывается движком по событию завершения потока. К этому моменту код потока уже отработал,
// поэтому все, что он не освободил сам, освобождается здесь: закрепленное соединение, бронь под
// еще не открытое и заявка в очереди ожидающих.
//
// Объявлен до "Занять()" намеренно: движок разрешает имя обработчика в один проход, и подписка
// на метод, объявленный ниже по модулю, не компилируется.
//
Процедура ПриЗавершенииПотокаИсполнения()

	ПотокИсполнения = ТекущийПоток();

	Блокировка.Запись().Заблокировать();

	Попытка
		ОсвободитьРесурсыПотокаИсполнения(ПотокИсполнения);
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Занимает соединение для текущего потока исполнения.
//
// Захват реентерабельный: поток, уже занявший соединение, получает то же самое, а освобождать
// его нужно столько же раз, сколько занимал.
//
// Если предел пула исчерпан, вызов встает в очередь и ждет, пока соединение освободит другой
// поток исполнения. Освобожденное соединение достается тому, кто ждет дольше всех.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение, закрепленное за текущим потоком исполнения.
//
Функция Занять() Экспорт

	ПотокИсполнения = ТекущийПоток();

	// ПотокИсполнения может не дойти до Освободить(): оборваться, забыть освободить или просто
	// закончиться. Подписка снимает с пула обязанность выяснять это опросом - о завершении
	// сообщит сам поток исполнения. Повторная подписка тем же обработчиком ничего не добавляет.
	ДобавитьОбработчик ПотокИсполнения.ПриЗавершении, ПриЗавершенииПотокаИсполнения;

	Блокировка.Запись().Заблокировать();

	Попытка
		Итог = ПопытатьсяЗанять(ПотокИсполнения);
		Если Итог.Соединение = Неопределено И НЕ Итог.Бронь Тогда
			Заявка = ВстатьВОчередь(ПотокИсполнения);
		КонецЕсли;
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Если Итог.Соединение <> Неопределено Тогда
		Возврат Итог.Соединение;
	КонецЕсли;

	Если Итог.Бронь Тогда
		Возврат ОткрытьПоБрони(ПотокИсполнения);
	КонецЕсли;

	Возврат ДождатьсяПоЗаявке(ПотокИсполнения, Заявка);

КонецФункции

// Освобождает соединение текущего потока исполнения.
//
// Соединение возвращается в пул только после того, как поток освободил его столько же раз,
// сколько занимал. Освобождение без захвата ничего не делает.
//
Процедура Освободить() Экспорт

	ПотокИсполнения = ТекущийПоток();

	Блокировка.Запись().Заблокировать();

	Попытка
		ОсвободитьЗахват(ПотокИсполнения);
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Возвращает соединение, занятое текущим потоком исполнения.
//
// Глубину захвата не меняет, поэтому подходит для завершения транзакции: соединение нужно
// освободить ровно один раз, парно к его захвату.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение текущего потока исполнения.
//   Неопределено - Текущий поток исполнения соединения не занимал.
//
Функция СоединениеТекущегоПотокаИсполнения() Экспорт

	ПотокИсполнения = ТекущийПоток();

	Блокировка.Чтение().Заблокировать();
	Результат = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Определяет, занято ли соединение текущим потоком исполнения.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение занято и еще не освобождено.
//
Функция ЕстьСоединениеТекущегоПотокаИсполнения() Экспорт
	Возврат СоединениеТекущегоПотокаИсполнения() <> Неопределено;
КонецФункции

// Возвращает число соединений, занятых потоками исполнения.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество занятых соединений.
//
Функция КоличествоЗанятых() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = СоединенияПотоковИсполнения.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число свободных соединений в очереди.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество свободных соединений.
//
Функция КоличествоСвободных() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Свободные.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число занятых пулом мест: открытых соединений и броней под те, что открываются
// прямо сейчас.
//
// Предназначено для диагностики и проверок: именно это число сравнивается с размером пула,
// и именно оно протекает, если неудачное открытие не вернет свое место.
//
// Возвращаемое значение:
//   Число - Количество занятых мест в пуле.
//
Функция КоличествоСозданных() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = СозданоСоединений;
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает число потоков исполнения, ожидающих освобождения соединения.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество ожидающих.
//
Функция КоличествоОжидающих() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Ожидающие.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает тип коннектора, которым пул открывает соединения.
//
// Возвращаемое значение:
//   Тип - Тип класса, реализующего интерфейс коннектора.
//
Функция ТипКоннектора() Экспорт
	Возврат ТипКоннектора;
КонецФункции

// Возвращает строку соединения, с которой пул открывает соединения.
//
// Возвращаемое значение:
//   Строка - Строка соединения с БД.
//
Функция СтрокаСоединения() Экспорт
	Возврат СтрокаСоединения;
КонецФункции

// Возвращает дополнительные параметры коннекторов пула.
//
// Возвращаемое значение:
//   Массив - Параметры коннектора.
//
Функция ПараметрыКоннектора() Экспорт
	Возврат ПараметрыКоннектора;
КонецФункции

// Закрывает все соединения пула.
//
// Закрытие терминально: после него пул соединений не выдает, и `Занять()` завершается ошибкой.
// Иначе ожидающий, проснувшийся после закрытия, молча открыл бы себе новое соединение, которое
// пережило бы закрытие пула, - обещание "закрывает все соединения" перестало бы выполняться.
//
Процедура Закрыть() Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		Для Каждого КлючИЗначение Из СоединенияПотоковИсполнения Цикл
			КлючИЗначение.Значение.Закрыть();
		КонецЦикла;
		СоединенияПотоковИсполнения.Очистить();
		ГлубиныЗахвата.Очистить();

		Пока Свободные.Количество() > 0 Цикл
			Свободные.Взять().Получить().Закрыть();
		КонецЦикла;

		// Соединение, уже отданное заявке, не лежит ни за потоком, ни в свободных: заберет его
		// ожидающий, до которого очередь дошла. Без разбора заявок оно пережило бы закрытие пула.
		Пока Ожидающие.Количество() > 0 Цикл
			Заявка = Ожидающие.Взять().Получить();
			Заявка.Снята = Истина;
			Если Заявка.Соединение <> Неопределено Тогда
				Заявка.Соединение.Закрыть();
				Заявка.Соединение = Неопределено;
			КонецЕсли;
		КонецЦикла;

		// Брони снимаются последними: по снятой броне открывающий поток исполнения поймет, что пул
		// закрыт, и закроет свое соединение сам - здесь его еще нет.
		Брони.Очистить();

		СозданоСоединений = 0;
		Закрыт = Истина;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Одна попытка занять соединение. Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
// Возвращаемое значение:
//   Структура - Итог попытки, см. Конструктор_ИтогПопытки.
//
Функция ПопытатьсяЗанять(Знач ПотокИсполнения)

	Если Закрыт Тогда
		ВызватьИсключение "Пул соединений закрыт";
	КонецЕсли;

	Итог = Конструктор_ИтогПопытки();

	Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
	Если Соединение <> Неопределено Тогда
		ГлубиныЗахвата.Вставить(ПотокИсполнения, ГлубиныЗахвата.Получить(ПотокИсполнения) + 1);
		Итог.Соединение = Соединение;
		Возврат Итог;
	КонецЕсли;

	Соединение = ВзятьСвободное();
	Если Соединение <> Неопределено Тогда
		ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение);
		Итог.Соединение = Соединение;
		Возврат Итог;
	КонецЕсли;

	// Свободных нет. Если предел позволяет, за потоком исполнения бронируется место, а открывать
	// соединение он будет уже без блокировки.
	Если РазмерПула = 0 ИЛИ СозданоСоединений < РазмерПула Тогда
		Брони.Вставить(ПотокИсполнения, Истина);
		СозданоСоединений = СозданоСоединений + 1;
		Итог.Бронь = Истина;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Достает соединение из очереди свободных.
// Вызывается при захваченной блокировке записи.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение, не закрепленное ни за одним потоком исполнения.
//   Неопределено - Свободных соединений нет.
//
Функция ВзятьСвободное()

	Если Свободные.Количество() > 0 Тогда
		Возврат Свободные.Взять().Получить();
	КонецЕсли;

	Если РазмерПула = 0 ИЛИ СозданоСоединений < РазмерПула Тогда
		// Место под новое соединение есть - его займет бронь, а не очередь свободных.
		Возврат Неопределено;
	КонецЕсли;

	// Искать здесь соединения завершившихся потоков исполнения не нужно: каждый из них вернул свое
	// сам, обработчиком ПриЗавершенииПотокаИсполнения.
	Возврат Неопределено;

КонецФункции

// Открывает соединение по ранее взятой брони и закрепляет его за потоком исполнения.
//
// Открытие идет БЕЗ блокировки пула: это сетевой вызов, и его длительность не должна ничего
// останавливать. Иначе недоступная база морозила бы весь пул на таймаут подключения, причем
// последовательно для каждого потока исполнения, и заодно не давала бы никому вернуть исправное
// соединение - `Освободить()` берет ту же блокировку. Место в пуле на это время держит бронь.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
// Возвращаемое значение:
//   СоединениеСБД - Открытое соединение, закрепленное за потоком исполнения.
//
Функция ОткрытьПоБрони(Знач ПотокИсполнения)

	Попытка
		Соединение = Новый СоединениеСБД(ТипКоннектора, СтрокаСоединения, ПараметрыКоннектора);
	Исключение
		СнятьБронь(ПотокИсполнения);
		ВызватьИсключение;
	КонецПопытки;

	Возврат ЗакрепитьОткрытое(ПотокИсполнения, Соединение);

КонецФункции

// Снимает бронь, не открыв по ней соединения, и возвращает место в пул.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
Процедура СнятьБронь(Знач ПотокИсполнения)

	Блокировка.Запись().Заблокировать();

	Попытка
		Если Брони.Получить(ПотокИсполнения) <> Неопределено Тогда
			Брони.Удалить(ПотокИсполнения);
			СозданоСоединений = СозданоСоединений - 1;
		КонецЕсли;
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Закрепляет за потоком исполнения соединение, открытое по брони.
//
// Пропасть бронь может по двум разным причинам, и путать их нельзя. Закрытый пул - это отказ:
// соединение закрывается, вызов завершается ошибкой. А вот снятие брони обработчиком завершения
// потока - не отказ: место под соединение просто занимается заново, пул на короткое время
// может выйти за предел, и это дешевле отказа.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Соединение - СоединениеСБД - Только что открытое соединение.
//
// Возвращаемое значение:
//   СоединениеСБД - То же соединение, закрепленное за потоком исполнения.
//
Функция ЗакрепитьОткрытое(Знач ПотокИсполнения, Соединение)

	Блокировка.Запись().Заблокировать();

	Попытка

		ПулЗакрыт = Закрыт;
		Если НЕ ПулЗакрыт Тогда

			Если Брони.Получить(ПотокИсполнения) = Неопределено Тогда
				// Бронь сняли, сочтя поток исполнения завершенным: место занимается заново.
				СозданоСоединений = СозданоСоединений + 1;
			Иначе
				Брони.Удалить(ПотокИсполнения);
			КонецЕсли;

			ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Соединение);

		КонецЕсли;

	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Если ПулЗакрыт Тогда
		Соединение.Закрыть();
		ВызватьИсключение "Пул соединений закрыт, пока открывалось соединение";
	КонецЕсли;

	Возврат Соединение;

КонецФункции

// Ставит поток исполнения в очередь ожидающих. Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
// Возвращаемое значение:
//   Структура - Заявка на соединение.
//
Функция ВстатьВОчередь(Знач ПотокИсполнения)

	НомерПоследнейЗаявки = НомерПоследнейЗаявки + 1;

	Заявка = Новый Структура("Номер, ПотокИсполнения, Соединение, Снята");
	Заявка.Номер = НомерПоследнейЗаявки;
	Заявка.ПотокИсполнения = ПотокИсполнения;
	Заявка.Соединение = Неопределено;
	Заявка.Снята = Ложь;
	Ожидающие.Положить(Заявка);

	Возврат Заявка;

КонецФункции

// Ждет, пока по заявке выдадут соединение.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Заявка - Структура - Заявка, поданная в очередь ожидающих.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение, закрепленное за потоком исполнения.
//
Функция ДождатьсяПоЗаявке(Знач ПотокИсполнения, Заявка)

	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределОжидания;

	Пока Истина Цикл

		// Ждать нужно вне блокировки, иначе освободить соединение стало бы некому.
		Приостановить(ПаузаОжидания);

		Блокировка.Запись().Заблокировать();

		Попытка
			Итог = ПопытатьсяПолучитьПоЗаявке(Заявка, ПотокИсполнения);
		Исключение
			// Иначе выданное по брошенной заявке соединение не забрал бы никто.
			Заявка.Снята = Истина;
			Блокировка.Запись().Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

		Блокировка.Запись().Разблокировать();

		Если Итог.Соединение <> Неопределено Тогда
			Возврат Итог.Соединение;
		КонецЕсли;

		// Место освободилось, пока ждали: открываем свое соединение так же, как обычный захват -
		// без блокировки.
		Если Итог.Бронь Тогда
			Возврат ОткрытьПоБрони(ПотокИсполнения);
		КонецЕсли;

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= КрайнийСрок Тогда
			ОтказатьВОжидании(Заявка);
		КонецЕсли;

	КонецЦикла;

КонецФункции

// Снимает заявку по истечении предела ожидания и завершает захват ошибкой.
//
// Ждать бесконечно нельзя: соединение мог не освободить живой поток - забытым `Освободить()`
// или просто долгой работой, - а обработчик завершения возвращает соединения только за теми,
// кто уже отработал. Без предела такой захват висел бы навсегда. Предел есть у любого пула:
// в HikariCP это `connectionTimeout`, а встроенный пул Hibernate не ждет вовсе и отказывает
// сразу, как только исчерпан максимум.
//
// Параметры:
//   Заявка - Структура - Заявка, поданная в очередь ожидающих.
//
Процедура ОтказатьВОжидании(Заявка)

	Блокировка.Запись().Заблокировать();

	Попытка

		Заявка.Снята = Истина;

		// Соединение могли назначить заявке в последний момент - между проверкой и этой строкой.
		// В снятой заявке забрать его больше некому.
		Если Заявка.Соединение <> Неопределено Тогда
			СоединениеЗаявки = Заявка.Соединение;
			Заявка.Соединение = Неопределено;
			ВернутьВПул(СоединениеЗаявки);
		КонецЕсли;

	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	ВызватьИсключение СтрШаблон(
		"ПотокИсполнения не дождался свободного соединения за %1 мс",
		Формат(ПределОжидания, "ЧГ=")
	);

КонецПроцедуры

// Одна попытка получить соединение ожидающим потоком исполнения.
//
// Сначала берется соединение, выданное по заявке. Если его нет, поток пробует занять соединение
// сам: заявку могли снять как брошенную, и тогда без этой попытки поток ждал бы вечно.
//
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   Заявка - Структура - Заявка, поданная в очередь ожидающих.
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
// Возвращаемое значение:
//   Структура - Итог попытки, см. Конструктор_ИтогПопытки.
//
Функция ПопытатьсяПолучитьПоЗаявке(Заявка, Знач ПотокИсполнения)

	Если Заявка.Соединение <> Неопределено Тогда
		Заявка.Снята = Истина;
		ЗакрепитьЗаПотокомИсполнения(ПотокИсполнения, Заявка.Соединение);

		Итог = Конструктор_ИтогПопытки();
		Итог.Соединение = Заявка.Соединение;

		Возврат Итог;
	КонецЕсли;

	Итог = ПопытатьсяЗанять(ПотокИсполнения);
	Если Итог.Соединение = Неопределено И НЕ Итог.Бронь Тогда
		Возврат Итог;
	КонецЕсли;

	// Заявка больше не нужна: выданное по ней соединение осталось бы невостребованным.
	Заявка.Снята = Истина;

	// Пока шла попытка, соединение могли назначить этой же заявке: завершившийся поток вернул
	// свое соединение в пул, а оттуда оно ушло в очередь ожидающих. В снятой заявке такое
	// соединение забрать больше некому.
	Если Заявка.Соединение <> Неопределено Тогда
		СоединениеЗаявки = Заявка.Соединение;
		Заявка.Соединение = Неопределено;
		ВернутьВПул(СоединениеЗаявки);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Закрепляет соединение за потоком исполнения с первой глубиной захвата.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//   Соединение - СоединениеСБД - Выданное соединение.
//
Процедура ЗакрепитьЗаПотокомИсполнения(Знач ПотокИсполнения, Соединение)

	СоединенияПотоковИсполнения.Вставить(ПотокИсполнения, Соединение);
	ГлубиныЗахвата.Вставить(ПотокИсполнения, 1);

КонецПроцедуры

// Уменьшает глубину захвата и возвращает соединение в пул, когда она дошла до нуля.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
Процедура ОсвободитьЗахват(Знач ПотокИсполнения)

	Глубина = ГлубиныЗахвата.Получить(ПотокИсполнения);
	Если Глубина = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Глубина = Глубина - 1;
	Если Глубина > 0 Тогда
		ГлубиныЗахвата.Вставить(ПотокИсполнения, Глубина);
		Возврат;
	КонецЕсли;

	// Начатую транзакцию соединение переживает: она принадлежит потоку и держит соединение за
	// ним до фиксации или отмены, сколько бы операций между ними ни прошло. Иначе завершение
	// транзакции пришлось бы считать захватом, а повторное начало оставляло бы лишний.
	Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);
	Если Соединение <> Неопределено И Соединение.ВТранзакции() Тогда
		ГлубиныЗахвата.Вставить(ПотокИсполнения, 0);
		Возврат;
	КонецЕсли;

	ОтобратьСоединение(ПотокИсполнения);

КонецПроцедуры

// Отбирает соединение у потока исполнения и передает его дальше.
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, для которого выполняется операция.
//
Процедура ОтобратьСоединение(Знач ПотокИсполнения)

	Соединение = СоединенияПотоковИсполнения.Получить(ПотокИсполнения);

	ГлубиныЗахвата.Удалить(ПотокИсполнения);
	СоединенияПотоковИсполнения.Удалить(ПотокИсполнения);

	ВернутьВПул(Соединение);

КонецПроцедуры

// Отдает освобожденное соединение голове очереди ожидающих, а если никто не ждет - в очередь
// свободных либо на закрытие. Вызывается при захваченной блокировке записи.
//
// Параметры:
//   Соединение - СоединениеСБД - Освобожденное соединение.
//
Процедура ВернутьВПул(Соединение)

	// Соединение, на котором не удалось завершить транзакцию, переиспользовать нельзя: в каком
	// состоянии осталась транзакция, неизвестно. Такое соединение закрывается, а его место
	// возвращается в пул - следующий поток исполнения откроет себе новое.
	Если Соединение.Испорчено() Тогда
		Соединение.Закрыть();
		СозданоСоединений = СозданоСоединений - 1;
		Возврат;
	КонецЕсли;

	Соединение.ОтметитьВозврат();

	Заявка = ПервыйОжидающий();
	Если Заявка <> Неопределено Тогда
		Заявка.Соединение = Соединение;
		Возврат;
	КонецЕсли;

	Если РазмерПула = 0 Тогда
		Соединение.Закрыть();
		СозданоСоединений = СозданоСоединений - 1;
		Возврат;
	КонецЕсли;

	Свободные.Положить(Соединение);

КонецПроцедуры

// Достает из очереди самую раннюю заявку, по которой еще ждут.
//
// Заявка оборвавшегося потока здесь не отсеивается: ее снимет обработчик завершения этого
// потока, он же вернет в пул назначенное ей соединение.
//
// Вызывается при захваченной блокировке записи.
//
// Возвращаемое значение:
//   Структура - Заявка на соединение.
//   Неопределено - Ожидающих нет.
//
Функция ПервыйОжидающий()

	Если Ожидающие.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заявки = Новый Массив;
	Пока Ожидающие.Количество() > 0 Цикл
		Заявки.Добавить(Ожидающие.Взять().Получить());
	КонецЦикла;

	Выбранная = Неопределено;
	Для Каждого Заявка Из Заявки Цикл

		// Снятую заявку удовлетворять нечем: поток исполнения уже получил соединение другим путем, и
		// выданное по ней никто бы не забрал. В очередь она не возвращается.
		Если Заявка.Снята Тогда
			Продолжить;
		КонецЕсли;

		// Заявка возвращается в очередь в любом случае, в том числе с уже назначенным
		// соединением. Пока ожидающий его не забрал, очередь - единственное место, где это
		// соединение видно закрытию пула и разбору заявок брошенных потоков исполнения.
		Ожидающие.Положить(Заявка);

		Если Выбранная = Неопределено И Заявка.Соединение = Неопределено Тогда
			Выбранная = Заявка;
		КонецЕсли;

	КонецЦикла;

	Возврат Выбранная;

КонецФункции

// Возвращает в пул все, что удерживал завершившийся поток исполнения.
//
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, чьи ресурсы освобождаются.
//
Процедура ОсвободитьРесурсыПотокаИсполнения(Знач ПотокИсполнения)

	Если СоединенияПотоковИсполнения.Получить(ПотокИсполнения) <> Неопределено Тогда
		ОтобратьСоединение(ПотокИсполнения);
	КонецЕсли;

	// Поток, оборвавшийся посреди открытия соединения, свою бронь не снимет, а место в пуле
	// она держит. Само соединение либо не открылось, либо будет закрыто самим открывающим:
	// пропавшую бронь он увидит в ЗакрепитьОткрытое.
	Если Брони.Получить(ПотокИсполнения) <> Неопределено Тогда
		Брони.Удалить(ПотокИсполнения);
		СозданоСоединений = СозданоСоединений - 1;
	КонецЕсли;

	СнятьЗаявкуПотокаИсполнения(ПотокИсполнения);

КонецПроцедуры

// Снимает заявку завершившегося потока исполнения и возвращает в пул назначенное ей соединение.
//
// Ожидающий обычно жив - он в этот момент исполняет цикл ожидания и свою заявку при ошибке
// снимает сам, - но оборвавшийся поток исполнения не снимет ничего. Соединение, назначенное такой
// заявке, не лежит ни за потоком исполнения, ни в свободных, и забрать его больше некому.
//
// Очередь перебирается сливом и обратной укладкой: чужие заявки возвращаются на место,
// чтобы отобранное соединение досталось тому, кто его действительно ждет.
//
// Вызывается при захваченной блокировке записи.
//
// Параметры:
//   ПотокИсполнения - ПотокИсполнения - Поток, чья заявка снимается.
//
Процедура СнятьЗаявкуПотокаИсполнения(Знач ПотокИсполнения)

	Заявки = Новый Массив;
	Пока Ожидающие.Количество() > 0 Цикл
		Заявки.Добавить(Ожидающие.Взять().Получить());
	КонецЦикла;

	Брошенные = Новый Массив;
	Для Каждого Заявка Из Заявки Цикл

		// Снятая заявка ничего не ждет и соединения не удержит: в очередь она не возвращается.
		Если Заявка.Снята Тогда
			Продолжить;
		КонецЕсли;

		Если Заявка.ПотокИсполнения = ПотокИсполнения Тогда
			Заявка.Снята = Истина;
			Брошенные.Добавить(Заявка);
		Иначе
			Ожидающие.Положить(Заявка);
		КонецЕсли;

	КонецЦикла;

	Для Каждого Заявка Из Брошенные Цикл
		Если Заявка.Соединение <> Неопределено Тогда
			Соединение = Заявка.Соединение;
			Заявка.Соединение = Неопределено;
			ВернутьВПул(Соединение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Создает структуру итога попытки занять соединение.
//
// Возвращаемое значение:
//   Структура - Итог попытки:
//     * Соединение - СоединениеСБД - Занятое соединение.
//                  - Неопределено - Занять не удалось.
//     * Бронь - Булево - Истина, если за потоком забронировано место и он должен открыть
//         соединение сам, вне блокировки пула.
//
Функция Конструктор_ИтогПопытки()

	Итог = Новый Структура;
	Итог.Вставить("Соединение");
	Итог.Вставить("Бронь", Ложь);

	Возврат Итог;

КонецФункции
