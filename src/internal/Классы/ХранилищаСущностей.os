// Хранилища сущностей одного менеджера: соответствие типа сущности хранилищу.
//
// Хранилище работает моделью данных того менеджера, который его создал, поэтому и принадлежит
// менеджеру: иначе хранилище с моделью закрытого менеджера досталось бы следующему. Источник
// данных о сущностях не знает, он дает только соединения.
//
// Обращения идут на каждую прочитанную сущность и на каждое разыменование ссылки, притом из
// разных потоков, поэтому попадание в кэш читается под блокировкой чтения: сериализуется только
// создание.
//
#Использовать "../concurrent"

// ИсточникДанных - Источник, соединениями которого работают хранилища.
Перем пИсточник;
// МодельДанных - Модель данных менеджера, которому принадлежат хранилища.
Перем пМодельДанных;
// Соответствие - Тип сущности: хранилище этого типа.
Перем пХранилища;
// БлокировкаЧтенияЗаписи - Защищает набор: менеджером пользуются из разных потоков.
Перем пБлокировка;

// Набор хранилищ одного менеджера.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, соединениями которого работают хранилища.
//   МодельДанных - МодельДанных - Модель данных менеджера.
//
Процедура ПриСозданииОбъекта(Знач Источник, Знач МодельДанных)

	пИсточник = Источник;
	пМодельДанных = МодельДанных;
	пХранилища = Новый Соответствие();
	пБлокировка = Новый БлокировкаЧтенияЗаписи();

КонецПроцедуры

// Источник данных, соединениями которого работают хранилища.
//
// Возвращаемое значение:
//   ИсточникДанных - Источник данных.
//
Функция Источник() Экспорт
	Возврат пИсточник;
КонецФункции

// Возвращает хранилище сущностей, создавая его при первом обращении.
//
// К БД обращения нет, поэтому закрытый источник хранилище выдает: ошибку дает первая операция,
// когда хранилище просит соединение.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности, зарегистрированный в модели данных менеджера.
//
// Возвращаемое значение:
//   ХранилищеСущностей - Хранилище для переданного типа.
//
Функция Получить(Знач ТипСущности) Экспорт

	пБлокировка.Чтение().Заблокировать();
	Хранилище = пХранилища.Получить(ТипСущности);
	пБлокировка.Чтение().Разблокировать();

	Если Хранилище <> Неопределено Тогда
		Возврат Хранилище;
	КонецЕсли;

	пБлокировка.Запись().Заблокировать();

	Попытка

		// Пока ждали запись, хранилище мог создать другой поток.
		Хранилище = пХранилища.Получить(ТипСущности);
		Если Хранилище = Неопределено Тогда
			Хранилище = Новый ХранилищеСущностей(пМодельДанных.Получить(ТипСущности), ЭтотОбъект);
			пХранилища.Вставить(ТипСущности, Хранилище);
		КонецЕсли;

	Исключение

		пБлокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	пБлокировка.Запись().Разблокировать();

	Возврат Хранилище;

КонецФункции

// Закрывает хранилища менеджера и убирает их из набора.
//
Процедура Закрыть() Экспорт

	пБлокировка.Запись().Заблокировать();

	Попытка

		Для Каждого КлючИЗначение Из пХранилища Цикл
			КлючИЗначение.Значение.Закрыть();
		КонецЦикла;
		пХранилища.Очистить();

	Исключение

		пБлокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	пБлокировка.Запись().Разблокировать();

КонецПроцедуры
