// Пул ранее прочитанных экземпляров сущностей одного хранилища.
//
// На один идентификатор в пуле живет один экземпляр: иначе разные контексты получили бы разные
// объекты одной и той же строки, и правка через один не была бы видна через другой.
//
// Пул разделяется всеми контекстами исполнения, поэтому доступ к нему синхронизирован. Блокировку
// пул держит свою: общий реестр блокировок ничего не вытесняет и рассчитан на постоянный набор
// ключей - имена таблиц, файлов, строки соединения, - а пул сущностей создается и умирает вместе
// с хранилищем, то есть был бы для реестра динамическим ключом и оставался бы в нем навсегда.
//
#Использовать "../concurrent"

// Соответствие - Идентификатор сущности и ее экземпляр.
Перем Сущности;
// БлокировкаЧтенияЗаписи - Защищает соответствие: пул общий на все контексты.
Перем Блокировка;

Процедура ПриСозданииОбъекта()

	Сущности = Новый Соответствие();
	Блокировка = Новый БлокировкаЧтенияЗаписи();

КонецПроцедуры

// Возвращает экземпляр сущности по идентификатору.
//
// Параметры:
//   ЗначениеИдентификатора - Произвольный - Идентификатор сущности.
//
// Возвращаемое значение:
//   Произвольный - Найденный экземпляр.
//   Неопределено - Сущности с таким идентификатором в пуле нет.
//
Функция Получить(Знач ЗначениеИдентификатора) Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Сущности.Получить(ЗначениеИдентификатора);
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции

// Помещает экземпляр в пул, если места под этот идентификатор еще никто не занял.
//
// Возвращается тот экземпляр, который остался в пуле: если, пока вызывающий создавал свой,
// другой контекст успел вставить свой, победителем остается вставленный первым. Так создание
// экземпляра выносится за пределы блокировки, а единственность на идентификатор сохраняется.
//
// Параметры:
//   ЗначениеИдентификатора - Произвольный - Идентификатор сущности.
//   Сущность - Произвольный - Экземпляр, который вызывающий хочет поместить в пул.
//
// Возвращаемое значение:
//   Произвольный - Экземпляр, оставшийся в пуле под этим идентификатором.
//
Функция ПолучитьИлиВставить(Знач ЗначениеИдентификатора, Сущность) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		Результат = Сущности.Получить(ЗначениеИдентификатора);
		Если Результат = Неопределено Тогда
			Результат = Сущность;
			Сущности.Вставить(ЗначениеИдентификатора, Сущность);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Возврат Результат;

КонецФункции

// Помещает экземпляр в пул, замещая прежний.
//
// Параметры:
//   ЗначениеИдентификатора - Произвольный - Идентификатор сущности.
//   Сущность - Произвольный - Запоминаемый экземпляр.
//
Процедура Вставить(Знач ЗначениеИдентификатора, Сущность) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка
		Сущности.Вставить(ЗначениеИдентификатора, Сущность);
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Убирает экземпляр из пула.
//
// Параметры:
//   ЗначениеИдентификатора - Произвольный - Идентификатор убираемой сущности.
//
Процедура Удалить(Знач ЗначениеИдентификатора) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка
		Сущности.Удалить(ЗначениеИдентификатора);
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Опустошает пул.
//
Процедура Очистить() Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка
		Сущности.Очистить();
	Исключение
		Блокировка.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Возвращает число экземпляров в пуле.
//
// Предназначено для диагностики и проверок.
//
// Возвращаемое значение:
//   Число - Количество экземпляров.
//
Функция Количество() Экспорт

	Блокировка.Чтение().Заблокировать();
	Результат = Сущности.Количество();
	Блокировка.Чтение().Разблокировать();

	Возврат Результат;

КонецФункции
