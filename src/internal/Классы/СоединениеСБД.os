// АбстрактныйКоннектор - Коннектор, которым выполняются операции этого соединения.
Перем Коннектор;
// Булево - Признак начатой и еще не завершенной транзакции.
Перем ВТранзакции;
// Булево - Признак непригодности к переиспользованию: состояние соединения неизвестно.
Перем Испорчено;
// Число - Момент последнего возврата в пул в миллисекундах. По нему пул выбирает, какое
// соединение выдать следующим.
Перем МоментВозврата;
// НаблюдателиСущностей - Наблюдатели пула: получают события транзакций этого соединения.
Перем НаблюдателиПула;
// СобытиеСущностей - Событие текущей транзакции, начатое в НачатьТранзакцию и завершаемое
// исходом. Неопределено вне транзакции или без наблюдателей.
Перем СобытиеТранзакции;

// Соединение с базой данных, выданное из пула соединений.
//
// Содержит собственный экземпляр коннектора и состояние транзакции. Соединение выдается одному
// потоку исполнения и не разделяется: именно поэтому транзакция одного фонового задания не
// может быть зафиксирована или отменена другим.
//
// Создается пулом соединений, напрямую конструировать не следует. Конструктор открывает
// соединение с базой данных.
//
// Параметры:
//   ТипКоннектора - Тип - Тип класса, реализующего интерфейс коннектора.
//   СтрокаСоединения - Строка - Строка соединения с БД.
//   ПараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//   Наблюдатели - НаблюдателиСущностей - Реестр наблюдателей пула: коннектор, объявивший
//     НаблюдаемыйКоннектор, получает его после открытия.
//
Процедура ПриСозданииОбъекта(Знач ТипКоннектора, Знач СтрокаСоединения, Знач ПараметрыКоннектора, Знач Наблюдатели)

	Коннектор = РаботаСКоннекторами.СоздатьКоннектор(ТипКоннектора);
	РаботаСКоннекторами.ОткрытьКоннектор(Коннектор, СтрокаСоединения, ПараметрыКоннектора);
	Наблюдатели.ПодключитьКоннектор(Коннектор);
	НаблюдателиПула = Наблюдатели;

	ВТранзакции = Ложь;
	Испорчено = Ложь;
	ОтметитьВозврат();

КонецПроцедуры

// Возвращает коннектор соединения.
//
// Возвращаемое значение:
//   АбстрактныйКоннектор - Коннектор для работы с БД.
//
Функция ПолучитьКоннектор() Экспорт
	Возврат Коннектор;
КонецФункции

// Начинает транзакцию.
//
// Вызов уходит коннектору как есть: вложенные транзакции не поддерживает ни один коннектор,
// и об этом должна сказать СУБД, а не обертка.
//
Процедура НачатьТранзакцию() Экспорт

	РаботаСКоннекторами.НачатьТранзакцию(Коннектор);
	ВТранзакции = Истина;

	// Событие живет до исхода: фиксации, отмены, неудачи или отката брошенной транзакции.
	СобытиеТранзакции = НаблюдателиПула.СоздатьСобытие("Транзакция", "Транзакция");
	НаблюдателиПула.НачатьСобытие(СобытиеТранзакции);

КонецПроцедуры

// Фиксирует транзакцию.
//
Процедура ЗафиксироватьТранзакцию() Экспорт

	Попытка
		// Безусловно, как и коннектор без пула: транзакцию мог начать сырой запрос мимо обертки.
		РаботаСКоннекторами.ЗафиксироватьТранзакцию(Коннектор);
	Исключение
		ИспортитьПослеНеудачногоЗавершения();
		ЗавершитьСобытиеТранзакции("failed", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ВТранзакции = Ложь;
	ЗавершитьСобытиеТранзакции("commit");

КонецПроцедуры

// Отменяет транзакцию.
//
Процедура ОтменитьТранзакцию() Экспорт

	Попытка
		// Безусловно, как и коннектор без пула: транзакцию мог начать сырой запрос мимо обертки.
		РаботаСКоннекторами.ОтменитьТранзакцию(Коннектор);
	Исключение
		ИспортитьПослеНеудачногоЗавершения();
		ЗавершитьСобытиеТранзакции("failed", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ВТранзакции = Ложь;
	ЗавершитьСобытиеТранзакции("rollback");

КонецПроцедуры

// Завершает событие транзакции исходом и отдает его наблюдателям.
//
// Параметры:
//   Исход - Строка - commit, rollback, failed или abandoned.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка завершения.
//
Процедура ЗавершитьСобытиеТранзакции(Знач Исход, Знач ИнформацияОбОшибке = Неопределено)

	Если СобытиеТранзакции = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Событие = СобытиеТранзакции;
	СобытиеТранзакции = Неопределено;

	Событие.УстановитьИсход(Исход);
	НаблюдателиПула.ЗавершитьСобытие(Событие, ИнформацияОбОшибке);

КонецПроцедуры

// Помечает соединение непригодным после неудавшегося завершения транзакции.
//
// Признак транзакции снимается: держать соединение за потоком больше незачем, а повторный
// откат при возврате в пул тем более не удастся. Взамен соединение помечается испорченным -
// в каком состоянии осталась транзакция на стороне СУБД, неизвестно, и переиспользовать такое
// соединение нельзя. Пул его закроет.
//
Процедура ИспортитьПослеНеудачногоЗавершения()

	ВТранзакции = Ложь;
	Испорчено = Истина;

КонецПроцедуры

// Определяет, пригодно ли соединение к переиспользованию.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение переиспользовать нельзя.
//
Функция Испорчено() Экспорт
	Возврат Испорчено;
КонецФункции

// Определяет, начата ли транзакция этим соединением.
//
// Возвращаемое значение:
//   Булево - Истина, если транзакция активна.
//
Функция ВТранзакции() Экспорт
	Возврат ВТранзакции;
КонецФункции

// Возвращает момент последнего возврата соединения в пул.
//
// Возвращаемое значение:
//   Число - Универсальная дата возврата в миллисекундах.
//
Функция МоментВозврата() Экспорт
	Возврат МоментВозврата;
КонецФункции

// Отмечает возврат соединения в пул.
//
// Незавершенная транзакция при этом откатывается: соединение уходит следующему потоку, и
// оставлять на нем чужую начатую транзакцию нельзя. Ошибка отката подавляется - соединение
// возвращается в пул в любом случае, иначе оно было бы потеряно.
//
Процедура ОтметитьВозврат() Экспорт

	Если ВТранзакции Тогда
		// Транзакцию бросили: исход для наблюдателей - abandoned, каким бы ни был откат.
		СобытиеБрошенной = СобытиеТранзакции;
		СобытиеТранзакции = Неопределено;
		Попытка
			ЭтотОбъект.ОтменитьТранзакцию();
			ОшибкаОтката = Неопределено;
		Исключение
			ВТранзакции = Ложь;
			ОшибкаОтката = ИнформацияОбОшибке();
		КонецПопытки;
		СобытиеТранзакции = СобытиеБрошенной;
		ЗавершитьСобытиеТранзакции("abandoned", ОшибкаОтката);
	КонецЕсли;

	МоментВозврата = ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецПроцедуры

// Закрывает соединение.
//
Процедура Закрыть() Экспорт

	ОтметитьВозврат();
	РаботаСКоннекторами.ЗакрытьКоннектор(Коннектор);

КонецПроцедуры
