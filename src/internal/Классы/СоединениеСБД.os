// АбстрактныйКоннектор - Коннектор, которым выполняются операции этого соединения.
Перем Коннектор;
// Булево - Признак начатой и еще не завершенной транзакции.
Перем ВТранзакции;
// Булево - Признак непригодности к переиспользованию: состояние соединения неизвестно.
Перем Испорчено;
// Число - Момент последнего возврата в пул в миллисекундах. По нему пул выбирает, какое
// соединение выдать следующим.
Перем МоментВозврата;
// НаблюдателиИсточникаДанных - Наблюдатели пула: получают события транзакций этого соединения.
Перем НаблюдателиПула;
// Массив из СобытиеИсточникаДанных - Стопка событий транзакций: каждое начало кладет свое
// событие, каждое завершение снимает верхнее. Пуста вне транзакции и без наблюдателей.
Перем СобытияТранзакций;

// Соединение с базой данных, выданное из пула соединений.
//
// Содержит собственный экземпляр коннектора и состояние транзакции. Соединение выдается одному
// потоку исполнения и не разделяется: именно поэтому транзакция одного фонового задания не
// может быть зафиксирована или отменена другим.
//
// Создается пулом соединений, напрямую конструировать не следует. Конструктор открывает
// соединение с базой данных.
//
// Параметры:
//   ТипКоннектора - Тип - Тип класса, реализующего интерфейс коннектора.
//   СтрокаСоединения - Строка - Строка соединения с БД.
//   ПараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//   Наблюдатели - НаблюдателиИсточникаДанных - Реестр наблюдателей пула: коннектор, объявивший
//     НаблюдаемыйКоннектор, получает его после открытия.
//
Процедура ПриСозданииОбъекта(Знач ТипКоннектора, Знач СтрокаСоединения, Знач ПараметрыКоннектора, Знач Наблюдатели)

	Коннектор = РаботаСКоннекторами.СоздатьКоннектор(ТипКоннектора);
	РаботаСКоннекторами.ОткрытьКоннектор(Коннектор, СтрокаСоединения, ПараметрыКоннектора);

	// Коннектор уже открыт: ошибка подключения наблюдателей не должна оставить его без закрытия.
	Попытка
		Наблюдатели.ПодключитьКоннектор(Коннектор);
	Исключение
		РаботаСКоннекторами.ЗакрытьКоннектор(Коннектор);
		ВызватьИсключение;
	КонецПопытки;

	НаблюдателиПула = Наблюдатели;

	СобытияТранзакций = Новый Массив;
	ВТранзакции = Ложь;
	Испорчено = Ложь;
	ОтметитьВозврат();

КонецПроцедуры

// Возвращает коннектор соединения.
//
// Возвращаемое значение:
//   АбстрактныйКоннектор - Коннектор для работы с БД.
//
Функция ПолучитьКоннектор() Экспорт
	Возврат Коннектор;
КонецФункции

// Начинает транзакцию.
//
// Вызов уходит коннектору как есть: вложенные транзакции не поддерживает ни один коннектор,
// и об этом должна сказать СУБД, а не обертка.
//
Процедура НачатьТранзакцию() Экспорт

	// Событие начинается до BEGIN и живет до исхода: фиксации, отмены, неудачи - в том числе
	// самого начала - или отката брошенной транзакции. Свое событие получает каждое начало,
	// в том числе вложенное: в трассировке вложенный вызов должен быть виден отдельным спаном.
	НачатьСобытиеТранзакции();

	Попытка
		РаботаСКоннекторами.НачатьТранзакцию(Коннектор);
	Исключение
		// Неудачное начало закрывает только свое событие: начатая раньше транзакция жива.
		ЗавершитьВерхнееСобытиеТранзакции("failed", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ВТранзакции = Истина;

КонецПроцедуры

// Фиксирует транзакцию.
//
Процедура ЗафиксироватьТранзакцию() Экспорт

	Попытка
		// Безусловно, как и коннектор без пула: транзакцию мог начать сырой запрос мимо обертки.
		РаботаСКоннекторами.ЗафиксироватьТранзакцию(Коннектор);
	Исключение
		ИспортитьПослеНеудачногоЗавершения();
		ЗавершитьВерхнееСобытиеТранзакции("failed", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ВТранзакции = Ложь;
	ЗавершитьВерхнееСобытиеТранзакции("commit");

КонецПроцедуры

// Отменяет транзакцию.
//
Процедура ОтменитьТранзакцию() Экспорт

	Попытка
		// Безусловно, как и коннектор без пула: транзакцию мог начать сырой запрос мимо обертки.
		РаботаСКоннекторами.ОтменитьТранзакцию(Коннектор);
	Исключение
		ИспортитьПослеНеудачногоЗавершения();
		ЗавершитьВерхнееСобытиеТранзакции("failed", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ВТранзакции = Ложь;
	ЗавершитьВерхнееСобытиеТранзакции("rollback");

КонецПроцедуры

// Начинает событие очередной транзакции и кладет его на вершину стопки.
//
// Без наблюдателей события нет: стопка остается пустой, завершать нечего.
//
Процедура НачатьСобытиеТранзакции()

	Событие = НаблюдателиПула.СоздатьСобытие(ВидыСобытийИсточникаДанных.Транзакция(), "Транзакция");
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СобытияТранзакций.Добавить(Событие);
	НаблюдателиПула.НачатьСобытие(Событие);

КонецПроцедуры

// Снимает со стопки верхнее событие транзакции, завершает его исходом и отдает наблюдателям.
//
// Завершение всегда относится к последнему начатому событию: события транзакций вложены строго,
// как спаны в трассировке.
//
// Параметры:
//   Исход - Строка - commit, rollback, failed или abandoned.
//   ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - Ошибка завершения.
//
Процедура ЗавершитьВерхнееСобытиеТранзакции(Знач Исход, Знач ИнформацияОбОшибке = Неопределено)

	Если СобытияТранзакций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Вершина = СобытияТранзакций.ВГраница();
	Событие = СобытияТранзакций[Вершина];
	СобытияТранзакций.Удалить(Вершина);

	Событие.УстановитьИсход(Исход);
	НаблюдателиПула.ЗавершитьСобытие(Событие, ИнформацияОбОшибке);

КонецПроцедуры

// Помечает соединение непригодным после неудавшегося завершения транзакции.
//
// Признак транзакции снимается: держать соединение за потоком больше незачем, а повторный
// откат при возврате в пул тем более не удастся. Взамен соединение помечается испорченным -
// в каком состоянии осталась транзакция на стороне СУБД, неизвестно, и переиспользовать такое
// соединение нельзя. Пул его закроет.
//
Процедура ИспортитьПослеНеудачногоЗавершения()

	ВТранзакции = Ложь;
	Испорчено = Истина;

КонецПроцедуры

// Определяет, можно ли выдать соединение потоку исполнения.
//
// Испорченное соединение непригодно по состоянию транзакции, закрытое - по состоянию коннектора.
// Закрыть соединение может и сама СУБД: перезапуском, разрывом сети, административным
// отключением. Пулу такое соединение ничем не отличается от исправного - оно вернулось в очередь
// свободных как все, - и выдавалось бы снова и снова, а каждая операция на нем падает.
//
// Возвращаемое значение:
//   Булево - Истина, если соединение можно выдать потоку исполнения.
//
Функция Пригодно() Экспорт
	Возврат НЕ Испорчено И Коннектор.Открыт();
КонецФункции

// Определяет, начата ли транзакция этим соединением.
//
// Возвращаемое значение:
//   Булево - Истина, если транзакция активна.
//
Функция ВТранзакции() Экспорт
	Возврат ВТранзакции;
КонецФункции

// Возвращает момент последнего возврата соединения в пул.
//
// Возвращаемое значение:
//   Число - Универсальная дата возврата в миллисекундах.
//
Функция МоментВозврата() Экспорт
	Возврат МоментВозврата;
КонецФункции

// Отмечает возврат соединения в пул.
//
// Незавершенная транзакция при этом откатывается: соединение уходит следующему потоку, и
// оставлять на нем чужую начатую транзакцию нельзя. Ошибка отката наружу не идет - соединение
// возвращается в пул в любом случае, иначе оно было бы потеряно, - но соединение после нее
// непригодно так же, как после неудачного явного завершения транзакции.
//
Процедура ОтметитьВозврат() Экспорт

	Если ВТранзакции Тогда
		// Транзакцию бросили: исход для наблюдателей - abandoned, каким бы ни был откат, поэтому
		// откат идет мимо ОтменитьТранзакцию - та завершила бы событие исходом rollback.
		Попытка
			РаботаСКоннекторами.ОтменитьТранзакцию(Коннектор);
			ОшибкаОтката = Неопределено;
		Исключение
			ИспортитьПослеНеудачногоЗавершения();
			ОшибкаОтката = ИнформацияОбОшибке();
		КонецПопытки;
		ВТранзакции = Ложь;
		ЗавершитьВерхнееСобытиеТранзакции("abandoned", ОшибкаОтката);
	КонецЕсли;

	// Остаток стопки - события начал, которым не досталось своего завершения: их закрывает
	// возврат соединения, потому что дальше оно уйдет другому потоку исполнения.
	Пока СобытияТранзакций.Количество() > 0 Цикл
		ЗавершитьВерхнееСобытиеТранзакции("abandoned");
	КонецЦикла;

	МоментВозврата = ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецПроцедуры

// Закрывает соединение.
//
Процедура Закрыть() Экспорт

	ОтметитьВозврат();
	РаботаСКоннекторами.ЗакрытьКоннектор(Коннектор);

КонецПроцедуры
