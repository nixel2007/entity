#Использовать decorator

// Соответствие - Тип сущности: имя зарегистрированного типа ее активной записи.
Перем ТипыЗаписей;

// БлокировкаРесурса - Защищает ТипыЗаписей и регистрацию типов: модуль общий на процесс.
Перем Блокировка;

Перем Рефлектор;

Функция ТипСущности(Сущность) Экспорт
	Возврат ОбработкаДекоратора.ИсходныйТип(Сущность);
КонецФункции

// Создает экземпляр сущности, расширенный методами паттерна Active Record.
//
// Запись работает через хранилище своего типа, кто бы ее ни создал: хранилище тип уже знает,
// поэтому в методы записи его передавать не нужно, а операцию хранилище все равно делегирует
// своему менеджеру.
//
// Экземпляр создается из типа активной записи, зарегистрированного один раз на класс сущности:
// компилировать модуль на каждый экземпляр дорого, а экземпляры заново создает каждый поток
// исполнения. Тип общий у всех менеджеров процесса, поэтому хранилище и модель проставляются
// экземпляру после создания, а не значениями полей по умолчанию: те остались бы в реестре типов
// навсегда и держали бы хранилище первого менеджера.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Модель сущности, экземпляр которой создается.
//   ХранилищеСущностей - ХранилищеСущностей - Хранилище типа этой сущности.
//
// Возвращаемое значение:
//   Произвольный - Экземпляр класса сущности с методами Прочитать, Сохранить и Удалить.
//
Функция Создать(ОбъектМодели, ХранилищеСущностей) Экспорт

	Сущность = Новый(ТипЗаписи(ОбъектМодели.ТипСущности()));

	Рефлектор.УстановитьСвойство(Сущность, "_ХранилищеСущностей", ХранилищеСущностей);
	Рефлектор.УстановитьСвойство(Сущность, "_ОбъектМодели", ОбъектМодели);

	Возврат Сущность;

КонецФункции

// Возвращает имя типа активной записи класса сущности, при первом обращении регистрируя его.
//
// Параметры:
//   ТипСущности - Тип - Класс сущности.
//
// Возвращаемое значение:
//   Строка - Имя зарегистрированного типа.
//
Функция ТипЗаписи(Знач ТипСущности)

	Блокировка.Заблокировать();

	Попытка

		ИмяТипа = ТипыЗаписей.Получить(ТипСущности);
		Если ИмяТипа = Неопределено Тогда
			ИмяТипа = ЗарегистрироватьТипЗаписи(ТипСущности);
			ТипыЗаписей.Вставить(ТипСущности, ИмяТипа);
		КонецЕсли;

	Исключение
		Ошибка = ИнформацияОбОшибке();
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ИмяТипа;

КонецФункции

// Регистрирует тип активной записи класса сущности под уникальным в процессе именем.
//
// Параметры:
//   ТипСущности - Тип - Класс сущности.
//
// Возвращаемое значение:
//   Строка - Имя зарегистрированного типа.
//
Функция ЗарегистрироватьТипЗаписи(Знач ТипСущности)

	ИмяТипа = "АктивнаяЗапись_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	Построитель = Новый ПостроительДекоратора(ТипСущности)
		.Импорт(Новый Импорт("decorator"))

		.Поле(Новый Поле("_ХранилищеСущностей"))

		.Поле(Новый Поле("_ОбъектМодели"))

		.Метод(Новый Метод("Прочитать")
					.Публичный()
					.ТелоМетода("_ДанныеСущности = _ХранилищеСущностей.ПолучитьОдно(_ОбъектМодели.ПолучитьЗначениеИдентификатора(ЭтотОбъект));
								|ОбработкаДекоратора.СинхронизироватьПоля(_ДанныеСущности, ЭтотОбъект);"))

		.Метод(Новый Метод("Сохранить")
					.Публичный()
					.ТелоМетода("_ХранилищеСущностей.Сохранить(ЭтотОбъект);"))

		.Метод(Новый Метод("Удалить")
					.Публичный()
					.ТелоМетода("_ХранилищеСущностей.Удалить(ЭтотОбъект);"));

	Построитель.ЗарегистрироватьВСистемеТипов(ИмяТипа);

	Возврат ИмяТипа;

КонецФункции

ТипыЗаписей = Новый Соответствие;
Блокировка = Новый БлокировкаРесурса;
Рефлектор = Новый Рефлектор;
