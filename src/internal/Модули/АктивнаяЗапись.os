#Использовать decorator
#Использовать collectionos

// СинхронизированнаяКарта - Имена зарегистрированных типов записей: ключ - тип сущности, значение - имя типа.
Перем ТипыЗаписей;

Функция ТипСущности(Сущность) Экспорт
	Если ОбработкаДекоратора.ЭтоДекоратор(Сущность) Тогда
		Возврат ОбработкаДекоратора.ИсходныйТип(Сущность);
	КонецЕсли;

	Возврат ТипЗнч(Сущность);
КонецФункции

// Создает экземпляр сущности, расширенный методами паттерна Active Record.
//
// Запись работает через хранилище своего типа, кто бы ее ни создал: хранилище тип уже знает,
// поэтому в методы записи его передавать не нужно, а операцию хранилище все равно делегирует
// своему менеджеру.
//
// Тип записи регистрируется в системе типов один раз на тип сущности: декоратор компилируется
// при первом создании, дальше экземпляры создаются как обычные объекты этого типа.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Модель сущности, экземпляр которой создается.
//   ХранилищеСущностей - ХранилищеСущностей - Хранилище типа этой сущности.
//
// Возвращаемое значение:
//   Произвольный - Экземпляр класса сущности с методами Прочитать, Сохранить и Удалить.
//
Функция Создать(ОбъектМодели, ХранилищеСущностей) Экспорт
	Запись = Новый(ИмяТипаЗаписи(ОбъектМодели.ТипСущности()));

	// Хранилище и модель у каждого менеджера свои, поэтому они привязываются к экземпляру,
	// а не к зарегистрированному типу.
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Запись, "_ХранилищеСущностей", ХранилищеСущностей);
	Рефлектор.УстановитьСвойство(Запись, "_ОбъектМодели", ОбъектМодели);

	Возврат Запись;
КонецФункции

// Регистрирует тип записи для типа сущности. Вызывается картой типов под ее блокировкой.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//
// Возвращаемое значение:
//   Строка - Имя зарегистрированного типа записи.
//
Функция ЗарегистрироватьТипЗаписи(ТипСущности) Экспорт
	ИмяТипа = "ЗаписьСущности_" + ТипСущности;

	Построитель = Новый ПостроительДекоратора(ТипСущности)
		.Импорт(Новый Импорт("decorator"))

		.Поле(Новый Поле("_ХранилищеСущностей"))

		.Поле(Новый Поле("_ОбъектМодели"))

		.Метод(Новый Метод("Прочитать")
					.Публичный()
					.ТелоМетода("_ДанныеСущности = _ХранилищеСущностей.ПолучитьОдно(_ОбъектМодели.ПолучитьЗначениеИдентификатора(ЭтотОбъект));
								|ОбработкаДекоратора.СинхронизироватьПоля(_ДанныеСущности, ЭтотОбъект);"))

		.Метод(Новый Метод("Сохранить")
					.Публичный()
					.ТелоМетода("_ХранилищеСущностей.Сохранить(ЭтотОбъект);"))

		.Метод(Новый Метод("Удалить")
					.Публичный()
					.ТелоМетода("_ХранилищеСущностей.Удалить(ЭтотОбъект);"));

	Построитель.ЗарегистрироватьВСистемеТипов(ИмяТипа);

	Возврат ИмяТипа;
КонецФункции

Функция ИмяТипаЗаписи(ТипСущности)
	ИмяТипа = ТипыЗаписей.ПолучитьИлиУмолчание(ТипСущности, Неопределено);
	Если ИмяТипа <> Неопределено Тогда
		Возврат ИмяТипа;
	КонецЕсли;

	// Проверка и регистрация под одной блокировкой: тип регистрируется ровно один раз на процесс.
	Возврат ТипыЗаписей.ВычислитьЕслиОтсутствует(
		ТипСущности,
		"(ТипСущности) -> АктивнаяЗапись.ЗарегистрироватьТипЗаписи(ТипСущности)"
	).Получить();
КонецФункции

ТипыЗаписей = Новый СинхронизированнаяКарта(Новый КартаСоответствие());
