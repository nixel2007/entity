// Соединение под операцию источника данных: захват и возврат, парные событию операции.
//
// Обе половины протокола операции живут здесь: соединение берется под уже начатое событие и
// возвращается вместе с его завершением. Коннектора модуль не касается - он о пуле и наблюдателях.

#Использовать logos

// Лог - Журнал операций источника данных.
Перем Лог;

// Занимает соединение для начатой операции.
//
// Захват может не удаться - пул закрыт или предел ожидания исчерпан. Такая операция должна
// завершиться для наблюдателей ошибкой, а не остаться начатой навсегда.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул, из которого берется соединение.
//   Событие - СобытиеИсточникаДанных, Неопределено - Событие операции из НачатьОперацию.
//
// Возвращаемое значение:
//   СоединениеСБД - Соединение текущего потока исполнения.
//
Функция ЗанятьДляОперации(Пул, Событие) Экспорт

	Попытка
		Соединение = Пул.Занять();
	Исключение
		Пул.Наблюдатели().ЗавершитьОперацию(Событие, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	Возврат Соединение;

КонецФункции

// Возвращает соединение операции в пул и завершает событие операции.
//
// Освобождение может не удаться: пул закрывает непригодное соединение, а закрытие идет в СУБД
// и падает вместе с ней. Событие операции завершается в любом случае - иначе наблюдатель не
// получит ПослеСобытия, а вложенность операций потока так и останется увеличенной.
//
// Ошибка освобождения идет наружу, только если операция прошла успешно. Упади они обе, наружу
// уходит ошибка операции: она первопричина, а неудачное освобождение - ее следствие.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул, которому возвращается соединение.
//   Наблюдатели - НаблюдателиИсточникаДанных - Реестр наблюдателей пула.
//   Событие - СобытиеИсточникаДанных, Неопределено - Событие операции из НачатьОперацию.
//   ОшибкаОперации - ИнформацияОбОшибке, Неопределено - Ошибка, которой завершилась операция.
//   КоличествоСтрок - Число, Неопределено - Число прочитанных операцией строк.
//
Процедура ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие,
	Знач ОшибкаОперации = Неопределено, Знач КоличествоСтрок = Неопределено) Экспорт

	Попытка
		Пул.Освободить();
	Исключение

		Если ОшибкаОперации <> Неопределено Тогда
			Лог.Ошибка(
				"Не удалось освободить соединение после ошибки операции: %1",
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			Наблюдатели.ЗавершитьОперацию(Событие, ОшибкаОперации);
			Возврат;
		КонецЕсли;

		Наблюдатели.ЗавершитьОперацию(Событие, ИнформацияОбОшибке(), КоличествоСтрок);
		ВызватьИсключение;

	КонецПопытки;

	Наблюдатели.ЗавершитьОперацию(Событие, ОшибкаОперации, КоличествоСтрок);

КонецПроцедуры

Процедура Инициализация()
	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.operations");
КонецПроцедуры

Инициализация();
