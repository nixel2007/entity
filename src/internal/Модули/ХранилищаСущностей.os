// Пул хранилищ сущностей: соответствие типа сущности хранилищу, общее на процесс.
//
// Ключ учитывает еще тип коннектора и строку соединения, поэтому хранилища разных баз не
// смешиваются. Обращения идут на каждую прочитанную сущность и на каждое разыменование ссылки,
// притом из разных потоков, поэтому попадание в кэш читается под блокировкой чтения:
// сериализуется только создание.
//
#Использовать "../concurrent"

// Соответствие - Ключ хранилища и структура с хранилищем и признаками его базы.
Перем Хранилища;
// БлокировкаЧтенияЗаписи - Защищает пул: он общий на все потоки.
Перем Блокировка;

// Возвращает хранилище сущностей, создавая его при первом обращении.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Модель сущности, для которой нужно хранилище.
//   Пул - ПулСоединенийСБД - Пул, которым хранилище выполняет операции.
//
// Возвращаемое значение:
//   ХранилищеСущностей - Хранилище для переданной модели.
//
Функция Получить(ОбъектМодели, Пул) Экспорт

	КлючХранилища = ПолучитьКлючХранилища(
		ОбъектМодели.ТипСущности(),
		Пул.ТипКоннектора(),
		Пул.СтрокаСоединения()
	);

	Блокировка.Чтение().Заблокировать();
	ДанныеХранилища = Хранилища.Получить(КлючХранилища);
	Блокировка.Чтение().Разблокировать();

	Если ДанныеХранилища <> Неопределено Тогда
		Возврат ДанныеХранилища.Хранилище;
	КонецЕсли;

	Блокировка.Запись().Заблокировать();

	Попытка

		// Пока ждали запись, хранилище мог создать другой поток.
		ДанныеХранилища = Хранилища.Получить(КлючХранилища);
		Если ДанныеХранилища = Неопределено Тогда
			ДанныеХранилища = Новый Структура("Хранилище, ТипКоннектора, СтрокаСоединения");
			ДанныеХранилища.Хранилище = Новый ХранилищеСущностей(ОбъектМодели, Пул);
			ДанныеХранилища.ТипКоннектора = Пул.ТипКоннектора();
			ДанныеХранилища.СтрокаСоединения = Пул.СтрокаСоединения();
			Хранилища.Вставить(КлючХранилища, ДанныеХранилища);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Возврат ДанныеХранилища.Хранилище;

КонецФункции

// Закрывает и убирает из пула хранилища указанной базы.
//
// Параметры:
//   ТипКоннектора - Тип - Тип коннектора закрываемой базы.
//   СтрокаСоединения - Строка - Строка соединения закрываемой базы.
//
Процедура Закрыть(ТипКоннектора, СтрокаСоединения) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		ЗакрываемыеХранилища = Новый Массив;
		Для Каждого КлючИЗначение Из Хранилища Цикл
			ДанныеХранилища = КлючИЗначение.Значение;

			Если ДанныеХранилища.ТипКоннектора = ТипКоннектора
				И ДанныеХранилища.СтрокаСоединения = СтрокаСоединения Тогда

				ДанныеХранилища.Хранилище.Закрыть();
				ЗакрываемыеХранилища.Добавить(КлючИЗначение.Ключ);

			КонецЕсли;
		КонецЦикла;

		Для Каждого ЗакрываемоеХранилище Из ЗакрываемыеХранилища Цикл
			Хранилища.Удалить(ЗакрываемоеХранилище);
		КонецЦикла;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Составляет ключ хранилища.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ТипКоннектора - Тип - Тип коннектора.
//   СтрокаСоединения - Строка - Строка соединения.
//
// Возвращаемое значение:
//   Строка - Ключ хранилища.
//
Функция ПолучитьКлючХранилища(ТипСущности, ТипКоннектора, СтрокаСоединения)
	Возврат СтрШаблон(
		"%1 - %2 - %3",
		ТипСущности,
		ТипКоннектора,
		СтрокаСоединения
	);
КонецФункции

Хранилища = Новый Соответствие();
Блокировка = Новый БлокировкаЧтенияЗаписи();
