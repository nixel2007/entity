// Пул хранилищ сущностей: соответствие пула соединений и типа сущности хранилищу, общее на процесс.
//
// Ключ - пул соединений источника данных, поэтому хранилища разных источников не смешиваются,
// а менеджеры одного источника делят хранилища. Обращения идут на каждую прочитанную сущность
// и на каждое разыменование ссылки, притом из разных потоков, поэтому попадание в кэш читается
// под блокировкой чтения: сериализуется только создание.
//
#Использовать "../concurrent"

// Соответствие - Пул соединений: соответствие типа сущности хранилищу.
Перем Хранилища;
// БлокировкаЧтенияЗаписи - Защищает пул: он общий на все потоки.
Перем Блокировка;

// Возвращает хранилище сущностей, создавая его при первом обращении.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Модель сущности, для которой нужно хранилище.
//   Пул - ПулСоединенийСБД - Пул, которым хранилище выполняет операции.
//
// Возвращаемое значение:
//   ХранилищеСущностей - Хранилище для переданной модели.
//
Функция Получить(ОбъектМодели, Пул) Экспорт

	ТипСущности = ОбъектМодели.ТипСущности();

	Блокировка.Чтение().Заблокировать();
	Хранилище = НайтиХранилище(Пул, ТипСущности);
	Блокировка.Чтение().Разблокировать();

	Если Хранилище <> Неопределено Тогда
		Возврат Хранилище;
	КонецЕсли;

	Блокировка.Запись().Заблокировать();

	Попытка

		// Пока ждали запись, хранилище мог создать другой поток.
		Хранилище = НайтиХранилище(Пул, ТипСущности);
		Если Хранилище = Неопределено Тогда
			ХранилищаПула = Хранилища.Получить(Пул);
			Если ХранилищаПула = Неопределено Тогда
				ХранилищаПула = Новый Соответствие;
				Хранилища.Вставить(Пул, ХранилищаПула);
			КонецЕсли;
			Хранилище = Новый ХранилищеСущностей(ОбъектМодели, Пул);
			ХранилищаПула.Вставить(ТипСущности, Хранилище);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Возврат Хранилище;

КонецФункции

// Закрывает и убирает из пула хранилища указанного пула соединений.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул соединений закрываемого источника данных.
//
Процедура Закрыть(Пул) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		ХранилищаПула = Хранилища.Получить(Пул);
		Если ХранилищаПула <> Неопределено Тогда
			Для Каждого КлючИЗначение Из ХранилищаПула Цикл
				КлючИЗначение.Значение.Закрыть();
			КонецЦикла;
			Хранилища.Удалить(Пул);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Ищет хранилище в пуле. Вызывается при захваченной блокировке.
//
// Параметры:
//   Пул - ПулСоединенийСБД - Пул соединений.
//   ТипСущности - Тип - Тип сущности.
//
// Возвращаемое значение:
//   ХранилищеСущностей, Неопределено - Хранилище или Неопределено, если его еще нет.
//
Функция НайтиХранилище(Пул, ТипСущности)

	ХранилищаПула = Хранилища.Получить(Пул);
	Если ХранилищаПула = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ХранилищаПула.Получить(ТипСущности);

КонецФункции

Хранилища = Новый Соответствие();
Блокировка = Новый БлокировкаЧтенияЗаписи();
