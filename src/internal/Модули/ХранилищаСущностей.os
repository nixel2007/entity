// Пул хранилищ сущностей: соответствие источника данных и типа сущности хранилищу, общее на процесс.
//
// Ключ - источник данных, поэтому хранилища разных источников не смешиваются, а менеджеры одного
// источника делят хранилища. Обращения идут на каждую прочитанную сущность и на каждое
// разыменование ссылки, притом из разных потоков, поэтому попадание в кэш читается под
// блокировкой чтения: сериализуется только создание.
//
#Использовать "../concurrent"

// Соответствие - Источник данных: соответствие типа сущности хранилищу.
Перем Хранилища;
// БлокировкаЧтенияЗаписи - Защищает пул: он общий на все потоки.
Перем Блокировка;

// Возвращает хранилище сущностей, создавая его при первом обращении. Для закрытого источника
// хранилище не создается: обращение завершается ошибкой.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Модель сущности, для которой нужно хранилище.
//   Источник - ИсточникДанных - Источник, соединениями которого хранилище выполняет операции.
//
// Возвращаемое значение:
//   ХранилищеСущностей - Хранилище для переданной модели.
//
Функция Получить(ОбъектМодели, Источник) Экспорт

	ТипСущности = ОбъектМодели.ТипСущности();

	Блокировка.Чтение().Заблокировать();
	Хранилище = НайтиХранилище(Источник, ТипСущности);
	Блокировка.Чтение().Разблокировать();

	Если Хранилище <> Неопределено Тогда
		Возврат Хранилище;
	КонецЕсли;

	Блокировка.Запись().Заблокировать();

	Попытка

		// Пока ждали запись, хранилище мог создать другой поток.
		Хранилище = НайтиХранилище(Источник, ТипСущности);
		Если Хранилище = Неопределено Тогда
			// Закрытый источник свои хранилища уже убрал: новое легло бы в кэш навсегда.
			Если Источник.Закрыт() Тогда
				ВызватьИсключение СтрШаблон("Источник данных <%1> закрыт", Источник.Имя());
			КонецЕсли;
			ХранилищаИсточника = Хранилища.Получить(Источник);
			Если ХранилищаИсточника = Неопределено Тогда
				ХранилищаИсточника = Новый Соответствие;
				Хранилища.Вставить(Источник, ХранилищаИсточника);
			КонецЕсли;
			Хранилище = Новый ХранилищеСущностей(ОбъектМодели, Источник);
			ХранилищаИсточника.Вставить(ТипСущности, Хранилище);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Возврат Хранилище;

КонецФункции

// Закрывает и убирает из пула хранилища указанного источника данных.
//
// Параметры:
//   Источник - ИсточникДанных - Закрываемый источник данных.
//
Процедура Закрыть(Источник) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		ХранилищаИсточника = Хранилища.Получить(Источник);
		Если ХранилищаИсточника <> Неопределено Тогда
			Для Каждого КлючИЗначение Из ХранилищаИсточника Цикл
				КлючИЗначение.Значение.Закрыть();
			КонецЦикла;
			Хранилища.Удалить(Источник);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Ищет хранилище в пуле. Вызывается при захваченной блокировке.
//
// Параметры:
//   Источник - ИсточникДанных - Источник данных.
//   ТипСущности - Тип - Тип сущности.
//
// Возвращаемое значение:
//   ХранилищеСущностей, Неопределено - Хранилище или Неопределено, если его еще нет.
//
Функция НайтиХранилище(Источник, ТипСущности)

	ХранилищаИсточника = Хранилища.Получить(Источник);
	Если ХранилищаИсточника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ХранилищаИсточника.Получить(ТипСущности);

КонецФункции

Хранилища = Новый Соответствие();
Блокировка = Новый БлокировкаЧтенияЗаписи();
