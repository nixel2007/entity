// Реестр хранилищ сущностей, общий на процесс.
//
// Хранилище создается один раз на сочетание типа сущности, типа коннектора и строки соединения,
// а вот обращения к реестру идут на каждую прочитанную сущность и на каждое разыменование ссылки,
// притом из разных потоков. Поэтому попадание в кэш читается под блокировкой чтения: читатели
// друг друга не задерживают, а сериализуется только само создание.
//
#Использовать "../concurrent"

// Соответствие: ключ хранилища - хранилище сущностей.
Перем Хранилища;
// Защищает реестр: он общий на все потоки.
Перем Блокировка;

// Возвращает хранилище сущностей, создавая его при первом обращении.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Модель сущности, для которой нужно хранилище.
//   Коннектор - АбстрактныйКоннектор - Коннектор, определяющий базу хранилища.
//   Пул - ПулСоединений - Пул, которым хранилище выполняет операции.
//
// Возвращаемое значение:
//   ХранилищеСущностей - Хранилище для переданной модели.
//
Функция Получить(ОбъектМодели, Коннектор, Пул) Экспорт

	СвойстваКоннектора = РаботаСКоннекторами.ПолучитьСвойстваКоннектора(Коннектор);

	КлючХранилища = ПолучитьКлючХранилища(
		ОбъектМодели.ТипСущности(),
		ТипЗнч(Коннектор),
		СвойстваКоннектора.СтрокаСоединения
	);

	Блокировка.Чтение().Заблокировать();
	ХранилищеСущностей = Хранилища.Получить(КлючХранилища);
	Блокировка.Чтение().Разблокировать();

	Если ХранилищеСущностей <> Неопределено Тогда
		Возврат ХранилищеСущностей;
	КонецЕсли;

	Блокировка.Запись().Заблокировать();

	Попытка

		// Пока ждали запись, хранилище мог создать другой контекст.
		ХранилищеСущностей = Хранилища.Получить(КлючХранилища);
		Если ХранилищеСущностей = Неопределено Тогда
			ХранилищеСущностей = Новый ХранилищеСущностей(
				ОбъектМодели,
				ТипЗнч(Коннектор),
				СвойстваКоннектора.СтрокаСоединения,
				СвойстваКоннектора.Параметры,
				Пул
			);
			Хранилища.Вставить(КлючХранилища, ХранилищеСущностей);
		КонецЕсли;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

	Возврат ХранилищеСущностей;

КонецФункции

// Закрывает и убирает из реестра хранилища указанной базы.
//
// Параметры:
//   ТипКоннектора - Тип - Тип коннектора закрываемой базы.
//   СтрокаСоединения - Строка - Строка соединения закрываемой базы.
//   ПараметрыКоннектора - Массив - Параметры коннектора. Не участвуют в отборе.
//
Процедура Закрыть(ТипКоннектора, СтрокаСоединения, ПараметрыКоннектора) Экспорт

	Блокировка.Запись().Заблокировать();

	Попытка

		ЗакрываемыеХранилища = Новый Массив;
		Для Каждого КлючИЗначение Из Хранилища Цикл
			Хранилище = КлючИЗначение.Значение;
			КоннекторХранилища = Хранилище.ПолучитьКоннектор();
			СвойстваКоннектора = РаботаСКоннекторами.ПолучитьСвойстваКоннектора(КоннекторХранилища);

			Если ТипКоннектора = ТипЗнч(КоннекторХранилища) И СтрокаСоединения = СвойстваКоннектора.СтрокаСоединения Тогда
				Хранилище.Закрыть();
				ЗакрываемыеХранилища.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;

		Для Каждого ЗакрываемоеХранилище Из ЗакрываемыеХранилища Цикл
			Хранилища.Удалить(ЗакрываемоеХранилище);
		КонецЦикла;

	Исключение

		Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Составляет ключ хранилища.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ТипКоннектора - Тип - Тип коннектора.
//   СтрокаСоединения - Строка - Строка соединения.
//
// Возвращаемое значение:
//   Строка - Ключ хранилища.
//
Функция ПолучитьКлючХранилища(ТипСущности, ТипКоннектора, СтрокаСоединения)
	Возврат СтрШаблон(
		"%1 - %2 - %3",
		ТипСущности,
		ТипКоннектора,
		СтрокаСоединения
	);
КонецФункции

Хранилища = Новый Соответствие();
Блокировка = Новый БлокировкаЧтенияЗаписи();
