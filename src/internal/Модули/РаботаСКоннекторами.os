#Использовать asserts
#Использовать lambdas

Перем СвойстваКоннекторов;

Функция СоздатьКоннектор(ТипКоннектора) Экспорт
	Коннектор = Новый(ТипКоннектора);
	СвойстваКоннектора = Конструктор_СвойстваКоннектора();
	СвойстваКоннекторов.Вставить(Коннектор, СвойстваКоннектора);

	Возврат Коннектор;
КонецФункции

Процедура ОткрытьКоннектор(Коннектор, СтрокаСоединения, ПараметрыКоннектора) Экспорт
	СвойстваКоннектора = СвойстваКоннекторов.Получить(Коннектор);
	СвойстваКоннектора.СтрокаСоединения = СтрокаСоединения;
	СвойстваКоннектора.Параметры = ПараметрыКоннектора;

	Коннектор.Открыть(СтрокаСоединения, ПараметрыКоннектора);
КонецПроцедуры

Процедура ЗакрытьКоннектор(Коннектор) Экспорт
	Если Коннектор.Открыт() Тогда
		Коннектор.Закрыть();
	КонецЕсли;
КонецПроцедуры

// Сохраняет сущность в БД соединением из пула.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   Сущность - Произвольный - Сохраняемая сущность.
//
Процедура СохранитьЧерезПул(Пул, ОбъектМодели, ПулСущностей, Сущность) Экспорт
	ВыполнитьЧерезПул(Пул, "Сохранить", ОбъектМодели, ПулСущностей, Сущность);
КонецПроцедуры

// Ищет сущности соединением из пула.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   ОпцииПоиска - ОпцииПоиска - Опции поиска.
//
// Возвращаемое значение:
//   Массив - Найденные сущности.
//
Функция ПолучитьЧерезПул(Пул, ОбъектМодели, ПулСущностей, ОпцииПоиска) Экспорт
	Возврат ВыполнитьЧерезПул(Пул, "Получить", ОбъектМодели, ПулСущностей, ОпцииПоиска);
КонецФункции

// Ищет одну сущность соединением из пула.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   ОпцииПоиска - ОпцииПоиска - Опции поиска.
//
// Возвращаемое значение:
//   Произвольный - Найденная сущность.
//   Неопределено - Сущность не найдена.
//
Функция ПолучитьОдноЧерезПул(Пул, ОбъектМодели, ПулСущностей, ОпцииПоиска) Экспорт
	Возврат ВыполнитьЧерезПул(Пул, "ПолучитьОдно", ОбъектМодели, ПулСущностей, ОпцииПоиска);
КонецФункции

// Удаляет сущность из БД соединением из пула.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   Сущность - Произвольный - Удаляемая сущность.
//
Процедура УдалитьЧерезПул(Пул, ОбъектМодели, ПулСущностей, Сущность) Экспорт
	ВыполнитьЧерезПул(Пул, "Удалить", ОбъектМодели, ПулСущностей, Сущность);
КонецПроцедуры

// Выполняет алгоритм коннектором из пула и возвращает соединение обратно.
//
// Соединение занимается на время выполнения алгоритма. Если текущий контекст исполнения уже
// начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
Процедура ВыполнитьСКоннекторомЧерезПул(Пул, Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт

	Действие = ПостроитьДействие(Алгоритм, Контекст, Объект, ФункциональныеИнтерфейсы.УниПроцедура());

	Соединение = Пул.Занять();

	Попытка
		Действие.Выполнить(Соединение.ПолучитьКоннектор());
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Пул.Освободить();

КонецПроцедуры

// Вычисляет значение алгоритмом, выполненным коннектором из пула, и возвращает соединение обратно.
//
// Соединение занимается на время выполнения алгоритма. Если текущий контекст исполнения уже
// начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
// Возвращаемое значение:
//   Произвольный - Результат алгоритма.
//
Функция ВычислитьСКоннекторомЧерезПул(Пул, Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт

	Действие = ПостроитьДействие(Алгоритм, Контекст, Объект, ФункциональныеИнтерфейсы.УниФункция());

	Соединение = Пул.Занять();

	Попытка
		Результат = Действие.Выполнить(Соединение.ПолучитьКоннектор());
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Пул.Освободить();

	Возврат Результат;

КонецФункции

// Строит действие по лямбда-выражению.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//   Интерфейс - ИнтерфейсОбъекта - Функциональный интерфейс, которому должно отвечать выражение.
//
// Возвращаемое значение:
//   Действие - Действие на метод лямбда-выражения.
//
Функция ПостроитьДействие(Знач Алгоритм, Знач Контекст, Объект, Интерфейс)

	Выражение = Лямбда.Выражение(Алгоритм).Интерфейс(Интерфейс);

	Если Контекст <> Неопределено Тогда
		Выражение = Выражение.Контекст(Контекст);
	КонецЕсли;

	Если Объект <> Неопределено Тогда
		Выражение = Выражение.ЗахватитьОбъект(Объект);
	КонецЕсли;

	Возврат Выражение.ВДействие();

КонецФункции

// Начинает транзакцию текущего контекста исполнения.
//
// Контекст занимает соединение и держит его до фиксации или отмены, поэтому все его операции
// попадают в эту транзакцию, а завершить ее другой контекст не может.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//
Процедура НачатьТранзакциюКонтекста(Пул) Экспорт

	Соединение = Пул.Занять();

	Попытка
		Соединение.НачатьТранзакцию();
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Фиксирует транзакцию текущего контекста исполнения и возвращает соединение в пул.
//
// Параметры:
//   Пул - ПулСоединений - Пул, которому принадлежит соединение.
//
Процедура ЗафиксироватьТранзакциюКонтекста(Пул) Экспорт
	ЗавершитьТранзакциюКонтекста(Пул, Истина);
КонецПроцедуры

// Отменяет транзакцию текущего контекста исполнения и возвращает соединение в пул.
//
// Параметры:
//   Пул - ПулСоединений - Пул, которому принадлежит соединение.
//
Процедура ОтменитьТранзакциюКонтекста(Пул) Экспорт
	ЗавершитьТранзакциюКонтекста(Пул, Ложь);
КонецПроцедуры

// Завершает транзакцию текущего контекста и освобождает его соединение.
//
// Соединение освобождается в любом случае: если завершение не удалось, держать его за контекстом
// тем более незачем.
//
// Параметры:
//   Пул - ПулСоединений - Пул, которому принадлежит соединение.
//   Фиксировать - Булево - Истина - зафиксировать транзакцию, Ложь - отменить.
//
Процедура ЗавершитьТранзакциюКонтекста(Пул, Знач Фиксировать)

	Соединение = Пул.СоединениеТекущегоКонтекста();
	Если Соединение = Неопределено Тогда
		// Транзакции не было. Ведем себя как коннектор без пула: пусть об этом скажет СУБД.
		Соединение = Пул.Занять();
	КонецЕсли;

	Попытка
		Если Фиксировать Тогда
			Соединение.ЗафиксироватьТранзакцию();
		Иначе
			Соединение.ОтменитьТранзакцию();
		КонецЕсли;
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Пул.Освободить();

КонецПроцедуры

// Единственное место, где операция занимает соединение и возвращает его в пул.
//
// Захват реентерабельный, поэтому операция внутри транзакции получает соединение этой транзакции
// и попадает в нее.
//
// Параметры:
//   Пул - ПулСоединений - Пул, из которого берется соединение.
//   ИмяОперации - Строка - Сохранить, Получить, ПолучитьОдно или Удалить.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   Аргумент - Произвольный - Сущность либо опции поиска, смотря по операции.
//
// Возвращаемое значение:
//   Произвольный - Результат операции.
//
Функция ВыполнитьЧерезПул(Пул, Знач ИмяОперации, ОбъектМодели, ПулСущностей, Аргумент)

	Соединение = Пул.Занять();

	Попытка
		Результат = ВыполнитьКоннектором(
			Соединение.ПолучитьКоннектор(),
			Пул,
			ИмяОперации,
			ОбъектМодели,
			ПулСущностей,
			Аргумент
		);
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Пул.Освободить();

	Возврат Результат;

КонецФункции

// Выполняет операцию уже занятым коннектором.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Пул - ПулСоединений - Пул, из которого взято соединение. Нужен хранилищам ссылочных типов.
//   ИмяОперации - Строка - Сохранить, Получить, ПолучитьОдно или Удалить.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   Аргумент - Произвольный - Сущность либо опции поиска, смотря по операции.
//
// Возвращаемое значение:
//   Произвольный - Результат операции.
//
Функция ВыполнитьКоннектором(Коннектор, Пул, Знач ИмяОперации, ОбъектМодели, ПулСущностей, Аргумент)

	Если ИмяОперации = "Получить" Тогда
		Возврат Получить(Коннектор, Пул, ОбъектМодели, ПулСущностей, Аргумент);
	ИначеЕсли ИмяОперации = "ПолучитьОдно" Тогда
		Возврат ПолучитьОдно(Коннектор, Пул, ОбъектМодели, ПулСущностей, Аргумент);
	ИначеЕсли ИмяОперации = "Сохранить" Тогда
		Сохранить(Коннектор, ОбъектМодели, ПулСущностей, Аргумент);
	Иначе
		Удалить(Коннектор, ОбъектМодели, ПулСущностей, Аргумент);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура Сохранить(Коннектор, ОбъектМодели, ПулСущностей, Сущность) Экспорт
	ТипСущности = АктивнаяЗапись.ТипСущности(Сущность);

	ПроверитьЧтоКлассЯвляетсяСущностью(ТипСущности);
	ПроверитьЧтоТипСущностиЗарегистрированВМодели(ОбъектМодели);
	ПроверитьНеобходимостьЗаполненияИдентификатора(ОбъектМодели, Сущность);
	
	Коннектор.Сохранить(ОбъектМодели, Сущность);
	
	// Сохранение полей, расширяемых таблицами
	ПодчиненныеТаблицы = ОбъектМодели.ПодчиненныеТаблицы();
	Для Каждого ПодчиненнаяТаблица Из ПодчиненныеТаблицы Цикл
		
		ОбъектМоделиЭлементКоллекции = ОбработкаКоллекций.ПолучитьОбъектМоделиДляПодчиненнойТаблицы(
			ОбъектМодели,
			ПодчиненнаяТаблица
		);
		
		// Очистка подчиненной таблицы
		ОпцииПоиска = Новый ОпцииПоиска();
		ОпцииПоиска.Отбор("ref", ВидСравнения.Равно, ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность));
		Коннектор.УдалитьСтрокиВТаблице(ОбъектМоделиЭлементКоллекции, ОпцииПоиска);
		
		РасширяемоеПоле = ОбъектМодели.ПолучитьЗначениеПоля(Сущность, ПодчиненнаяТаблица.ИмяПоля);
		
		Если НЕ ЗначениеЗаполнено(РасширяемоеПоле) Тогда
			Продолжить;
		КонецЕсли;
		
		КоллекцияСущностей = ОбработкаКоллекций.ПреобразоватьКоллекциюККоллекцииСущностей(
			РасширяемоеПоле,
			Сущность,
			ОбъектМодели,
			ПодчиненнаяТаблица
		);
		
		Для Каждого ЭлементКоллекции Из КоллекцияСущностей Цикл
			Коннектор.Сохранить(ОбъектМоделиЭлементКоллекции, ЭлементКоллекции);
		КонецЦикла;
		
	КонецЦикла;

	ПулСущностей.Вставить(ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность), Сущность);
КонецПроцедуры

Функция Получить(Коннектор, Пул, ОбъектМодели, ПулСущностей, ОпцииПоиска) Экспорт

	Колонки = ОбъектМодели.Колонки();
	ПередаваемыеОпцииПоиска = ПреобразоватьОпцииПоиска(Колонки, ОпцииПоиска);

	НайденныеСущности = Новый Массив;
	НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, ПередаваемыеОпцииПоиска);

	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл

		ЗначениеИдентификатора = ОбъектМодели.ПривестиЗначениеПоля(
			НайденнаяСтрока.Получить(ОбъектМодели.Идентификатор().ИмяКолонки),
			ОбъектМодели.Идентификатор().ИмяПоля
		);

		Сущность = ПолучитьСущностьИзПула(Коннектор, Пул, ОбъектМодели, ПулСущностей, ЗначениеИдентификатора);

		ЗаполнитьКолонки(Сущность, НайденнаяСтрока, Коннектор, Пул, ОбъектМодели, ЗначениеИдентификатора);
		ЗаполнитьПодчиненныеТаблицы(Сущность, Коннектор, Пул, ОбъектМодели, ЗначениеИдентификатора);

		НайденныеСущности.Добавить(Сущность);

	КонецЦикла;

	Возврат НайденныеСущности;

КонецФункции

// Переводит опции поиска с имен полей на имена колонок таблицы.
//
// Параметры:
//   Колонки - ТаблицаЗначений - Описание колонок модели.
//   ОпцииПоиска - Соответствие, ОпцииПоиска - Опции поиска в терминах полей.
//
// Возвращаемое значение:
//   ОпцииПоиска - Опции поиска в терминах колонок таблицы.
//
Функция ПреобразоватьОпцииПоиска(Колонки, ОпцииПоиска)

	ПередаваемыеОпцииПоиска = Новый ОпцииПоиска();

	Если ТипЗнч(ОпцииПоиска) = Тип("Соответствие") Тогда

		Для Каждого КлючИЗначение Из ОпцииПоиска Цикл
			Колонка = НайтиКолонкуПоИмениПоля(Колонки, КлючИЗначение.Ключ);
			ПередаваемыеОпцииПоиска.Отбор(Колонка.ИмяКолонки, ВидСравнения.Равно, КлючИЗначение.Значение);
		КонецЦикла;

		Возврат ПередаваемыеОпцииПоиска;

	КонецЕсли;

	Если ТипЗнч(ОпцииПоиска) <> Тип("ОпцииПоиска") Тогда
		ВызватьИсключение "В метод получения данных передан неожиданный тип опций поиска: " + ТипЗнч(ОпцииПоиска);
	КонецЕсли;

	Для Каждого ЭлементОтбора Из ОпцииПоиска.Отборы() Цикл
		Колонка = НайтиКолонкуПоИмениПоля(Колонки, ЭлементОтбора.ПутьКДанным);
		ПередаваемыеОпцииПоиска.Отбор(Колонка.ИмяКолонки, ЭлементОтбора.ВидСравнения, ЭлементОтбора.Значение);
	КонецЦикла;

	Для Каждого ЭлементПорядка Из ОпцииПоиска.Сортировки() Цикл
		Колонка = НайтиКолонкуПоИмениПоля(Колонки, ЭлементПорядка.ПутьКДанным);
		ПередаваемыеОпцииПоиска.СортироватьПо(Колонка.ИмяКолонки, ЭлементПорядка.НаправлениеСортировки);
	КонецЦикла;

	ПередаваемыеОпцииПоиска.Смещение(ОпцииПоиска.ВыбираетсяСоСмещением());
	ПередаваемыеОпцииПоиска.Первые(ОпцииПоиска.ВыбираютсяПервые());

	Возврат ПередаваемыеОпцииПоиска;

КонецФункции

// Находит описание колонки по имени поля сущности.
//
// Параметры:
//   Колонки - ТаблицаЗначений - Описание колонок модели.
//   ИмяПоля - Строка - Имя поля сущности.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений - Описание колонки.
//
Функция НайтиКолонкуПоИмениПоля(Колонки, Знач ИмяПоля)

	Колонка = Колонки.Найти(ИмяПоля, "ИмяПоля");
	Ожидаем.Что(
		Колонка,
		СтрШаблон("Не удалось найти данные о колонке по имени поля %1", ИмяПоля)
	).Не_().Равно(Неопределено);

	Возврат Колонка;

КонецФункции

// Возвращает экземпляр сущности из пула сущностей, создавая его при первом обращении.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Пул - ПулСоединений - Пул, из которого взято соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - Соответствие - Ранее прочитанные экземпляры сущностей.
//   ЗначениеИдентификатора - Произвольный - Идентификатор сущности.
//
// Возвращаемое значение:
//   Произвольный - Экземпляр сущности.
//
Функция ПолучитьСущностьИзПула(Коннектор, Пул, ОбъектМодели, ПулСущностей, Знач ЗначениеИдентификатора)

	Сущность = ПулСущностей.Получить(ЗначениеИдентификатора);
	Если Сущность <> Неопределено Тогда
		Возврат Сущность;
	КонецЕсли;

	ХранилищеСущностей = ХранилищаСущностей.Получить(ОбъектМодели, Пул);
	Сущность = АктивнаяЗапись.СоздатьИзХранилища(ОбъектМодели, ХранилищеСущностей);
	ПулСущностей.Вставить(ЗначениеИдентификатора, Сущность);

	Возврат Сущность;

КонецФункции

// Заполняет поля сущности значениями колонок прочитанной строки, разыменовывая ссылки.
//
// Параметры:
//   Сущность - Произвольный - Заполняемая сущность.
//   НайденнаяСтрока - Соответствие - Прочитанная строка таблицы.
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Пул - ПулСоединений - Пул, из которого взято соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ЗначениеИдентификатора - Произвольный - Идентификатор заполняемой сущности.
//
Процедура ЗаполнитьКолонки(Сущность, НайденнаяСтрока, Коннектор, Пул, ОбъектМодели, Знач ЗначениеИдентификатора)

	Для Каждого Колонка Из ОбъектМодели.Колонки() Цикл

		ЗначениеКолонки = НайденнаяСтрока.Получить(Колонка.ИмяКолонки);

		Если Колонка.ТипКолонки = ТипыКолонок.Ссылка И ЗначениеЗаполнено(ЗначениеКолонки) Тогда
			ЗначениеКолонки = РазыменоватьСсылку(
				ЗначениеКолонки,
				Колонка.ТипСсылки,
				Коннектор,
				Пул,
				ОбъектМодели,
				Сущность,
				ЗначениеИдентификатора
			);
		КонецЕсли;

		ОбъектМодели.УстановитьЗначениеКолонкиВПоле(Сущность, Колонка.ИмяКолонки, ЗначениеКолонки);

	КонецЦикла;

КонецПроцедуры

// Читает сущность, на которую указывает ссылочная колонка.
//
// Ссылка сущности на саму себя не читается повторно: возвращается уже собранный экземпляр,
// иначе чтение зациклилось бы.
//
// Параметры:
//   ЗначениеКолонки - Произвольный - Идентификатор сущности, на которую указывает ссылка.
//   ТипСсылки - Тип - Тип сущности, на которую указывает ссылка.
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Пул - ПулСоединений - Пул, из которого взято соединение.
//   ОбъектМодели - ОбъектМодели - Модель сущности, которой принадлежит колонка.
//   Сущность - Произвольный - Сущность, которой принадлежит колонка.
//   ЗначениеИдентификатора - Произвольный - Идентификатор этой сущности.
//
// Возвращаемое значение:
//   Произвольный - Сущность, на которую указывает ссылка.
//
Функция РазыменоватьСсылку(
	Знач ЗначениеКолонки,
	Знач ТипСсылки,
	Коннектор,
	Пул,
	ОбъектМодели,
	Сущность,
	Знач ЗначениеИдентификатора
)

	Если ТипСсылки = ОбъектМодели.ТипСущности() И ЗначениеКолонки = ЗначениеИдентификатора Тогда
		Возврат Сущность;
	КонецЕсли;

	ХранилищеСущностейСсылки = ХранилищаСущностей.Получить(ОбъектМодели.МодельДанных().Получить(ТипСсылки), Пул);

	Возврат ХранилищеСущностейСсылки.ПолучитьОдно(ЗначениеКолонки);

КонецФункции

// Заполняет поля сущности, которые хранятся в подчиненных таблицах.
//
// Параметры:
//   Сущность - Произвольный - Заполняемая сущность.
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Пул - ПулСоединений - Пул, из которого взято соединение.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ЗначениеИдентификатора - Произвольный - Идентификатор заполняемой сущности.
//
Процедура ЗаполнитьПодчиненныеТаблицы(Сущность, Коннектор, Пул, ОбъектМодели, Знач ЗначениеИдентификатора)

	Для Каждого ПодчиненнаяТаблица Из ОбъектМодели.ПодчиненныеТаблицы() Цикл

		ОбъектМоделиЭлементКоллекции = ОбработкаКоллекций.ПолучитьОбъектМоделиДляПодчиненнойТаблицы(
			ОбъектМодели,
			ПодчиненнаяТаблица
		);

		ВнутренниеОпцииПоиска = Новый ОпцииПоиска();
		ВнутренниеОпцииПоиска.Отбор("ref", ВидСравнения.Равно, ЗначениеИдентификатора);

		Строки = Коннектор.НайтиСтрокиВТаблице(ОбъектМоделиЭлементКоллекции, ВнутренниеОпцииПоиска);
		ЗначениеКолонки = ОбработкаКоллекций.ПреобразоватьКоллекциюСтрокККоллекции(Строки, ПодчиненнаяТаблица);

		Если ПодчиненнаяТаблица.КаскадноеЧтение И ТипыКолонок.ЭтоСсылочныйТип(ПодчиненнаяТаблица.ТипЭлемента) Тогда
			ПрочитатьЭлементыКоллекции(ЗначениеКолонки, ПодчиненнаяТаблица.ТипЭлемента, Коннектор, Пул, ОбъектМодели);
		КонецЕсли;

		ОбъектМодели.УстановитьЗначениеПодчиненнойТаблицыВПоле(Сущность, ПодчиненнаяТаблица.ИмяПоля, ЗначениеКолонки);

	КонецЦикла;

КонецПроцедуры

// Заменяет идентификаторы в коллекции на сами сущности.
//
// Параметры:
//   Коллекция - Массив - Коллекция идентификаторов, изменяется на месте.
//   ТипЭлемента - Тип - Тип сущности элементов коллекции.
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Пул - ПулСоединений - Пул, из которого взято соединение.
//   ОбъектМодели - ОбъектМодели - Модель сущности, которой принадлежит коллекция.
//
Процедура ПрочитатьЭлементыКоллекции(Коллекция, Знач ТипЭлемента, Коннектор, Пул, ОбъектМодели)

	ХранилищеСущностейСсылки = ХранилищаСущностей.Получить(ОбъектМодели.МодельДанных().Получить(ТипЭлемента), Пул);

	Для НомерИндекса = 0 По Коллекция.ВГраница() Цикл
		Коллекция[НомерИндекса] = ХранилищеСущностейСсылки.ПолучитьОдно(Коллекция[НомерИндекса]);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьОдно(Коннектор, Пул, ОбъектМодели, ПулСущностей, ОпцииПоиска) Экспорт
	
	Если ТипЗнч(ОпцииПоиска) = Тип("Соответствие") Тогда
		ПередаваемыеОпцииПоиска = ОпцииПоиска;
	ИначеЕсли ТипЗнч(ОпцииПоиска) = Тип("ОпцииПоиска") Тогда
		ПередаваемыеОпцииПоиска = ОпцииПоиска;
	Иначе
		ПередаваемыеОпцииПоиска = Новый ОпцииПоиска();
		ПередаваемыеОпцииПоиска.Отбор(ОбъектМодели.Идентификатор().ИмяПоля, ВидСравнения.Равно, ОпцииПоиска);
	КонецЕсли;
	
	НайденныеСущности = Получить(Коннектор, Пул, ОбъектМодели, ПулСущностей, ПередаваемыеОпцииПоиска);
	
	Если НайденныеСущности.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайденныеСущности[0];
	КонецЕсли;
	
КонецФункции

// Удаляет удаление сущности из базы данных.
// Сущность должна иметь заполненный идентификатор.
//
// Параметры:
//   Сущность - Произвольный - Удаляемая сущность
//
Процедура Удалить(Коннектор, ОбъектМодели, ПулСущностей, Сущность) Экспорт
	Коннектор.Удалить(ОбъектМодели, Сущность);
	ПулСущностей.Удалить(Сущность);
КонецПроцедуры

// Посылает коннектору запрос на начало транзакции.
//
Процедура НачатьТранзакцию(Коннектор) Экспорт
	Коннектор.НачатьТранзакцию();
КонецПроцедуры

// Посылает коннектору запрос на фиксацию транзакции.
//
Процедура ЗафиксироватьТранзакцию(Коннектор) Экспорт
	Коннектор.ЗафиксироватьТранзакцию();
КонецПроцедуры

// Посылает коннектору запрос на отмену транзакции.
//
Процедура ОтменитьТранзакцию(Коннектор) Экспорт
	Коннектор.ОтменитьТранзакцию();
КонецПроцедуры

// Возвращает дополнительные свойства коннектора
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор, свойства которого необходимо получить.
//
//  Возвращаемое значение:
//   Структура - Дополнительные свойства коннектора. см. Конструктор_СвойстваКоннектора()
//
Функция ПолучитьСвойстваКоннектора(Коннектор) Экспорт
	Возврат СвойстваКоннекторов.Получить(Коннектор);
КонецФункции

// <Описание процедуры>
//
// Параметры:
//   ТипКласса - Тип - Тип, в котором проверяется наличие необходимых аннотаций.
//
Процедура ПроверитьЧтоКлассЯвляетсяСущностью(ТипКласса)
	
	РефлекторОбъекта = Новый РефлекторОбъекта(ТипКласса);
	ТаблицаМетодов = РефлекторОбъекта.ПолучитьТаблицуМетодов("Сущность", Ложь);
	Ожидаем.Что(ТаблицаМетодов, СтрШаблон("Класс %1 не имеет аннотации &Сущность", ТипКласса)).ИмеетДлину(1);
	
	ТаблицаСвойств = РефлекторОбъекта.ПолучитьТаблицуСвойств("Идентификатор");
	Ожидаем.Что(ТаблицаСвойств, СтрШаблон("Класс %1 не имеет поля с аннотацией &Идентификатор", ТипКласса)).ИмеетДлину(1);
	
КонецПроцедуры

Процедура ПроверитьЧтоТипСущностиЗарегистрированВМодели(ОбъектМодели)
	// TODO: проверка должна быть в момент получения репозитория
	Ожидаем.Что(ОбъектМодели, "Тип сущности не зарегистрирован в модели данных").Не_().Равно(Неопределено);
КонецПроцедуры

Процедура ПроверитьНеобходимостьЗаполненияИдентификатора(ОбъектМодели, Сущность)
	Если ОбъектМодели.Идентификатор().ГенерируемоеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеИдентификатора = ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность);
		Ожидаем.Что(
		ЗначениеИдентификатора, СтрШаблон("Сущность с типом %1 должна иметь заполненный идентификатор", Тип(Сущность))
	).Заполнено();

КонецПроцедуры

Функция Конструктор_СвойстваКоннектора()
	СвойстваКоннектора = Новый Структура;
	СвойстваКоннектора.Вставить("СтрокаСоединения");
	СвойстваКоннектора.Вставить("Параметры");
	
	Возврат СвойстваКоннектора;
КонецФункции

СвойстваКоннекторов = Новый Соответствие();
