#Использовать "../concurrent"

#Использовать asserts
#Использовать lambdas

Функция СоздатьКоннектор(ТипКоннектора) Экспорт
	Возврат Новый(ТипКоннектора);
КонецФункции

Процедура ОткрытьКоннектор(Коннектор, СтрокаСоединения, ПараметрыКоннектора) Экспорт
	Коннектор.Открыть(СтрокаСоединения, ПараметрыКоннектора);
КонецПроцедуры

Процедура ЗакрытьКоннектор(Коннектор) Экспорт
	Если Коннектор.Открыт() Тогда
		Коннектор.Закрыть();
	КонецЕсли;
КонецПроцедуры

// Сохраняет сущность в БД соединением источника данных.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища своих типов.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   Сущность - Произвольный - Сохраняемая сущность.
//
Процедура Сохранить(Менеджер, ОбъектМодели, ПулСущностей, Сущность) Экспорт

	ПроверитьЧтоКлассЯвляетсяСущностью(АктивнаяЗапись.ТипСущности(Сущность));
	ПроверитьНеобходимостьЗаполненияИдентификатора(ОбъектМодели, Сущность);

	Пул = Менеджер.ИсточникДанных().ПулСоединений();
	Наблюдатели = Пул.Наблюдатели();
	Событие = Наблюдатели.НачатьОперацию("Сохранить", ОбъектМодели);
	Соединение = ОперацииИсточникаДанных.ЗанятьДляОперации(Пул, Событие);

	Попытка
		Коннектор = Соединение.ПолучитьКоннектор();
		Коннектор.Сохранить(ОбъектМодели, Сущность);
		СохранитьПодчиненныеТаблицы(Коннектор, ОбъектМодели, Сущность);
	Исключение
		ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие);

	ПулСущностей.Вставить(ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность), Сущность);

КонецПроцедуры

// Ищет сущности соединением источника данных.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища своих типов.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   ОпцииПоиска - Соответствие, ОпцииПоиска - Опции поиска.
//
// Возвращаемое значение:
//   Массив - Найденные сущности.
//
Функция Получить(Менеджер, ОбъектМодели, ПулСущностей, ОпцииПоиска) Экспорт

	ПередаваемыеОпцииПоиска = ПреобразоватьОпцииПоиска(ОбъектМодели.Колонки(), ОпцииПоиска);

	Возврат НайтиСущности(Менеджер, ОбъектМодели, ПулСущностей, ПередаваемыеОпцииПоиска, "Получить");

КонецФункции

// Ищет сущности соединением источника данных и отдает наблюдателям событие своей операции.
//
// Операция названа параметром: вызов ПолучитьОдно - такая же одна операция для наблюдателя,
// а не поиск, вложенный в поиск.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища своих типов.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   ОпцииПоиска - ОпцииПоиска - Опции поиска в терминах колонок таблицы.
//   ИмяОперации - Строка - Имя операции для наблюдателей.
//
// Возвращаемое значение:
//   Массив - Найденные сущности.
//
Функция НайтиСущности(Менеджер, ОбъектМодели, ПулСущностей, ОпцииПоиска, Знач ИмяОперации)

	НайденныеСущности = Новый Массив;

	Пул = Менеджер.ИсточникДанных().ПулСоединений();
	Наблюдатели = Пул.Наблюдатели();
	Событие = Наблюдатели.НачатьОперацию(ИмяОперации, ОбъектМодели);
	Соединение = ОперацииИсточникаДанных.ЗанятьДляОперации(Пул, Событие);

	Попытка

		Коннектор = Соединение.ПолучитьКоннектор();
		НайденныеСтроки = Коннектор.НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска);

		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденныеСущности.Добавить(СобратьСущность(Коннектор, Менеджер, ОбъектМодели, ПулСущностей, НайденнаяСтрока));
		КонецЦикла;

	Исключение
		ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие, , НайденныеСущности.Количество());

	Возврат НайденныеСущности;

КонецФункции

// Ищет одну сущность соединением источника данных.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища своих типов.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   ОпцииПоиска - Соответствие, ОпцииПоиска, Произвольный - Опции поиска; любой другой тип - идентификатор.
//
// Возвращаемое значение:
//   Произвольный - Найденная сущность.
//   Неопределено - Сущность не найдена.
//
Функция ПолучитьОдно(Менеджер, ОбъектМодели, ПулСущностей, ОпцииПоиска) Экспорт

	Если ТипЗнч(ОпцииПоиска) = Тип("Соответствие") ИЛИ ТипЗнч(ОпцииПоиска) = Тип("ОпцииПоиска") Тогда
		ПередаваемыеОпцииПоиска = ОпцииПоиска;
	Иначе
		ПередаваемыеОпцииПоиска = Новый ОпцииПоиска();
		ПередаваемыеОпцииПоиска.Отбор(ОбъектМодели.Идентификатор().ИмяПоля, ВидСравнения.Равно, ОпцииПоиска);
	КонецЕсли;

	ПередаваемыеОпцииПоиска = ПреобразоватьОпцииПоиска(ОбъектМодели.Колонки(), ПередаваемыеОпцииПоиска);

	НайденныеСущности = НайтиСущности(Менеджер, ОбъектМодели, ПулСущностей, ПередаваемыеОпцииПоиска, "ПолучитьОдно");

	Если НайденныеСущности.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайденныеСущности[0];
	КонецЕсли;

КонецФункции

// Удаляет сущность из БД соединением источника данных.
// Сущность должна иметь заполненный идентификатор.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища своих типов.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   Сущность - Произвольный - Удаляемая сущность.
//
Процедура Удалить(Менеджер, ОбъектМодели, ПулСущностей, Сущность) Экспорт

	Пул = Менеджер.ИсточникДанных().ПулСоединений();
	Наблюдатели = Пул.Наблюдатели();
	Событие = Наблюдатели.НачатьОперацию("Удалить", ОбъектМодели);
	Соединение = ОперацииИсточникаДанных.ЗанятьДляОперации(Пул, Событие);

	Попытка
		Соединение.ПолучитьКоннектор().Удалить(ОбъектМодели, Сущность);
	Исключение
		ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие);

	// Пул сущностей разложен по идентификаторам: удаление по самой сущности не нашло бы ничего.
	ПулСущностей.Удалить(ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность));

КонецПроцедуры

// Выполняет алгоритм коннектором источника данных и возвращает соединение обратно.
//
// Соединение занимается на время выполнения алгоритма. Если текущий поток исполнения уже
// начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, соединением которого выполняется алгоритм.
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
Процедура ВыполнитьСКоннектором(Источник, Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт

	Действие = ПостроитьДействие(Алгоритм, Контекст, Объект, ФункциональныеИнтерфейсы.УниПроцедура());

	Пул = Источник.ПулСоединений();
	Наблюдатели = Пул.Наблюдатели();
	Событие = Наблюдатели.НачатьОперацию("ВыполнитьСКоннектором");
	Соединение = ОперацииИсточникаДанных.ЗанятьДляОперации(Пул, Событие);

	Попытка
		Действие.Выполнить(Соединение.ПолучитьКоннектор());
	Исключение
		ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие);

КонецПроцедуры

// Вычисляет значение алгоритмом, выполненным коннектором источника данных, и возвращает
// соединение обратно.
//
// Соединение занимается на время выполнения алгоритма. Если текущий поток исполнения уже
// начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, соединением которого выполняется алгоритм.
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
// Возвращаемое значение:
//   Произвольный - Результат алгоритма.
//
Функция ВычислитьСКоннектором(Источник, Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт

	Действие = ПостроитьДействие(Алгоритм, Контекст, Объект, ФункциональныеИнтерфейсы.УниФункция());

	Пул = Источник.ПулСоединений();
	Наблюдатели = Пул.Наблюдатели();
	Событие = Наблюдатели.НачатьОперацию("ВычислитьСКоннектором");
	Соединение = ОперацииИсточникаДанных.ЗанятьДляОперации(Пул, Событие);

	Попытка
		Результат = Действие.Выполнить(Соединение.ПолучитьКоннектор());
	Исключение
		ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	ОперацииИсточникаДанных.ОсвободитьИЗавершитьОперацию(Пул, Наблюдатели, Событие);

	Возврат Результат;

КонецФункции

// Строит действие по лямбда-выражению.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//   Интерфейс - ИнтерфейсОбъекта - Функциональный интерфейс, которому должно отвечать выражение.
//
// Возвращаемое значение:
//   Действие - Действие на метод лямбда-выражения.
//
Функция ПостроитьДействие(Знач Алгоритм, Знач Контекст, Объект, Интерфейс)

	Выражение = Лямбда.Выражение(Алгоритм).Интерфейс(Интерфейс);

	Если Контекст <> Неопределено Тогда
		Выражение = Выражение.Контекст(Контекст);
	КонецЕсли;

	Если Объект <> Неопределено Тогда
		Выражение = Выражение.ЗахватитьОбъект(Объект);
	КонецЕсли;

	Возврат Выражение.ВДействие();

КонецФункции

// Начинает транзакцию текущего потока исполнения.
//
// Поток занимает соединение и держит его до фиксации или отмены, поэтому все его операции
// попадают в эту транзакцию, а завершить ее другой поток не может.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, соединением которого открывается транзакция.
//
Процедура НачатьТранзакциюПотокаИсполнения(Источник) Экспорт

	Пул = Источник.ПулСоединений();
	Соединение = Пул.Занять();

	Попытка
		Соединение.НачатьТранзакцию();
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	// Захват снимается сразу: дальше соединение держит за потоком сама транзакция. Иначе
	// повторное начало добавляло бы захват, снять который нечем - завершение транзакции одно.
	Пул.Освободить();

КонецПроцедуры

// Фиксирует транзакцию текущего потока исполнения и возвращает соединение в пул.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, которому принадлежит соединение.
//
Процедура ЗафиксироватьТранзакциюПотокаИсполнения(Источник) Экспорт
	ЗавершитьТранзакциюПотокаИсполнения(Источник, Истина);
КонецПроцедуры

// Отменяет транзакцию текущего потока исполнения и возвращает соединение в пул.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, которому принадлежит соединение.
//
Процедура ОтменитьТранзакциюПотокаИсполнения(Источник) Экспорт
	ЗавершитьТранзакциюПотокаИсполнения(Источник, Ложь);
КонецПроцедуры

// Завершает транзакцию текущего потока и освобождает его соединение.
//
// Захват берется и снимается парно, как в любой другой операции: соединение уходит в пул, когда
// транзакции на нем больше нет и поток не занят ничем другим. Если транзакции не было, захват
// достанет из пула новое соединение - ведем себя как коннектор без пула, пусть о лишнем
// завершении скажет СУБД.
//
// Соединение освобождается в любом случае: если завершение не удалось, держать его за потоком
// тем более незачем.
//
// Параметры:
//   Источник - ИсточникДанных - Источник, которому принадлежит соединение.
//   Фиксировать - Булево - Истина - зафиксировать транзакцию, Ложь - отменить.
//
Процедура ЗавершитьТранзакциюПотокаИсполнения(Источник, Знач Фиксировать)

	Пул = Источник.ПулСоединений();
	Соединение = Пул.Занять();

	Попытка
		Если Фиксировать Тогда
			Соединение.ЗафиксироватьТранзакцию();
		Иначе
			Соединение.ОтменитьТранзакцию();
		КонецЕсли;
	Исключение
		Пул.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Пул.Освободить();

КонецПроцедуры

// Перезаписывает строки подчиненных таблиц сущности: старые строки удаляются, текущее
// содержимое коллекций сохраняется заново.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   Сущность - Произвольный - Сохраняемая сущность.
//
Процедура СохранитьПодчиненныеТаблицы(Коннектор, ОбъектМодели, Сущность)

	Для Каждого ПодчиненнаяТаблица Из ОбъектМодели.ПодчиненныеТаблицы() Цикл

		ОбъектМоделиЭлементКоллекции = ОбработкаКоллекций.ПолучитьОбъектМоделиДляПодчиненнойТаблицы(
			ОбъектМодели,
			ПодчиненнаяТаблица
		);

		// Очистка подчиненной таблицы
		ОпцииПоиска = Новый ОпцииПоиска();
		ОпцииПоиска.Отбор("ref", ВидСравнения.Равно, ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность));
		Коннектор.УдалитьСтрокиВТаблице(ОбъектМоделиЭлементКоллекции, ОпцииПоиска);

		РасширяемоеПоле = ОбъектМодели.ПолучитьЗначениеПоля(Сущность, ПодчиненнаяТаблица.ИмяПоля);

		Если НЕ ЗначениеЗаполнено(РасширяемоеПоле) Тогда
			Продолжить;
		КонецЕсли;

		КоллекцияСущностей = ОбработкаКоллекций.ПреобразоватьКоллекциюККоллекцииСущностей(
			РасширяемоеПоле,
			Сущность,
			ОбъектМодели,
			ПодчиненнаяТаблица
		);

		Для Каждого ЭлементКоллекции Из КоллекцияСущностей Цикл
			Коннектор.Сохранить(ОбъектМоделиЭлементКоллекции, ЭлементКоллекции);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Собирает сущность по прочитанной строке таблицы: берет экземпляр из пула сущностей,
// заполняет колонки и подчиненные таблицы.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища по ссылкам.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   НайденнаяСтрока - Соответствие - Прочитанная строка таблицы.
//
// Возвращаемое значение:
//   Произвольный - Заполненная сущность.
//
Функция СобратьСущность(Коннектор, Менеджер, ОбъектМодели, ПулСущностей, НайденнаяСтрока)

	ЗначениеИдентификатора = ОбъектМодели.ПривестиЗначениеПоля(
		НайденнаяСтрока.Получить(ОбъектМодели.Идентификатор().ИмяКолонки),
		ОбъектМодели.Идентификатор().ИмяПоля
	);

	Сущность = ПолучитьСущностьИзПула(Менеджер, ОбъектМодели, ПулСущностей, ЗначениеИдентификатора);

	ЗаполнитьКолонки(Сущность, НайденнаяСтрока, Менеджер, ОбъектМодели, ЗначениеИдентификатора);
	ЗаполнитьПодчиненныеТаблицы(Сущность, Коннектор, Менеджер, ОбъектМодели, ЗначениеИдентификатора);

	Возврат Сущность;

КонецФункции

// Переводит опции поиска с имен полей на имена колонок таблицы.
//
// Параметры:
//   Колонки - ТаблицаЗначений - Описание колонок модели.
//   ОпцииПоиска - Соответствие, ОпцииПоиска - Опции поиска в терминах полей.
//
// Возвращаемое значение:
//   ОпцииПоиска - Опции поиска в терминах колонок таблицы.
//
Функция ПреобразоватьОпцииПоиска(Колонки, ОпцииПоиска)

	ПередаваемыеОпцииПоиска = Новый ОпцииПоиска();

	Если ТипЗнч(ОпцииПоиска) = Тип("Соответствие") Тогда

		Для Каждого КлючИЗначение Из ОпцииПоиска Цикл
			Колонка = НайтиКолонкуПоИмениПоля(Колонки, КлючИЗначение.Ключ);
			ПередаваемыеОпцииПоиска.Отбор(Колонка.ИмяКолонки, ВидСравнения.Равно, КлючИЗначение.Значение);
		КонецЦикла;

		Возврат ПередаваемыеОпцииПоиска;

	КонецЕсли;

	Если ТипЗнч(ОпцииПоиска) <> Тип("ОпцииПоиска") Тогда
		ВызватьИсключение "В метод получения данных передан неожиданный тип опций поиска: " + ТипЗнч(ОпцииПоиска);
	КонецЕсли;

	Для Каждого ЭлементОтбора Из ОпцииПоиска.Отборы() Цикл
		Колонка = НайтиКолонкуПоИмениПоля(Колонки, ЭлементОтбора.ПутьКДанным);
		ПередаваемыеОпцииПоиска.Отбор(Колонка.ИмяКолонки, ЭлементОтбора.ВидСравнения, ЭлементОтбора.Значение);
	КонецЦикла;

	Для Каждого ЭлементПорядка Из ОпцииПоиска.Сортировки() Цикл
		Колонка = НайтиКолонкуПоИмениПоля(Колонки, ЭлементПорядка.ПутьКДанным);
		ПередаваемыеОпцииПоиска.СортироватьПо(Колонка.ИмяКолонки, ЭлементПорядка.НаправлениеСортировки);
	КонецЦикла;

	ПередаваемыеОпцииПоиска.Смещение(ОпцииПоиска.ВыбираетсяСоСмещением());
	ПередаваемыеОпцииПоиска.Первые(ОпцииПоиска.ВыбираютсяПервые());

	Возврат ПередаваемыеОпцииПоиска;

КонецФункции

// Находит описание колонки по имени поля сущности.
//
// Параметры:
//   Колонки - ТаблицаЗначений - Описание колонок модели.
//   ИмяПоля - Строка - Имя поля сущности.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений - Описание колонки.
//
Функция НайтиКолонкуПоИмениПоля(Колонки, Знач ИмяПоля)

	Колонка = Колонки.Найти(ИмяПоля, "ИмяПоля");
	Ожидаем.Что(
		Колонка,
		СтрШаблон("Не удалось найти данные о колонке по имени поля %1", ИмяПоля)
	).Не_().Равно(Неопределено);

	Возврат Колонка;

КонецФункции

// Возвращает экземпляр сущности из пула сущностей, создавая его при первом обращении.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Менеджер, которому принадлежит хранилище сущности.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ПулСущностей - СинхронизированнаяКарта - Ранее прочитанные экземпляры сущностей.
//   ЗначениеИдентификатора - Произвольный - Идентификатор сущности.
//
// Возвращаемое значение:
//   Произвольный - Экземпляр сущности.
//
Функция ПолучитьСущностьИзПула(Менеджер, ОбъектМодели, ПулСущностей, Знач ЗначениеИдентификатора)

	Сущность = ПулСущностей.ПолучитьИлиУмолчание(ЗначениеИдентификатора, Неопределено);
	Если Сущность <> Неопределено Тогда
		Возврат Сущность;
	КонецЕсли;

	ХранилищеСущностей = Менеджер.ПолучитьХранилищеСущностей(ОбъектМодели.ТипСущности());
	Сущность = АктивнаяЗапись.Создать(ОбъектМодели, ХранилищеСущностей);

	// Пул мог пополниться, пока создавалась сущность: экземпляр на идентификатор должен остаться
	// один, иначе разные потоки получат разные объекты одной строки. Победителем остается тот,
	// кто вставил первым, а свой лишний экземпляр вызывающий просто выбрасывает.
	Предыдущая = ПулСущностей.ВставитьЕслиОтсутствует(ЗначениеИдентификатора, Сущность);

	Возврат ?(Предыдущая.Пустой(), Сущность, Предыдущая.Получить());

КонецФункции

// Заполняет поля сущности значениями колонок прочитанной строки, разыменовывая ссылки.
//
// Параметры:
//   Сущность - Произвольный - Заполняемая сущность.
//   НайденнаяСтрока - Соответствие - Прочитанная строка таблицы.
//   Менеджер - МенеджерСущностей - Менеджер операции: дает источник и хранилища по ссылкам.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ЗначениеИдентификатора - Произвольный - Идентификатор заполняемой сущности.
//
Процедура ЗаполнитьКолонки(Сущность, НайденнаяСтрока, Менеджер, ОбъектМодели, Знач ЗначениеИдентификатора)

	Для Каждого Колонка Из ОбъектМодели.Колонки() Цикл

		ЗначениеКолонки = НайденнаяСтрока.Получить(Колонка.ИмяКолонки);

		Если Колонка.ТипКолонки = ТипыКолонок.Ссылка И ЗначениеЗаполнено(ЗначениеКолонки) Тогда
			ЗначениеКолонки = РазыменоватьСсылку(
				ЗначениеКолонки,
				Колонка.ТипСсылки,
				Менеджер,
				ОбъектМодели,
				Сущность,
				ЗначениеИдентификатора
			);
		КонецЕсли;

		ОбъектМодели.УстановитьЗначениеКолонкиВПоле(Сущность, Колонка.ИмяКолонки, ЗначениеКолонки);

	КонецЦикла;

КонецПроцедуры

// Читает сущность, на которую указывает ссылочная колонка.
//
// Ссылка сущности на саму себя не читается повторно: возвращается уже собранный экземпляр,
// иначе чтение зациклилось бы.
//
// Параметры:
//   ЗначениеКолонки - Произвольный - Идентификатор сущности, на которую указывает ссылка.
//   ТипСсылки - Тип - Тип сущности, на которую указывает ссылка.
//   Менеджер - МенеджерСущностей - Менеджер, у которого запрашивается хранилище ссылки.
//   ОбъектМодели - ОбъектМодели - Модель сущности, которой принадлежит колонка.
//   Сущность - Произвольный - Сущность, которой принадлежит колонка.
//   ЗначениеИдентификатора - Произвольный - Идентификатор этой сущности.
//
// Возвращаемое значение:
//   Произвольный - Сущность, на которую указывает ссылка.
//
Функция РазыменоватьСсылку(
	Знач ЗначениеКолонки,
	Знач ТипСсылки,
	Менеджер,
	ОбъектМодели,
	Сущность,
	Знач ЗначениеИдентификатора
)

	Если ТипСсылки = ОбъектМодели.ТипСущности() И ЗначениеКолонки = ЗначениеИдентификатора Тогда
		Возврат Сущность;
	КонецЕсли;

	ХранилищеСущностейСсылки = Менеджер.ПолучитьХранилищеСущностей(ТипСсылки);

	Возврат ХранилищеСущностейСсылки.ПолучитьОдно(ЗначениеКолонки);

КонецФункции

// Заполняет поля сущности, которые хранятся в подчиненных таблицах.
//
// Параметры:
//   Сущность - Произвольный - Заполняемая сущность.
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//   Менеджер - МенеджерСущностей - Менеджер, у которого запрашиваются хранилища элементов.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ЗначениеИдентификатора - Произвольный - Идентификатор заполняемой сущности.
//
Процедура ЗаполнитьПодчиненныеТаблицы(Сущность, Коннектор, Менеджер, ОбъектМодели, Знач ЗначениеИдентификатора)

	Для Каждого ПодчиненнаяТаблица Из ОбъектМодели.ПодчиненныеТаблицы() Цикл

		ОбъектМоделиЭлементКоллекции = ОбработкаКоллекций.ПолучитьОбъектМоделиДляПодчиненнойТаблицы(
			ОбъектМодели,
			ПодчиненнаяТаблица
		);

		ВнутренниеОпцииПоиска = Новый ОпцииПоиска();
		ВнутренниеОпцииПоиска.Отбор("ref", ВидСравнения.Равно, ЗначениеИдентификатора);

		Строки = Коннектор.НайтиСтрокиВТаблице(ОбъектМоделиЭлементКоллекции, ВнутренниеОпцииПоиска);
		ЗначениеКолонки = ОбработкаКоллекций.ПреобразоватьКоллекциюСтрокККоллекции(Строки, ПодчиненнаяТаблица);

		Если ПодчиненнаяТаблица.КаскадноеЧтение И ТипыКолонок.ЭтоСсылочныйТип(ПодчиненнаяТаблица.ТипЭлемента) Тогда
			ПрочитатьЭлементыКоллекции(ЗначениеКолонки, ПодчиненнаяТаблица.ТипЭлемента, Менеджер);
		КонецЕсли;

		ОбъектМодели.УстановитьЗначениеПодчиненнойТаблицыВПоле(Сущность, ПодчиненнаяТаблица.ИмяПоля, ЗначениеКолонки);

	КонецЦикла;

КонецПроцедуры

// Заменяет идентификаторы в коллекции на сами сущности.
//
// Параметры:
//   Коллекция - Массив - Коллекция идентификаторов, изменяется на месте.
//   ТипЭлемента - Тип - Тип сущности элементов коллекции.
//   Менеджер - МенеджерСущностей - Менеджер, у которого запрашивается хранилище элементов.
//
Процедура ПрочитатьЭлементыКоллекции(Коллекция, Знач ТипЭлемента, Менеджер)

	ХранилищеСущностейСсылки = Менеджер.ПолучитьХранилищеСущностей(ТипЭлемента);

	Для НомерИндекса = 0 По Коллекция.ВГраница() Цикл
		Коллекция[НомерИндекса] = ХранилищеСущностейСсылки.ПолучитьОдно(Коллекция[НомерИндекса]);
	КонецЦикла;

КонецПроцедуры

// Посылает коннектору запрос на начало транзакции.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор, которому адресован запрос.
//
Процедура НачатьТранзакцию(Коннектор) Экспорт
	Коннектор.НачатьТранзакцию();
КонецПроцедуры

// Посылает коннектору запрос на фиксацию транзакции.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор, которому адресован запрос.
//
Процедура ЗафиксироватьТранзакцию(Коннектор) Экспорт
	Коннектор.ЗафиксироватьТранзакцию();
КонецПроцедуры

// Посылает коннектору запрос на отмену транзакции.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор, которому адресован запрос.
//
Процедура ОтменитьТранзакцию(Коннектор) Экспорт
	Коннектор.ОтменитьТранзакцию();
КонецПроцедуры

// Проверяет, что тип класса размечен как сущность.
//
// Параметры:
//   ТипКласса - Тип - Тип, в котором проверяется наличие необходимых аннотаций.
//
Процедура ПроверитьЧтоКлассЯвляетсяСущностью(ТипКласса)

	РефлекторОбъекта = Новый РефлекторОбъекта(ТипКласса);
	ТаблицаМетодов = РефлекторОбъекта.ПолучитьТаблицуМетодов("Сущность", Ложь);
	Ожидаем.Что(ТаблицаМетодов, СтрШаблон("Класс %1 не имеет аннотации &Сущность", ТипКласса)).ИмеетДлину(1);

	ТаблицаСвойств = РефлекторОбъекта.ПолучитьТаблицуСвойств("Идентификатор");
	Ожидаем.Что(ТаблицаСвойств, СтрШаблон("Класс %1 не имеет поля с аннотацией &Идентификатор", ТипКласса)).ИмеетДлину(1);

КонецПроцедуры

Процедура ПроверитьНеобходимостьЗаполненияИдентификатора(ОбъектМодели, Сущность)
	Если ОбъектМодели.Идентификатор().ГенерируемоеЗначение Тогда
		Возврат;
	КонецЕсли;

	ЗначениеИдентификатора = ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность);
		Ожидаем.Что(
		ЗначениеИдентификатора, СтрШаблон("Сущность с типом %1 должна иметь заполненный идентификатор", Тип(Сущность))
	).Заполнено();

КонецПроцедуры

