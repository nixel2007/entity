// Разбор строк соединения вида "Ключ=Значение;Ключ=Значение".
//
// Нужен коннекторам, чтобы описать соединение наблюдателям: адрес, порт, база. Ключи
// сравниваются без учета регистра и пробелов вокруг; значения возвращаются как есть.

// Разбирает строку соединения на пары.
//
// Параметры:
//   СтрокаСоединения - Строка - Строка вида "Host=localhost;Port=5432;Database=test".
//
// Возвращаемое значение:
//   Соответствие - Ключ в нижнем регистре без пробелов - значение без пробелов по краям.
//
Функция Параметры(Знач СтрокаСоединения) Экспорт

	Результат = Новый Соответствие;

	Для Каждого Пара Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл

		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;

		Ключ = НРег(СокрЛП(Лев(Пара, ПозицияРавно - 1)));
		Значение = СокрЛП(Сред(Пара, ПозицияРавно + 1));

		Если ЗначениеЗаполнено(Ключ) Тогда
			Результат.Вставить(Ключ, Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает первое найденное значение из перечисленных ключей.
//
// Параметры:
//   ПараметрыСтроки - Соответствие - Результат Параметры().
//   Ключи - Строка - Ключи через запятую в порядке предпочтения, например "host,server".
//   ЗначениеПоУмолчанию - Произвольный - Что вернуть, если ни одного ключа нет.
//
// Возвращаемое значение:
//   Произвольный - Значение первого найденного ключа или значение по умолчанию.
//
Функция Значение(Знач ПараметрыСтроки, Знач Ключи, Знач ЗначениеПоУмолчанию = "") Экспорт

	Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
		Найденное = ПараметрыСтроки.Получить(НРег(СокрЛП(Ключ)));
		Если Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЦикла;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Описание соединения без секретов для коннектора клиент-серверной СУБД.
//
// Параметры:
//   Система - Строка - Имя СУБД.
//   СтрокаСоединения - Строка - Строка соединения.
//   ПортПоУмолчанию - Число - Порт, если в строке его нет.
//
// Возвращаемое значение:
//   Структура - Система, Адрес, Порт, БазаДанных.
//
Функция ОписаниеСервера(Знач Система, Знач СтрокаСоединения, Знач ПортПоУмолчанию) Экспорт

	ПараметрыСтроки = Параметры(СтрокаСоединения);

	Порт = Значение(ПараметрыСтроки, "port", "");
	Попытка
		Порт = ?(ЗначениеЗаполнено(Порт), Число(Порт), ПортПоУмолчанию);
	Исключение
		Порт = ПортПоУмолчанию;
	КонецПопытки;

	Возврат Новый Структура(
		"Система, Адрес, Порт, БазаДанных",
		Система,
		Значение(ПараметрыСтроки, "host,server,data source"),
		Порт,
		Значение(ПараметрыСтроки, "database,initial catalog")
	);

КонецФункции

// Описание соединения для файловой или встроенной СУБД без сервера.
//
// Параметры:
//   Система - Строка - Имя СУБД.
//   БазаДанных - Строка - Путь к файлу, каталогу или иное имя базы.
//
// Возвращаемое значение:
//   Структура - Система, Адрес, Порт, БазаДанных.
//
Функция ОписаниеБезСервера(Знач Система, Знач БазаДанных) Экспорт
	Возврат Новый Структура("Система, Адрес, Порт, БазаДанных", Система, "", 0, БазаДанных);
КонецФункции
