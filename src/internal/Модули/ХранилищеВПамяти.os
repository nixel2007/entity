// Данные коннекторов в памяти, общие на процесс.
//
// Коннекторов с одной строкой подключения несколько - пул выдает каждому потоку исполнения
// свой, - а таблицы и счетчики у них общие. Поэтому рядом с данными подключения живет и
// блокировка: таблица значений параллельной записи не переживает, а счетчик без блокировки выдал
// бы двум сущностям один идентификатор.
//
#Использовать "../concurrent"

// Соответствие - Строка подключения и структура с его таблицами, счетчиками и блокировкой.
Перем ДанныеПодключений;
// БлокировкаРесурса - Защищает соответствие от одновременного создания данных одного подключения.
Перем БлокировкаРеестра;

// Возвращает кеш таблиц подключения.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, к которой относятся таблицы.
//
// Возвращаемое значение:
//   Соответствие - Имя таблицы - таблица значений с данными.
//
Функция КешТаблиц(СтрокаПодключения = "default") Экспорт
	Возврат ДанныеПодключения(СтрокаПодключения).Таблицы;
КонецФункции

// Возвращает счетчики идентификаторов подключения.
//
// Хранят последний выданный идентификатор каждой таблицы, чтобы генерация не искала максимум
// перебором. Счетчики живут рядом с таблицами и разделяются всеми коннекторами этого
// подключения: коннекторов на одну строку подключения несколько, и счетчик в поле экземпляра
// приводил бы к выдаче совпадающих идентификаторов.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, к которой относятся таблицы.
//
// Возвращаемое значение:
//   Соответствие - Имя таблицы - последний выданный идентификатор.
//
Функция СчетчикиИдентификаторов(СтрокаПодключения = "default") Экспорт
	Возврат ДанныеПодключения(СтрокаПодключения).Счетчики;
КонецФункции

// Возвращает блокировку данных подключения.
//
// Таблицы и счетчики общие для всех коннекторов подключения, а к параллельному изменению не
// приспособлены: коннектор изменяет их под блокировкой записи, а читает под блокировкой чтения.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, данные которого защищаются.
//
// Возвращаемое значение:
//   БлокировкаЧтенияЗаписи - Блокировка таблиц и счетчиков подключения.
//
Функция Блокировка(СтрокаПодключения = "default") Экспорт
	Возврат ДанныеПодключения(СтрокаПодключения).Блокировка;
КонецФункции

// Очищает данные подключения.
//
// Соответствия очищаются, а не создаются заново: открытые коннекторы держат ссылки на них, и
// подмена оставила бы их работать со старыми таблицами.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, данные которой очищаются.
//
Процедура Очистить(СтрокаПодключения = "default") Экспорт

	Данные = ДанныеПодключения(СтрокаПодключения);

	Данные.Блокировка.Запись().Заблокировать();

	Попытка

		Данные.Таблицы.Очистить();
		Данные.Счетчики.Очистить();

	Исключение

		Данные.Блокировка.Запись().Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Данные.Блокировка.Запись().Разблокировать();

КонецПроцедуры

// Возвращает данные подключения, создавая их при первом обращении.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, данные которого нужны.
//
// Возвращаемое значение:
//   Структура - Данные подключения:
//     * Таблицы - Соответствие - Имя таблицы - таблица значений с данными.
//     * Счетчики - Соответствие - Имя таблицы - последний выданный идентификатор.
//     * Блокировка - БлокировкаЧтенияЗаписи - Защищает таблицы и счетчики подключения.
//
Функция ДанныеПодключения(Знач СтрокаПодключения)

	БлокировкаРеестра.Заблокировать();

	Попытка

		Результат = ДанныеПодключений.Получить(СтрокаПодключения);
		Если Результат = Неопределено Тогда
			Результат = Новый Структура(
				"Таблицы, Счетчики, Блокировка",
				Новый Соответствие(),
				Новый Соответствие(),
				Новый БлокировкаЧтенияЗаписи()
			);
			ДанныеПодключений.Вставить(СтрокаПодключения, Результат);
		КонецЕсли;

	Исключение

		БлокировкаРеестра.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаРеестра.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура Инициализация()
	ДанныеПодключений = Новый Соответствие();
	БлокировкаРеестра = Новый БлокировкаРесурса();
КонецПроцедуры

Инициализация();
