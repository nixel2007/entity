// Соответствие: строка подключения - кеш таблиц этого подключения.
Перем КешиТаблиц;
// Соответствие: строка подключения - счетчики идентификаторов таблиц этого подключения.
Перем КешиСчетчиков;

// Кеш таблиц подключения.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, к которой относятся таблицы.
//
// Возвращаемое значение:
//   Соответствие - Имя таблицы - таблица значений с данными.
//
Функция КешТаблиц(СтрокаПодключения = "default") Экспорт
	Результат = КешиТаблиц.Получить(СтрокаПодключения);

	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие();
		КешиТаблиц.Вставить(СтрокаПодключения, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Счетчики идентификаторов подключения.
//
// Хранят последний выданный идентификатор каждой таблицы, чтобы генерация не искала максимум
// перебором. Счетчики живут рядом с таблицами и разделяются всеми коннекторами этого
// подключения: коннекторов на одну строку подключения несколько, и счетчик в поле экземпляра
// приводил бы к выдаче совпадающих идентификаторов.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, к которой относятся таблицы.
//
// Возвращаемое значение:
//   Соответствие - Имя таблицы - последний выданный идентификатор.
//
Функция СчетчикиИдентификаторов(СтрокаПодключения = "default") Экспорт
	Результат = КешиСчетчиков.Получить(СтрокаПодключения);

	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие();
		КешиСчетчиков.Вставить(СтрокаПодключения, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Очищает данные подключения.
//
// Параметры:
//   СтрокаПодключения - Строка - Строка подключения, данные которой очищаются.
//
Процедура Очистить(СтрокаПодключения = "default") Экспорт
	КешиТаблиц.Вставить(СтрокаПодключения, Новый Соответствие());
	КешиСчетчиков.Вставить(СтрокаПодключения, Новый Соответствие());
КонецПроцедуры

Процедура Инициализация()
	КешиТаблиц = Новый Соответствие();
	КешиСчетчиков = Новый Соответствие();
КонецПроцедуры

Инициализация();
