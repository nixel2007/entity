#Использовать "../internal/concurrent"

#Использовать asserts
#Использовать fluent
#Использовать fs
#Использовать logos

// Для хранения статуса соединения
Перем Открыт;

Перем БазовыйКаталог;

Перем Лог;

// Конструктор объекта АбстрактныйКоннектор.
//
Процедура ПриСозданииОбъекта()
	
	Открыт = Ложь;
	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.connector.json");

КонецПроцедуры

// Открыть соединение с БД.
//
// Параметры:
//   СтрокаСоединения - Строка - Строка соединения с БД.
//   ПараметрыКоннектора - Массив - Дополнительные параметры инициализиации коннектора.
//
Процедура Открыть(СтрокаСоединения, ПараметрыКоннектора) Экспорт // BSLLS:UnusedParameters-off
	Открыт = Истина;
	Лог.Отладка("Открытие коннектора со строкой соединения %1", СтрокаСоединения);
	Ожидаем
		.Что(ФС.КаталогСуществует(СтрокаСоединения), "Существует каталог для выгрузки данных сущностей")
		.ЭтоИстина();
	БазовыйКаталог = СтрокаСоединения;
КонецПроцедуры

// Закрыть соединение с БД.
//
Процедура Закрыть() Экспорт
	Открыт = Ложь;
КонецПроцедуры

// Получить статус соединения с БД.
//
//  Возвращаемое значение:
//   Булево - Состояние соединения. Истина, если соединение установлено и готово к использованию.
//       В обратном случае - Ложь.
//
Функция Открыт() Экспорт
	Возврат Открыт;
КонецФункции

// Начинает новую транзакцию в БД.
//
Процедура НачатьТранзакцию() Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

// Фиксирует открытую транзакцию в БД.
//
Процедура ЗафиксироватьТранзакцию() Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

// Отменяет открытую транзакцию в БД.
//
Процедура ОтменитьТранзакцию() Экспорт
	ВызватьИсключение "Не поддерживается";
КонецПроцедуры

// Создает таблицу в БД по данным модели.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//
Процедура ИнициализироватьТаблицу(ОбъектМодели) Экспорт

	ИмяФайла = ОбъединитьПути(БазовыйКаталог, ОбъектМодели.ИмяТаблицы()) + ".json";
	Блокировка = БлокировкиЧтенияЗаписи.Получить(ИмяФайла).Запись();
	Блокировка.Заблокировать();

	Попытка

		Если НЕ ФС.Существует(ИмяФайла) Тогда
			Лог.Отладка("Инициализация таблицы %1 в файле %2", ОбъектМодели.ИмяТаблицы(), ИмяФайла);
			Таблица = Новый Соответствие;
			ЗаписатьОбъектВФайл(Таблица, ИмяФайла);
		КонецЕсли;

	Исключение

		Блокировка.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Сохраняет сущность в БД.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   Сущность - Произвольный - Объект (экземпляр класса, зарегистрированного в модели) для сохранения в БД.
//
Процедура Сохранить(ОбъектМодели, Сущность) Экспорт
	ИмяФайла = ОбъединитьПути(БазовыйКаталог, ОбъектМодели.ИмяТаблицы()) + ".json";
	Блокировка = БлокировкиЧтенияЗаписи.Получить(ИмяФайла).Запись();
	Блокировка.Заблокировать();

	Попытка

		Таблица = ПрочитатьОбъектИзФайла(ИмяФайла);

		Идентификатор = ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность);
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда

			Если ОбъектМодели.Идентификатор().ТипКолонки <> ТипыКолонок.Целое Тогда
				Сообщение = СтрШаблон(
					"Ошибка при сохранении сущности с типом %1.
					|Генерация идентификаторов поддерживается только для колонок с типом ""Целое""",
					ОбъектМодели.ТипСущности()
				);
				ВызватьИсключение Сообщение;
			КонецЕсли;

			Идентификатор = СледующийИдентификатор(Таблица);

			ОбъектМодели.УстановитьЗначениеКолонкиВПоле(
				Сущность,
				ОбъектМодели.Идентификатор().ИмяКолонки,
				Идентификатор
			);

		КонецЕсли;
		Если ТипЗнч(Идентификатор) = Тип("Число") Тогда
			Идентификатор = Формат(Идентификатор, "ЧГ=");
		КонецЕсли;

		Лог.Отладка("Сохранение сущности с типом %1 и идентификатором %2", ОбъектМодели.ТипСущности(), Идентификатор);

		Таблица.Вставить(Идентификатор, РазложитьОбъектВСоответствие(Сущность, ОбъектМодели));
		ЗаписатьОбъектВФайл(Таблица, ИмяФайла, ОбъектМодели);

	Исключение

		Блокировка.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет сущность из таблицы БД.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   Сущность - Произвольный - Объект (экземпляр класса, зарегистрированного в модели) для удаления из БД.
//
Процедура Удалить(ОбъектМодели, Сущность) Экспорт
	
	ИмяФайла = ОбъединитьПути(БазовыйКаталог, ОбъектМодели.ИмяТаблицы()) + ".json";
	Блокировка = БлокировкиЧтенияЗаписи.Получить(ИмяФайла).Запись();
	Блокировка.Заблокировать();

	Попытка

		Таблица = ПрочитатьОбъектИзФайла(ИмяФайла);

		Идентификатор = ОбъектМодели.ПолучитьЗначениеИдентификатора(Сущность);
		Если ТипЗнч(Идентификатор) = Тип("Число") Тогда
			Идентификатор = Формат(Идентификатор, "ЧГ=");
		КонецЕсли;

		Лог.Отладка(
			"Удаление сущности с типом %1 и идентификатором %2",
			ОбъектМодели.ТипСущности(),
			Идентификатор
		);

		Таблица.Удалить(Идентификатор);

		ЗаписатьОбъектВФайл(Таблица, ИмяФайла, ОбъектМодели);

	Исключение

		Блокировка.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Осуществляет поиск строк в таблице по указанному отбору.
//
// Файл таблицы читается под блокировкой чтения: параллельные чтения одной таблицы не мешают
// друг другу, но не пересекаются с записью, поэтому одновременные чтение и запись из разных
// потоков одного процесса не конфликтуют за файл.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ОпцииПоиска - ОпцииПоиска - Опции поиска. Содержит следующие параметры:
//     * Отборы - Массив - Отбор для поиска. Каждый элемент массива должен иметь тип "ЭлементОтбора".
//                         Каждый элемент отбора преобразуется к условию поиска.
//                         В качестве "ПутьКДанным" указываются имена колонок.
//     * Сортировки - Массив - Сортировка для результата поиска.
//                             Каждый элемент массива должен иметь тип "ЭлементПорядка".
//                             В качестве "ПутьКДанным" указываются имена колонок.
//
//  Возвращаемое значение:
//   Массив - Массив, элементами которого являются "Соответствия". Ключом элемента соответствия является имя колонки,
//     значением элемента соответствия - значение колонки.
//
Функция НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт

	НайденныеСтроки = Новый Массив;

	ИмяФайла = ОбъединитьПути(БазовыйКаталог, ОбъектМодели.ИмяТаблицы()) + ".json";
	Блокировка = БлокировкиЧтенияЗаписи.Получить(ИмяФайла).Чтение();
	Блокировка.Заблокировать();

	Попытка
		Таблица = ПрочитатьОбъектИзФайла(ИмяФайла);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Лог.Отладка("Поиск сущностей в таблице %1", ОбъектМодели.ИмяТаблицы());

	// Даты восстанавливаются до отбора и сортировки: иначе условия сравнивали бы
	// значение типа "Дата" с представлением даты из файла.
	ВосстановитьДатыВТаблице(Таблица, ОбъектМодели);

	ПроцессорКоллекций = ПроцессорыКоллекций.ИзКоллекции(Таблица);
	
	Для Каждого ЭлементОтбора Из ОпцииПоиска.Отборы() Цикл
		ДополнительныеПараметры = Новый Структура("Значение", ЭлементОтбора.Значение);
		ПроцессорКоллекций = ПроцессорКоллекций.Фильтровать(
			ПолучитьУсловиеОтбора(ЭлементОтбора),
			ДополнительныеПараметры
		);
	КонецЦикла;

	СтрокаСортировка = ПолучитьВыражениеСортировки(ОбъектМодели, ОпцииПоиска);
	Если СтрокаСортировка <> "" Тогда
		ПроцессорКоллекций = ПроцессорКоллекций.Сортировать(СтрокаСортировка);
	КонецЕсли;

	Если ОпцииПоиска.ВыбираетсяСоСмещением() <> Неопределено Тогда
		ПроцессорКоллекций = ПроцессорКоллекций.Пропустить(ОпцииПоиска.ВыбираетсяСоСмещением());
	КонецЕсли;

	Если ОпцииПоиска.ВыбираютсяПервые() <> Неопределено Тогда
		ПроцессорКоллекций = ПроцессорКоллекций.Первые(ОпцииПоиска.ВыбираютсяПервые());
	КонецЕсли;

	ДанныеТаблицы = ПроцессорКоллекций.ВМассив();
	
	Для Каждого СтрокаДанныхТаблицы Из ДанныеТаблицы Цикл
		ЗначенияКолонок = Новый Соответствие;
		Для Каждого Колонка Из ОбъектМодели.Колонки() Цикл
			Значение = ПрочитатьЗначениеКолонки(Колонка, СтрокаДанныхТаблицы.Значение.Получить(Колонка.ИмяКолонки));
			ЗначенияКолонок.Вставить(Колонка.ИмяКолонки, Значение);
		КонецЦикла;
		НайденныеСтроки.Добавить(ЗначенияКолонок);
	КонецЦикла;

	Возврат НайденныеСтроки;
КонецФункции

// Формирует текст лямбды-условия для одного элемента отбора.
//
// Значение элемента отбора передается в лямбду параметром "Значение".
//
// Параметры:
//   ЭлементОтбора - ЭлементОтбора - Элемент отбора из опций поиска.
//
// Возвращаемое значение:
//   Строка - Текст лямбды для "ПроцессорКоллекций.Фильтровать".
//
Функция ПолучитьУсловиеОтбора(ЭлементОтбора)

	Если ЭлементОтбора.ВидСравнения = ВидСравнения.В Тогда
		Возврат СтрШаблон(
			"Элемент -> Значение.Найти(Элемент.Значение.Получить(""%1"")) <> Неопределено", // BSLLS:Typo-off
			ЭлементОтбора.ПутьКДанным
		);
	КонецЕсли;

	Если ЭлементОтбора.ВидСравнения = ВидСравнения.НеВ Тогда
		Возврат СтрШаблон(
			"Элемент -> Значение.Найти(Элемент.Значение.Получить(""%1"")) = Неопределено", // BSLLS:Typo-off
			ЭлементОтбора.ПутьКДанным
		);
	КонецЕсли;

	Возврат СтрШаблон(
		"Элемент -> Элемент.Значение.Получить(""%1"") %2 Значение",
		ЭлементОтбора.ПутьКДанным,
		ЭлементОтбора.ВидСравнения
	);

КонецФункции

// Формирует текст лямбды сравнения строк таблицы по всем элементам порядка.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ОпцииПоиска - ОпцииПоиска - Опции поиска. См. "НайтиСтрокиВТаблице".
//
// Возвращаемое значение:
//   Строка - Текст лямбды для "ПроцессорКоллекций.Сортировать".
//            Пустая строка, если сортировка не задана.
//
Функция ПолучитьВыражениеСортировки(ОбъектМодели, ОпцииПоиска)

	Колонки = ОбъектМодели.Колонки();
	СтрокаСортировка = "";

	Для Каждого ЭлементПорядка Из ОпцииПоиска.Сортировки() Цикл

		НайденныеКолонки = Колонки.НайтиСтроки(Новый Структура("ИмяКолонки", ЭлементПорядка.ПутьКДанным));

		Если НайденныеКолонки.Количество() = 0 Тогда
			ИмяПоля = ЭлементПорядка.ПутьКДанным;
		Иначе
			ИмяПоля = НайденныеКолонки[0].ИмяПоля;
		КонецЕсли;

		ПорядокСортировки = ?(
			ЭлементПорядка.НаправлениеСортировки = НаправлениеСортировки.Возр,
			"ПрямойПорядок",
			"ОбратныйПорядок"
		);

		// формирование текста лямбды для сравнения элементов по нескольким полям
		СтрокаСортировка = СтрокаСортировка + СтрШаблон(
			"Сравнение = ПроцессорыКоллекцийСлужебный.СравнениеЗначений%1(
			|	Элемент1.Значение.Получить(""%2""),
			|	Элемент2.Значение.Получить(""%2"")
			|);
			|Если Сравнение <> 0 Тогда
			|	Возврат Сравнение;
			|КонецЕсли;
			|
			|",
			ПорядокСортировки,
			ИмяПоля
		);

	КонецЦикла;

	Если СтрокаСортировка = "" Тогда
		Возврат "";
	КонецЕсли;

	Возврат "(Элемент1, Элемент2) -> " + Символы.ПС + СтрокаСортировка + "Возврат Сравнение;";

КонецФункции

// Удаляет строки в таблице по указанному отбору.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//   ОпцииПоиска - ОпцииПоиска - Опции поиска. Содержит следующие параметры:
//     * Отборы - Массив - Отбор для поиска. Каждый элемент массива должен иметь тип "ЭлементОтбора".
//                         Каждый элемент отбора преобразуется к условию поиска.
//                         В качестве "ПутьКДанным" указываются имена колонок.
//
Процедура УдалитьСтрокиВТаблице(ОбъектМодели, ОпцииПоиска) Экспорт
	
	Лог.Отладка("Удаление сущностей в таблице %1", ОбъектМодели.ИмяТаблицы());

	ИмяФайла = ОбъединитьПути(БазовыйКаталог, ОбъектМодели.ИмяТаблицы()) + ".json";
	Блокировка = БлокировкиЧтенияЗаписи.Получить(ИмяФайла).Запись();
	Блокировка.Заблокировать();

	Попытка

		НайденныеСтроки = НайтиСтрокиВТаблице(ОбъектМодели, ОпцииПоиска);

		Лог.Отладка("К удалению сущностей: %1 шт.", НайденныеСтроки.Количество());

		Таблица = ПрочитатьОбъектИзФайла(ИмяФайла);

		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Идентификатор = НайденнаяСтрока.Получить(ОбъектМодели.Идентификатор().ИмяКолонки);
			Если ТипЗнч(Идентификатор) = Тип("Число") Тогда
				Идентификатор = Формат(Идентификатор, "ЧГ=");
			КонецЕсли;

			Таблица.Удалить(Идентификатор);
		КонецЦикла;

		ЗаписатьОбъектВФайл(Таблица, ИмяФайла, ОбъектМодели);

	Исключение

		Блокировка.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

Процедура ЗаписатьОбъектВФайл(Значение, ИмяФайла, ОбъектМодели = Неопределено)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(ИмяФайла, "UTF-8");

	Попытка
		ЗаписатьJSON(ЗаписьJSON, Значение);
	Исключение
		ЗаписьJSON.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьJSON.Закрыть();

КонецПроцедуры

Функция РазложитьОбъектВСоответствие(Значение, ОбъектМодели)
	Соответствие = Новый Соответствие;
	Для Каждого Колонка Из ОбъектМодели.Колонки() Цикл
		ЗначениеПараметра = ОбъектМодели.ПолучитьПриведенноеЗначениеПоля(Значение, Колонка.ИмяПоля);
		Если Колонка.ТипКолонки = ТипыКолонок.ДвоичныеДанные И ЗначениеПараметра <> Неопределено Тогда
			ЗначениеПараметра = ПолучитьBase64СтрокуИзДвоичныхДанных(ЗначениеПараметра);
		КонецЕсли;
		Соответствие.Вставить(Колонка.ИмяКолонки, ЗначениеПараметра);
	КонецЦикла;

	Возврат Соответствие;
КонецФункции

// Восстанавливает значения колонок с датой во всех строках таблицы.
//
// Параметры:
//   Таблица - Соответствие - Данные таблицы, прочитанные из файла. Изменяется по месту.
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//
Процедура ВосстановитьДатыВТаблице(Таблица, ОбъектМодели)

	КолонкиДат = Новый Массив;
	Для Каждого Колонка Из ОбъектМодели.Колонки() Цикл
		Если Колонка.ТипКолонки = ТипыКолонок.Дата
			ИЛИ Колонка.ТипКолонки = ТипыКолонок.Время
			ИЛИ Колонка.ТипКолонки = ТипыКолонок.ДатаВремя Тогда
			КолонкиДат.Добавить(Колонка.ИмяКолонки);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого ИмяКолонки Из КолонкиДат Цикл
			Значение = СтрокаТаблицы.Значение.Получить(ИмяКолонки);
			Если Значение <> Неопределено Тогда
				СтрокаТаблицы.Значение.Вставить(ИмяКолонки, ПрочитатьДатуИзПредставления(Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Восстанавливает значение колонки из представления, хранящегося в файле таблицы.
//
// Параметры:
//   Колонка - Структура - Описание колонки из объекта модели.
//   Значение - Произвольный - Значение колонки, прочитанное из файла таблицы.
//
// Возвращаемое значение:
//   Произвольный - Значение, приведенное к типу колонки.
//
Функция ПрочитатьЗначениеКолонки(Колонка, Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Колонка.ТипКолонки = ТипыКолонок.ДвоичныеДанные Тогда
		Возврат ПолучитьДвоичныеДанныеИзBase64Строки(Значение);
	КонецЕсли;

	Если Колонка.ТипКолонки = ТипыКолонок.Дата
		ИЛИ Колонка.ТипКолонки = ТипыКолонок.Время
		ИЛИ Колонка.ТипКолонки = ТипыКолонок.ДатаВремя Тогда
		Возврат ПрочитатьДатуИзПредставления(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Восстанавливает дату из представления, хранящегося в файле таблицы.
//
// Даты записываются в формате ISO 8601 без указания часового пояса. Файлы, записанные
// прежними версиями библиотеки, содержат дополнительный суффикс "Z", однако значение под
// ним хранится не в UTC: суффикс дописывался к местному времени, а при чтении отбрасывался.
// Поэтому суффикс игнорируется и здесь - иначе даты в таких файлах сдвинулись бы на
// смещение часового пояса.
//
// Параметры:
//   Значение - Строка - Представление даты из файла таблицы.
//            - Дата - Значение, уже восстановленное платформой при разборе JSON.
//
// Возвращаемое значение:
//   Дата - Восстановленное значение.
//
Функция ПрочитатьДатуИзПредставления(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ПрочитатьДатуJSON(СтрЗаменить(Значение, "Z", ""), ФорматДатыJSON.ISO);

КонецФункции

Функция ПрочитатьОбъектИзФайла(ИмяФайла)

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ИмяФайла, "UTF-8");

	Попытка
		Объект = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ЧтениеJSON.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Возврат Объект;

КонецФункции

// Вычисляет идентификатор, не занятый в таблице.
//
// Максимум ищется обычным циклом, а не лямбдой процессора коллекций: лямбда вычисляет
// строковое выражение на каждую строку и обходится на порядок дороже прохода.
//
// Параметры:
//   Таблица - Соответствие - Данные таблицы, прочитанные из файла.
//
// Возвращаемое значение:
//   Число - Идентификатор, больший всех занятых в таблице.
//
Функция СледующийИдентификатор(Таблица)

	МаксимальныйИдентификатор = 0;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗанятыйИдентификатор = Число(СтрокаТаблицы.Ключ);
		Если ЗанятыйИдентификатор > МаксимальныйИдентификатор Тогда
			МаксимальныйИдентификатор = ЗанятыйИдентификатор;
		КонецЕсли;
	КонецЦикла;

	Возврат МаксимальныйИдентификатор + 1;

КонецФункции
