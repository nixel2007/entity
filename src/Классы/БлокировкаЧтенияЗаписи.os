// Реентерабельная блокировка чтения-записи.
//
// Разделяет доступ к ресурсу: читатели работают параллельно друг с другом, писатель работает
// монопольно. Блокировка реентерабельна - контекст исполнения, уже владеющий блокировкой,
// захватывает ее повторно без ожидания. Каждому захвату должно соответствовать освобождение.
//
// Владельцем считается контекст исполнения, а не поток операционной системы: фоновое задание
// опознается по "ФоновыеЗадания.ПолучитьТекущее()", а весь код вне фоновых заданий считается
// одним владельцем. Из этого следуют два ограничения:
//   - код, запущенный в потоках в обход "ФоновыеЗадания", между собой не различается;
//   - "ФоновыеЗадания.Очистить()" очищает список заданий, после чего работающее задание
//     перестает опознаваться и сливается с главным потоком.
//
// Повышение блокировки чтения до блокировки записи не поддерживается и вызывает исключение:
// два читателя, одновременно запросившие запись, ждали бы освобождения друг друга. Обратный
// переход разрешен - владелец блокировки записи может захватить чтение.
//
// Писатель имеет приоритет: пока писатель ожидает, новые читатели не допускаются. Повторный
// захват чтения владельцем при этом не ждет, иначе вложенное чтение блокировало бы само себя.
//
// Ключ владельца, удерживающего блокировку записи. Пустая строка - блокировка записи свободна.
Перем ВладелецЗаписи;
// Число захватов блокировки записи ее владельцем.
Перем ГлубинаЗаписи;
// Соответствие: ключ владельца - число захватов им блокировки чтения.
Перем ГлубиныЧтения;
// Число владельцев, ожидающих блокировку записи. Пока положительно, новые читатели не проходят.
Перем ОжидающиеПисатели;

// Защищает поля состояния. Удерживается только на время их чтения и изменения.
Перем БлокировкаСостояния;
// Пауза между попытками захвата в миллисекундах.
Перем РазмерПаузы;

// Ключ владельца для кода, выполняющегося вне фоновых заданий.
Перем КлючВнеФоновогоЗадания;

Процедура ПриСозданииОбъекта()

	ВладелецЗаписи = "";
	ГлубинаЗаписи = 0;
	ГлубиныЧтения = Новый Соответствие();
	ОжидающиеПисатели = 0;

	БлокировкаСостояния = Новый БлокировкаРесурса();
	РазмерПаузы = 10;

	КлючВнеФоновогоЗадания = "*";

КонецПроцедуры

// Захватить блокировку чтения.
//
// Ожидает, пока ресурс занят писателем или пока писатель стоит в очереди. Если блокировка уже
// захвачена текущим контекстом исполнения - на чтение или на запись, - возвращает управление
// сразу, увеличивая счетчик захватов.
//
// Параметры:
//   ТаймаутОжидания - Число - Таймаут ожидания в миллисекундах. Ноль - ожидать без ограничения.
//
Процедура ЗахватитьЧтение(Знач ТаймаутОжидания = 0) Экспорт

	Ключ = КлючВладельца();
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока НЕ ПопытатьсяЗахватитьЧтение(Ключ) Цикл
		ПроверитьТаймаут(ВремяНачала, ТаймаутОжидания, "чтения");
		Приостановить(РазмерПаузы);
	КонецЦикла;

КонецПроцедуры

// Освободить блокировку чтения.
//
// Уменьшает счетчик захватов чтения текущим контекстом исполнения. Если блокировка чтения
// текущим контекстом не захвачена, вызывает исключение.
//
Процедура ОсвободитьЧтение() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();

	Попытка

		ТекущаяГлубина = ГлубиныЧтения.Получить(Ключ);
		Если ТекущаяГлубина = Неопределено Тогда
			ВызватьИсключение "Блокировка чтения не захвачена текущим контекстом исполнения";
		КонецЕсли;

		Если ТекущаяГлубина = 1 Тогда
			ГлубиныЧтения.Удалить(Ключ);
		Иначе
			ГлубиныЧтения.Вставить(Ключ, ТекущаяГлубина - 1);
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

КонецПроцедуры

// Захватить блокировку записи.
//
// Ожидает, пока ресурс занят другими читателями или другим писателем. Если блокировка записи
// уже захвачена текущим контекстом исполнения, возвращает управление сразу, увеличивая счетчик
// захватов.
//
// Вызывает исключение, если текущий контекст удерживает блокировку чтения и не удерживает
// блокировку записи: повышение блокировки не поддерживается.
//
// Параметры:
//   ТаймаутОжидания - Число - Таймаут ожидания в миллисекундах. Ноль - ожидать без ограничения.
//
Процедура ЗахватитьЗапись(Знач ТаймаутОжидания = 0) Экспорт

	Ключ = КлючВладельца();
	ПроверитьЧтоНеТребуетсяПовышение(Ключ);

	ИзменитьЧислоОжидающихПисателей(1);

	Попытка

		ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока НЕ ПопытатьсяЗахватитьЗапись(Ключ) Цикл
			ПроверитьТаймаут(ВремяНачала, ТаймаутОжидания, "записи");
			Приостановить(РазмерПаузы);
		КонецЦикла;

	Исключение

		ИзменитьЧислоОжидающихПисателей(-1);

		ВызватьИсключение;

	КонецПопытки;

	ИзменитьЧислоОжидающихПисателей(-1);

КонецПроцедуры

// Освободить блокировку записи.
//
// Уменьшает счетчик захватов записи. Если блокировка записи текущим контекстом не захвачена,
// вызывает исключение.
//
Процедура ОсвободитьЗапись() Экспорт

	Ключ = КлючВладельца();

	БлокировкаСостояния.Заблокировать();

	Попытка

		Если ВладелецЗаписи <> Ключ Тогда
			ВызватьИсключение "Блокировка записи не захвачена текущим контекстом исполнения";
		КонецЕсли;

		ГлубинаЗаписи = ГлубинаЗаписи - 1;
		Если ГлубинаЗаписи = 0 Тогда
			ВладелецЗаписи = "";
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

КонецПроцедуры

// Однократная попытка захватить блокировку чтения.
//
// Параметры:
//   Ключ - Строка - Ключ владельца, запрашивающего блокировку.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ПопытатьсяЗахватитьЧтение(Знач Ключ)

	БлокировкаСостояния.Заблокировать();

	Попытка

		ТекущаяГлубина = ГлубиныЧтения.Получить(Ключ);

		// Повторный захват не ждет очереди писателей: иначе владелец, обратившийся к блокировке
		// вложенно, ждал бы писателя, который ждет освобождения этого же владельца.
		Захвачено = ТекущаяГлубина <> Неопределено
			ИЛИ ВладелецЗаписи = Ключ
			ИЛИ (ВладелецЗаписи = "" И ОжидающиеПисатели = 0);

		Если Захвачено Тогда
			ГлубиныЧтения.Вставить(Ключ, ?(ТекущаяГлубина = Неопределено, 0, ТекущаяГлубина) + 1);
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

	Возврат Захвачено;

КонецФункции

// Однократная попытка захватить блокировку записи.
//
// Параметры:
//   Ключ - Строка - Ключ владельца, запрашивающего блокировку.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена.
//
Функция ПопытатьсяЗахватитьЗапись(Знач Ключ)

	БлокировкаСостояния.Заблокировать();

	Попытка

		Захвачено = (ВладелецЗаписи = "" ИЛИ ВладелецЗаписи = Ключ) И НетПостороннихЧитателей(Ключ);

		Если Захвачено Тогда
			ВладелецЗаписи = Ключ;
			ГлубинаЗаписи = ГлубинаЗаписи + 1;
		КонецЕсли;

	Исключение

		БлокировкаСостояния.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

	Возврат Захвачено;

КонецФункции

// Определяет, отсутствуют ли читатели, кроме указанного владельца.
//
// Вызывается при захваченной "БлокировкаСостояния".
//
// Параметры:
//   Ключ - Строка - Ключ владельца, который не учитывается.
//
// Возвращаемое значение:
//   Булево - Истина, если других читателей нет.
//
Функция НетПостороннихЧитателей(Знач Ключ)

	Для Каждого КлючИЗначение Из ГлубиныЧтения Цикл
		Если КлючИЗначение.Ключ <> Ключ Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Убеждается, что запрос блокировки записи не является повышением блокировки чтения.
//
// Параметры:
//   Ключ - Строка - Ключ владельца, запрашивающего блокировку записи.
//
Процедура ПроверитьЧтоНеТребуетсяПовышение(Знач Ключ)

	БлокировкаСостояния.Заблокировать();

	Попытка
		ТребуетсяПовышение = ГлубиныЧтения.Получить(Ключ) <> Неопределено И ВладелецЗаписи <> Ключ;
	Исключение
		БлокировкаСостояния.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

	Если ТребуетсяПовышение Тогда
		ТекстОшибки = "Повышение блокировки чтения до блокировки записи не поддерживается.
			|Освободите блокировку чтения перед захватом блокировки записи";
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

// Изменяет счетчик писателей, стоящих в очереди. Пока счетчик положителен, новые читатели
// не допускаются.
//
// Параметры:
//   Приращение - Число - Величина, на которую изменяется счетчик.
//
Процедура ИзменитьЧислоОжидающихПисателей(Знач Приращение)

	БлокировкаСостояния.Заблокировать();

	Попытка
		ОжидающиеПисатели = ОжидающиеПисатели + Приращение;
	Исключение
		БлокировкаСостояния.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСостояния.Разблокировать();

КонецПроцедуры

// Вызывает исключение, если время ожидания захвата истекло.
//
// Параметры:
//   ВремяНачала - Число - Момент начала ожидания в миллисекундах.
//   ТаймаутОжидания - Число - Таймаут ожидания в миллисекундах. Ноль - ожидать без ограничения.
//   ВидБлокировки - Строка - Вид блокировки для текста исключения.
//
Процедура ПроверитьТаймаут(Знач ВремяНачала, Знач ТаймаутОжидания, Знач ВидБлокировки)

	Если НЕ ЗначениеЗаполнено(ТаймаутОжидания) Тогда
		Возврат;
	КонецЕсли;

	Если ВремяНачала + ТаймаутОжидания < ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда
		ВызватьИсключение СтрШаблон("Истекло время ожидания захвата блокировки %1", ВидБлокировки);
	КонецЕсли;

КонецПроцедуры

// Ключ текущего контекста исполнения.
//
// Возвращаемое значение:
//   Строка - Идентификатор текущего фонового задания либо общий ключ для кода вне заданий.
//
Функция КлючВладельца()

	ТекущееЗадание = ФоновыеЗадания.ПолучитьТекущее();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат КлючВнеФоновогоЗадания;
	КонецЕсли;

	Возврат Строка(ТекущееЗадание.УникальныйИдентификатор);

КонецФункции
