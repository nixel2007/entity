#Использовать "../internal"
#Использовать "../internal/concurrent"

#Использовать asserts
#Использовать reflector

// Строка - Имя источника данных, по которому сущности выбирают источник в аннотации &Сущность.
Перем пИмя;
// Тип - Тип класса коннектора.
Перем пТипКоннектора;
// Строка - Строка соединения с БД.
Перем пСтрокаСоединения;
// ФиксированныйМассив - Дополнительные параметры коннектора.
Перем пПараметрыКоннектора;
// Число - Предел одновременно живущих соединений с БД; 0 - без предела.
Перем пРазмерПула;
// ПулСоединенийСБД, Неопределено - Пул соединений; создается при первом обращении.
Перем пПул;
// БлокировкаЧтенияЗаписи - Защищает создание и закрытие пула.
Перем БлокировкаПула;
// Булево - Закрывать источник по завершению потока, в котором он создан.
Перем пАвтоЗакрытие;
// Булево - Источник закрыт: пул закрыт и соединений больше не выдает.
Перем пЗакрыт;

// Вызывается движком по завершению потока, создавшего источник: при включенном автозакрытии
// закрывает источник. Объявлен до конструктора намеренно: имя обработчика движок разрешает
// в один проход, и подписка на метод, объявленный ниже по модулю, не компилируется.
//
// Вызов через "ДобавитьОбработчик" статический анализ не видит, отсюда подавление диагностики.
//
// BSLLS:UnusedLocalMethod-off
Процедура ПриЗавершенииПотока()
	Если пАвтоЗакрытие Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры
// BSLLS:UnusedLocalMethod-on

// Источник данных: имя, тип коннектора, строка соединения, параметры коннектора, размер пула
// и сам пул соединений одним объектом.
//
// Пул создается при первом обращении и общий для всех, кто работает через источник. Закрывает
// пул сам источник: методом Закрыть() или по завершению потока, в котором источник создан, если
// автозакрытие не выключено, см. УстановитьАвтоЗакрытие. Закрытие терминально: закрытый
// источник соединений не выдает. Тип коннектора проверяется при создании: тип без интерфейса
// АбстрактныйКоннектор отвергается с ошибкой.
//
// Параметры:
//   Имя - Строка - Имя источника данных.
//   ТипКоннектора - Тип - Тип класса, реализующего интерфейс АбстрактныйКоннектор.
//   СтрокаСоединения - Строка - Строка соединения с БД.
//   ПараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//   РазмерПула - Число - Предел одновременно живущих соединений с БД. Ноль снимает предел
//     и постоянно живущих соединений не держит.
//
// Пример:
//   Источник = Новый ИсточникДанных("Основной", Тип("КоннекторPostgreSQL"), СтрокаСоединения);
//
Процедура ПриСозданииОбъекта(
	Знач Имя,
	Знач ТипКоннектора,
	Знач СтрокаСоединения = "",
	Знач ПараметрыКоннектора = Неопределено,
	Знач РазмерПула = 10
)

	ПроверитьПоддержкуИнтерфейсаКоннектора(ТипКоннектора);

	пИмя = Имя;
	пТипКоннектора = ТипКоннектора;
	пСтрокаСоединения = СтрокаСоединения;
	пРазмерПула = РазмерПула;

	Если ПараметрыКоннектора = Неопределено Тогда
		ПараметрыКоннектора = Новый Массив();
	КонецЕсли;
	// Параметры другого источника уже зафиксированы: их можно взять как есть.
	Если ТипЗнч(ПараметрыКоннектора) = Тип("ФиксированныйМассив") Тогда
		пПараметрыКоннектора = ПараметрыКоннектора;
	Иначе
		пПараметрыКоннектора = Новый ФиксированныйМассив(ПараметрыКоннектора);
	КонецЕсли;

	пПул = Неопределено;
	БлокировкаПула = Новый БлокировкаЧтенияЗаписи;
	пАвтоЗакрытие = Истина;
	пЗакрыт = Ложь;

	// Источник живет не дольше создавшего его потока: о завершении сообщит сам поток.
	ДобавитьОбработчик ТекущийПоток().ПриЗавершении, ПриЗавершенииПотока;

КонецПроцедуры

// Проверяет, что тип коннектора реализует интерфейс АбстрактныйКоннектор.
//
// Параметры:
//   ТипКоннектора - Тип - Тип класса коннектора.
//
Процедура ПроверитьПоддержкуИнтерфейсаКоннектора(Знач ТипКоннектора)

	ИнтерфейсКоннектор = Новый ИнтерфейсОбъекта;
	ИнтерфейсКоннектор.ИзОбъекта(Тип("АбстрактныйКоннектор"));

	РефлекторОбъекта = Новый РефлекторОбъекта(ТипКоннектора);
	ПоддерживаетсяИнтерфейсКоннектора = РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсКоннектор);

	Ожидаем.Что(
		ПоддерживаетсяИнтерфейсКоннектора,
		СтрШаблон("Тип <%1> не реализует интерфейс коннектора", ТипКоннектора)
	).ЭтоИстина();

КонецПроцедуры

// Имя источника данных.
//
// Возвращаемое значение:
//   Строка - Имя.
//
Функция Имя() Экспорт
	Возврат пИмя;
КонецФункции

// Тип коннектора.
//
// Возвращаемое значение:
//   Тип - Тип класса коннектора.
//
Функция ТипКоннектора() Экспорт
	Возврат пТипКоннектора;
КонецФункции

// Строка соединения с БД.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединения() Экспорт
	Возврат пСтрокаСоединения;
КонецФункции

// Дополнительные параметры коннектора.
//
// Возвращаемое значение:
//   ФиксированныйМассив - Параметры.
//
Функция ПараметрыКоннектора() Экспорт
	Возврат пПараметрыКоннектора;
КонецФункции

// Размер пула соединений.
//
// Возвращаемое значение:
//   Число - Предел одновременно живущих соединений с БД; 0 - без предела.
//
Функция РазмерПула() Экспорт
	Возврат пРазмерПула;
КонецФункции

// Включает или выключает закрытие источника по завершению потока, в котором он создан.
//
// По умолчанию включено. Выключает тот, кто управляет временем жизни источника сам: контейнер
// приложения или код, создающий источник в одном потоке для работы в других. Тогда источник
// закрывается только явным Закрыть().
//
// Параметры:
//   Значение - Булево - Истина - закрывать по завершению потока; Ложь - только явным Закрыть().
//
Процедура УстановитьАвтоЗакрытие(Знач Значение) Экспорт
	пАвтоЗакрытие = Значение;
КонецПроцедуры

// Признак закрытия источника по завершению потока, см. УстановитьАвтоЗакрытие.
//
// Возвращаемое значение:
//   Булево - Истина, если источник закрывается по завершению создавшего его потока.
//
Функция АвтоЗакрытие() Экспорт
	Возврат пАвтоЗакрытие;
КонецФункции

// Закрывает пул соединений источника: все его соединения закрываются.
//
// Закрытие терминально: после него обращение через источник завершается ошибкой. Повторный
// вызов ничего не делает.
//
Процедура Закрыть() Экспорт

	БлокировкаПула.Запись().Заблокировать();

	Попытка
		Если пПул <> Неопределено И НЕ пЗакрыт Тогда
			// Хранилища сущностей держат пул: закрываются вместе с ним.
			ХранилищаСущностей.Закрыть(пПул);
			пПул.Закрыть();
		КонецЕсли;
		пЗакрыт = Истина;
	Исключение
		БлокировкаПула.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаПула.Запись().Разблокировать();

КонецПроцедуры

// Источник закрыт, см. Закрыть.
//
// Возвращаемое значение:
//   Булево - Истина после закрытия, явного или по завершению потока.
//
Функция Закрыт() Экспорт
	Возврат пЗакрыт;
КонецФункции

// BSLLS:UsingServiceTag-off
// @internal
// BSLLS:UsingServiceTag-on
// Пул соединений источника; создается при первом обращении.
//
// Возвращаемое значение:
//   ПулСоединенийСБД - Пул соединений.
//
Функция ПулСоединений() Экспорт

	Если пПул <> Неопределено И НЕ пЗакрыт Тогда
		Возврат пПул;
	КонецЕсли;

	БлокировкаПула.Запись().Заблокировать();

	Попытка
		Если пЗакрыт Тогда
			ВызватьИсключение СтрШаблон("Источник данных <%1> закрыт", пИмя);
		КонецЕсли;
		Если пПул = Неопределено Тогда
			пПул = Новый ПулСоединенийСБД(пРазмерПула, пТипКоннектора, пСтрокаСоединения, пПараметрыКоннектора);
		КонецЕсли;
	Исключение
		БлокировкаПула.Запись().Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаПула.Запись().Разблокировать();

	Возврат пПул;

КонецФункции
