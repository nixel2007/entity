#Использовать asserts
#Использовать reflector

// Строка - Имя источника данных, по которому сущности выбирают источник в аннотации &Сущность.
Перем пИмя;
// Тип - Тип класса коннектора.
Перем пТипКоннектора;
// Строка - Строка соединения с БД.
Перем пСтрокаСоединения;
// ФиксированныйМассив - Дополнительные параметры коннектора.
Перем пПараметрыКоннектора;
// Число - Размер пула соединений менеджера сущностей.
Перем пРазмерПула;

// Описание источника данных: параметры соединения и пула одним объектом.
//
// Сам источник соединений не открывает; менеджер создается из источника:
//   Источник = Новый ИсточникДанных("Основной", Тип("КоннекторPostgreSQL"), СтрокаСоединения);
//   МенеджерСущностей = Новый МенеджерСущностей(Источник);
//
// Параметры:
//   Имя - Строка - Имя источника данных.
//   ТипКоннектора - Тип - Тип класса, реализующего интерфейс АбстрактныйКоннектор; проверяется при создании.
//   СтрокаСоединения - Строка - Строка соединения с БД.
//   ПараметрыКоннектора - Массив - Дополнительные параметры коннектора.
//   РазмерПула - Число - Размер пула соединений менеджера; по умолчанию тот же, что у
//     конструктора МенеджерСущностей. Ноль снимает предел и постоянно живущих соединений не держит.
//
Процедура ПриСозданииОбъекта(
	Знач Имя,
	Знач ТипКоннектора,
	Знач СтрокаСоединения = "",
	Знач ПараметрыКоннектора = Неопределено,
	Знач РазмерПула = 10
)

	ПроверитьПоддержкуИнтерфейсаКоннектора(ТипКоннектора);

	пИмя = Имя;
	пТипКоннектора = ТипКоннектора;
	пСтрокаСоединения = СтрокаСоединения;
	пРазмерПула = РазмерПула;

	Если ПараметрыКоннектора = Неопределено Тогда
		ПараметрыКоннектора = Новый Массив();
	КонецЕсли;
	// Параметры другого источника уже зафиксированы: их можно взять как есть.
	Если ТипЗнч(ПараметрыКоннектора) = Тип("ФиксированныйМассив") Тогда
		пПараметрыКоннектора = ПараметрыКоннектора;
	Иначе
		пПараметрыКоннектора = Новый ФиксированныйМассив(ПараметрыКоннектора);
	КонецЕсли;

КонецПроцедуры

// Проверяет, что тип коннектора реализует интерфейс АбстрактныйКоннектор.
//
// Параметры:
//   ТипКоннектора - Тип - Тип класса коннектора.
//
Процедура ПроверитьПоддержкуИнтерфейсаКоннектора(Знач ТипКоннектора)

	ИнтерфейсКоннектор = Новый ИнтерфейсОбъекта;
	ИнтерфейсКоннектор.ИзОбъекта(Тип("АбстрактныйКоннектор"));

	РефлекторОбъекта = Новый РефлекторОбъекта(ТипКоннектора);
	ПоддерживаетсяИнтерфейсКоннектора = РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсКоннектор);

	Ожидаем.Что(
		ПоддерживаетсяИнтерфейсКоннектора,
		СтрШаблон("Тип <%1> не реализует интерфейс коннектора", ТипКоннектора)
	).ЭтоИстина();

КонецПроцедуры

// Имя источника данных.
//
// Возвращаемое значение:
//   Строка - Имя.
//
Функция Имя() Экспорт
	Возврат пИмя;
КонецФункции

// Тип коннектора.
//
// Возвращаемое значение:
//   Тип - Тип класса коннектора.
//
Функция ТипКоннектора() Экспорт
	Возврат пТипКоннектора;
КонецФункции

// Строка соединения с БД.
//
// Возвращаемое значение:
//   Строка - Строка соединения.
//
Функция СтрокаСоединения() Экспорт
	Возврат пСтрокаСоединения;
КонецФункции

// Дополнительные параметры коннектора.
//
// Возвращаемое значение:
//   ФиксированныйМассив - Параметры.
//
Функция ПараметрыКоннектора() Экспорт
	Возврат пПараметрыКоннектора;
КонецФункции

// Размер пула соединений менеджера сущностей.
//
// Возвращаемое значение:
//   Число - Предел одновременно живущих соединений; 0 - без предела.
//
Функция РазмерПула() Экспорт
	Возврат пРазмерПула;
КонецФункции
