// BSLLS:UnusedParameters-off
// Для хранения статуса соединения
Перем Открыт;

// Конструктор объекта АбстрактныйКоннектор.
//
// Класс описывает интерфейс коннектора: реализации объявляют его аннотацией
// &Реализует("АбстрактныйКоннектор") и могут дополнительно объявить НаблюдаемыйКоннектор.
//
&Интерфейс
Процедура ПриСозданииОбъекта()
	Открыт = Ложь;
КонецПроцедуры

// Открыть соединение с БД.
//
// Параметры:
//   СтрокаСоединения - Строка - Строка соединения с БД.
//   ПараметрыКоннектора - Массив - Дополнительные параметры инициализации коннектора.
//
Процедура Открыть(СтрокаСоединения, ПараметрыКоннектора) Экспорт
	Открыт = Истина;
КонецПроцедуры

// Закрыть соединение с БД.
//
Процедура Закрыть() Экспорт
	Открыт = Ложь;
КонецПроцедуры

// Получить статус соединения с БД.
//
//  Возвращаемое значение:
//   Булево - Состояние соединения. Истина, если соединение установлено и готово к использованию.
//       В обратном случае - Ложь.
//
Функция Открыт() Экспорт
	Возврат Открыт;
КонецФункции

// Начинает новую транзакцию в БД.
//
Процедура НачатьТранзакцию() Экспорт
	
КонецПроцедуры

// Фиксирует открытую транзакцию в БД.
//
Процедура ЗафиксироватьТранзакцию() Экспорт
	
КонецПроцедуры

// Отменяет открытую транзакцию в БД.
//
Процедура ОтменитьТранзакцию() Экспорт

КонецПроцедуры

// Определяет, начата ли этим коннектором транзакция, которая еще не завершена: методом
// коннектора или текстом запроса прямого доступа.
//
// По ответу пул откатывает транзакцию, брошенную алгоритмом ВыполнитьСКоннектором, прежде чем
// соединение достанется другому потоку исполнения. Коннектор без транзакций отвечает Ложь.
//
//  Возвращаемое значение:
//   Булево - Истина, если транзакция начата и не завершена.
//
Функция ВТранзакции() Экспорт
	Возврат Ложь;
КонецФункции

// Выполняет действие так, чтобы другие потоки исполнения не видели его промежуточных состояний.
//
// Библиотека выполняет так операции из нескольких запросов - сохранение сущности с подчиненными
// таблицами. Коннектор с транзакциями выполняет действие в своей транзакции, а внутри уже
// начатой - просто выполняет; коннектор без транзакций - под своей блокировкой записи. Коннектор,
// не умеющий изолировать, просто выполняет действие.
//
// Параметры:
//   Действие - Действие - Действие без параметров.
//
Процедура ВыполнитьМонопольно(Действие) Экспорт
	Действие.Выполнить();
КонецПроцедуры

// Создает таблицу в БД по данным модели.
//
// Параметры:
//   ОбъектМодели - ОбъектМодели - Объект, содержащий описание класса-сущности и настроек таблицы БД.
//
Процедура ИнициализироватьТаблицу(ОбъектМодели) Экспорт

КонецПроцедуры

// Сохраняет сущность в БД.
//
// Параметры:
