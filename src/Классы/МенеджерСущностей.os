#Использовать "../Аннотации"
#Использовать "../internal"

#Использовать asserts
#Использовать logos
#Использовать reflector

// МодельДанных - Хранит данные о типах полей, колонках, настроек таблиц для типов сущностей
Перем МодельДанных;

// ИсточникДанных - Источник данных, из которого создан менеджер: параметры соединения и пула.
Перем Источник;

// ПулСоединенийСБД - Выдает потокам исполнения отдельные коннекторы: через него идут все обращения к БД.
Перем ПулСоединений;

// Лог - Журнал библиотеки.
Перем Лог;

// Конструктор объекта МенеджерСущностей.
//
// Менеджер создается из источника данных: из него берутся тип коннектора, строка соединения,
// параметры коннектора и размер пула. Создание по параметрам соединения устарело и отмечается
// предупреждением в логе, как и параметры, переданные вместе с источником.
//
// Параметры:
//   ИсточникДанных - ИсточникДанных - Источник данных, из которого создается менеджер.
//                  - Тип - Устарел. Тип класса, реализующего интерфейс Коннектор.
//   УстарелСтрокаСоединения - Строка - Устарел. Строка соединения к БД, задается в источнике данных.
//   УстарелПараметрыКоннектора - Массив - Устарел. Параметры коннектора, задаются в источнике данных.
//   УстарелРазмерПулаСоединений - Число - Устарел. Размер пула соединений, задается в источнике данных.
//
// Пример:
//   Источник = Новый ИсточникДанных("Основной", Тип("КоннекторSQLite"), СтрокаСоединения);
//   МенеджерСущностей = Новый МенеджерСущностей(Источник);
//
Процедура ПриСозданииОбъекта(
	Знач ИсточникДанных,
	Знач УстарелСтрокаСоединения = "",
	Знач УстарелПараметрыКоннектора = Неопределено,
	Знач УстарелРазмерПулаСоединений = 10
)

	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.manager");

	Если ТипЗнч(ИсточникДанных) = Тип("ИсточникДанных") Тогда
		Источник = ИсточникДанных;
		ПредупредитьОЛишнихПараметрах(
			УстарелСтрокаСоединения,
			УстарелПараметрыКоннектора,
			УстарелРазмерПулаСоединений
		);
	Иначе
		Лог.Предупреждение(
			"Создание МенеджерСущностей по параметрам соединения устарело: создавайте менеджер из ИсточникДанных"
		);
		Источник = Новый ИсточникДанных(
			"",
			ИсточникДанных,
			УстарелСтрокаСоединения,
			УстарелПараметрыКоннектора,
			УстарелРазмерПулаСоединений
		);
	КонецЕсли;

	Лог.Отладка("Инициализация менеджера сущностей с коннектором %1", Источник.ТипКоннектора());

	МодельДанных = Новый МодельДанных;

	// Соединений пул заранее не открывает, поэтому его можно завести сразу: коннектор доступен
	// до Инициализировать(), как и раньше. Параметры коннектора берутся зафиксированными из источника.
	ПулСоединений = Новый ПулСоединенийСБД(
		Источник.РазмерПула(),
		Источник.ТипКоннектора(),
		Источник.СтрокаСоединения(),
		Источник.ПараметрыКоннектора()
	);

КонецПроцедуры

// Предупреждает, что вместе с источником данных переданы устаревшие параметры конструктора.
//
// Параметры:
//   СтрокаСоединения - Строка - Второй параметр конструктора.
//   ПараметрыКоннектора - Массив, Неопределено - Третий параметр конструктора.
//   РазмерПулаСоединений - Число - Четвертый параметр конструктора.
//
Процедура ПредупредитьОЛишнихПараметрах(Знач СтрокаСоединения, Знач ПараметрыКоннектора, Знач РазмерПулаСоединений)

	ЕстьЛишние = ЗначениеЗаполнено(СтрокаСоединения)
		ИЛИ ПараметрыКоннектора <> Неопределено
		ИЛИ РазмерПулаСоединений <> РазмерПулаПоУмолчанию();

	Если ЕстьЛишние Тогда
		Лог.Предупреждение(
			"При создании МенеджерСущностей из ИсточникДанных остальные параметры конструктора не используются: "
				+ "строка соединения, параметры коннектора и размер пула берутся из источника"
		);
	КонецЕсли;

КонецПроцедуры

// Размер пула, подразумеваемый конструктором, когда он не задан.
//
// Возвращаемое значение:
//   Число - Значение по умолчанию параметра УстарелРазмерПулаСоединений.
//
Функция РазмерПулаПоУмолчанию()
	Возврат 10; // BSLLS:MagicNumber-off
КонецФункции

// Регистрирует переданный тип класса-сценария в модели данных.
//
// Параметры:
//   ТипСущности - Тип - Тип для добавления в модель
//
Процедура ДобавитьКлассВМодель(ТипСущности) Экспорт
	ПроверитьЧтоКлассЯвляетсяСущностью(ТипСущности);

	МодельДанных.СоздатьОбъектМодели(ТипСущности);
КонецПроцедуры

// Получить модель данных - хранилище информации о типах полей, колонок, таблиц для типов сущостей.
// 
// Возвращаемое значение:
//   МодельДанных
//
Функция ПолучитьМодельДанных() Экспорт
	Возврат МодельДанных;
КонецФункции

// Создает таблицы БД по модели данных.
//
Процедура Инициализировать() Экспорт

	Соединение = ПулСоединений.Занять();

	Попытка
		СоздатьТаблицы(Соединение.ПолучитьКоннектор());
	Исключение
		ПулСоединений.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	ПулСоединений.Освободить();

КонецПроцедуры

// Создает таблицы БД по объектам модели данных.
//
// Параметры:
//   Коннектор - АбстрактныйКоннектор - Коннектор занятого соединения.
//
Процедура СоздатьТаблицы(Коннектор)

	Для Каждого ОбъектМодели Из МодельДанных.ПолучитьОбъектыМодели() Цикл

		Коннектор.ИнициализироватьТаблицу(ОбъектМодели);

		Для Каждого ПодчиненнаяТаблица Из ОбъектМодели.ПодчиненныеТаблицы() Цикл

			ОбъектМоделиЭлементКоллекции = ОбработкаКоллекций.ПолучитьОбъектМоделиДляПодчиненнойТаблицы(
				ОбъектМодели,
				ПодчиненнаяТаблица
			);

			Коннектор.ИнициализироватьТаблицу(ОбъектМоделиЭлементКоллекции);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Создает экземпляр сущности, расширенный методами паттерна Active Record.
//
// Параметры:
//   ТипСущности - Тип - Тип создаваемой сущности.
//
//  Возвращаемое значение:
//   Произвольный - экземпляр класса сущности с типом, привязанным к переданному "ТипуСущности",
//                  с дополнительными методами паттерна Active Record.
//
Функция СоздатьЭлемент(ТипСущности) Экспорт
	ОбъектМодели = МодельДанных.Получить(ТипСущности);

	Возврат АктивнаяЗапись.СоздатьИзМенеджера(ОбъектМодели, ЭтотОбъект);
КонецФункции

// Сохраняет сущность в БД.
// Если текущий поток исполнения начал транзакцию, операция идет по соединению этой транзакции.
//
// Параметры:
//   Сущность - Произвольный - Объект (экземпляр класса, зарегистрированного в модели) для сохранения в БД.
//
Процедура Сохранить(Сущность) Экспорт

	ТипСущности = АктивнаяЗапись.ТипСущности(Сущность);
	ОбъектМодели = МодельДанных.Получить(ТипСущности);
	ПулСущностей = ПолучитьПулСущностей(ТипСущности);

	РаботаСКоннекторами.СохранитьЧерезПул(ПулСоединений, ОбъектМодели, ПулСущностей, Сущность);

КонецПроцедуры

// Осуществляет поиск сущностей переданного типа по идентификатору.
// Если текущий поток исполнения начал транзакцию, операция идет по соединению этой транзакции.
//
// Параметры:
//   ТипСущности - Тип - Тип искомой сущности.
//   ОпцииПоиска - Произвольный - Опции поиска.
//     Если параметр не задан или равен "Неопределено", то возвращаются все найденные сущности указанного типа.
//     Если параметр имеет тип "Соответствие", то каждое значение соответствия преобразуется к условию поиска
//      ИмяПоля = ЗначениеПоля, где ИмяПоля - ключ элемента соответствия, ЗначениеПоля - значение элемента соответствия.
//     Если параметр имеет тип "ОпцииПоиска", то опции передаются как есть.
//
//  Возвращаемое значение:
//   Массив - Массив найденных сущностей. В качестве элементов массива выступают
//     экземпляры класса с типом, равным переданному параметру "ТипСущности", с заполненными значениями полей.
//
Функция Получить(ТипСущности, Знач ОпцииПоиска = Неопределено) Экспорт

	ОбъектМодели = МодельДанных.Получить(ТипСущности);
	ПулСущностей = ПолучитьПулСущностей(ТипСущности);
	Если ОпцииПоиска = Неопределено Тогда
		ОпцииПоиска = Новый ОпцииПоиска;
	КонецЕсли;

	Возврат РаботаСКоннекторами.ПолучитьЧерезПул(ПулСоединений, ОбъектМодели, ПулСущностей, ОпцииПоиска);

КонецФункции

// Осуществляет поиск сущности переданного типа по идентификатору.
// Если текущий поток исполнения начал транзакцию, операция идет по соединению этой транзакции.
//
// Параметры:
//   ТипСущности - Тип - Тип искомой сущности.
//   ОпцииПоиска - Произвольный - Опции поиска.
//     Если параметр не задан или равен "Неопределено", то возвращаются все найденные сущности указанного типа.
//     Если параметр имеет тип "Соответствие", то каждое значение соответствия преобразуется к условию поиска
//      ИмяПоля = ЗначениеПоля, где ИмяПоля - ключ элемента соответствия, ЗначениеПоля - значение элемента соответствия.
//     Если параметр имеет тип "ОпцииПоиска", то опции передаются как есть.
//     Любой другой тип интерпретируется как поиск по &Идентификатору.
//
//  Возвращаемое значение:
//   Произвольный - Если сущность была найдена, то возвращается экземпляр класса с типом, равным переданному параметру
//     "ТипСущности", с заполненными значениями полей. Иначе возвращается "Неопределено".
//
Функция ПолучитьОдно(ТипСущности, Знач ОпцииПоиска = Неопределено) Экспорт

	ОбъектМодели = МодельДанных.Получить(ТипСущности);
	ПулСущностей = ПолучитьПулСущностей(ТипСущности);
	Если ОпцииПоиска = Неопределено Тогда
		ОпцииПоиска = Новый ОпцииПоиска;
	КонецЕсли;

	Возврат РаботаСКоннекторами.ПолучитьОдноЧерезПул(ПулСоединений, ОбъектМодели, ПулСущностей, ОпцииПоиска);

КонецФункции

// Выполняет удаление сущности из базы данных.
// Если текущий поток исполнения начал транзакцию, операция идет по соединению этой транзакции.
// Сущность должна иметь заполненный идентификатор.
//
// Параметры:
//   Сущность - Произвольный - Удаляемая сущность
//
Процедура Удалить(Сущность) Экспорт

	ТипСущности = АктивнаяЗапись.ТипСущности(Сущность);
	ОбъектМодели = МодельДанных.Получить(ТипСущности);
	ПулСущностей = ПолучитьПулСущностей(ТипСущности);

	РаботаСКоннекторами.УдалитьЧерезПул(ПулСоединений, ОбъектМодели, ПулСущностей, Сущность);

КонецПроцедуры

// Выполняет очистку полную данных библиотеки.
// Дополнительно посылает всем используемым коннекторам запросы на закрытие соединения.
//
Процедура Закрыть() Экспорт

	ХранилищаСущностей.Закрыть(Источник.ТипКоннектора(), Источник.СтрокаСоединения());

	Если ПулСоединений <> Неопределено Тогда
		ПулСоединений.Закрыть();
	КонецЕсли;

	МодельДанных.Очистить();

	// Для освобожения ссылок на все коннекторы и соединения с СУБД
	ВыполнитьСборкуМусора();

КонецПроцедуры

// Начинает транзакцию для текущего потока исполнения.
//
// Поток занимает соединение и держит его до фиксации или отмены, поэтому все его операции
// попадают в эту транзакцию, а завершить ее другое фоновое задание не может.
//
Процедура НачатьТранзакцию() Экспорт
	РаботаСКоннекторами.НачатьТранзакциюПотокаИсполнения(ПулСоединений);
КонецПроцедуры

// Фиксирует транзакцию текущего потока исполнения и возвращает его соединение в пул.
//
Процедура ЗафиксироватьТранзакцию() Экспорт
	РаботаСКоннекторами.ЗафиксироватьТранзакциюПотокаИсполнения(ПулСоединений);
КонецПроцедуры

// Отменяет транзакцию текущего потока исполнения и возвращает его соединение в пул.
//
Процедура ОтменитьТранзакцию() Экспорт
	РаботаСКоннекторами.ОтменитьТранзакциюПотокаИсполнения(ПулСоединений);
КонецПроцедуры

// Выполняет алгоритм коннектором из пула.
//
// Прямой доступ к БД в обход библиотеки. Соединение занимается на время выполнения алгоритма и
// сразу возвращается в пул, поэтому держать его за пределами вызова нельзя. Если текущий поток
// исполнения начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
// Пример:
//   Менеджер.ВыполнитьСКоннектором(
//       "Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)",
//       Новый Структура("Текст", "DELETE FROM Авторы")
//   );
//
Процедура ВыполнитьСКоннектором(Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт
	РаботаСКоннекторами.ВыполнитьСКоннекторомЧерезПул(ПулСоединений, Алгоритм, Контекст, Объект);
КонецПроцедуры

// Вычисляет значение алгоритмом, выполненным коннектором из пула.
//
// Прямой доступ к БД в обход библиотеки. Соединение занимается на время выполнения алгоритма и
// сразу возвращается в пул, поэтому держать его за пределами вызова нельзя. Если текущий поток
// исполнения начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
// Возвращаемое значение:
//   Произвольный - Результат алгоритма.
//
// Пример:
//   Строки = Менеджер.ВычислитьСКоннектором("Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
//       Новый Структура("Запрос", "SELECT * FROM Авторы"));
//
Функция ВычислитьСКоннектором(Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт
	Возврат РаботаСКоннекторами.ВычислитьСКоннекторомЧерезПул(ПулСоединений, Алгоритм, Контекст, Объект);
КонецФункции

// BSLLS:UsingServiceTag-off
// @internal
// BSLLS:UsingServiceTag-on
// Для служебного пользования.
//
// Возвращает пул соединений менеджера.
//
// Хранилища сущностей работают тем же пулом, что и менеджер: предел одновременно живущих
// соединений должен быть общим, а транзакция потока - видной из обоих.
//
// Возвращаемое значение:
//   ПулСоединенийСБД - Пул соединений менеджера.
//
Функция ПолучитьПулСоединений() Экспорт
	Возврат ПулСоединений;
КонецФункции

// Получает ХранилищеСущностей, привязанное к переданному типу сущности.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности, зарегистрированный в Модели
//
//  Возвращаемое значение:
//   ХранилищеСущностей - Хранилище сущностей, привязанное к переданному типу сущности.
//
Функция ПолучитьХранилищеСущностей(ТипСущности) Экспорт
	ОбъектМодели = МодельДанных.Получить(ТипСущности);
	ХранилищеСущностей = ХранилищаСущностей.Получить(ОбъектМодели, ПулСоединений);
	Возврат ХранилищеСущностей;
КонецФункции

// @internal
//
// Для служебного пользования.
//
// Возвращает пул сущностей из хранилища сущностей, привязанного к переданному типу сущности.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности, зарегистрированный в Модели.
//
//  Возвращаемое значение:
//   Соответствие - Пул сущностей.
//
Функция ПолучитьПулСущностей(ТипСущности) Экспорт
	Возврат ПолучитьХранилищеСущностей(ТипСущности).ПолучитьПулСущностей();
КонецФункции

// <Описание процедуры>
//
// Параметры:
//   ТипКласса - Тип - Тип, в котором проверяется наличие необходимых аннотаций.
//
Процедура ПроверитьЧтоКлассЯвляетсяСущностью(ТипКласса)

	РефлекторОбъекта = Новый РефлекторОбъекта(ТипКласса);
	ТаблицаМетодов = РефлекторОбъекта.ПолучитьТаблицуМетодов("Сущность", Ложь);
	Ожидаем.Что(ТаблицаМетодов, СтрШаблон("Класс %1 не имеет аннотации &Сущность", ТипКласса)).ИмеетДлину(1);

	ТаблицаСвойств = РефлекторОбъекта.ПолучитьТаблицуСвойств("Идентификатор");
	Ожидаем.Что(ТаблицаСвойств, СтрШаблон("Класс %1 не имеет поля с аннотацией &Идентификатор", ТипКласса)).ИмеетДлину(1);

КонецПроцедуры
