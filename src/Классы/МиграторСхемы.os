#Использовать "../internal"

#Использовать asserts
#Использовать logos
#Использовать reflector
#Использовать semver

// Выполняет автоматическую миграцию схемы БД при инициализации менеджера сущностей.
//
// Мигратор сравнивает модель данных с фактической схемой БД, строит ПланМиграции
// и применяет его через коннектор, реализующий интерфейс АбстрактныйКоннекторМиграций.
// Для коннектора без поддержки этого интерфейса выполняется обычная инициализация таблиц.
//
// До и после применения изменений схемы вызываются зарегистрированные обработчики миграции
// (см. АбстрактныйОбработчикМиграции). При включенном отслеживании версии схемы
// (см. УстановитьВерсиюСхемы) обработчики, привязанные к версиям, образуют конвейер:
// при обновлении через несколько версий они выполняются в порядке возрастания версий.

Перем МенеджерСущностей;
Перем Обработчики;
Перем ВерсияПриложения;
Перем МинимальнаяВерсияОбновления;
Перем УдалятьЛишниеКолонки;
Перем ОтслеживатьВерсию;
Перем ИдентификаторЗаписиВерсии;

Перем Рефлектор;
Перем Лог;

// Конструктор объекта МиграторСхемы.
//
// Параметры:
//   ПМенеджерСущностей - МенеджерСущностей - Менеджер сущностей, для которого выполняется миграция.
//
Процедура ПриСозданииОбъекта(Знач ПМенеджерСущностей)
	МенеджерСущностей = ПМенеджерСущностей;
	Обработчики = Новый Массив;
	ВерсияПриложения = "";
	МинимальнаяВерсияОбновления = "";
	УдалятьЛишниеКолонки = Ложь;
	ОтслеживатьВерсию = Ложь;
	ИдентификаторЗаписиВерсии = "схема";

	Рефлектор = Новый Рефлектор;
	Лог = Логирование.ПолучитьЛог("oscript.lib.entity.migrator");
КонецПроцедуры

// Устанавливает версию схемы данных приложения и включает хранение версии схемы
// в служебной таблице (см. СлужебнаяСущность_ВерсияСхемы).
//
// При первой инициализации с включенным отслеживанием версия просто фиксируется в БД,
// обработчики, привязанные к версиям, при этом не выполняются.
// При последующих повышениях версии выполняется конвейер обработчиков (см. ДобавитьОбработчикМиграции).
// Понижение версии не поддерживается и приводит к исключению при инициализации.
//
// Параметры:
//   Версия - Строка - Версия схемы в формате семантического версионирования ("МАЖОР.МИНОР.ПАТЧ").
//       Недостающие компоненты версии дополняются нулями: "0.2" эквивалентно "0.2.0".
//
Процедура УстановитьВерсиюСхемы(Знач Версия) Экспорт
	Ожидаем.Что(Версия, "Версия схемы должна быть заполнена").Заполнено();
	ВерсияПриложения = НормализоватьВерсию(Версия);
	ОтслеживатьВерсию = Истина;
КонецПроцедуры

// Возвращает установленную версию схемы данных приложения.
//
//  Возвращаемое значение:
//   Строка - Нормализованная версия схемы приложения, либо пустая строка.
//
Функция ВерсияСхемыПриложения() Экспорт
	Возврат ВерсияПриложения;
КонецФункции

// Устанавливает барьерную версию: минимальную хранимую версию схемы, с которой поддерживается
// обновление на версию схемы приложения.
//
// Используется, когда сквозное обновление через несколько версий невозможно без потери данных.
// Например: в версии 2.0.0 добавлена колонка, заполняемая из старой колонки, а в версии 3.0.0
// старая колонка удалена из модели. Миграция данных версии 2.0.0 неисполнима в приложении
// версии 3.0.0 - его модель данных уже не содержит старой колонки. В этом случае приложение
// версии 3.0.0 объявляет минимальную версию обновления 2.0.0: инициализация с хранимой версией
// схемы меньше барьерной завершается исключением с указанием выполнить обновление
// через промежуточную версию приложения.
//
// Ограничение проверяется только при фактическом повышении версии схемы
// (требуется УстановитьВерсиюСхемы).
//
// Параметры:
//   Версия - Строка - Версия схемы в формате семантического версионирования ("МАЖОР.МИНОР.ПАТЧ").
//       Недостающие компоненты версии дополняются нулями.
//
Процедура УстановитьМинимальнуюВерсиюОбновления(Знач Версия) Экспорт
	Ожидаем.Что(Версия, "Минимальная версия обновления должна быть заполнена").Заполнено();
	МинимальнаяВерсияОбновления = НормализоватьВерсию(Версия);
КонецПроцедуры

// Возвращает установленную барьерную версию обновления.
//
//  Возвращаемое значение:
//   Строка - Нормализованная минимальная версия обновления, либо пустая строка.
//
Функция МинимальнаяВерсияОбновления() Экспорт
	Возврат МинимальнаяВерсияОбновления;
КонецФункции

// Возвращает версию схемы, сохраненную в служебной таблице БД.
//
//  Возвращаемое значение:
//   Строка, Неопределено - Хранимая версия схемы. Неопределено, если версия не сохранялась
//       или отслеживание версии не включено.
//
Функция ХранимаяВерсияСхемы() Экспорт
	Если НЕ ОтслеживатьВерсию Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗаписьВерсии = МенеджерСущностей.ПолучитьОдно(Тип("СлужебнаяСущность_ВерсияСхемы"), ИдентификаторЗаписиВерсии);
	Если ЗаписьВерсии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НормализоватьВерсию(ЗаписьВерсии.Версия);
КонецФункции

// Включает или выключает удаление из БД колонок, отсутствующих в модели данных.
//
// По умолчанию удаление выключено: лишние колонки сохраняются, а в журнал выводится предупреждение.
//
// Параметры:
//   Значение - Булево - Истина, если лишние колонки нужно удалять при миграции.
//
Процедура УстановитьУдалениеЛишнихКолонок(Знач Значение) Экспорт
	УдалятьЛишниеКолонки = Значение;
КонецПроцедуры

// Регистрирует обработчик данных, вызываемый при обновлении схемы БД.
//
// Обработчик должен реализовывать хотя бы один из методов ПередМиграцией / ПослеМиграции
// (см. АбстрактныйОбработчикМиграции). Если обработчик реализует метод ВерсияСхемы,
// возвращающий непустую версию, он выполняется только при переходе хранимой версии схемы
// через эту версию. Обработчики нескольких версий выполняются в порядке возрастания версий
// независимо от порядка регистрации; несколько обработчиков одной версии выполняются
// в порядке регистрации.
//
// Параметры:
//   Обработчик - Произвольный - Регистрируемый обработчик миграции.
//
Процедура ДобавитьОбработчикМиграции(Знач Обработчик) Экспорт
	ЕстьМетодПеред = Рефлектор.МетодСуществует(Обработчик, "ПередМиграцией");
	ЕстьМетодПосле = Рефлектор.МетодСуществует(Обработчик, "ПослеМиграции");

	Ожидаем.Что(
		ЕстьМетодПеред ИЛИ ЕстьМетодПосле,
		СтрШаблон(
			"Обработчик миграции %1 должен реализовывать хотя бы один из методов ПередМиграцией / ПослеМиграции",
			ТипЗнч(Обработчик)
		)
	).ЭтоИстина();

	ВерсияОбработчика = ЗначениеМетодаВерсии(Обработчик, "ВерсияСхемы");
	МинимальнаяВерсияОбработчика = ЗначениеМетодаВерсии(Обработчик, "МинимальнаяВерсияСхемы");

	ОписаниеОбработчика = Новый Структура(
		"Обработчик, Версия, МинимальнаяВерсия",
		Обработчик,
		ВерсияОбработчика,
		МинимальнаяВерсияОбработчика
	);
	Обработчики.Добавить(ОписаниеОбработчика);
КонецПроцедуры

// Выполняет миграцию схемы БД.
//
// Вызывается менеджером сущностей при инициализации. Порядок выполнения:
//   1. Инициализация служебной таблицы версии схемы и чтение хранимой версии (при отслеживании версии);
//   2. Построение плана миграции сравнением модели данных с фактической схемой БД;
//   3. Вызов методов ПередМиграцией обработчиков;
//   4. Применение плана миграции;
//   5. Вызов методов ПослеМиграции обработчиков с фиксацией каждой пройденной версии конвейера;
//   6. Фиксация версии схемы приложения.
//
Процедура ВыполнитьМиграцию() Экспорт
	Коннектор = МенеджерСущностей.ПолучитьКоннектор();
	ПоддерживаютсяМиграции = КоннекторПоддерживаетМиграции(Коннектор);

	Если НЕ ПоддерживаютсяМиграции Тогда
		Лог.Предупреждение(
			"Коннектор %1 не реализует интерфейс АбстрактныйКоннекторМиграций, миграция схемы недоступна",
			ТипЗнч(Коннектор)
		);
		ИнициализироватьТаблицыБезМиграции(Коннектор);
	КонецЕсли;

	ХранимаяВерсия = Неопределено;
	Если ОтслеживатьВерсию Тогда
		ХранимаяВерсия = ИнициализироватьХранениеВерсии(Коннектор, ПоддерживаютсяМиграции);
		ПроверитьДопустимостьОбновленияВерсии(ХранимаяВерсия);
	КонецЕсли;

	План = ПостроитьПланМиграции();

	ВыполняетсяПовышениеВерсии = ОтслеживатьВерсию
		И ХранимаяВерсия <> Неопределено
		И ЗначениеЗаполнено(ВерсияПриложения)
		И Версии.СравнитьВерсии(ВерсияПриложения, ХранимаяВерсия) = 1;

	Если План.Пустой() И НЕ ВыполняетсяПовышениеВерсии Тогда
		Если ОтслеживатьВерсию И ХранимаяВерсия = Неопределено Тогда
			// Первичная фиксация версии схемы (baseline)
			ЗаписатьВерсию(ВерсияПриложения);
		КонецЕсли;

		Возврат;
	КонецЕсли;

	Лог.Информация("Обнаружено обновление схемы данных");
	Если НЕ План.Пустой() Тогда
		Лог.Информация("План миграции схемы:%1%2", Символы.ПС, План.Представление());
	КонецЕсли;

	ШагиКонвейера = ШагиКонвейераОбновления(ХранимаяВерсия, ВыполняетсяПовышениеВерсии);
	БезверсионныеОбработчики = БезверсионныеОбработчики();

	ВызватьОбработчики("ПередМиграцией", БезверсионныеОбработчики, План);
	Для Каждого Шаг Из ШагиКонвейера Цикл
		ВызватьОбработчики("ПередМиграцией", Шаг.Обработчики, План);
	КонецЦикла;

	Если ПоддерживаютсяМиграции Тогда
		ПрименитьПлан(Коннектор, План);
	КонецЕсли;

	Для Каждого Шаг Из ШагиКонвейера Цикл
		ВызватьОбработчики("ПослеМиграции", Шаг.Обработчики, План);
		// Фиксация пройденной версии конвейера: прерванная миграция продолжится со следующей версии
		ЗаписатьВерсию(Шаг.Версия);
	КонецЦикла;
	ВызватьОбработчики("ПослеМиграции", БезверсионныеОбработчики, План);

	ЗаписатьВерсию(ВерсияПриложения);
КонецПроцедуры

// Строит план миграции сравнением модели данных с фактической схемой БД.
//
// Если коннектор не реализует интерфейс АбстрактныйКоннекторМиграций, возвращается пустой план.
//
//  Возвращаемое значение:
//   ПланМиграции - План изменений схемы БД.
//
Функция ПостроитьПланМиграции() Экспорт
	План = Новый ПланМиграции;

	Коннектор = МенеджерСущностей.ПолучитьКоннектор();
	Если НЕ КоннекторПоддерживаетМиграции(Коннектор) Тогда
		Возврат План;
	КонецЕсли;

	Для Каждого ОбъектМодели Из ОбъектыМоделиВсехТаблиц() Цикл
		ДобавитьВПланИзмененияТаблицы(План, Коннектор, ОбъектМодели);
	КонецЦикла;

	Возврат План;
КонецФункции

#Область СравнениеСхем

Процедура ДобавитьВПланИзмененияТаблицы(План, Коннектор, ОбъектМодели)
	ОписаниеТаблицы = Коннектор.ПолучитьОписаниеТаблицы(ОбъектМодели);

	Если НЕ ОписаниеТаблицы.Существует() Тогда
		План.Добавить(Новый ИзменениеСхемы(ВидыИзмененийСхемы.СозданиеТаблицы, ОбъектМодели));
		Возврат;
	КонецЕсли;

	КолонкиМодели = ОбъектМодели.Колонки();

	Для Каждого КолонкаМодели Из КолонкиМодели Цикл
		ОжидаемыйТип = Коннектор.ПолучитьТипКолонкиСУБД(ОбъектМодели, КолонкаМодели);
		ФактическаяКолонка = ОписаниеТаблицы.НайтиКолонку(КолонкаМодели.ИмяКолонки);

		Если ФактическаяКолонка = Неопределено Тогда
			План.Добавить(Новый ИзменениеСхемы(
				ВидыИзмененийСхемы.ДобавлениеКолонки,
				ОбъектМодели,
				КолонкаМодели.ИмяКолонки,
				ОжидаемыйТип
			));
		ИначеЕсли ЗначениеЗаполнено(ФактическаяКолонка.ТипКолонкиСУБД)
			И НРег(ФактическаяКолонка.ТипКолонкиСУБД) <> НРег(ОжидаемыйТип) Тогда
			План.Добавить(Новый ИзменениеСхемы(
				ВидыИзмененийСхемы.ИзменениеТипаКолонки,
				ОбъектМодели,
				КолонкаМодели.ИмяКолонки,
				ОжидаемыйТип
			));
		КонецЕсли;
	КонецЦикла;

	Для Каждого ФактическаяКолонка Из ОписаниеТаблицы.Колонки() Цикл
		Если НайтиКолонкуМодели(КолонкиМодели, ФактическаяКолонка.ИмяКолонки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если УдалятьЛишниеКолонки Тогда
			План.Добавить(Новый ИзменениеСхемы(
				ВидыИзмененийСхемы.УдалениеКолонки,
				ОбъектМодели,
				ФактическаяКолонка.ИмяКолонки
			));
		Иначе
			Лог.Предупреждение(
				"В таблице %1 обнаружена колонка %2, отсутствующая в модели данных.
				|Удаление лишних колонок отключено, см. МиграторСхемы.УстановитьУдалениеЛишнихКолонок",
				ОбъектМодели.ИмяТаблицы(),
				ФактическаяКолонка.ИмяКолонки
			);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НайтиКолонкуМодели(КолонкиМодели, Знач ИмяКолонки)
	Для Каждого КолонкаМодели Из КолонкиМодели Цикл
		Если НРег(КолонкаМодели.ИмяКолонки) = НРег(ИмяКолонки) Тогда
			Возврат КолонкаМодели;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Функция ОбъектыМоделиВсехТаблиц()
	Результат = Новый Массив;

	МодельДанных = МенеджерСущностей.ПолучитьМодельДанных();
	Для Каждого ОбъектМодели Из МодельДанных.ПолучитьОбъектыМодели() Цикл
		Если ОбъектМодели.ТипСущности() = Тип("СлужебнаяСущность_ВерсияСхемы") Тогда
			// Служебная таблица версии схемы обслуживается до построения общего плана
			Продолжить;
		КонецЕсли;

		Результат.Добавить(ОбъектМодели);

		Для Каждого ПодчиненнаяТаблица Из ОбъектМодели.ПодчиненныеТаблицы() Цикл
			Результат.Добавить(
				ОбработкаКоллекций.ПолучитьОбъектМоделиДляПодчиненнойТаблицы(ОбъектМодели, ПодчиненнаяТаблица)
			);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПрименениеПлана

Процедура ПрименитьПлан(Коннектор, План)
	Если План.Пустой() Тогда
		Возврат;
	КонецЕсли;

	ОбработанныеТаблицы = Новый Соответствие;
	Для Каждого Изменение Из План.Изменения() Цикл
		КлючТаблицы = НРег(Изменение.ИмяТаблицы);
		Если ОбработанныеТаблицы.Получить(КлючТаблицы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеТаблицы.Вставить(КлючТаблицы, Истина);

		Коннектор.ПрименитьИзмененияТаблицы(
			Изменение.ОбъектМодели,
			План.ИзмененияТаблицы(Изменение.ИмяТаблицы)
		);
	КонецЦикла;
КонецПроцедуры

Процедура ИнициализироватьТаблицыБезМиграции(Коннектор)
	Для Каждого ОбъектМодели Из ОбъектыМоделиВсехТаблиц() Цикл
		Коннектор.ИнициализироватьТаблицу(ОбъектМодели);
	КонецЦикла;
КонецПроцедуры

Функция КоннекторПоддерживаетМиграции(Коннектор)
	ИнтерфейсМиграций = Новый ИнтерфейсОбъекта;
	ИнтерфейсМиграций.ИзОбъекта(Тип("АбстрактныйКоннекторМиграций"));

	РефлекторОбъекта = Новый РефлекторОбъекта(ТипЗнч(Коннектор));
	Возврат РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсМиграций);
КонецФункции

#КонецОбласти

#Область ВерсияСхемы

Функция ИнициализироватьХранениеВерсии(Коннектор, ПоддерживаютсяМиграции)
	МодельДанных = МенеджерСущностей.ПолучитьМодельДанных();
	ОбъектМоделиВерсии = МодельДанных.Получить(Тип("СлужебнаяСущность_ВерсияСхемы"));
	Если ОбъектМоделиВерсии = Неопределено Тогда
		ОбъектМоделиВерсии = МодельДанных.СоздатьОбъектМодели(Тип("СлужебнаяСущность_ВерсияСхемы"));
	КонецЕсли;

	Если ПоддерживаютсяМиграции Тогда
		ПланСлужебнойТаблицы = Новый ПланМиграции;
		ДобавитьВПланИзмененияТаблицы(ПланСлужебнойТаблицы, Коннектор, ОбъектМоделиВерсии);
		ПрименитьПлан(Коннектор, ПланСлужебнойТаблицы);
	Иначе
		Коннектор.ИнициализироватьТаблицу(ОбъектМоделиВерсии);
	КонецЕсли;

	Возврат ХранимаяВерсияСхемы();
КонецФункции

Процедура ПроверитьДопустимостьОбновленияВерсии(ХранимаяВерсия)
	Если ХранимаяВерсия = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВерсияПриложения) Тогда
		Возврат;
	КонецЕсли;

	Если Версии.СравнитьВерсии(ВерсияПриложения, ХранимаяВерсия) = -1 Тогда
		ВызватьИсключение СтрШаблон(
			"Версия схемы приложения %1 меньше версии схемы в БД %2. Понижение версии схемы не поддерживается",
			ВерсияПриложения,
			ХранимаяВерсия
		);
	КонецЕсли;

	Если Версии.СравнитьВерсии(ВерсияПриложения, ХранимаяВерсия) <> 1 Тогда
		// Версия схемы не повышается, барьерные версии не проверяются
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(МинимальнаяВерсияОбновления)
		И Версии.СравнитьВерсии(ХранимаяВерсия, МинимальнаяВерсияОбновления) = -1 Тогда
		ВызватьИсключение СтрШаблон(
			"Обновление схемы с версии %1 на версию %2 невозможно: минимальная версия схемы для обновления - %3.
			|Выполните обновление через промежуточные версии приложения",
			ХранимаяВерсия,
			ВерсияПриложения,
			МинимальнаяВерсияОбновления
		);
	КонецЕсли;

	Для Каждого ОписаниеОбработчика Из Обработчики Цикл
		Если НЕ ЗначениеЗаполнено(ОписаниеОбработчика.Версия)
			ИЛИ НЕ ЗначениеЗаполнено(ОписаниеОбработчика.МинимальнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		// Ограничение проверяется только для обработчиков, участвующих в текущем обновлении
		Если Версии.СравнитьВерсии(ОписаниеОбработчика.Версия, ХранимаяВерсия) <> 1
			ИЛИ Версии.СравнитьВерсии(ОписаниеОбработчика.Версия, ВерсияПриложения) = 1 Тогда
			Продолжить;
		КонецЕсли;

		Если Версии.СравнитьВерсии(ХранимаяВерсия, ОписаниеОбработчика.МинимальнаяВерсия) = -1 Тогда
			ВызватьИсключение СтрШаблон(
				"Миграция на версию %1 возможна только с версии схемы не ниже %2, версия схемы в БД - %3.
				|Выполните обновление через промежуточные версии приложения",
				ОписаниеОбработчика.Версия,
				ОписаниеОбработчика.МинимальнаяВерсия,
				ХранимаяВерсия
			);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьВерсию(Знач Версия)
	Если НЕ ОтслеживатьВерсию ИЛИ НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат;
	КонецЕсли;

	ЗаписьВерсии = МенеджерСущностей.ПолучитьОдно(Тип("СлужебнаяСущность_ВерсияСхемы"), ИдентификаторЗаписиВерсии);
	Если ЗаписьВерсии = Неопределено Тогда
		ЗаписьВерсии = Новый СлужебнаяСущность_ВерсияСхемы;
		ЗаписьВерсии.Идентификатор = ИдентификаторЗаписиВерсии;
	КонецЕсли;

	ЗаписьВерсии.Версия = Версия;
	ЗаписьВерсии.ДатаОбновления = ТекущаяДата();
	МенеджерСущностей.Сохранить(ЗаписьВерсии);

	Лог.Отладка("Зафиксирована версия схемы %1", Версия);
КонецПроцедуры

Функция НормализоватьВерсию(Знач Версия)
	Версия = СокрЛП(Версия);
	ЧастиВерсии = СтрРазделить(Версия, ".");
	Пока ЧастиВерсии.Количество() < 3 Цикл
		ЧастиВерсии.Добавить("0");
	КонецЦикла;

	Возврат СтрСоединить(ЧастиВерсии, ".");
КонецФункции

Функция ЗначениеМетодаВерсии(Обработчик, Знач ИмяМетода)
	Если НЕ Рефлектор.МетодСуществует(Обработчик, ИмяМетода) Тогда
		Возврат "";
	КонецЕсли;

	Версия = Рефлектор.ВызватьМетод(Обработчик, ИмяМетода, Новый Массив);
	Если НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат "";
	КонецЕсли;

	Возврат НормализоватьВерсию(Версия);
КонецФункции

#КонецОбласти

#Область Обработчики

Функция ШагиКонвейераОбновления(ХранимаяВерсия, ВыполняетсяПовышениеВерсии)
	Шаги = Новый Массив;
	Если НЕ ВыполняетсяПовышениеВерсии Тогда
		Возврат Шаги;
	КонецЕсли;

	Для Каждого ОписаниеОбработчика Из Обработчики Цикл
		Если НЕ ЗначениеЗаполнено(ОписаниеОбработчика.Версия) Тогда
			Продолжить;
		КонецЕсли;

		// В конвейер попадают версии из интервала (ХранимаяВерсия; ВерсияПриложения]
		Если Версии.СравнитьВерсии(ОписаниеОбработчика.Версия, ХранимаяВерсия) <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Если Версии.СравнитьВерсии(ОписаниеОбработчика.Версия, ВерсияПриложения) = 1 Тогда
			Продолжить;
		КонецЕсли;

		Шаг = НайтиШагКонвейера(Шаги, ОписаниеОбработчика.Версия);
		Если Шаг = Неопределено Тогда
			Шаг = Новый Структура("Версия, Обработчики", ОписаниеОбработчика.Версия, Новый Массив);
			ВставитьШагПоВозрастаниюВерсии(Шаги, Шаг);
		КонецЕсли;

		Шаг.Обработчики.Добавить(ОписаниеОбработчика.Обработчик);
	КонецЦикла;

	Возврат Шаги;
КонецФункции

Функция НайтиШагКонвейера(Шаги, Знач Версия)
	Для Каждого Шаг Из Шаги Цикл
		Если Версии.СравнитьВерсии(Шаг.Версия, Версия) = 0 Тогда
			Возврат Шаг;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Процедура ВставитьШагПоВозрастаниюВерсии(Шаги, Шаг)
	ИндексВставки = 0;
	Для Каждого СуществующийШаг Из Шаги Цикл
		Если Версии.СравнитьВерсии(СуществующийШаг.Версия, Шаг.Версия) = 1 Тогда
			Прервать;
		КонецЕсли;
		ИндексВставки = ИндексВставки + 1;
	КонецЦикла;

	Шаги.Вставить(ИндексВставки, Шаг);
КонецПроцедуры

Функция БезверсионныеОбработчики()
	Результат = Новый Массив;
	Для Каждого ОписаниеОбработчика Из Обработчики Цикл
		Если НЕ ЗначениеЗаполнено(ОписаниеОбработчика.Версия) Тогда
			Результат.Добавить(ОписаниеОбработчика.Обработчик);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Процедура ВызватьОбработчики(Знач ИмяМетода, Знач СписокОбработчиков, План)
	Для Каждого Обработчик Из СписокОбработчиков Цикл
		Если НЕ Рефлектор.МетодСуществует(Обработчик, ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;

		Лог.Отладка("Вызов метода %1 обработчика миграции %2", ИмяМетода, ТипЗнч(Обработчик));

		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(МенеджерСущностей);
		ПараметрыМетода.Добавить(План);
		Рефлектор.ВызватьМетод(Обработчик, ИмяМетода, ПараметрыМетода);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
