// Половина блокировки чтения-записи, отвечающая за чтение.
//
// Читатели работают параллельно друг с другом и не пересекаются с писателем. Создается объектом
// "БлокировкаЧтенияЗаписи", напрямую конструировать не следует - половины, созданные по
// отдельности, ничего не разделяют и ни от чего не защищают.
//
// Каждому захвату должно соответствовать освобождение, в том числе при исключении:
//
//   Блокировка.Заблокировать();
//   Попытка
//       // работа с ресурсом
//   Исключение
//       Блокировка.Разблокировать();
//       ВызватьИсключение;
//   КонецПопытки;
//   Блокировка.Разблокировать();
//
#Использовать "../internal"

// Состояние, разделяемое обеими половинами блокировки.
Перем Состояние;

// Конструктор.
//
// Параметры:
//   ПСостояние - СостояниеБлокировкиЧтенияЗаписи - Состояние блокировки чтения-записи.
//
Процедура ПриСозданииОбъекта(Знач ПСостояние)
	Состояние = ПСостояние;
КонецПроцедуры

// Захватить блокировку чтения, ожидая освобождения сколько потребуется.
//
// Если блокировка уже захвачена текущим контекстом исполнения - на чтение или на запись, -
// возвращает управление сразу, увеличивая счетчик захватов.
//
Процедура Заблокировать() Экспорт
	Состояние.ЗаблокироватьЧтение();
КонецПроцедуры

// Попытаться захватить блокировку чтения.
//
// Параметры:
//   ТаймаутОжидания - Число - Предельное время ожидания в миллисекундах. Ноль - одна попытка
//                             без ожидания.
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка захвачена. Ложь означает, что ресурс занят, и освобождать
//            блокировку не нужно.
//
Функция ПопытатьсяЗаблокировать(Знач ТаймаутОжидания = 0) Экспорт
	Возврат Состояние.ПопытатьсяЗаблокироватьЧтение(ТаймаутОжидания);
КонецФункции

// Освободить блокировку чтения.
//
// Уменьшает счетчик захватов текущего контекста исполнения. Если блокировка чтения текущим
// контекстом не захвачена, вызывает исключение.
//
Процедура Разблокировать() Экспорт
	Состояние.РазблокироватьЧтение();
КонецПроцедуры
