#Использовать "../internal"

#Использовать atomic

// ОбъектМодели - Модель сущности, к типу которой привязано хранилище.
Перем ОбъектМодели;

// Строка - Ключ, под которым пул сущностей хранилища лежит в данных потока исполнения.
//
// Пул у каждого потока свой: внутри потока на идентификатор один экземпляр и между вызовами, а
// разные потоки получают разные экземпляры одной строки. Так чтение в одном потоке не
// перезаписывает поля экземпляра, с которым работает другой. Пул пишет и читает только сам поток,
// блокировка не нужна.
Перем КлючПула;

// АтомарноеЧисло - Номер очистки хранилища. Закрыть увеличивает его: данные чужого потока
// вычистить нельзя, поэтому пул другого потока, заведенный до очистки, отбрасывается при его
// следующем обращении.
Перем НомерОчистки;

// МенеджерСущностей - Менеджер, которому принадлежит хранилище: хранилище подставляет в операции
// свой тип сущности и делегирует их ему.
Перем Менеджер;

// Создает хранилище, привязанное к типу сущности.
//
// Создается менеджером сущностей, напрямую конструировать не следует.
//
// Параметры:
//   ПОбъектМодели - ОбъектМодели - Модель сущности, к типу которой привязано хранилище.
//   ПМенеджер - МенеджерСущностей - Менеджер, создавший это хранилище.
//
Процедура ПриСозданииОбъекта(Знач ПОбъектМодели, Знач ПМенеджер)

	ОбъектМодели = ПОбъектМодели;
	КлючПула = "entity.entities." + Строка(Новый УникальныйИдентификатор);
	НомерОчистки = Новый АтомарноеЧисло(0);
	Менеджер = ПМенеджер;

КонецПроцедуры

// Создает экземпляр сущности, расширенный методами паттерна Active Record.
//
//  Возвращаемое значение:
//   Произвольный - экземпляр класса сущности с типом, привязанным к ХранилищуСущностей,
//                  с дополнительными методами паттерна Active Record.
//
Функция СоздатьЭлемент() Экспорт
	Возврат АктивнаяЗапись.Создать(ОбъектМодели, ЭтотОбъект);
КонецФункции

// Сохраняет сущность в БД.
//
// Операция выполняется коннектором из пула. Если текущий поток исполнения начал транзакцию,
// это коннектор той же транзакции.
//
// Параметры:
//   Сущность - Произвольный - Объект (экземпляр класса, зарегистрированного в модели) для сохранения в БД.
//
Процедура Сохранить(Сущность) Экспорт
	Менеджер.Сохранить(Сущность);
КонецПроцедуры

// Осуществляет поиск сущностей типа, привязанного к ХранилищуСущностей, по идентификатору.
//
// Операция выполняется коннектором из пула. Если текущий поток исполнения начал транзакцию,
// это коннектор той же транзакции.
//
// Параметры:
//   ОпцииПоиска - Произвольный - Опции поиска.
//     Если параметр не задан или равен "Неопределено", то возвращаются все найденные сущности указанного типа.
//     Если параметр имеет тип "Соответствие", то каждое значение соответствия преобразуется к условию поиска
//      ИмяПоля = ЗначениеПоля, где ИмяПоля - ключ элемента соответствия, ЗначениеПоля - значение элемента соответствия.
//     Если параметр имеет тип "ОпцииПоиска", то опции передаются как есть.
//
//  Возвращаемое значение:
//   Массив - Массив найденных сущностей. В качестве элементов массива выступают
//     экземпляры класса с типом, привязанным к ХранилищуСущностей, с заполненными значениями полей.
//
Функция Получить(Знач ОпцииПоиска = Неопределено) Экспорт
	Возврат Менеджер.Получить(ОбъектМодели.ТипСущности(), ОпцииПоиска);
КонецФункции

// Осуществляет поиск сущности типа, привязанного к ХранилищуСущностей, по идентификатору.
//
// Операция выполняется коннектором из пула. Если текущий поток исполнения начал транзакцию,
// это коннектор той же транзакции.
//
// Параметры:
//   ОпцииПоиска - Произвольный - Опции поиска.
//     Если параметр не задан или равен "Неопределено", то возвращаются все найденные сущности указанного типа.
//     Если параметр имеет тип "Соответствие", то каждое значение соответствия преобразуется к условию поиска
//      ИмяПоля = ЗначениеПоля, где ИмяПоля - ключ элемента соответствия, ЗначениеПоля - значение элемента соответствия.
//     Если параметр имеет тип "ОпцииПоиска", то опции передаются как есть.
//     Любой другой тип интерпретируется как поиск по &Идентификатору.
//
//  Возвращаемое значение:
//   Произвольный - Если сущность была найдена, то возвращается экземпляр класса с типом, 
//     привязанным к ХранилищуСущностей, с заполненными значениями полей. Иначе возвращается "Неопределено".
//
Функция ПолучитьОдно(Знач ОпцииПоиска = Неопределено) Экспорт
	Возврат Менеджер.ПолучитьОдно(ОбъектМодели.ТипСущности(), ОпцииПоиска);
КонецФункции

// Выполняет удаление сущности из базы данных.
// Сущность должна иметь заполненный идентификатор.
//
// Операция выполняется коннектором из пула. Если текущий поток исполнения начал транзакцию,
// это коннектор той же транзакции.
//
// Параметры:
//   Сущность - Произвольный - Удаляемая сущность
//
Процедура Удалить(Сущность) Экспорт
	Менеджер.Удалить(Сущность);
КонецПроцедуры

// Выполняет очистку текущего Хранилища сущностей.
//
// Отбрасывает ранее прочитанные экземпляры во всех потоках исполнения: следующая операция читает
// сущность из БД в новый экземпляр. Пул текущего потока освобождается сразу, пулы других потоков -
// при их следующем обращении к хранилищу или по завершении потока.
//
Процедура Закрыть() Экспорт
	НомерОчистки.ИнкрементироватьИПолучить();
	ТекущийПоток().Данные.Удалить(КлючПула);
КонецПроцедуры

// Начинает транзакцию для текущего потока исполнения.
//
// Транзакция принадлежит потоку исполнения: в нее попадают все операции этого потока, а не только
// начатые через это хранилище.
//
Процедура НачатьТранзакцию() Экспорт
	Менеджер.НачатьТранзакцию();
КонецПроцедуры

// Фиксирует транзакцию текущего потока исполнения.
//
Процедура ЗафиксироватьТранзакцию() Экспорт
	Менеджер.ЗафиксироватьТранзакцию();
КонецПроцедуры

// Отменяет транзакцию текущего потока исполнения.
//
Процедура ОтменитьТранзакцию() Экспорт
	Менеджер.ОтменитьТранзакцию();
КонецПроцедуры

// Выполняет алгоритм коннектором из пула.
//
// Прямой доступ к БД в обход библиотеки. Соединение занимается на время выполнения алгоритма и
// сразу возвращается в пул, поэтому держать его за пределами вызова нельзя. Если текущий поток
// исполнения начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
// Пример:
//   Хранилище.ВыполнитьСКоннектором(
//       "Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)",
//       Новый Структура("Текст", "DELETE FROM Авторы")
//   );
//
Процедура ВыполнитьСКоннектором(Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт
	Менеджер.ВыполнитьСКоннектором(Алгоритм, Контекст, Объект);
КонецПроцедуры

// Вычисляет значение алгоритмом, выполненным коннектором из пула.
//
// Прямой доступ к БД в обход библиотеки. Соединение занимается на время выполнения алгоритма и
// сразу возвращается в пул, поэтому держать его за пределами вызова нельзя. Если текущий поток
// исполнения начал транзакцию, алгоритм получает коннектор этой транзакции и попадает в нее.
//
// Параметры:
//   Алгоритм - Строка - Лямбда-выражение с одним параметром - коннектором.
//   Контекст - Структура - Значения, доступные в алгоритме по именам ключей.
//   Объект - Сценарий - Объект, поля и методы которого доступны в алгоритме.
//
// Возвращаемое значение:
//   Произвольный - Результат алгоритма.
//
// Пример:
//   Строки = Хранилище.ВычислитьСКоннектором("Коннектор -> Коннектор.ВыполнитьЗапрос(Запрос)",
//       Новый Структура("Запрос", "SELECT * FROM Авторы"));
//
Функция ВычислитьСКоннектором(Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт
	Возврат Менеджер.ВычислитьСКоннектором(Алгоритм, Контекст, Объект);
КонецФункции

// Возвращает объект модели, связанный с текущим хранилищем сущностей.
//
// Возвращаемое значение:
//  ОбъектМодели
//
Функция ПолучитьОбъектМодели() Экспорт
	Возврат ОбъектМодели;
КонецФункции

// @internal
//
// Для служебного пользования.
//
// Возвращает пул сущностей текущего потока исполнения: прочитанные им экземпляры по
// идентификаторам. Пул, заведенный до очистки хранилища, отбрасывается и заводится заново.
//
//  Возвращаемое значение:
//   Соответствие - Пул сущностей текущего потока.
//
Функция ПолучитьПулСущностей() Экспорт

	Данные = ТекущийПоток().Данные;
	Номер = НомерОчистки.Получить();
	Пул = Данные.Получить(КлючПула);

	Если Пул = Неопределено ИЛИ Пул.НомерОчистки <> Номер Тогда
		Пул = Новый ФиксированнаяСтруктура("НомерОчистки, Сущности", Номер, Новый Соответствие);
		Данные.Вставить(КлючПула, Пул);
	КонецЕсли;

	Возврат Пул.Сущности;

КонецФункции
