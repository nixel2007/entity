// Виды событий, которые менеджер сущностей отдает наблюдателям (СобытиеСущностей.Вид()).
//
// Наблюдатель сравнивает вид события со значениями перечисления, а не со строковыми литералами:
//
//   Если Событие.Вид() = ВидыСобытийСущностей.Запрос Тогда

// Строка - Операция менеджера или хранилища: Сохранить, Получить, Удалить и другие.
Перем Операция Экспорт;
// Строка - Запрос коннектора к СУБД: SELECT, INSERT, DELETE, CREATE TABLE, BEGIN, COMMIT, ROLLBACK.
Перем Запрос Экспорт;
// Строка - Захват и освобождение соединения пула: Занять, Освободить.
Перем Соединение Экспорт;
// Строка - Транзакция потока исполнения от начала до исхода.
Перем Транзакция Экспорт;

Перем Виды;

// Все виды событий в порядке объявления.
//
// Возвращаемое значение:
//   Массив из Строка - Операция, Запрос, Соединение, Транзакция.
//
Функция Виды() Экспорт
	Возврат Виды;
КонецФункции

Операция = "Операция";
Запрос = "Запрос";
Соединение = "Соединение";
Транзакция = "Транзакция";

Виды = Новый Массив;
Виды.Добавить(Операция);
Виды.Добавить(Запрос);
Виды.Добавить(Соединение);
Виды.Добавить(Транзакция);
