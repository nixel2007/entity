// Виды событий, которые менеджер сущностей отдает наблюдателям: их возвращает функция Вид события.
//
// Значения отдаются функциями, а не экспортными переменными, чтобы их нельзя было изменить
// извне. Наблюдатель сравнивает вид события с ними, а не со строковыми литералами, например
// с ВидыСобытийСущностей.Запрос().

// Массив из Строка - Все виды в порядке объявления.
Перем Виды;

// Операция менеджера или хранилища: Сохранить, Получить, Удалить и другие.
//
// Возвращаемое значение:
//   Строка - Вид события операции.
//
Функция Операция() Экспорт
	Возврат "Операция";
КонецФункции

// Запрос коннектора к СУБД: SELECT, INSERT, DELETE, CREATE TABLE, BEGIN, COMMIT, ROLLBACK.
//
// Возвращаемое значение:
//   Строка - Вид события запроса.
//
Функция Запрос() Экспорт
	Возврат "Запрос";
КонецФункции

// Захват и освобождение соединения пула: Занять, Освободить.
//
// Возвращаемое значение:
//   Строка - Вид события соединения.
//
Функция Соединение() Экспорт
	Возврат "Соединение";
КонецФункции

// Транзакция потока исполнения от начала до исхода.
//
// Возвращаемое значение:
//   Строка - Вид события транзакции.
//
Функция Транзакция() Экспорт
	Возврат "Транзакция";
КонецФункции

// Все виды событий в порядке объявления.
//
// Возвращаемое значение:
//   Массив из Строка - Операция, Запрос, Соединение, Транзакция.
//
Функция Виды() Экспорт
	Возврат Виды;
КонецФункции

Виды = Новый Массив;
Виды.Добавить(Операция());
Виды.Добавить(Запрос());
Виды.Добавить(Соединение());
Виды.Добавить(Транзакция());
