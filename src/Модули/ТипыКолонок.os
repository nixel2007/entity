Перем Целое Экспорт;
Перем Дробное Экспорт;
Перем Булево Экспорт;
Перем Строка Экспорт;
Перем Дата Экспорт;
Перем Время Экспорт;
Перем ДатаВремя Экспорт;
Перем Ссылка Экспорт;
Перем ДвоичныеДанные Экспорт;

Перем Типы;
Перем ПримитивныеТипы;

Функция Типы() Экспорт
	Возврат Типы;
КонецФункции

// Определяет, является ли тип примитивным типом модели.
//
// Значением типа "Тип" примитивный тип модели обозначить нельзя: модель различает "Целое" и
// "Дробное", которым соответствует один платформенный тип "Число", а также "Дата", "Время" и
// "ДатаВремя", которым соответствует "Дата". Поэтому такое значение всегда означает ссылку на
// класс-сущность и приведением к имени не проверяется - строковое представление платформенного
// типа к тому же зависит от локали процесса.
//
// Параметры:
//   Тип - Строка - Имя примитивного типа модели: "Целое", "Дробное", "Булево", "Строка",
//                  "Дата", "Время", "ДатаВремя", "ДвоичныеДанные".
//       - Тип - Тип класса-сущности.
//
// Возвращаемое значение:
//   Булево - Истина, если передано имя примитивного типа модели.
//
Функция ЭтоПримитивныйТип(Знач Тип) Экспорт
	Если ТипЗнч(Тип) = Тип("Тип") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПримитивныеТипы.Найти(Тип) <> Неопределено;
КонецФункции

// Определяет, является ли тип ссылкой на класс-сущность.
//
// Значение типа "Тип" всегда означает ссылку - по причинам, описанным у "ЭтоПримитивныйТип".
//
// Параметры:
//   Тип - Тип - Тип класса-сущности.
//       - Строка - Имя типа модели.
//
// Возвращаемое значение:
//   Булево - Истина, если тип не является типом модели.
//
Функция ЭтоСсылочныйТип(Знач Тип) Экспорт
	Если ТипЗнч(Тип) = Тип("Тип") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Типы.Найти(Тип) = Неопределено И Не ЭтоПримитивныйТип(Тип);
КонецФункции

Целое = "Целое";
Дробное = "Дробное";
Булево = "Булево";
Строка = "Строка";
Дата = "Дата";
Время = "Время";
ДатаВремя = "ДатаВремя";
Ссылка = "Ссылка";
ДвоичныеДанные = "ДвоичныеДанные";

Типы = Новый Массив;
Типы.Добавить(Целое);
Типы.Добавить(Дробное);
Типы.Добавить(Булево);
Типы.Добавить(Строка);
Типы.Добавить(Дата);
Типы.Добавить(Время);
Типы.Добавить(ДатаВремя);
Типы.Добавить(Ссылка);
Типы.Добавить(ДвоичныеДанные);

ПримитивныеТипы = Новый Массив;
ПримитивныеТипы.Добавить(Целое);
ПримитивныеТипы.Добавить(Дробное);
ПримитивныеТипы.Добавить(Булево);
ПримитивныеТипы.Добавить(Строка);
ПримитивныеТипы.Добавить(Дата);
ПримитивныеТипы.Добавить(Время);
ПримитивныеТипы.Добавить(ДатаВремя);
ПримитивныеТипы.Добавить(ДвоичныеДанные);