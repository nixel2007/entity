// Пул блокировок чтения-записи, разделяемый в пределах процесса.
//
Перем Блокировки;
Перем БлокировкаПула;

// Получить блокировку чтения-записи по ключу.
//
// Блокировки хранятся в общем пуле: на один и тот же ключ все вызывающие получают один и тот же
// объект, поэтому синхронизация работает и между фоновыми заданиями.
//
// Параметры:
//   Ключ - Произвольный - Идентификатор защищаемого ресурса. Значение должно удовлетворять
//                         требованиям, предъявляемым к ключам соответствий.
//
// Возвращаемое значение:
//   БлокировкаЧтенияЗаписи - Блокировка, соответствующая ключу.
//
Функция Получить(Ключ) Экспорт

	БлокировкаПула.Заблокировать();

	Попытка

		Блокировка = Блокировки.Получить(Ключ);
		Если Блокировка = Неопределено Тогда
			Блокировка = Новый БлокировкаЧтенияЗаписи();
			Блокировки.Вставить(Ключ, Блокировка);
		КонецЕсли;

	Исключение

		БлокировкаПула.Разблокировать();

		ВызватьИсключение;

	КонецПопытки;

	БлокировкаПула.Разблокировать();

	Возврат Блокировка;

КонецФункции

Блокировки = Новый Соответствие();
БлокировкаПула = Новый БлокировкаРесурса();
